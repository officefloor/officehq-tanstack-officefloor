@@ -0,0 +1,10 @@
+-- A retired person can be unretired: they are no longer retired (retired_from null) and the
+-- retirement is kept as a past one, from its from-date to the sheet's today when unretired. Kept in
+-- the order they ended, as `from:to` pairs (yyyy-mm-dd) separated by commas (null: none). No claim
+-- dated after the from and before the to of a past retirement can be added or edited for them.
+DROP TRIGGER public.person_history;
+ALTER TABLE public.person ADD COLUMN past_retirements VARCHAR(4000);
+ALTER TABLE asof.person ADD COLUMN past_retirements VARCHAR(4000);
+ALTER TABLE asof_hist.person ADD COLUMN past_retirements VARCHAR(4000);
+-- The history trigger keeps the column list it was created with: create it again to see the new one.
+CREATE TRIGGER person_history AFTER INSERT, UPDATE, DELETE ON public.person FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml
new file mode 100644
index 00000000..87aba772
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml
@@ -0,0 +1,31 @@
+# Unretire a retired person on the sheet's today: they are no longer retired, and the retirement is
+# kept as a past one, from its date to today. Anyone not retired is refused.
+validate:
+  class: net.officefloor.hq.app.person.ValidateUnretire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: unretire
+unretire:
+  class: net.officefloor.hq.app.person.UnretirePerson
+  govern: [ transaction ]
+  next: record
+# Audit only once the unretirement is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonUnretired
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
