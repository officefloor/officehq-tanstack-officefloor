@@ -0,0 +1,10 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.plugin.variable.Val;
+
+/** Refuses to unretire anyone not retired, before anything is written. */
+public class ValidateUnretire {
+    public void validate(@Val Person person) throws InvalidPersonException {
+        if (!person.isRetired()) throw new InvalidPersonException(person.getName() + " is not retired");
+    }
+}
diff --git a/src/main/resources/db/migration/V76__person_past_retirement.sql b/src/main/resources/db/migration/V76__person_past_retirement.sql
new file mode 100644
index 000000000..992afeefa
--- /dev/null
+++ b/src/main/resources/db/migration/V76__person_past_retirement.sql
@@ -0,0 +1,10 @@
+-- A retirement a person was unretired from: from its from-date to the sheet's today when they were
+-- unretired, oldest first. No claim dated after the from and before the to can be added to them.
+CREATE TABLE person_past_retirement (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    person_id BIGINT NOT NULL REFERENCES person(id),
+    from_date DATE NOT NULL,
+    to_date DATE NOT NULL
+);
+CREATE INDEX person_past_retirement_sheet ON person_past_retirement(sheet_id, person_id, id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml
new file mode 100644
index 000000000..2ebedc3c8
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml
@@ -0,0 +1,41 @@
+# Unretire a retired person on the sheet's today: their retirement is kept as a past one, from its
+# from-date to today, and no claim dated after the from and before the to can be added to them.
+# Anyone not retired is refused. Their claims count in the totals again.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateUnretire
+  govern: [ transaction ]
+  next: unretire
+unretire:
+  class: net.officefloor.hq.app.person.UnretirePerson
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the unretirement is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonUnretired
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
