--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheet}/people/{person}/unretire.POST.yml
@@ -0,0 +1,12 @@
+# Unretires the person on the sheet's today; refused for anyone not retired. Responds with the sheet's people.
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: unretire
+unretire:
+  class: net.officefloor.hq.app.person.UnretirePerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPeople
+  govern: [ transaction ]
