@@ -0,0 +1,10 @@
+-- A person's past retirements, each from the date they were retired from to the day they were unretired
+-- (the sheet's today then). No claim of theirs dated after the from-date and before the to-date may be added.
+CREATE TABLE person_retirement (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(255) NOT NULL,
+    person_id BIGINT       NOT NULL,
+    from_date DATE         NOT NULL,
+    to_date   DATE         NOT NULL
+);
+CREATE INDEX person_retirement_sheet ON person_retirement (sheet_id, person_id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml
new file mode 100644
index 000000000..4874b1aff
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml
@@ -0,0 +1,27 @@
+# POST /api/sheets/{sheetId}/people/{personId}/unretire — unretire a retired person (body: {user}) on the
+# sheet's today: they are no longer retired, and the retirement is kept as a past one, from its date to
+# that day; no claim dated after its from-date and before its to-date may be added to them. Refused
+# (400), storing nothing, when the person is not retired or not on the sheet. A stored unretirement is
+# recorded in the audit file as PERSON_UNRETIRED, followed by how it moved the figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidateUnretire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: unretire
+unretire:
+  class: net.officefloor.hq.app.person.UnretirePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonUnretired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
