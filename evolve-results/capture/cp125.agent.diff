diff --git a/src/main/java/net/officefloor/hq/app/person/UnretirePerson.java b/src/main/java/net/officefloor/hq/app/person/UnretirePerson.java
new file mode 100644
index 000000000..2d47fecc4
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/UnretirePerson.java
@@ -0,0 +1,14 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.plugin.variable.Val;
+
+/** Unretires the person: their retirement is kept as a past one, to the sheet's today. */
+public class UnretirePerson {
+    public void unretire(@Val Sheet sheet, @Val Person person, PersonRepository repository) {
+        PastRetirement past = new PastRetirement(person.getRetiredFrom(), sheet.today());
+        person.getPastRetirements().add(past);
+        person.setRetiredFrom(null);
+        repository.saveUnretired(person, past);
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/person/ValidateUnretire.java b/src/main/java/net/officefloor/hq/app/person/ValidateUnretire.java
