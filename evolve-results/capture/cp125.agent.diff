index 000000000..83baf8557
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.POST.yml
@@ -0,0 +1,26 @@
+# POST /api/sheets/{sheetId}/people/{personId}/unretire — unretire a retired person on the sheet's today. They are no
+# longer retired, and the retirement is kept as a past one, from its date to that day: no claim of theirs may be dated
+# after the from and before the to of one. A person not retired is a 400 and a person not on the sheet a 404, neither
+# writing anything. Their OPEN and PENDING claims count in the live totals again, and the figures that moves are written.
+# Responds with the person as stored.
+validate:
+  class: net.officefloor.hq.app.person.ValidateUnretire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: unretire
+unretire:
+  class: net.officefloor.hq.app.person.UnretirePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonUnretired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
