@@ -0,0 +1,30 @@
+# POST /api/sheets/{sheetId}/people/{personId}/unretire — unretire a retired person on the sheet's
+# today: they are no longer retired, their retirement kept as a past one (from its date to the
+# sheet's today); anyone not retired is refused. Their open claims count again in every live total
+# (ROLLUP/TOTALS lines when they move).
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: unretire
+unretire:
+  class: net.officefloor.hq.app.person.UnretirePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonUnretired
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
