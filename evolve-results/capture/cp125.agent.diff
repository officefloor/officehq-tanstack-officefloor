--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/UnretirePerson.java
@@ -0,0 +1,17 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.hq.app.sheet.SheetRepository;
+import net.officefloor.plugin.variable.Val;
+
+/** Unretires a retired person on the sheet's today, keeping the retirement as a past one; anyone
+ *  not retired is refused and nothing is written. */
+public class UnretirePerson {
+    public void unretire(@Val Person person, SheetRepository sheets, PersonRepository people)
+            throws InvalidPersonException {
+        if (!person.isRetired()) {
+            throw new InvalidPersonException("The person is not retired");
+        }
+        person.unretire(sheets.today(person.getSheetId()).toString());
+        people.updateUnretired(person);
+    }
+}
diff --git a/src/main/resources/db/migration/V61__person_retirement.sql b/src/main/resources/db/migration/V61__person_retirement.sql
new file mode 100644
index 000000000..dabcf45e1
--- /dev/null
+++ b/src/main/resources/db/migration/V61__person_retirement.sql
@@ -0,0 +1,14 @@
+-- A person's past retirements, oldest first: each ran from its from-date to the sheet's today when
+-- they were unretired (to_date). A claim dated after the from-date and before the to-date is refused,
+-- as one dated after a retirement is.
+CREATE TABLE person_retirement (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(200) NOT NULL,
+    person_id BIGINT       NOT NULL,
+    from_date DATE         NOT NULL,
+    to_date   DATE         NOT NULL
+);
+CREATE INDEX person_retirement_person ON person_retirement (sheet_id, person_id, id);
+
+-- An unretirement is kept in the retirement history as a row with no date: as of it, not retired.
+ALTER TABLE person_retired_history ALTER COLUMN retired_from SET NULL;
