@@ -0,0 +1,12 @@
+-- A person's past retirements: each one ended by unretiring them, from the date they were retired from to the
+-- sheet's today when they were unretired (made_on). A claim dated after the from and before the to is refused.
+-- Unretiring also logs a null from_date in person_retire_log: not retired from then on.
+CREATE TABLE person_retirement (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(100) NOT NULL REFERENCES sheet(id),
+    person_id BIGINT       NOT NULL REFERENCES person(id),
+    from_date DATE         NOT NULL,
+    to_date   DATE         NOT NULL,
+    made_on   DATE
+);
+CREATE INDEX person_retirement_person ON person_retirement(sheet_id, person_id, id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.PUT.yml
new file mode 100644
index 0000000..eaed273
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unretire.PUT.yml
@@ -0,0 +1,33 @@
+# Unretire a retired person on the sheet's today: they are no longer retired, and the retirement is kept as a past
+# one, from the date they were retired from to that day (a claim dated after the from and before the to is refused).
+# A refused unretire (no signed-in user, unknown person, a person not retired) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateUnretire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: refuse
+refuse:
+  class: net.officefloor.hq.app.person.RefuseNotRetired
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SaveUnretire
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonUnretired
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditUnretireRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
