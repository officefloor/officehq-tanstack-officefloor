+# Add a note, dated the sheet's today. Validate the body before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: note
+note:
+  class: net.officefloor.hq.app.note.ValidateNote
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.note.BuildNote
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.note.RecordNoteAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.note.RespondWithNote
+  govern: [ transaction ]
