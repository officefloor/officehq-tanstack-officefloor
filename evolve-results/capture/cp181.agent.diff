+# POST /api/sheets/{sheetId}/notes — adds a note to the sheet, dated the sheet's today. Body {"text":"..."}, trimmed. A
+# blank text is refused with 422 and nothing is stored or recorded.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.note.ValidateNote
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.note.AddNote
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.note.AuditNoteAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.note.RespondWithNote
+  govern: [ transaction ]
