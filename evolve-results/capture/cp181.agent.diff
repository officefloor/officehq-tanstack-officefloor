+# POST /api/sheets/{sheetId}/notes — add a note (trimmed) to the sheet, dated the sheet's today. A blank one is a 400 and
+# writes nothing. Writes NOTE_ADDED. Responds 201 with the note.
+validate:
+  class: net.officefloor.hq.app.note.ValidateNote
+  next: add
+add:
+  class: net.officefloor.hq.app.note.AddNote
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.note.RecordNoteAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.note.RespondWithNoteCreated
