+# POST /api/sheets/{sheetId}/notes — adds a note to the sheet (body: {text, user}), dated the sheet's today.
+# A blank text, a viewer, or an archived sheet is refused (400) and nothing is stored. Recorded as NOTE_ADDED.
+validate:
+  class: net.officefloor.hq.app.note.ValidateNote
+  next: save
+save:
+  class: net.officefloor.hq.app.note.SaveNote
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.note.AuditNoteAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.note.RespondWithNote
+  govern: [ transaction ]
