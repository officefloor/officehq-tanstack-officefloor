diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/notes.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/notes.POST.yml
new file mode 100644
index 00000000..7544053f
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/notes.POST.yml
@@ -0,0 +1,17 @@
+# Add a note. Validate first so a blank note is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.note.ValidateNote
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.note.SaveNote
+  govern: [ transaction ]
+  next: record
+# Audit only once the note is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.note.RecordNoteAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.note.RespondWithNote
+  govern: [ transaction ]
