diff --git a/src/main/java/net/officefloor/hq/app/claim/SaveClaimEdit.java b/src/main/java/net/officefloor/hq/app/claim/SaveClaimEdit.java
new file mode 100644
index 000000000..eca6ed46f
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/SaveClaimEdit.java
@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Val;
+
+/** Stores an edit of a draft, refusing it when another user moved the claim on first. */
+public class SaveClaimEdit {
+    public void save(@Val Claim claim, ClaimStore store) throws InvalidSheetException {
+        if (!store.edit(claim)) {
+            throw new InvalidSheetException("Only a DRAFT claim can be edited");
+        }
+    }
+}
