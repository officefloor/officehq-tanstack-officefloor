diff --git a/src/main/resources/db/migration/V14__tasks.sql b/src/main/resources/db/migration/V14__tasks.sql
new file mode 100644
index 0000000..bb8f7b5
--- /dev/null
+++ b/src/main/resources/db/migration/V14__tasks.sql
@@ -0,0 +1,10 @@
+-- Tasks a user keeps on a project: a title and a done flag, so a to-do can be ticked off. Each task
+-- belongs to exactly one project (project_id FK). IDENTITY id like client, project and contact, so
+-- the DB assigns it on insert while the seed path can still supply explicit ids (GENERATED BY
+-- DEFAULT). done defaults to FALSE — a freshly added task is OPEN until it is ticked off.
+CREATE TABLE task (
+    id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    project_id BIGINT NOT NULL REFERENCES project(id),
+    title      VARCHAR(255) NOT NULL,
+    done       BOOLEAN NOT NULL DEFAULT FALSE
+);
