diff --git a/src/main/resources/db/migration/V14__tasks.sql b/src/main/resources/db/migration/V14__tasks.sql
new file mode 100644
index 0000000..91cd387
--- /dev/null
+++ b/src/main/resources/db/migration/V14__tasks.sql
@@ -0,0 +1,10 @@
+-- Fourth domain table: a task is a to-do item that belongs to a project. IDENTITY id so the app
+-- generates ids on create, while the test seed inserts explicit ids (GENERATED BY DEFAULT lets a
+-- supplied id win). project_id is a FK to projects so a task always points at a real project.
+-- done is the tick-off flag: new rows start not-done (the DEFAULT); ticking one flips it to TRUE.
+CREATE TABLE tasks (
+    id         BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    project_id BIGINT NOT NULL REFERENCES projects (id),
+    title      VARCHAR(255) NOT NULL,
+    done       BOOLEAN NOT NULL DEFAULT FALSE
+);
