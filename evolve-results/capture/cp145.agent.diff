+# Re-date the selected claims together. Each that can be re-dated is re-dated and audited as a
+# single re-dating would be, with the figures it moved, in list order; each that cannot is left as
+# it is. Answers how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkRedate
+  next: redate
+redate:
+  class: net.officefloor.hq.app.claim.RedateClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkRedate
+  govern: [ transaction ]
