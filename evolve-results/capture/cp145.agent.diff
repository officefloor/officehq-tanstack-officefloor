@@ -0,0 +1,27 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import java.util.List;
+import java.util.Objects;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the body: the selected claim ids (each once; a missing list is none), the new date (a re-dating needs a real
+ *  date, yyyy-MM-dd) and who re-dates them. */
+public class ValidateBulkRedate {
+    public void validate(@RequestBody BulkRedateRequest request, Out<BulkRedating> body)
+            throws InvalidClaimStatusException {
+        String date = request == null || request.date() == null ? "" : request.date().trim();
+        LocalDate parsed;
+        try {
+            parsed = LocalDate.parse(date);
+        } catch (DateTimeParseException e) {
+            throw new InvalidClaimStatusException("A re-dating needs the claims' new date");
+        }
+        List<Long> ids = request.claimIds() == null ? List.of()
+                : request.claimIds().stream().filter(Objects::nonNull).distinct().toList();
+        String by = request.by() == null ? "" : request.by().trim();
+        body.set(new BulkRedating(ids, new ClaimRedating(parsed, by, null)));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-redate.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-redate.POST.yml
new file mode 100644
index 000000000..0c5392cd7
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-redate.POST.yml
@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/bulk-redate — re-date the selected claims together. Each selected claim is re-dated by the
+# signed-in user exactly as the single re-date does (see ApplyRedate), in list order: people by their place in the
+# list, a person's claims newest first; each writes its own CLAIM_REDATED and figure lines. Each that cannot be
+# re-dated (or is not on the sheet) is left as it is and counted refused. Not a date is a 409. Responds with how many
+# were re-dated and how many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkRedate
+  next: redate
+redate:
+  class: net.officefloor.hq.app.claim.RedateClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkRedate
