+# Re-date the selected claims to one date together, in list order (people as added, each one's claims newest first),
+# each exactly as its row's re-date. One that cannot be re-dated is left as it is; answers how many were re-dated and
+# how many refused.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: selected
+selected:
+  class: net.officefloor.hq.app.claim.ValidateBulkRedate
+  next: redate
+redate:
+  class: net.officefloor.hq.app.claim.RedateClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkRedate
+  govern: [ transaction ]
