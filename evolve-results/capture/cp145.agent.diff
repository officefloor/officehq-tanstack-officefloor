@@ -0,0 +1,22 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import java.util.List;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** A bulk re-dating needs the claims' new date. */
+public class ValidateBulkRedate {
+    public void validate(@RequestBody BulkRedateRequest request, Out<BulkRedateRequest> body, Out<Redate> date)
+            throws InvalidClaimException {
+        List<String> ids = request == null || request.claimIds() == null ? List.of() : request.claimIds();
+        String raw = request == null || request.date() == null ? "" : request.date().trim();
+        try {
+            date.set(new Redate(LocalDate.parse(raw)));
+        } catch (DateTimeParseException e) {
+            throw new InvalidClaimException("A re-dating needs the claims' new date");
+        }
+        body.set(new BulkRedateRequest(ids, raw));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/bulk-redate.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/bulk-redate.POST.yml
new file mode 100644
index 000000000..f9f9a283e
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/bulk-redate.POST.yml
@@ -0,0 +1,18 @@
+# Re-date the selected claims to one date together, in list order, by the rules of re-dating one. Each
+# that cannot be re-dated is refused and left as it is; the response tells how many were re-dated and
+# how many refused. A request without a date is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkRedate
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: redate
+# Each claim re-dated is audited as it is re-dated: its own line, then the figures it moved.
+redate:
+  class: net.officefloor.hq.app.claim.RedateSelectedClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkRedate
+  govern: [ transaction ]
