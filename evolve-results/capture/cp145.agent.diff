@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/bulk-redate — re-date the selected claims together (body {claimIds, date, user}).
+# Each selected claim is re-dated in list order — people by their positions, a person's claims newest
+# first — by exactly the rules of a single re-dating by the user (who may, which statuses, closed periods,
+# retirement), and recorded as a single re-dating is (CLAIM_REDATED and its rollup lines); each that a single
+# re-dating would refuse is refused and left as it is. Answers {redated, refused}. Refused (400) only when no
+# claim is selected or the date does not parse.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkRedate
+  next: redate
+redate:
+  class: net.officefloor.hq.app.claim.RedateClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkRedate
+  govern: [ transaction ]
