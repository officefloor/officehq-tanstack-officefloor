@@ -0,0 +1,12 @@
+# Open the selected claims together, in list order. Each that can be opened is opened (numbered, audited and
+# rolled up as a single open is); each that cannot is left as it is. Responds with how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkOpen
+  next: open
+open:
+  class: net.officefloor.hq.app.claim.BulkOpenClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
+  govern: [ transaction ]
