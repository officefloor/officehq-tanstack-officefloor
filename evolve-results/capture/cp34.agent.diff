@@ -0,0 +1,15 @@
+# Open the selected claims together, numbered in list order (people as added, each one's claims newest
+# first). One that cannot be opened is left as it is; answers how many were opened and how many refused.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: selected
+selected:
+  class: net.officefloor.hq.app.claim.ValidateBulkOpen
+  next: open
+open:
+  class: net.officefloor.hq.app.claim.OpenClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
+  govern: [ transaction ]
