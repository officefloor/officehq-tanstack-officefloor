@@ -0,0 +1,12 @@
+# Open the selected claims together. Each that can be opened is opened (and audited) as a single
+# open would be, in list order; each that cannot is left as it is. Answers how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkOpen
+  next: open
+open:
+  class: net.officefloor.hq.app.claim.OpenClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
+  govern: [ transaction ]
