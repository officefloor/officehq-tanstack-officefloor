+# Open the selected claims together. Each one that can be opened (a DRAFT not dated inside a closed
+# period) is opened and numbered in list order — the people in the order they were added, then each
+# person's claims in the order they were added; each that cannot is left as it is and counted refused.
+open:
+  class: net.officefloor.hq.app.claim.BulkOpenClaims
+  govern: [ transaction ]
+  next: audit
+# Record the opened claims only once they are saved, in the order they were numbered.
+audit:
+  class: net.officefloor.hq.app.claim.AuditBulkOpened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
