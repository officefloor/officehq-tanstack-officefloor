--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-open.POST.yml
@@ -0,0 +1,15 @@
+# POST /api/sheets/{sheetId}/bulk-open — open the selected claims together (body {claimIds, user}).
+# Each selected claim that can be opened (a DRAFT on the sheet, not dated in a closed period) is
+# opened and numbered in list order — people in the order they were added, a person's claims
+# newest first — and recorded as CLAIM_OPENED, as a single open is; each that cannot is refused and
+# left as it is. Answers {opened, refused}. Refused (400) only when no claim is selected.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkOpen
+  next: open
+open:
+  class: net.officefloor.hq.app.claim.OpenClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
+  govern: [ transaction ]
