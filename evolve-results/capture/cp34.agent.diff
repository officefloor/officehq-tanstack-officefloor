@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/bulk-open — open the selected claims together. Each selected claim that can be opened
+# (a DRAFT not dated inside a closed period) is opened as the single open does, in list order: people in the order
+# they were added, a person's claims newest first, so each takes the sheet's next number in that order and writes
+# its own CLAIM_OPENED, ROLLUP and TOTALS lines. Each that cannot (or is not on the sheet) is left as it is and
+# counted refused. Responds with how many were opened and how many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkOpen
+  next: open
+open:
+  class: net.officefloor.hq.app.claim.OpenClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
