@@ -0,0 +1,23 @@
+import { ClaimCells } from '../../slots/defs/claimColumns';
+import type { Claim } from './claimsQuery';
+import { useSelectedClaims } from './useSelectedClaims';
+
+/** The checkbox that ticks a claim for a bulk action. */
+function ClaimSelect({ claim }: { sheetId: string; claim: Claim }) {
+  const [selected, setSelected] = useSelectedClaims();
+  const checked = selected.includes(claim.id);
+  return (
+    <td>
+      <input
+        type="checkbox"
+        data-testid="claim-select"
+        checked={checked}
+        onChange={(e) =>
+          setSelected(e.target.checked ? [...selected, claim.id] : selected.filter((id) => id !== claim.id))
+        }
+      />
+    </td>
+  );
+}
+
+export const contribution = ClaimCells.fill({ order: 0, Component: ClaimSelect });
diff --git a/src/main/frontend/features/claims/useSelectedClaims.ts b/src/main/frontend/features/claims/useSelectedClaims.ts
new file mode 100644
index 00000000..ebc6cabf
--- /dev/null
+++ b/src/main/frontend/features/claims/useSelectedClaims.ts
@@ -0,0 +1,10 @@
+import { useSearchParam } from '../../url/useSearchParam';
+
+const asIds = (raw: unknown): number[] =>
+  (Array.isArray(raw) ? raw : []).map(Number).filter((n) => Number.isInteger(n));
+
+/** The ids of the claims ticked for a bulk action, kept in the URL. */
+export function useSelectedClaims(): [number[], (ids: number[]) => void] {
+  const [ids, setIds] = useSearchParam('selectedClaims', asIds);
+  return [ids, (next) => setIds(next.length ? next : undefined)];
+}
