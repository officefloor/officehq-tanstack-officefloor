@@ -0,0 +1,13 @@
+# Open the selected claims together. Each that can be opened is opened, in list order (people in the
+# order they were added, each person's claims newest first), with its own audit lines as a single open
+# writes them; each that cannot is left as it is and writes nothing. Responds with the two counts.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkOpen
+  next: open
+open:
+  class: net.officefloor.hq.app.claim.BulkOpenClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
+  govern: [ transaction ]
