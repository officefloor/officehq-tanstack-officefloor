+# POST /api/sheets/{sheetId}/bulk-open — open the selected claims together, in list order; each that
+# cannot be opened is left as it is. Responds with how many were opened and how many refused.
+open:
+  class: net.officefloor.hq.app.claim.BulkOpenClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
