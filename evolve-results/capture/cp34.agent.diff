@@ -0,0 +1,17 @@
+# Open the selected claims together, in list order. Each that cannot be opened is refused and left
+# as it is; the response tells how many were opened and how many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkOpen
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: open
+# Each claim opened is audited as it is opened: its own line, then the figures it moved.
+open:
+  class: net.officefloor.hq.app.claim.OpenSelectedClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkOpen
+  govern: [ transaction ]
