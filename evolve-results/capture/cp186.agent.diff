--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheet}/periods/generate-quarters.POST.yml
@@ -0,0 +1,12 @@
+# Validate first so a bad year is a 400; Generate adds each calendar quarter of the year not already a period nor
+# overlapping one. Responds with how many were made and the sheet's periods.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateQuarters
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
