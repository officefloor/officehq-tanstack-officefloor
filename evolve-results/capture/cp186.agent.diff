+# POST /api/sheets/{sheetId}/generate-quarters — make the year's four calendar quarters as periods named
+# <yyyy>-Q1 to <yyyy>-Q4, each as adding a period would, leaving out a quarter whose name is taken or whose
+# days overlap a period. A year that is not yyyy is refused. Responds with how many were made.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
