--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate-quarters.POST.yml
@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/periods/generate-quarters — generate the four calendar quarters of the year given (yyyy)
+# as periods named <yyyy>-Q1 to <yyyy>-Q4, each from the first day of its first month to the last day of its third,
+# each written as PERIOD_ADDED as the period form would add it. A quarter whose name is already a period of the sheet,
+# or whose days overlap one, is left out. A year that is not yyyy is a 400 and writes nothing. Responds with how many
+# were made.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateQuarters
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
