+# POST /api/sheets/{sheetId}/periods/generate-quarters — make the four calendar quarters of a year (body:
+# {year, user}) as periods named <yyyy>-Q1 to <yyyy>-Q4, each as the period form adds it: a quarter whose
+# name is taken or whose days overlap a period is left out, each made recorded as PERIOD_ADDED. Answers
+# {generated}. A year that is not four digits is refused (400) and nothing is stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateQuarters
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
+  govern: [ transaction ]
