--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/period-generate-quarters.POST.yml
@@ -0,0 +1,12 @@
+# Generate a calendar year's four quarterly periods (yyyy given), each named <yyyy>-Q1 to <yyyy>-Q4 and
+# added as the period form would add it: a quarter already named or overlapping a period is left out.
+# Answers how many were made.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
