@@ -0,0 +1,21 @@
+# Generate the four calendar quarters of a year as periods named <yyyy>-Q1 to <yyyy>-Q4, each as the period form
+# would add it: a quarter whose name is already a period or whose days overlap one is left out. A refused generate
+# (bad year, unknown sheet) writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidateQuarterGenerate
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SaveQuarterPeriods
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodsGenerated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriodsGenerated
+  govern: [ transaction ]
