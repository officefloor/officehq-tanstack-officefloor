diff --git a/src/main/java/net/officefloor/hq/app/period/SaveQuarterPeriods.java b/src/main/java/net/officefloor/hq/app/period/SaveQuarterPeriods.java
new file mode 100644
index 0000000..e1be47a
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/SaveQuarterPeriods.java
@@ -0,0 +1,35 @@
+package net.officefloor.hq.app.period;
+
+import java.time.LocalDate;
+import java.time.YearMonth;
+import java.util.ArrayList;
+import java.util.List;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** Add a <yyyy>-Q<n> period for each calendar quarter starting in first..last, leaving out a quarter whose name is
+ *  already a period on the sheet (without regard to case) or whose days overlap a period on the sheet. */
+public class SaveQuarterPeriods {
+    public void save(@PathVariable("sheetId") String sheetId, @Val PeriodGenerateInput input,
+            PeriodRepository repository, Out<GeneratedPeriods> generated) {
+        String id = sheetId.trim();
+        repository.lockSheet(id);
+        List<Period> existing = new ArrayList<>(repository.list(id));
+        List<Period> made = new ArrayList<>();
+        for (YearMonth start = input.first(); !start.isAfter(input.last()); start = start.plusMonths(3)) {
+            String name = start.getYear() + "-Q" + ((start.getMonthValue() - 1) / 3 + 1);
+            LocalDate from = start.atDay(1);
+            LocalDate to = start.plusMonths(2).atEndOfMonth();
+            boolean taken = existing.stream()
+                    .anyMatch(p -> p.name().trim().equalsIgnoreCase(name) || p.overlaps(from, to));
+            if (taken) {
+                continue;
+            }
+            Period period = repository.insert(id, name, from, to);
+            existing.add(period);
+            made.add(period);
+        }
+        generated.set(new GeneratedPeriods(made));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/period/ValidateQuarterGenerate.java b/src/main/java/net/officefloor/hq/app/period/ValidateQuarterGenerate.java
new file mode 100644
index 0000000..9c5a6fe
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/ValidateQuarterGenerate.java
@@ -0,0 +1,22 @@
+package net.officefloor.hq.app.period;
+
+import java.time.YearMonth;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Bind the body and refuse it before anything is read or written: a signed-in user and a year yyyy. The year is
+ *  passed on as the months January to December it runs. */
+public class ValidateQuarterGenerate {
+    public void validate(@RequestBody QuarterGenerateRequest request, Out<PeriodGenerateInput> body)
+            throws InvalidPeriodException {
+        if (request == null || request.user() == null || request.user().isBlank()) {
+            throw new InvalidPeriodException("Sign in before generating periods.");
+        }
+        String year = request.year() == null ? "" : request.year().trim();
+        if (!year.matches("\\d{4}")) {
+            throw new InvalidPeriodException("The year must be a year, yyyy.");
+        }
+        int y = Integer.parseInt(year);
+        body.set(new PeriodGenerateInput(request.user().trim(), YearMonth.of(y, 1), YearMonth.of(y, 12)));
+    }
+}
