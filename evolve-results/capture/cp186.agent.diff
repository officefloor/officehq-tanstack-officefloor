@@ -0,0 +1,20 @@
+# Generate a calendar year's four quarterly periods. Validate first so a bad year is a 400, not a 404.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateQuarters
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: generate
+# yyyy-Q1 to yyyy-Q4, each left out when its name exists or its days overlap a period.
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
