+# Generate the year's four calendar quarters as periods named yyyy-Q1 to yyyy-Q4, each as the period form would add
+# it: a quarter whose name is in use or whose days overlap a period left out; answers how many were made.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: year
+year:
+  class: net.officefloor.hq.app.period.ValidateGenerateQuarters
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
