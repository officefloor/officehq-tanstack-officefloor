new file mode 100644
index 00000000..7c23cffa
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-quarters.POST.yml
@@ -0,0 +1,13 @@
+# Generate the four calendar quarters of a year as periods yyyy-Q1 to yyyy-Q4. Validate first so a
+# bad year is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateQuarters
+  next: generate
+# Each quarter left out when its name is taken or its days overlap a period; audits each one made.
+generate:
+  class: net.officefloor.hq.app.period.GenerateQuarters
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
