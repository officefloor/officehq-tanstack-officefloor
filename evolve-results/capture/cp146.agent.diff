+-- The sheet's alert threshold: a person whose due-total crosses above it writes an ALERT line. Null
+-- when unset (off). Not dated.
+ALTER TABLE public.sheet_setting ADD COLUMN alert_threshold DECIMAL(12,2);
+ALTER TABLE asof.sheet_setting ADD COLUMN alert_threshold DECIMAL(12,2);
+ALTER TABLE asof_hist.sheet_setting ADD COLUMN alert_threshold DECIMAL(12,2);
+-- The history trigger keeps the column list it was created with: create it again to see the new one.
