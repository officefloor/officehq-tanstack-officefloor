@@ -0,0 +1,20 @@
+# Add a holiday to the sheet. A new claim's due-by falling on a holiday is moved to the next day that is not one;
+# claims already made keep theirs. A refused add (bad date, a date already on the list) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.holiday.ValidateHoliday
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.holiday.SaveHoliday
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.holiday.AuditHolidayAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.holiday.RespondWithHoliday
+  govern: [ transaction ]
