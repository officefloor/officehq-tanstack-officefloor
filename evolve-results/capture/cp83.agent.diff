+# POST /api/sheets/{sheetId}/holidays — adds a holiday to the sheet. Body {"date":"yyyy-mm-dd"}. A date that is not
+# real, or one already on the list, is refused with 422 and nothing is stored or recorded.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.holiday.ValidateHoliday
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.holiday.AddHoliday
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.holiday.AuditHolidayAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.holiday.RespondWithHoliday
+  govern: [ transaction ]
