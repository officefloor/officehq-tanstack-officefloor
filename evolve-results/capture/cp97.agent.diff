+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { claimDueCents, live, useClaims } from '../claims/useClaims';
+import { gradeOn, heldOnBy, usePeople } from '../people/usePeople';
+import { rateOn, totalDue, useRates } from '../rates/useRates';
+import { useFloor, useLate } from '../settings/useSettings';
+import { useSheetToday } from '../sheet/useSheet';
+
+/**
+ * A due-total per calendar month, for every month (yyyy-mm) any claim on the sheet is dated in:
+ * the dues of the claims dated in it that count (as the sheet's totals count them), each as its
+ * claim shows it, added up (n/a ones skipped). Not capped.
+ */
+function MonthsPanel({ sheet }: { user: string; sheet: string }) {
+  const { data: all = [] } = useClaims(sheet);
+  const { data: people = [] } = usePeople(sheet);
+  const { data: rates = [] } = useRates(sheet);
+  const today = useSheetToday(sheet);
+  const floor = useFloor(sheet);
+  const late = useLate(sheet);
+  const byId = new Map(people.map((p) => [p.id, p]));
+  const claims = live(all, heldOnBy(people, today));
+  const months = [...new Set(all.map((c) => c.date.slice(0, 7)))].sort();
+  const dueOf = (c: (typeof claims)[number]) => {
+    const p = byId.get(c.personId);
+    return claimDueCents(c, floor, p ? rateOn(rates, gradeOn(p, c.date), c.date) : undefined, late);
+  };
+
+  return (
+    <section data-testid="months-panel">
+      <h2>Months</h2>
+      <table>
+        <thead>
+          <tr>
+            <th>Month</th>
+            <th>Due</th>
+          </tr>
+        </thead>
+        <tbody>
+          {months.map((m) => (
+            <tr key={m}>
+              <td>{m}</td>
+              <td data-testid={`month-${m}-due-total`}>{totalDue(claims.filter((c) => c.date.startsWith(m)).map(dueOf))}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: 27, Component: MonthsPanel });
