diff --git a/src/main/frontend/features/claims/tags.slot.tsx b/src/main/frontend/features/claims/tags.slot.tsx
new file mode 100644
index 000000000..e5c259c8b
--- /dev/null
+++ b/src/main/frontend/features/claims/tags.slot.tsx
@@ -0,0 +1,41 @@
+import { HomeMain } from '../../slots/defs/homeMain';
+import { usePeople } from '../people/people';
+import { useCurrentSheet } from '../../session/session';
+import { useSheetToday } from '../sheet/sheet';
+import { floorOf, useSettings } from '../settings/settings';
+import { lateOf } from '../overdue/overdue';
+import { dueTotal, personTagged, useRates } from '../rates/rates';
+import { live, useClaims, useTags } from './claims';
+
+// For every tag ever used on the sheet, its due-total: the dues of the claims that count which carry it,
+// everyone's added up, not capped or trimmed (a claim with two tags counts in both).
+function TagTotals() {
+  const [sheet] = useCurrentSheet();
+  const tags = useTags(sheet);
+  const people = usePeople(sheet);
+  const claims = useClaims(sheet);
+  const rates = useRates(sheet);
+  const today = useSheetToday(sheet);
+  const settings = useSettings(sheet).data;
+  const floor = floorOf(settings);
+  const total = (tag: string) =>
+    dueTotal(
+      (people.data ?? []).map((p) =>
+        personTagged(live((claims.data ?? []).filter((c) => c.personId === p.id), [p]), tag, rates.data, p.grades, today, floor,
+          lateOf(settings, today, [p])),
+      ),
+    );
+  if ((tags.data ?? []).length === 0) return null;
+  return (
+    <p>
+      Due by tag{' '}
+      {(tags.data ?? []).map((tag) => (
+        <span key={tag}>
+          {tag} <strong data-testid={`tag-${tag}-due-total`}>{total(tag)}</strong>{' '}
+        </span>
+      ))}
+    </p>
+  );
+}
+
+export const contribution = HomeMain.fill({ order: 36.5, Component: TagTotals });
diff --git a/src/main/frontend/features/rates/rates.ts b/src/main/frontend/features/rates/rates.ts
index 97651e649..9cbb02759 100644
--- a/src/main/frontend/features/rates/rates.ts
+++ b/src/main/frontend/features/rates/rates.ts
@@ -218,3 +218,18 @@ export function personSplit(
     dueTotal(mine.filter(keep).map((c) => claimDue(c, rates, grades, floor, late)));
   return { settled: total((c) => c.status === 'SETTLED'), open: total((c) => c.status !== 'SETTLED') };
 }
+
+/** A person's due on a tag: the sum of the dues (skipping n/a) of their claims that count that carry it;
+ *  0.00 when their due-total is n/a. */
+export function personTagged(
+  claims: Claim[],
+  tag: string,
+  rates: Rate[] | undefined,
+  grades: Grades,
+  today: string | undefined,
+  floor: Floor,
+  late?: Late,
+): string {
+  if (uncappedDue(claims, rates, grades, today, floor, late) === NA) return format(0n);
+  return dueTotal(claims.filter((c) => counts(c) && c.tags.includes(tag)).map((c) => claimDue(c, rates, grades, floor, late)));
+}
