index 000000000..adfb617c8
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/defer.POST.yml
@@ -0,0 +1,36 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/defer — defer an OPEN claim (body {until, user}) until a
+# date after the sheet's today. Until the sheet's today reaches that date the claim counts in no total,
+# is not overdue, cannot be settled and is left unbound by a statement; from that day on it is an OPEN
+# claim like any other. Refused (400) when the date does not parse or is not after today, the claim is
+# not OPEN or not on the sheet, or its date falls in a closed period; nothing is stored then. A stored
+# deferral is recorded in the audit file as CLAIM_DEFERRED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateDefer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: checkDefer
+checkDefer:
+  class: net.officefloor.hq.app.claim.CheckDefer
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyDefer
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimDeferred
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
