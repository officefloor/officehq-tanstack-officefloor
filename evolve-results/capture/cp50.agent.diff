+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/** Records the claim just deferred, with its person's name, then the date it is deferred until. */
+public class AuditClaimDeferred {
+    public void audit(@Val Claim claim, PersonRepository people, @RequestParam("user") String user, Audit audit) {
+        Person person = people.find(claim.sheetId(), claim.personId());
+        audit.record("CLAIM_DEFERRED sheet=" + claim.sheetId() + " by=" + user + " person="
+                + (person == null ? "" : person.name()) + " amount=" + claim.amount().setScale(2).toPlainString()
+                + " date=" + claim.date() + Claim.auditNumber(claim.number()) + " until=" + claim.deferredUntil());
+    }
+}
