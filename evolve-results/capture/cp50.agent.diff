@@ -0,0 +1,31 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/defer — defer an OPEN claim to a date after the sheet's today. Body
+# {"until":"yyyy-mm-dd"}. Until the sheet's today reaches it the claim counts in no total, is not overdue, cannot be
+# settled and is left unbound by a statement. Refused with 422 for a claim not OPEN, a date not after today, or a
+# claim dated inside a closed period; nothing is stored. 404 for a claim not on the sheet.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: closed
+  govern: [ transaction ]
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplyDefer
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimDeferred
+  next: rollup
+  govern: [ transaction ]
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithEditedClaim
+  govern: [ transaction ]
