new file mode 100644
index 0000000..5d311a5
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ValidateDefer.java
@@ -0,0 +1,22 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Bind the body and refuse it before anything is read: a signed-in user and a date (yyyy-mm-dd) to defer until. */
+public class ValidateDefer {
+    public void validate(@RequestBody DeferRequest request, Out<DeferInput> body) throws InvalidClaimException {
+        if (request == null || request.user() == null || request.user().isBlank()) {
+            throw new InvalidClaimException("Sign in before changing claims.");
+        }
+        LocalDate until;
+        try {
+            until = LocalDate.parse(request.until() == null ? "" : request.until().trim());
+        } catch (DateTimeParseException e) {
+            throw new InvalidClaimException("Give the date to defer the claim until as yyyy-mm-dd.");
+        }
+        body.set(new DeferInput(request.user().trim(), until));
+    }
+}
