@@ -0,0 +1,39 @@
+# Defer an OPEN claim until the body's date (yyyy-MM-dd), which must be after the sheet's today. A claim that is
+# not OPEN, a date not after today, or a claim dated inside a closed period is refused (400) and writes nothing.
+# Until the sheet's today reaches the date the claim counts in no total, is not overdue, cannot be settled and is
+# left unbound by a statement; from that day on it is an OPEN claim like any other.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateDeferRequest
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkPeriod
+checkPeriod:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriodOpen
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.claim.CheckClaimDeferral
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: defer
+defer:
+  class: net.officefloor.hq.app.claim.DeferClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimDeferred
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
