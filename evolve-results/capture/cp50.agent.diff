diff --git a/src/main/resources/db/migration/V34__claim_deferred_until.sql b/src/main/resources/db/migration/V34__claim_deferred_until.sql
new file mode 100644
index 0000000..83bc2a8
--- /dev/null
+++ b/src/main/resources/db/migration/V34__claim_deferred_until.sql
@@ -0,0 +1,3 @@
+-- An OPEN claim may be deferred to a date after the sheet's today (null: never deferred). Until the sheet's today
+-- reaches it the claim counts in no total, is not overdue, cannot be settled and is left unbound by a statement.
+ALTER TABLE claim ADD COLUMN deferred_until DATE;
