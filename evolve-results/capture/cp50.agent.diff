@@ -0,0 +1,30 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/defer — defer an OPEN claim until a date after the sheet's today: until
+# the sheet's today reaches that date the claim counts in no total, is not overdue, cannot be settled and is left
+# unbound by a statement. A claim that is not OPEN, a date not after today (or not a date), or a claim dated inside a
+# closed period, is a 409 and a claim not on the sheet a 404, neither writing anything. Responds with the claim as
+# stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateDefer
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyDefer
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveDefer
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimDeferred
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
