+validate:
+  class: net.officefloor.hq.app.claim.ValidateDefer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: defer
+defer:
+  class: net.officefloor.hq.app.claim.DeferClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaims
+  govern: [ transaction ]
