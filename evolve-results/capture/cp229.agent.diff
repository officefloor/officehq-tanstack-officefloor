diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades.POST.yml
new file mode 100644
index 000000000..f3d738e27
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades.POST.yml
@@ -0,0 +1,18 @@
+# POST /api/sheets/{sheetId}/grades — adds a grade to the sheet (body: {grade, user}). The code, trimmed, must be
+# one to three capital letters and not yet a grade of the sheet; anything else, or a viewer, is refused (400) and
+# nothing is stored. Recorded as GRADE_ADDED. The grade is listed after A, B and C (and those added before it)
+# and can be chosen wherever a grade is: for a person, a rate, a bulk grade, an import, a retire or a merge.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeAdd
+  next: save
+save:
+  class: net.officefloor.hq.app.grade.SaveGradeAdded
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.grade.AuditGradeAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGradeAdded
+  govern: [ transaction ]
