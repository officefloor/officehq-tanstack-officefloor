diff --git a/src/main/resources/db/migration/V100__grade_added.sql b/src/main/resources/db/migration/V100__grade_added.sql
new file mode 100644
index 000000000..8ca52617b
--- /dev/null
+++ b/src/main/resources/db/migration/V100__grade_added.sql
@@ -0,0 +1,12 @@
+-- The grades added to a sheet beyond A, B and C: a code of one to three capital letters, listed after
+-- them in the order added. A person's grade and a rate's grade may be any grade of their sheet.
+CREATE TABLE grade_added (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(200) NOT NULL REFERENCES sheet (id),
+    grade     VARCHAR(10)  NOT NULL,
+    added_by  VARCHAR(200) NOT NULL,
+    added_at  TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    CONSTRAINT grade_added_unique UNIQUE (sheet_id, grade)
+);
+ALTER TABLE person_grade ALTER COLUMN grade VARCHAR(10) NOT NULL;
+ALTER TABLE rate ALTER COLUMN grade VARCHAR(10) NOT NULL;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grade-add.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grade-add.POST.yml
new file mode 100644
index 000000000..be9eb1756
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grade-add.POST.yml
@@ -0,0 +1,21 @@
+# POST /api/sheets/{sheetId}/grade-add — add a grade to the sheet: a code of one to three capital
+# letters (trimmed) not yet a grade of the sheet; it follows A, B, C and the grades added before it.
+# Refused (400) for anything else. A viewer may change nothing: refused before anything is read or
+# written. Responds with the grades as they now stand.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.grade.ValidateAddGrade
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.grade.AddGrade
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.grade.RecordGradeAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGradesAdded
