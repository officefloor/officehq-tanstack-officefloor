diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades.POST.yml
new file mode 100644
index 000000000..4db51018b
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades.POST.yml
@@ -0,0 +1,25 @@
+# Add a grade to the sheet: a code of one to three capital letters not yet a grade on it. It is
+# listed after A, B and C and those added before it. Anything else is refused (a 400) and writes
+# nothing. A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.grade.ValidateNewGrade
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.grade.AddGrade
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.grade.AuditGradeAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
