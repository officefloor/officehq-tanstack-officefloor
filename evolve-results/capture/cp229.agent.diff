+# Add a grade to the sheet: it follows A, B and C (in the order added) in every grade select, the summary, the rates
+# and the rate calendar. A refused add (no user, not one to three capital letters, already a grade) writes nothing,
+# not even an audit line.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeAdd
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.grade.SaveGradeAdd
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.grade.AuditGradeAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
