index 00000000..23c24ab8
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades.POST.yml
@@ -0,0 +1,18 @@
+# Add a grade to the sheet. Validate first so a code that is not one to three capital letters, or is
+# already a grade, is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateAddGrade
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.grade.SaveGradeAdded
+  govern: [ transaction ]
+  next: record
+# Audit only once the grade is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.grade.RecordGradeAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
