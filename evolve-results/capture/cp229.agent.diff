@@ -0,0 +1,28 @@
+# POST /api/sheets/{sheetId}/grades — adds a grade on the sheet. Body {"grade":"<code>"}: one to three capital letters,
+# not yet a grade on the sheet. Anything else is refused with 422 and nothing is stored or recorded. Responds with the
+# grades, as GET grades does.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeAdd
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.grade.AddGrade
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.grade.AuditGradeAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
+handle:
+  class: net.officefloor.hq.app.grade.HandleGradeRefused
