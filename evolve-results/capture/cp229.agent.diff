+# POST /api/sheets/{sheetId}/grades — add a grade to the sheet: from then on it is one of the sheet's grades, after A, B,
+# C and those added before it. A code (without the spaces around it) other than one to three capital letters, or one
+# already a grade of the sheet, is a 400 and writes nothing. Writes GRADE_ADDED. Responds with the grades (see the
+# grades' GET).
+validate:
+  class: net.officefloor.hq.app.grade.ValidateAddGrade
+  next: add
+add:
+  class: net.officefloor.hq.app.grade.AddGrade
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
