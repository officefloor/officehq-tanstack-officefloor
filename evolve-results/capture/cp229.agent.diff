diff --git a/src/main/resources/db/migration/V98__grade.sql b/src/main/resources/db/migration/V98__grade.sql
new file mode 100644
index 00000000..ccd06bd0
--- /dev/null
+++ b/src/main/resources/db/migration/V98__grade.sql
@@ -0,0 +1,17 @@
+-- The grades added on a sheet beyond A, B and C, in the order they were added: a code of one to three capital letters.
+CREATE TABLE grade (
+    sheet_id VARCHAR(255) NOT NULL,
+    grade    VARCHAR(3)   NOT NULL,
+    seq      BIGINT GENERATED BY DEFAULT AS IDENTITY,
+    PRIMARY KEY (sheet_id, grade)
+);
+
+-- A grade may now be up to three letters wherever one is kept.
+ALTER TABLE person ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
+ALTER TABLE person_history ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
+ALTER TABLE person_grade ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
+ALTER TABLE person_grade_history ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
+ALTER TABLE rate ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
+ALTER TABLE rate_history ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
+ALTER TABLE rate_version ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
+ALTER TABLE grade_retired ALTER COLUMN grade SET DATA TYPE VARCHAR(3);
