@@ -0,0 +1,31 @@
+package net.officefloor.hq.app.rollup;
+
+import java.util.Map;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/**
+ * Follows a change's own records with one ROLLUP line per person whose figures it moved (a person new to the
+ * sheet counts as moved), in the order they were added, then a TOTALS line when the sheet's totals moved.
+ */
+public class AuditRollup {
+    public void audit(@Val RollupBefore before, @PathVariable("sheetId") String sheetId,
+            @RequestParam("user") String user, RollupService rollups, Audit audit) {
+        Rollup was = before.rollup();
+        Rollup now = rollups.compute(sheetId);
+        String prefix = " sheet=" + sheetId + " by=" + user;
+        for (Map.Entry<Long, Rollup.Figures> entry : now.people().entrySet()) {
+            Rollup.Figures figures = entry.getValue();
+            if (!figures.sameAs(was.people().get(entry.getKey()))) {
+                audit.record("ROLLUP" + prefix + " person=" + figures.name() + " claimed=" + figures.claimed()
+                        + " due-total=" + figures.dueTotal());
+            }
+        }
+        if (!now.claimedTotal().equals(was.claimedTotal()) || !now.dueTotal().equals(was.dueTotal())) {
+            audit.record("TOTALS" + prefix + " claimed-total=" + now.claimedTotal() + " due-total="
+                    + now.dueTotal());
+        }
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/rollup/Rollup.java b/src/main/java/net/officefloor/hq/app/rollup/Rollup.java
new file mode 100644
index 000000000..df0849785
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rollup/Rollup.java
@@ -0,0 +1,19 @@
+package net.officefloor.hq.app.rollup;
+
+import java.util.Map;
+
+/**
+ * A sheet's figures at one moment: each person's claimed and due-total (by person id, in the order they were
+ * added) and the sheet's claimed-total and due-total, each as shown (two decimals; a due-total may be n/a).
+ */
+public record Rollup(Map<Long, Figures> people, String claimedTotal, String dueTotal) {
+
+    /** A person's name and figures. */
+    public record Figures(String name, String claimed, String dueTotal) {
+
+        /** Whether the figures are the same as the other's, whatever the name. */
+        public boolean sameAs(Figures other) {
+            return other != null && claimed.equals(other.claimed) && dueTotal.equals(other.dueTotal);
+        }
+    }
+}
