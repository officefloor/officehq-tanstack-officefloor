@@ -0,0 +1,27 @@
+package net.officefloor.hq.app.rollup;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.plugin.variable.Val;
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.web.bind.annotation.PathVariable;
+
+public class AuditRollup {
+    // After the change's own lines: one ROLLUP per person whose figures moved (a new person counts as moved),
+    // in the order they were added, then TOTALS when a sheet total moved.
+    public void audit(@PathVariable("sheetId") String sheetId, @Val Figures before, Rollup rollup,
+            ServerHttpConnection connection, Audit audit) {
+        String sheet = sheetId.trim();
+        String user = Audit.user(connection);
+        Figures after = rollup.figures(sheet);
+        after.people().forEach((id, now) -> {
+            if (!now.sameAs(before.people().get(id))) {
+                audit.record(Audit.line("ROLLUP", sheet, user, "person=" + now.name(), "claimed=" + now.claimed(),
+                        "due-total=" + now.dueTotal()));
+            }
+        });
+        if (!after.claimedTotal().equals(before.claimedTotal()) || !after.dueTotal().equals(before.dueTotal())) {
+            audit.record(Audit.line("TOTALS", sheet, user, "claimed-total=" + after.claimedTotal(),
+                    "due-total=" + after.dueTotal()));
+        }
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/rollup/Figures.java b/src/main/java/net/officefloor/hq/app/rollup/Figures.java
new file mode 100644
index 00000000..b090e16e
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rollup/Figures.java
@@ -0,0 +1,18 @@
+package net.officefloor.hq.app.rollup;
+
+import java.util.Map;
+
+/**
+ * A sheet's figures at one moment, as the screen shows them: each person's (by id, in the order they were
+ * added) and the sheet's totals.
+ */
+public record Figures(Map<Long, PersonFigures> people, String claimedTotal, String dueTotal) {
+
+    /** A person's name, claimed and due-total ({@code "n/a"} when they have none). */
+    public record PersonFigures(String name, String claimed, String dueTotal) {
+
+        public boolean sameAs(PersonFigures other) {
+            return other != null && claimed.equals(other.claimed) && dueTotal.equals(other.dueTotal);
+        }
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/rollup/Rollup.java b/src/main/java/net/officefloor/hq/app/rollup/Rollup.java
new file mode 100644
index 00000000..a757133e
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rollup/Rollup.java
@@ -0,0 +1,84 @@
+package net.officefloor.hq.app.rollup;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import net.officefloor.hq.app.claim.Claim;
+import net.officefloor.hq.app.claim.ClaimStatus;
+import net.officefloor.hq.app.claim.Claims;
+import net.officefloor.hq.app.person.People;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.rate.Rates;
+import net.officefloor.hq.app.sheet.Sheets;
+import org.springframework.stereotype.Service;
+
+/** Works out a sheet's figures the way the screen shows them (claimed, due-total, and their totals). */
+@Service
+public class Rollup {
+
+    private static final BigDecimal ZERO = BigDecimal.ZERO.setScale(2);
+
+    private final People people;
+    private final Claims claims;
+    private final Rates rates;
+    private final Sheets sheets;
+
+    public Rollup(People people, Claims claims, Rates rates, Sheets sheets) {
+        this.people = people;
+        this.claims = claims;
+        this.rates = rates;
+        this.sheets = sheets;
+    }
+
+    public Figures figures(String sheetId) {
+        LocalDate today = sheets.today(sheetId);
+        List<Claim> counting = claims.list(sheetId).stream()
+                .filter(c -> c.status() == ClaimStatus.OPEN || c.status() == ClaimStatus.SETTLED).toList();
+        Map<Long, Figures.PersonFigures> figures = new LinkedHashMap<>();
+        BigDecimal claimedTotal = ZERO;
+        BigDecimal dueTotal = ZERO;
+        for (Person person : people.list(sheetId)) {
+            BigDecimal claimed = ZERO;
+            BigDecimal due = ZERO;
+            boolean anyFigure = false;
+            for (Claim claim : counting) {
+                if (claim.personId() != person.id()) {
+                    continue;
+                }
+                claimed = claimed.add(claim.amount());
+                BigDecimal figure = figure(claim, person);
+                if (figure != null) {
+                    due = due.add(figure);
+                    anyFigure = true;
+                }
+            }
+            // With no rate today and no figure, the due-total is n/a.
+            boolean none = !anyFigure && rates.on(sheetId, person.grade(), today) == null;
+            claimedTotal = claimedTotal.add(claimed);
+            if (!none) {
+                dueTotal = dueTotal.add(due);
+            }
+            figures.put(person.id(), new Figures.PersonFigures(person.name(), claimed.toPlainString(),
+                    none ? "n/a" : due.toPlainString()));
+        }
+        return new Figures(figures, claimedTotal.toPlainString(), dueTotal.toPlainString());
+    }
+
+    /**
+     * The claim's figure (null when it has none): a settled claim's frozen due, otherwise the figure its person's
+     * last statement bound it to, otherwise its amount times its person's grade's rate on its date, half to even.
+     */
+    private BigDecimal figure(Claim claim, Person person) {
+        if (claim.settledDue() != null) {
+            return claim.settledDue();
+        }
+        if (claim.stated()) {
+            return claim.statedDue();
+        }
+        BigDecimal rate = rates.on(claim.sheetId(), person.grade(), claim.date());
+        return rate == null ? null : claim.amount().multiply(rate).movePointLeft(2).setScale(2, RoundingMode.HALF_EVEN);
+    }
+}
