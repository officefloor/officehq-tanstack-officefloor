 # POST /api/sheets/{sheetId}/today — set the sheet's today (body: {today: yyyy-MM-dd, user}).
-# A date that does not parse is refused (400) and nothing is stored.
+# A date that does not parse is refused (400) and nothing is stored. A new today records
+# no line of its own, only the ROLLUP/TOTALS lines of the figures it moved.
 validate:
   class: net.officefloor.hq.app.sheet.ValidateToday
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
   next: save
 save:
   class: net.officefloor.hq.app.sheet.SaveToday
   govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.sheet.AuditToday
+  govern: [ transaction ]
   next: respond
 respond:
   class: net.officefloor.hq.app.sheet.RespondWithSheet
