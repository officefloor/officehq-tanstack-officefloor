+# Validate before Load so an invalid body is a 400, not masked by a 404.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateReviewAssign
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyReviewAssign
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveReviewAssign
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditReviewAssigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
