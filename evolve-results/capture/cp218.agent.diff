diff --git a/src/main/resources/db/migration/V108__claim_review_assigned.sql b/src/main/resources/db/migration/V108__claim_review_assigned.sql
new file mode 100644
index 00000000..45bb3f0a
--- /dev/null
+++ b/src/main/resources/db/migration/V108__claim_review_assigned.sql
@@ -0,0 +1,7 @@
+-- The user a steward assigned a REVIEW claim to: kept once the claim leaves REVIEW. Null when none.
+ALTER TABLE public.claim ADD COLUMN review_assigned VARCHAR(255);
+ALTER TABLE asof.claim ADD COLUMN review_assigned VARCHAR(255);
+ALTER TABLE asof_hist.claim ADD COLUMN review_assigned VARCHAR(255);
+-- The history trigger keeps the column list it was created with: create it again to see the new one.
+DROP TRIGGER public.claim_history;
+CREATE TRIGGER claim_history AFTER INSERT, UPDATE, DELETE ON public.claim FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/db/migration/V109__sheet_batch.sql b/src/main/resources/db/migration/V109__sheet_batch.sql
new file mode 100644
index 00000000..01ef2fdd
--- /dev/null
+++ b/src/main/resources/db/migration/V109__sheet_batch.sql
@@ -0,0 +1,14 @@
+-- The number of the sheet's last bulk settle batch: kept on the sheet, so it stays when the claims
+-- that carry it leave the sheet (a transfer takes them away), and the next batch never reuses it.
+CREATE TABLE sheet_batch (
+    sheet_id   VARCHAR(200) PRIMARY KEY,
+    last_batch INT          NOT NULL
+);
+
+CREATE TABLE asof.sheet_batch AS SELECT * FROM public.sheet_batch WHERE FALSE;
+CREATE TABLE asof_hist.sheet_batch AS SELECT * FROM public.sheet_batch WHERE FALSE;
+ALTER TABLE asof_hist.sheet_batch ADD COLUMN h_seq BIGINT NOT NULL;
+ALTER TABLE asof_hist.sheet_batch ADD COLUMN h_made_on DATE;
+ALTER TABLE asof_hist.sheet_batch ADD COLUMN h_op CHAR(1) NOT NULL;
+CREATE INDEX sheet_batch_hist_sheet ON asof_hist.sheet_batch (sheet_id, h_seq);
+CREATE TRIGGER sheet_batch_history AFTER INSERT, UPDATE, DELETE ON public.sheet_batch FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review-assign.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review-assign.POST.yml
new file mode 100644
index 00000000..16c4d1fb
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review-assign.POST.yml
@@ -0,0 +1,25 @@
+# Assign a REVIEW claim's review to a user. Only a steward assigns it; a blank user is a 400, a claim
+# in any other status or anyone else assigning it is a 409, and either writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimReviewAssign
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimReviewAssign
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimReviewAssigned
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused assignment writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimReviewAssigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
