+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review/assign.PUT.yml
@@ -0,0 +1,26 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/review/assign?user=<name> — assign a REVIEW claim's review to a user (a steward only).
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: claim
+claim:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyReviewAssign
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditReviewAssigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
