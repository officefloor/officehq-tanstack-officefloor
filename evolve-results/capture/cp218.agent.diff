diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review/assign.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review/assign.PUT.yml
