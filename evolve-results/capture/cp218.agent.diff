diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review-assign.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review-assign.POST.yml
new file mode 100644
index 000000000..069b068c1
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review-assign.POST.yml
@@ -0,0 +1,31 @@
+# Assign a claim in REVIEW to a user to review (a steward). A blank user is a 400, a claim not in
+# REVIEW a 409, and anyone not a steward is refused; each writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateReviewAssign
+  govern: [ transaction ]
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+# Checks the status and the steward, and writes the assignment only when both allow it.
+apply:
+  class: net.officefloor.hq.app.claim.AssignReview
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the assignment is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditReviewAssigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
