+# POST /api/sheets/{sheetId}/claims/{claimId}/assign-review?user=<user> — a steward assigns a REVIEW
+# claim to a user; refused (409) for anyone else or any other status, (400) for a blank user.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: assign
+assign:
+  class: net.officefloor.hq.app.claim.AssignReview
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveReviewAssignee
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordReviewAssigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
