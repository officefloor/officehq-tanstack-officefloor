@@ -0,0 +1,21 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/assign-review — a steward assigns a REVIEW claim's review to a user
+# (body {user, assignee}). Refused (400) for anyone but a steward, a blank assignee, a claim not on the sheet, or one
+# in any other status; nothing is stored then. A stored assignment is recorded in the audit file as REVIEW_ASSIGNED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateAssignReview
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyAssignReview
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditReviewAssigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
