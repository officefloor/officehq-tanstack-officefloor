+# Generate the fiscal year's twelve monthly periods (by the sheet's fiscal start month) exactly as the period generator
+# does: named yyyy-mm, a month whose name is in use or whose days overlap a period left out; answers how many were made.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: year
+year:
+  class: net.officefloor.hq.app.period.ValidateGenerateFiscalYear
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: range
+range:
+  class: net.officefloor.hq.app.period.FiscalYearRange
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
