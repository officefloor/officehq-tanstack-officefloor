+# Validate first so a bad year is a 400; Generate adds each month of the fiscal year exactly as the period generator
+# does. Responds with how many were made and the sheet's periods.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateFiscalYear
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
