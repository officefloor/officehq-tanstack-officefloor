diff --git a/src/main/resources/db/migration/V81__sheet_fiscal_start_month.sql b/src/main/resources/db/migration/V81__sheet_fiscal_start_month.sql
new file mode 100644
index 0000000..10ad527
--- /dev/null
+++ b/src/main/resources/db/migration/V81__sheet_fiscal_start_month.sql
@@ -0,0 +1,3 @@
+-- The sheet's fiscal year start month (1 to 12; not dated). A fiscal year runs twelve months from the first day of
+-- that month, and is named FY<yyyy> by the calendar year its first day falls in.
+ALTER TABLE sheet ADD COLUMN fiscal_start_month INT NOT NULL DEFAULT 1;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate-fy.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate-fy.POST.yml
new file mode 100644
index 0000000..581c50e
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate-fy.POST.yml
@@ -0,0 +1,25 @@
+# Generate the twelve monthly periods of a fiscal year (FY<yyyy>: from the first day of the sheet's fiscal year start
+# month in yyyy), exactly as the period generator does: each named yyyy-mm, a month already a period or overlapping
+# one left out. A refused generate (bad year, unknown sheet) writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidateFiscalYearGenerate
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: plan
+plan:
+  class: net.officefloor.hq.app.period.PlanFiscalYear
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SaveGeneratedPeriods
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodsGenerated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriodsGenerated
+  govern: [ transaction ]
