diff --git a/src/main/resources/db/migration/V81__fiscal_start_month.sql b/src/main/resources/db/migration/V81__fiscal_start_month.sql
new file mode 100644
index 000000000..7e38c8649
--- /dev/null
+++ b/src/main/resources/db/migration/V81__fiscal_start_month.sql
@@ -0,0 +1,3 @@
+-- A sheet's fiscal year start month, 1 to 12, not dated: a fiscal year runs twelve months from its
+-- first day in that month, and is named FY<yyyy> by the calendar year that day falls in. Null: 1.
+ALTER TABLE sheet ADD COLUMN fiscal_start_month INT;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate-fy.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate-fy.POST.yml
new file mode 100644
index 000000000..72f6a5ac4
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate-fy.POST.yml
@@ -0,0 +1,20 @@
+# Generate a fiscal year's twelve monthly periods. Validate first so a bad year is a 400, not a 404.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateFiscalYear
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: generate
+# From the first day of the sheet's fiscal start month in the year, as the period generator does.
+generate:
+  class: net.officefloor.hq.app.period.GenerateFiscalYear
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
