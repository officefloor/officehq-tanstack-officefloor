diff --git a/src/main/resources/db/migration/V76__fiscal_start_month.sql b/src/main/resources/db/migration/V76__fiscal_start_month.sql
new file mode 100644
index 00000000..77fd1db6
--- /dev/null
+++ b/src/main/resources/db/migration/V76__fiscal_start_month.sql
@@ -0,0 +1,8 @@
+-- The sheet's fiscal year start month (1 to 12): fiscal year FY<yyyy> starts on its first day in
+-- yyyy. Null when unset (1, January). Not dated.
+ALTER TABLE public.sheet_setting ADD COLUMN fiscal_start_month INT;
+ALTER TABLE asof.sheet_setting ADD COLUMN fiscal_start_month INT;
+ALTER TABLE asof_hist.sheet_setting ADD COLUMN fiscal_start_month INT;
+-- The history trigger keeps the column list it was created with: create it again to see the new one.
+DROP TRIGGER public.sheet_setting_history;
+CREATE TRIGGER sheet_setting_history AFTER INSERT, UPDATE, DELETE ON public.sheet_setting FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-fiscal-year.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-fiscal-year.POST.yml
new file mode 100644
index 00000000..9c429814
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-fiscal-year.POST.yml
@@ -0,0 +1,13 @@
+# Generate the twelve monthly periods of a fiscal year. Validate first so a bad year is a 400 and
+# writes nothing; it hands the fiscal year's months to the period generator.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateFiscalYear
+  next: generate
+# Each month left out when its name is taken or its days overlap a period; audits each one made.
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
