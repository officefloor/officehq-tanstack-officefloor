+# POST /api/sheets/{sheetId}/periods/generate-fy — generate the twelve monthly periods of a fiscal year exactly as
+# generate does, from the first day of the sheet's fiscal start month (the fiscal-start-month setting, 1 unless set) in
+# the year given (yyyy, the FY<yyyy> the fiscal year is named) to the last day of the eleventh month after it. A year
+# that is not yyyy is a 400 and writes nothing. Responds with how many were made.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateFiscalYear
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
