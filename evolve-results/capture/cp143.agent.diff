+# Generate a fiscal year's twelve monthly periods: from the sheet's fiscal year start month in the year given (yyyy),
+# exactly as period-generate does. Answers how many were made.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateFiscalYear
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
