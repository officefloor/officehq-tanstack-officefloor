@@ -0,0 +1,13 @@
+# POST /api/sheets/{sheetId}/generate-fiscal-year — make a fiscal year's twelve monthly periods, from the
+# sheet's fiscal year start month of the year given, as generate-periods does. A year that is not yyyy
+# is refused. Responds with how many were made.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GenerateFiscalYear
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
