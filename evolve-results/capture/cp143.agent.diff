@@ -0,0 +1,15 @@
+# POST /api/sheets/{sheetId}/periods/generate-fy — make the twelve monthly periods of a fiscal year (body:
+# {year, user}). Fiscal year FY<year> starts on the first day of the sheet's fiscal start month in that
+# calendar year; its months are made exactly as periods/generate makes them (a month whose name is taken or
+# whose days overlap a period is left out, each made recorded as PERIOD_ADDED). Answers {generated}. A year
+# that is not four digits is refused (400) and nothing is stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerateFiscalYear
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
+  govern: [ transaction ]
