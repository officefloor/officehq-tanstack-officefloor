+                (rs, n) -> new long[] { rs.getLong("id"), rs.getLong("position") }, sheetId);
+        int at = -1;
+        for (int i = 0; i < order.size(); i++) {
+            if (order.get(i)[0] == id) {
+                at = i;
+            }
+        }
+        int to = up ? at - 1 : at + 1;
+        if (at < 0 || to < 0 || to >= order.size()) {
+            return null;
+        }
+        long[] mine = order.get(at);
+        long[] theirs = order.get(to);
+        long mineTo = theirs[1];
