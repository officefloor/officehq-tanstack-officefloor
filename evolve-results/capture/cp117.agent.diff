@@ -0,0 +1,25 @@
+# POST /api/sheets/{sheetId}/people/{personId}/move — swap the person with the one above ({"direction": "up"})
+# or below ({"direction": "down"}) them in the sheet's list (PERSON_MOVED with their new place, from 1);
+# the first cannot move up nor the last down. The list, the rollup lines and every action that works
+# in list order follow the places.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateMove
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: move
+move:
+  class: net.officefloor.hq.app.person.MovePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonMoved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
