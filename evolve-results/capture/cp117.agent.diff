+            mineTo = up ? theirs[1] - 1 : theirs[1] + 1;
+        }
+        jdbc.update("UPDATE person SET position = ? WHERE sheet_id = ? AND id = ?", mineTo, sheetId, mine[0]);
+        jdbc.update("UPDATE person SET position = ? WHERE sheet_id = ? AND id = ?", theirsTo, sheetId, theirs[0]);
