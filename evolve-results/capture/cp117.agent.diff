@@ -0,0 +1,5 @@
+-- People have a position in their sheet's list: listed by it (then by id), new people going to the end. Moving a
+-- person up or down swaps their position with the neighbour's. Existing people keep the order they were added in.
+ALTER TABLE person ADD COLUMN list_position BIGINT;
+UPDATE person SET list_position = id;
+CREATE INDEX person_sheet_position ON person(sheet_id, list_position, id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.PUT.yml
new file mode 100644
index 0000000..015d931
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.PUT.yml
@@ -0,0 +1,21 @@
+# Move a person up or down the list: swap them with the one above or below. The top person cannot move up nor the
+# bottom one down. A refused move (no signed-in user, bad direction, unknown person, nowhere to move) writes nothing,
+# not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMove
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SaveMove
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMoved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithMove
+  govern: [ transaction ]
