+# Move a person up or down the list: swap them with the one above or below. The top row cannot
+# move up, nor the bottom row down.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMove
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: move
+move:
+  class: net.officefloor.hq.app.person.MovePerson
+  govern: [ transaction ]
+  next: record
+# Audit only once the move is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonMoved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
