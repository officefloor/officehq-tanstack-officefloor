+# PUT /api/sheets/{sheetId}/people/{personId}/move/{direction} — move a person up or down the list, swapping them with
+# the person above or below. The top person moving up, the bottom person moving down, or any other direction is
+# refused with 422 and nothing is stored; 404 for a person not on the sheet. Audited as PERSON_MOVED with the new
+# position (counting from 1).
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: move
+  govern: [ transaction ]
+move:
+  class: net.officefloor.hq.app.person.MovePerson
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMoved
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.person.RespondWithEditedPerson
+  govern: [ transaction ]
