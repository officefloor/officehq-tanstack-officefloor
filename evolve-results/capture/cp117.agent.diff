--- /dev/null
+++ b/src/main/resources/db/migration/V73__person_position.sql
@@ -0,0 +1,6 @@
+-- A person's place in the sheet's list: people are listed by it (ascending), not by id. Those
+-- already on a sheet keep the order they were added in; a new person goes to the end.
+ALTER TABLE person ADD COLUMN list_pos BIGINT;
+UPDATE person SET list_pos = id;
+ALTER TABLE person ALTER COLUMN list_pos SET NOT NULL;
+CREATE INDEX person_sheet_pos ON person(sheet_id, list_pos);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.POST.yml
new file mode 100644
index 000000000..8ce33f398
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.POST.yml
@@ -0,0 +1,30 @@
+# Move a person up or down the list: swapped with the one above or below. Validate first so a bad
+# direction is a 400, not a 404. An unknown person is a 404; the top row moving up, or the bottom
+# row down, is a 400 and writes nothing. The list's order moves no figures.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateMove
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: move
+move:
+  class: net.officefloor.hq.app.person.MovePerson
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the move is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMoved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
