@@ -1,4 +1,4 @@
-# GET /api/sheets/{sheetId}/people — the sheet's people in the order they were added.
+# GET /api/sheets/{sheetId}/people — the sheet's people in list order (by their positions; a new person goes to the end).
 respond:
   class: net.officefloor.hq.app.person.RespondWithPeople
   govern: [ readonly-transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.POST.yml
new file mode 100644
index 000000000..5e3799c4d
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/move.POST.yml
@@ -0,0 +1,23 @@
+# POST /api/sheets/{sheetId}/people/{personId}/move — swap the person with the one above or below them in
+# the list (body: {direction: "up" | "down", user}). The list, the rollup lines and every action that works
+# in list order follow the people's positions. Refused (400), storing nothing, when the direction is neither,
+# the user is a viewer, the person is not on the sheet, or they are the top moving up or the bottom moving
+# down. A stored move is recorded in the audit file as PERSON_MOVED with the person's new position (from 1).
+validate:
+  class: net.officefloor.hq.app.person.ValidateMove
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: move
+move:
+  class: net.officefloor.hq.app.person.MovePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMoved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
