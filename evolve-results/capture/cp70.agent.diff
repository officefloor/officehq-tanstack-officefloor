diff --git a/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
new file mode 100644
index 000000000..8c98eb169
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
@@ -0,0 +1,25 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.setting.Permissions;
+import net.officefloor.hq.app.setting.SettingRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/**
+ * Soft-closes the period, fixing its due-total and each person's figure as they stand now (see {@link PeriodCloser}),
+ * while claims dated in it can still be added and changed. Refused (400) when it is already closed or soft-closed, or
+ * when the permission matrix does not allow the user's role closing.
+ */
+public class SoftClosePeriod {
+    public void softClose(@Val Period period, PeriodCloser closer, SettingRepository settings,
+            @RequestParam("user") String user, Out<Period> closed) throws InvalidPeriodException {
+        if (!settings.find(period.sheetId()).may(user, Permissions.CLOSE)) {
+            throw new InvalidPeriodException("The user's role is not allowed to close a period.");
+        }
+        if (period.fixed()) {
+            throw new InvalidPeriodException("The period " + period.name() + " is already closed.");
+        }
+        closed.set(closer.softClose(period));
+    }
+}
diff --git a/src/main/resources/db/migration/V45__period_soft_close.sql b/src/main/resources/db/migration/V45__period_soft_close.sql
new file mode 100644
index 000000000..34a50c376
--- /dev/null
+++ b/src/main/resources/db/migration/V45__period_soft_close.sql
@@ -0,0 +1,5 @@
+-- A period can be soft-closed: its due-total (closed_total) and each person's figure for it (period_person_total)
+-- are fixed then, as for a close, but claims dated inside it can still be added, edited, opened, settled and voided.
+ALTER TABLE period ADD COLUMN soft_closed BOOLEAN DEFAULT FALSE NOT NULL;
+-- A claim added while the period containing its date was soft-closed is a late entry; it stays one.
+ALTER TABLE claim ADD COLUMN late_entry BOOLEAN DEFAULT FALSE NOT NULL;
