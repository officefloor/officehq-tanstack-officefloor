diff --git a/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
new file mode 100644
index 00000000..a82d887f
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
@@ -0,0 +1,33 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.AuditUser;
+import net.officefloor.hq.app.claim.ClaimLogRepository;
+import net.officefloor.hq.app.claim.ClaimRepository;
+import net.officefloor.hq.app.person.PersonGradeRepository;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.hq.app.rate.RateRepository;
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.hq.app.sheet.SheetRepository;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.RequestHeader;
+
+/** Soft-closes the period, fixing each person's due-total for it and its own exactly as closing does, while claims
+ *  dated in it can still be added, edited and change status. Refuses a period already closed or soft-closed, and a
+ *  soft close by a role the sheet's permission matrix does not allow to close. */
+public class SoftClosePeriod {
+    public void close(@Val Period period, PeriodRepository repository, ClaimRepository claims, PersonRepository people,
+            RateRepository rates, SheetRepository sheets, PersonGradeRepository grades, ClaimLogRepository log,
+            RoleRepository roles, @RequestHeader(name = "X-User", required = false) String user) throws InvalidPeriodException {
+        Sheet sheet = sheets.findById(period.getSheetId()).orElseGet(() -> new Sheet(period.getSheetId()));
+        String role = roles.roleOf(period.getSheetId(), AuditUser.decode(user));
+        if (!sheet.allows("close", role)) {
+            throw new InvalidPeriodException("A " + role + " cannot close a period.");
+        }
+        if (period.isClosed() || period.isSoftClosed()) {
+            throw new InvalidPeriodException("The period is already closed.");
+        }
+        period.softClose(ClosePeriod.totals(period, sheet, claims, people, rates, grades, log));
+        repository.saveAndFlush(period);
+    }
+}
diff --git a/src/main/resources/db/migration/V43__period_soft_close.sql b/src/main/resources/db/migration/V43__period_soft_close.sql
new file mode 100644
index 00000000..457796c9
--- /dev/null
+++ b/src/main/resources/db/migration/V43__period_soft_close.sql
@@ -0,0 +1,4 @@
+-- A soft-closed period: its due-total and each person's are fixed (as on closing), but claims dated in it can
+-- still be added, edited and change status. A claim added while its period is soft-closed is a late entry.
+ALTER TABLE period ADD COLUMN soft_closed BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE claim ADD COLUMN late_entry BOOLEAN DEFAULT FALSE NOT NULL;
