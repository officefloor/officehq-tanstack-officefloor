diff --git a/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
new file mode 100644
index 00000000..2472208a
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
@@ -0,0 +1,28 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.setting.Settings;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.web.bind.annotation.PathVariable;
+
+public class SoftClosePeriod {
+    // Only a role the permission matrix allows to close soft-closes a period. Fixes each person's due-total for the open period as it
+    // stands now, and the period's as their sum, while its claims stay open to change; stored only if the period is still open.
+    public void softClose(@PathVariable("sheetId") String sheetId, @PathVariable("name") String name, Periods periods,
+            Rollup rollup, Settings settings, ServerHttpConnection connection, Out<Period> periodOut) throws PeriodRefusedException {
+        Period period = periods.find(sheetId.trim(), name.trim());
+        if (period == null) {
+            throw new PeriodRefusedException("No period " + name + " on this sheet.");
+        }
+        if (!settings.permits(period.sheetId(), "close", Audit.user(connection).trim())) {
+            throw new PeriodRefusedException("Your role is not allowed to close a period.");
+        }
+        Period soft = period.softClosedAt(rollup.personDueTotals(period.sheetId(), period.from(), period.to()));
+        if (period.closed() || period.soft() || !periods.softClose(soft)) {
+            throw new PeriodRefusedException("The period " + period.name() + " is already closed.");
+        }
+        periodOut.set(soft);
+    }
+}
diff --git a/src/main/resources/db/migration/V38__period_soft_close.sql b/src/main/resources/db/migration/V38__period_soft_close.sql
new file mode 100644
index 00000000..9c15b9c4
--- /dev/null
+++ b/src/main/resources/db/migration/V38__period_soft_close.sql
@@ -0,0 +1,4 @@
+-- A period can be soft-closed: its due-total (closed_total) and its people's figures (period_person_total) are fixed,
+-- but claims dated in it can still change. A claim added while its period is soft-closed is a late entry.
+ALTER TABLE period ADD COLUMN soft BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE claim ADD COLUMN late_entry BOOLEAN DEFAULT FALSE NOT NULL;
