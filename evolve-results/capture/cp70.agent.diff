diff --git a/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
new file mode 100644
index 000000000..ecc7421f3
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/SoftClosePeriod.java
@@ -0,0 +1,20 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.hq.app.setting.SettingRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+
+/** Soft-closes an open period: its due-total and each person's are fixed as a close fixes them (see ClosePeriod), but
+ *  claims dated inside it can still be added, edited, opened, settled and voided. Soft-closing a period closed or
+ *  soft-closed already is refused, and so is soft-closing by a role the sheet's close permission does not allow. */
+public class SoftClosePeriod {
+    public void close(@Val Period period, @Val PeriodCloseRequest request, PeriodCloser closer,
+            SettingRepository settings, RoleRepository roles, Out<PeriodClose> closed)
+            throws InvalidPeriodException {
+        if (!settings.permits(period.sheetId(), "close", roles.roleOf(period.sheetId(), request.by()))) {
+            throw new InvalidPeriodException("The sheet's permission does not let this user close a period");
+        }
+        closed.set(new PeriodClose(request.by(), closer.softClose(period)));
+    }
+}
diff --git a/src/main/resources/db/migration/V37__period_soft_closed.sql b/src/main/resources/db/migration/V37__period_soft_closed.sql
new file mode 100644
index 000000000..594276370
--- /dev/null
+++ b/src/main/resources/db/migration/V37__period_soft_closed.sql
@@ -0,0 +1,6 @@
+-- A period can be soft-closed: its due-total (closed_total) and each person's (period_person_total) are fixed as for a
+-- close, but claims dated inside it can still be added, edited, opened, settled and voided. A soft-closed period is
+-- not closed; closing it fixes the figures afresh, reopening drops them.
+ALTER TABLE period ADD COLUMN soft_closed BOOLEAN DEFAULT FALSE NOT NULL;
+-- Whether a claim was added while the period its date falls in was soft-closed.
+ALTER TABLE claim ADD COLUMN late_entry BOOLEAN DEFAULT FALSE NOT NULL;
