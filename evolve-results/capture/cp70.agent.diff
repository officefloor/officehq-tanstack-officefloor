@@ -0,0 +1,4 @@
+-- A period can be soft-closed: closed with its due-total and each person's figure fixed, but claims
+-- dated inside it can still be changed. A claim added while its period is soft-closed is a late entry.
+ALTER TABLE period ADD COLUMN soft BOOLEAN NOT NULL DEFAULT FALSE;
+ALTER TABLE claim ADD COLUMN late_entry BOOLEAN NOT NULL DEFAULT FALSE;
