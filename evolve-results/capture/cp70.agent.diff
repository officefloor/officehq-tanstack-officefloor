+# Soft-close a period, fixing its due-total while claims in it stay open to change; refuses one not on the sheet or
+# already closed or soft-closed. Responds with the sheet's periods.
+softClose:
+  class: net.officefloor.hq.app.period.SoftClosePeriod
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriods
+  govern: [ transaction ]
