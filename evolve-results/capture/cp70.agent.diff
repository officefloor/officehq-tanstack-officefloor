+# Soft-close a period, fixing its due-total while claims dated in it stay changeable. An unknown
+# period is a 400; one already closed or soft-closed, or a soft close by a role the permission
+# matrix does not allow to close, is a 409.
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: close
+close:
+  class: net.officefloor.hq.app.period.SoftClosePeriod
+  govern: [ transaction ]
+  next: record
+# Audit only once the period is soft-closed: a refused soft close writes no line.
+record:
+  class: net.officefloor.hq.app.period.RecordPeriodSoftClosed
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithClosedPeriod
+  govern: [ transaction ]
