+# POST /api/sheets/{sheetId}/claims/{claimId}/split — split an amount off an OPEN claim (body: {"amount":"5.25"}).
+# The claim keeps the rest of its amount and loses any figure a statement bound it to; a new OPEN claim with the
+# split-off amount, the same date and note, the next number, opened by the user and due by its date plus the terms in
+# force on it, is split from the claim's number and lists as the newest. 422 for anything refused (a role that may not
+# open a claim, a claim not OPEN or deferred, an amount not more than 0.00 and less than the claim's, or a claim dated
+# inside a closed period); nothing is stored. 404 for a claim not on the sheet.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: closed
+  govern: [ transaction ]
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplySplit
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimSplit
