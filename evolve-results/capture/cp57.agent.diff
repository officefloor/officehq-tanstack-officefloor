+# POST /api/sheets/{sheetId}/claims/{claimId}/split?amount=<n.nn> — split an OPEN claim: it keeps the
+# rest of its amount and loses any figure a statement bound it to; a new OPEN claim of the split-off
+# amount (more than 0.00, less than the claim's) is opened by the user, split from its number.
+# Refused (409) when the claim is not OPEN or is deferred, or the user's role may not open a claim,
+# (400) for an amount out of range, (423) for a claim dated in a closed period.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: split
+split:
+  class: net.officefloor.hq.app.claim.SplitClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveSplit
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimSplit
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithSplit
