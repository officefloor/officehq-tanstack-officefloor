diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/split.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/split.POST.yml
new file mode 100644
index 00000000..df88092f
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/split.POST.yml
@@ -0,0 +1,36 @@
+# Split an amount off an OPEN claim into a new OPEN claim. Validate before Load so a bad amount is a
+# 400, not a 404; a claim that cannot be split (not OPEN, deferred, a role that may not open a claim,
+# an amount not less than the claim's) is a 409, one in a closed period refused too; nothing is written.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimSplit
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimSplit
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimSplit
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimSplit
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimSplit
+  govern: [ transaction ]
