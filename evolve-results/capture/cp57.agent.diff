+# Split an amount (the body's amount) off an OPEN claim: the claim keeps the rest of its amount and loses any figure a
+# statement bound it to; a new OPEN claim with the split amount, the same date and note, the next number, opened by the
+# user, its due-by fixed now and the original's number as split-from, is listed as its person's newest claim.
+# A PENDING, deferred, SETTLED (or any not OPEN) claim, one dated inside a closed period, an amount not more than 0.00
+# and less than the claim's, or a role not allowed to open a claim, is refused (400) and writes nothing.
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateSplitRequest
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkPeriod
+checkPeriod:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriodOpen
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: split
+split:
+  class: net.officefloor.hq.app.claim.SplitClaim
+  govern: [ transaction ]
+  next: log
+log:
+  class: net.officefloor.hq.app.claim.LogClaimStatus
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimSplit
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
