     body: JSON.stringify(body),
   });
 }
+
+export function putJson<T>(path: string, body?: unknown): Promise<T> {
+  return send<T>(path, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
