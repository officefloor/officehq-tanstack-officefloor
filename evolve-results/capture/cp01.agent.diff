@@ -0,0 +1,35 @@
+import { useState } from 'react';
+import { useCurrentUser } from './useSession';
+
+/** Sign in by typing a name; there is no password. */
+export function SignIn() {
+  const [, setUser] = useCurrentUser();
+  const [name, setName] = useState('');
+
+  return (
+    <form
+      data-testid="signin-form"
+      onSubmit={(e) => {
+        e.preventDefault();
+        const trimmed = name.trim();
+        if (trimmed !== '') setUser(trimmed);
+      }}
+    >
+      <label>
+        Name{' '}
+        <input data-testid="signin-name" value={name} onChange={(e) => setName(e.target.value)} />
+      </label>{' '}
+      <button type="submit" data-testid="signin-submit">
+        Sign in
+      </button>
+    </form>
+  );
+}
+
+export function CurrentUser({ user }: { user: string }) {
+  return (
+    <p>
+      Signed in as <strong data-testid="current-user">{user}</strong>
+    </p>
+  );
+}
diff --git a/src/main/frontend/features/session/useSession.ts b/src/main/frontend/features/session/useSession.ts
new file mode 100644
index 00000000..bcfca1f3
--- /dev/null
+++ b/src/main/frontend/features/session/useSession.ts
@@ -0,0 +1,13 @@
+import { asString, useSearchParam } from '../../url/useSearchParam';
+
+/**
+ * Who is signed in and which sheet is active. Both live in the URL (`user`, `sheet`) like any other
+ * state that outlives a click; every feature that needs them reads them from here.
+ */
+export function useCurrentUser() {
+  return useSearchParam('user', asString);
+}
+
+export function useCurrentSheet() {
+  return useSearchParam('sheet', asString);
+}
diff --git a/src/main/frontend/features/sheet/SheetPicker.tsx b/src/main/frontend/features/sheet/SheetPicker.tsx
new file mode 100644
