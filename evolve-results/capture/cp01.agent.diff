@@ -0,0 +1,32 @@
+import { useState } from 'react';
+import { AppHeader } from '../../slots/defs/appHeader';
+import { useCurrentUser } from '../../session/session';
+
+function SignIn() {
+  const [user, setUser] = useCurrentUser();
+  const [name, setName] = useState('');
+
+  if (user) {
+    return (
+      <div data-testid="session">
+        Signed in as <strong data-testid="current-user">{user}</strong>
+      </div>
+    );
+  }
+  return (
+    <form
+      data-testid="signin-form"
+      onSubmit={(e) => {
+        e.preventDefault();
+        if (name.trim()) setUser(name.trim());
+      }}
+    >
+      <input data-testid="signin-name" placeholder="Your name" value={name} onChange={(e) => setName(e.target.value)} />
+      <button type="submit" data-testid="signin-submit">
+        Sign in
+      </button>
+    </form>
+  );
+}
+
+export const contribution = AppHeader.fill({ order: 0, Component: SignIn });
diff --git a/src/main/frontend/features/sheet/picker.slot.tsx b/src/main/frontend/features/sheet/picker.slot.tsx
new file mode 100644
index 000000000..a5edaf3d2
--- /dev/null
+++ b/src/main/frontend/features/sheet/picker.slot.tsx
@@ -0,0 +1,40 @@
+import { useState } from 'react';
+import { useQueryClient } from '@tanstack/react-query';
+import { AppHeader } from '../../slots/defs/appHeader';
+import { useCurrentSheet, useCurrentUser } from '../../session/session';
+import { sheetKey, useSheet } from './sheet';
+
+function SheetPicker() {
+  const [user] = useCurrentUser();
+  const [sheet, setSheet] = useCurrentSheet();
+  const [input, setInput] = useState('');
+  const queryClient = useQueryClient();
+  const loaded = useSheet(sheet);
+
+  if (!user) return null;
+  return (
+    <form
+      data-testid="sheet-form"
+      onSubmit={(e) => {
+        e.preventDefault();
+        const id = input.trim();
+        if (!id) return;
+        // Loading an id again re-reads it from the store.
+        void queryClient.invalidateQueries({ queryKey: sheetKey(id) });
+        setSheet(id);
+      }}
+    >
+      <input data-testid="sheet-id-input" placeholder="Sheet id" value={input} onChange={(e) => setInput(e.target.value)} />
+      <button type="submit" data-testid="sheet-load">
+        Load
+      </button>
+      {loaded.data && (
+        <span>
+          {' '}Sheet <strong data-testid="sheet-current-id">{loaded.data.id}</strong>
+        </span>
+      )}
+    </form>
+  );
+}
+
+export const contribution = AppHeader.fill({ order: 10, Component: SheetPicker });
diff --git a/src/main/frontend/features/sheet/sheet.ts b/src/main/frontend/features/sheet/sheet.ts
new file mode 100644
