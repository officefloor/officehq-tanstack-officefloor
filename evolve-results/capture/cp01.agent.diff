+++ b/src/main/frontend/features/session/SheetPicker.tsx
@@ -0,0 +1,39 @@
+import { useState } from 'react';
+import { useQueryClient } from '@tanstack/react-query';
+import { asString, useSearchParam } from '../../url/useSearchParam';
+
+// Choose the active sheet by id. The active sheet is URL state (`sheet`); everything else is kept
+// per sheet, under query keys starting ['sheet', id]. Loading an id (again) re-reads it from the store.
+export function useSheetId(): string {
+  return useSearchParam('sheet', asString)[0];
+}
+
+export function SheetPicker() {
+  const [sheet, setSheet] = useSearchParam('sheet', asString);
+  const [id, setId] = useState('');
+  const queryClient = useQueryClient();
+
+  return (
+    <form
+      onSubmit={(e) => {
+        e.preventDefault();
+        const trimmed = id.trim();
+        if (!trimmed) return;
+        setSheet(trimmed);
+        void queryClient.invalidateQueries({ queryKey: ['sheet', trimmed] });
+      }}
+    >
+      <label>
+        Sheet <input data-testid="sheet-id-input" value={id} onChange={(e) => setId(e.target.value)} />
+      </label>
+      <button type="submit" data-testid="sheet-load">
+        Load
+      </button>
+      {sheet && (
+        <span>
+          {' '}Active sheet: <strong data-testid="sheet-current-id">{sheet}</strong>
+        </span>
+      )}
+    </form>
+  );
+}
diff --git a/src/main/frontend/features/session/SignIn.tsx b/src/main/frontend/features/session/SignIn.tsx
new file mode 100644
index 0000000..bd89ee8
--- /dev/null
+++ b/src/main/frontend/features/session/SignIn.tsx
@@ -0,0 +1,36 @@
+import { useState } from 'react';
+import { asString, useSearchParam } from '../../url/useSearchParam';
+
+// Sign in by name (no password). The signed-in name is URL state (`user`), so it survives a reload.
+export function useCurrentUser(): [string, (user: string | undefined) => void] {
+  return useSearchParam('user', asString);
+}
+
+export function SignIn() {
+  const [user, setUser] = useCurrentUser();
+  const [name, setName] = useState('');
+
+  if (user) {
+    return (
+      <p>
+        Signed in as <strong data-testid="current-user">{user}</strong>
+      </p>
+    );
+  }
+  return (
+    <form
+      onSubmit={(e) => {
+        e.preventDefault();
+        const trimmed = name.trim();
+        if (trimmed) setUser(trimmed);
+      }}
+    >
+      <label>
+        Name <input data-testid="signin-name" value={name} onChange={(e) => setName(e.target.value)} />
+      </label>
+      <button type="submit" data-testid="signin-submit">
+        Sign in
+      </button>
+    </form>
+  );
+}
