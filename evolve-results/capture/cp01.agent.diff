+# GET /api/sheets/{sheetId} — the sheet as the store holds it now. An id never used before is an
+# empty sheet; loading it writes nothing.
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
