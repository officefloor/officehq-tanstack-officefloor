+# PUT /api/sheets/{sheetId}/claims/{claimId}/status — change a claim's status by an action: open
+# (DRAFT to OPEN), settle (OPEN to SETTLED) or void (DRAFT or OPEN to VOID). An action the claim's
+# status does not allow, or an unknown action, is a 409 and a claim not on the sheet a 404, neither
+# writing anything. Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimStatus
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimStatus
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimStatus
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimStatusChanged
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
