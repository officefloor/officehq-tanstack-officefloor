+# Change a claim's status: open (DRAFT -> OPEN), settle (OPEN -> SETTLED) or void (DRAFT or OPEN ->
+# VOID). Any other change is refused (400) and writes nothing.
+change:
+  class: net.officefloor.hq.app.claim.ChangeClaimStatus
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
