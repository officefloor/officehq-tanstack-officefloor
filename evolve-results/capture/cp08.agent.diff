+# Move a claim to OPEN. A change its status does not allow is refused (409) and writes nothing.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.OpenClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimOpened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
