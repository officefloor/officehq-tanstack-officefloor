+# Move a claim to a status (open, settle or void). A change its current status does not allow is
+# refused before anything is written.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: status
+status:
+  class: net.officefloor.hq.app.claim.ValidateClaimStatus
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimStatus
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimStatus
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
