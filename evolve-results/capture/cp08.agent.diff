@@ -0,0 +1,18 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/status/{status} — move a claim to OPEN, SETTLED or VOID.
+# DRAFT -> OPEN -> SETTLED, and DRAFT or OPEN -> VOID; any other change is refused with 409 and
+# nothing is stored. 404 for a claim not on the sheet.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimStatus
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimStatus
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithEditedClaim
+  govern: [ transaction ]
