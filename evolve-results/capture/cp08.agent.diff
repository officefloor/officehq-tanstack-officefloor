+# POST /api/sheets/{sheetId}/claims/{claimId}/status — move a claim to a new status (body
+# {status, user}): DRAFT to OPEN, OPEN to SETTLED, DRAFT or OPEN to VOID. Refused (400) for any
+# other change, or when the claim is not on the sheet; nothing is stored then. A stored change is
+# recorded in the audit file as CLAIM_OPENED, CLAIM_SETTLED or CLAIM_VOIDED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateStatus
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyStatus
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimStatus
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
