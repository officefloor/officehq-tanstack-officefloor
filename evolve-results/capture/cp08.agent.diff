+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.hq.app.session.ChangedBy;
+import net.officefloor.plugin.variable.Val;
+
+public class RecordClaimStatus {
+    public void record(@Val Claim claim, @Val ChangedBy by, PersonRepository people, Audit audit) {
+        String event = switch (claim.getStatus()) {
+            case OPEN -> "CLAIM_OPENED";
+            case SETTLED -> "CLAIM_SETTLED";
+            case VOID -> "CLAIM_VOIDED";
+            case DRAFT -> throw new IllegalStateException("A claim never returns to DRAFT");
+        };
+        Person person = people.find(claim.getSheetId(), claim.getPersonId());
+        audit.record(ClaimAudit.line(event, claim, by, person == null ? "" : person.getName()));
+    }
+}
