+# Change a claim's status (open, settle or void). A refused change (not allowed from the claim's status, unknown claim) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimStatus
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimStatus
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimStatus
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
