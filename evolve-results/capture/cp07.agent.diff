+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates.POST.yml
@@ -0,0 +1,16 @@
+# Set a grade's rate. Validate first so a bad grade or percent is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRate
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.SaveRate
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.rate.RecordRateSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRate
+  govern: [ transaction ]
