+# Set a grade's rate, replacing any it had. Validate first so a bad grade or percent is refused (400)
+# and writes nothing.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRate
+  next: apply
+apply:
+  class: net.officefloor.hq.app.rate.ApplyRate
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.SaveRate
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.rate.AuditRateSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRate
