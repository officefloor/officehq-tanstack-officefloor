@@ -0,0 +1,51 @@
+import { useQuery } from '@tanstack/react-query';
+import { ClaimCells } from '../../slots/defs/claimColumns';
+import { PersonCells, PersonHeaders } from '../../slots/defs/personColumns';
+import { SheetPanel } from '../../slots/defs/sheetPanel';
+import { claimsQuery, sumAmounts } from '../claims/claimsQuery';
+import type { Claim } from '../claims/claimsQuery';
+import { peopleQuery } from '../people/peopleQuery';
+import type { Person } from '../people/peopleQuery';
+import { due, rateFor, ratesQuery, sumDue } from './ratesQuery';
+import type { Rate } from './ratesQuery';
+
+/** A person's due-total: their claimed times their grade's rate, or n/a when the grade has none. */
+function personDue(person: Person | undefined, claims: Claim[], rates: Rate[]): string {
+  if (!person) return 'n/a';
+  return due(sumAmounts(claims.filter((c) => c.personId === person.id)), rateFor(rates, person.grade));
+}
+
+function useSheetData(sheetId: string) {
+  return {
+    people: useQuery(peopleQuery(sheetId)).data ?? [],
+    claims: useQuery(claimsQuery(sheetId)).data ?? [],
+    rates: useQuery(ratesQuery(sheetId)).data ?? [],
+  };
+}
+
+function ClaimDue({ sheetId, claim }: { sheetId: string; claim: Claim }) {
+  const { people, rates } = useSheetData(sheetId);
+  const person = people.find((p) => p.id === claim.personId);
+  return <td data-testid="claim-due">{due(claim.amount, rateFor(rates, person?.grade))}</td>;
+}
+
+function PersonDueTotal({ sheetId, personId }: { sheetId: string; personId: number }) {
+  const { people, claims, rates } = useSheetData(sheetId);
+  return <td data-testid="person-due-total">{personDue(people.find((p) => p.id === personId), claims, rates)}</td>;
+}
+
+function DueTotal({ sheetId }: { sheetId: string }) {
+  const { people, claims, rates } = useSheetData(sheetId);
+  return (
+    <p data-testid="rollup-due">
+      Due total <strong data-testid="rollup-due-total">{sumDue(people.map((p) => personDue(p, claims, rates)))}</strong>
+    </p>
+  );
+}
+
+export const contributions = [
+  ClaimCells.fill({ order: 10, Component: ClaimDue }),
+  PersonHeaders.fill({ order: 15, Component: () => <th>Due</th> }),
+  PersonCells.fill({ order: 15, Component: PersonDueTotal }),
+  SheetPanel.fill({ order: 25, Component: DueTotal }),
+];
diff --git a/src/main/frontend/features/rates/rates.slot.tsx b/src/main/frontend/features/rates/rates.slot.tsx
new file mode 100644
index 00000000..2399b4d2
--- /dev/null
+++ b/src/main/frontend/features/rates/rates.slot.tsx
@@ -0,0 +1,107 @@
+import { useState } from 'react';
+import type { FormEvent } from 'react';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { putJson } from '../../api/http';
+import { SheetPanel } from '../../slots/defs/sheetPanel';
+import { useUser } from '../session/useUser';
+import { GRADES } from '../people/peopleQuery';
+import type { Grade } from '../people/peopleQuery';
+import { rateFor, ratesKey, ratesQuery } from './ratesQuery';
+import type { Rate } from './ratesQuery';
+
+const PERCENT = /^\d{1,7}(\.\d{1,2})?$/;
+
+/** The sheet's rate for each grade, and the form a grade's rate is set through. */
+function Rates({ sheetId }: { sheetId: string }) {
+  const queryClient = useQueryClient();
+  const rates = useQuery(ratesQuery(sheetId));
+  const [grade, setGrade] = useState<Grade>('A');
+  const [pct, setPct] = useState('');
+  const [error, setError] = useState('');
+
+  const [user] = useUser();
+  const save = useMutation({
+    mutationFn: (body: { grade: Grade; rate: string }) =>
+      putJson<Rate>(`/api/sheets/${encodeURIComponent(sheetId)}/rates/${body.grade}`, { rate: body.rate }, user),
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey: ratesKey(sheetId) });
+      setPct('');
+    },
+    onError: () => setError('The rate could not be set.'),
+  });
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    setError('');
+    const p = pct.trim();
+    if (!PERCENT.test(p)) {
+      setError('The rate must be a percent of 0.00 or more, with up to two decimals.');
+      return;
+    }
+    save.mutate({ grade, rate: p });
+  };
+
+  const list = rates.data ?? [];
+  return (
+    <section data-testid="rates">
+      <h3>Rates</h3>
+      <form data-testid="rate-form" onSubmit={submit}>
+        <label>
+          Grade{' '}
+          <select
+            data-testid="rate-form-grade"
+            value={grade}
+            onChange={(e) => {
+              setGrade(e.target.value as Grade);
+              setError('');
+            }}
+          >
+            {GRADES.map((g) => (
+              <option key={g} value={g}>
+                {g}
+              </option>
+            ))}
+          </select>
+        </label>{' '}
+        <label>
+          Rate %{' '}
+          <input
+            data-testid="rate-form-pct"
+            placeholder="0.00"
+            value={pct}
+            onChange={(e) => {
+              setPct(e.target.value);
+              setError('');
+            }}
+          />
+        </label>{' '}
+        <button type="submit" data-testid="rate-form-submit" disabled={save.isPending}>
+          Set rate
+        </button>
+        {error && <p data-testid="rate-form-error">{error}</p>}
+      </form>
+      {rates.isError && <p data-testid="rates-load-error">Could not load the rates.</p>}
+      <table>
+        <tbody>
+          {GRADES.map((g) => {
+            const rate = rateFor(list, g);
+            return (
+              <tr key={g} data-testid={rate === undefined ? undefined : `rate-row-${g}-start`}>
+                <td>{g}</td>
+                <td data-testid={`rate-current-${g}`}>
+                  <span data-testid="rate-pct">{rate ?? 'n/a'}</span>
+                </td>
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+// Keyed by sheet, so a typed rate or an error never carries over to another sheet.
+export const contribution = SheetPanel.fill({
+  order: 5,
+  Component: ({ sheetId }) => <Rates key={sheetId} sheetId={sheetId} />,
+});
diff --git a/src/main/frontend/features/rates/ratesQuery.ts b/src/main/frontend/features/rates/ratesQuery.ts
new file mode 100644
index 00000000..5f770587
--- /dev/null
+++ b/src/main/frontend/features/rates/ratesQuery.ts
@@ -0,0 +1,44 @@
+import { getJson } from '../../api/http';
+import { sheetKey } from '../sheet/sheetQuery';
+import type { Grade } from '../people/peopleQuery';
+
+/** `rate` is a percent with two decimals ("12.50"). A grade with no rate has no entry. */
+export type Rate = { grade: Grade; rate: string };
+
+/** Under the sheet's key, so re-loading the sheet re-reads its rates. */
+export const ratesKey = (sheetId: string) => [...sheetKey(sheetId), 'rates'] as const;
+
+export const ratesQuery = (sheetId: string) => ({
+  queryKey: ratesKey(sheetId),
+  queryFn: () => getJson<Rate[]>(`/api/sheets/${encodeURIComponent(sheetId)}/rates`),
+});
+
+/** The grade's rate, or undefined when it has none. */
+export function rateFor(rates: Rate[], grade: Grade | undefined): string | undefined {
+  return rates.find((r) => r.grade === grade)?.rate;
+}
+
+/** A two-decimal string ("12.50") in whole hundredths, exactly. */
+function hundredths(value: string): bigint {
+  const [whole, frac = ''] = value.trim().split('.');
+  return BigInt(whole || '0') * 100n + BigInt((frac + '00').slice(0, 2));
+}
+
+function show(cents: bigint): string {
+  return `${cents / 100n}.${(cents % 100n).toString().padStart(2, '0')}`;
+}
+
+/** Cents of `amount` times `rate` percent, rounded half up (away from zero; both are 0 or more). */
+export function dueCents(amount: string, rate: string): bigint {
+  return (hundredths(amount) * hundredths(rate) + 5000n) / 10000n;
+}
+
+/** `amount` times `rate` percent with two decimals, or n/a when there is no rate. */
+export function due(amount: string, rate: string | undefined): string {
+  return rate === undefined ? 'n/a' : show(dueCents(amount, rate));
+}
+
+/** Due-totals added up, skipping n/a. */
+export function sumDue(dues: string[]): string {
+  return show(dues.filter((d) => d !== 'n/a').reduce((total, d) => total + hundredths(d), 0n));
+}
