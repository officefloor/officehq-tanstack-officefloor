@@ -0,0 +1,112 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { postJson } from '../../api/http';
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { GRADES } from '../people/usePeople';
+import { PCT, rateByGrade, ratesKey, useRates, type Rate } from './useRates';
+
+/** The sheet's rate for each grade, and one form to set a grade's rate. */
+function RatesPanel({ user, sheet }: { user: string; sheet: string }) {
+  const queryClient = useQueryClient();
+  const { data: rates = [] } = useRates(sheet);
+  const current = rateByGrade(rates);
+  const [grade, setGrade] = useState<string>('A');
+  const [pct, setPct] = useState('');
+  const [invalid, setInvalid] = useState(false);
+
+  const save = useMutation({
+    mutationFn: (r: { grade: string; pct: string }) =>
+      postJson<Rate>(`/api/sheets/${encodeURIComponent(sheet)}/rates`, { ...r, user }),
+    onSuccess: async () => {
+      setPct('');
+      await queryClient.invalidateQueries({ queryKey: ratesKey(sheet) });
+    },
+  });
+
+  // An error goes as soon as its form is changed or submitted again.
+  const clearError = () => {
+    save.reset();
+    setInvalid(false);
+  };
+
+  return (
+    <section data-testid="rates-panel">
+      <h2>Rates</h2>
+      <form
+        data-testid="rate-form"
+        onSubmit={(e) => {
+          e.preventDefault();
+          if (!PCT.test(pct.trim())) {
+            // Refused here, before anything is sent: the store and the audit file are untouched.
+            save.reset();
+            setInvalid(true);
+            return;
+          }
+          setInvalid(false);
+          save.mutate({ grade, pct: pct.trim() });
+        }}
+      >
+        <label>
+          Grade{' '}
+          <select
+            data-testid="rate-form-grade"
+            value={grade}
+            onChange={(e) => {
+              setGrade(e.target.value);
+              clearError();
+            }}
+          >
+            {GRADES.map((g) => (
+              <option key={g} value={g}>
+                {g}
+              </option>
+            ))}
+          </select>
+        </label>{' '}
+        <label>
+          Rate %{' '}
+          <input
+            data-testid="rate-form-pct"
+            placeholder="0.00"
+            value={pct}
+            onChange={(e) => {
+              setPct(e.target.value);
+              clearError();
+            }}
+          />
+        </label>{' '}
+        <button type="submit" data-testid="rate-form-submit" disabled={save.isPending}>
+          Set rate
+        </button>
+        {(invalid || save.isError) && (
+          <span data-testid="rate-form-error" role="alert">
+            {' '}
+            {invalid
+              ? 'The rate must be a percent, 0.00 or more, with up to two decimals.'
+              : 'Could not set this rate.'}
+          </span>
+        )}
+      </form>
+      <table data-testid="rate-list">
+        <thead>
+          <tr>
+            <th>Grade</th>
+            <th>Rate %</th>
+          </tr>
+        </thead>
+        <tbody>
+          {GRADES.map((g) => (
+            <tr key={g} data-testid={current.has(g) ? `rate-row-${g}-start` : undefined}>
+              <td>{g}</td>
+              <td data-testid={`rate-current-${g}`}>
+                {current.has(g) ? <span data-testid="rate-pct">{current.get(g)}</span> : 'n/a'}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: 5, Component: RatesPanel });
diff --git a/src/main/frontend/features/rates/useRates.ts b/src/main/frontend/features/rates/useRates.ts
new file mode 100644
index 00000000..e3240855
--- /dev/null
+++ b/src/main/frontend/features/rates/useRates.ts
@@ -0,0 +1,56 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+
+/** A grade's rate as the server sends it: `pct` is a percent with two decimals. */
+export type Rate = { grade: string; pct: string };
+
+export const ratesKey = (sheet: string) => ['sheet', sheet, 'rates'] as const;
+
+/** The sheet's rates, one per grade that has one, re-read whenever the sheet is loaded. */
+export function useRates(sheet: string) {
+  return useQuery({
+    queryKey: ratesKey(sheet),
+    queryFn: () => getJson<Rate[]>(`/api/sheets/${encodeURIComponent(sheet)}/rates`),
+    staleTime: 0,
+    gcTime: 0,
+  });
+}
+
+/** A percent the server accepts: 0.00 or more, with up to two decimals. */
+export const PCT = /^\d{1,5}(\.\d{1,2})?$/;
+
+/** The rate for each grade that has one; a grade missing here has no rate. */
+export function rateByGrade(rates: Rate[]): Map<string, string> {
+  return new Map(rates.map((r) => [r.grade, r.pct]));
+}
+
+/** "12.34" as a whole number of hundredths (1234n), exactly. */
+function hundredths(value: string): bigint {
+  const [whole, frac = ''] = value.split('.');
+  return BigInt(whole) * 100n + BigInt((frac + '00').slice(0, 2));
+}
+
+function format(cents: bigint): string {
+  return `${cents / 100n}.${(cents % 100n).toString().padStart(2, '0')}`;
+}
+
+/**
+ * What is due on `amount` (two decimals) at `pct` percent: amount times pct divided by 100,
+ * rounded half up to two decimals, worked in whole numbers so it is exact. In cents, or null
+ * when there is no rate.
+ */
+export function dueCents(amount: string, pct: string | undefined): bigint | null {
+  if (pct === undefined) return null;
+  // cents * hundredths-of-a-percent is in ten-thousandths of a cent.
+  return (hundredths(amount) * hundredths(pct) + 5000n) / 10000n;
+}
+
+/** A due in cents as shown: two decimals, or n/a when there is no rate. */
+export function showDue(cents: bigint | null): string {
+  return cents === null ? 'n/a' : format(cents);
+}
+
+/** Dues added up, skipping the n/a ones. */
+export function totalDue(dues: Array<bigint | null>): string {
+  return format(dues.reduce<bigint>((sum, d) => (d === null ? sum : sum + d), 0n));
+}
