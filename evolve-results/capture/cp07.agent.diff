@@ -0,0 +1,20 @@
+import { useQuery } from '@tanstack/react-query';
+import { claimsKey, listClaims, sumAmounts } from '../claims/api';
+import { listPeople, peopleKey } from '../people/api';
+import { dueOf, listRates, rateByGrade, ratesKey, sumDues } from './api';
+
+/** The sheet's due-total: everyone's due-total added up, skipping those with no rate. */
+export function DueTotal({ sheetId }: { sheetId: string; user: string }) {
+  const people = useQuery({ queryKey: peopleKey(sheetId), queryFn: () => listPeople(sheetId) });
+  const claims = useQuery({ queryKey: claimsKey(sheetId), queryFn: () => listClaims(sheetId) });
+  const rates = useQuery({ queryKey: ratesKey(sheetId), queryFn: () => listRates(sheetId) });
+  const byGrade = rateByGrade(rates.data);
+  const dues = (people.data ?? []).map((p) =>
+    dueOf(sumAmounts((claims.data ?? []).filter((c) => c.personId === p.id)), byGrade.get(p.grade)),
+  );
+  return (
+    <p>
+      Due total <span data-testid="rollup-due-total">{sumDues(dues)}</span>
+    </p>
+  );
+}
diff --git a/src/main/frontend/features/rates/Rates.tsx b/src/main/frontend/features/rates/Rates.tsx
new file mode 100644
index 000000000..1c85e2c8c
--- /dev/null
+++ b/src/main/frontend/features/rates/Rates.tsx
@@ -0,0 +1,73 @@
+import { useState } from 'react';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { GRADES } from '../people/api';
+import { listRates, rateByGrade, ratesKey, setRate, type RateInput } from './api';
+
+const EMPTY: RateInput = { grade: 'A', pct: '' };
+
+/** The sheet's rate for each grade: a form that sets one, and each grade's current rate. */
+export function Rates({ sheetId, user }: { sheetId: string; user: string }) {
+  const queryClient = useQueryClient();
+  const rates = useQuery({ queryKey: ratesKey(sheetId), queryFn: () => listRates(sheetId) });
+  const byGrade = rateByGrade(rates.data);
+  const [form, setForm] = useState<RateInput>(EMPTY);
+
+  const save = useMutation({
+    mutationFn: (input: RateInput) => setRate(sheetId, user, input),
+    onSuccess: () => {
+      setForm((f) => ({ ...f, pct: '' }));
+      return queryClient.invalidateQueries({ queryKey: ratesKey(sheetId) });
+    },
+  });
+
+  const change = (patch: Partial<RateInput>) => {
+    setForm((f) => ({ ...f, ...patch }));
+    save.reset();
+  };
+
+  return (
+    <section>
+      <h3>Rates</h3>
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          save.reset();
+          save.mutate(form);
+        }}
+      >
+        <label>
+          Grade{' '}
+          <select data-testid="rate-form-grade" value={form.grade} onChange={(e) => change({ grade: e.target.value })}>
+            {GRADES.map((g) => (
+              <option key={g} value={g}>
+                {g}
+              </option>
+            ))}
+          </select>
+        </label>{' '}
+        <label>
+          Percent{' '}
+          <input data-testid="rate-form-pct" value={form.pct} onChange={(e) => change({ pct: e.target.value })} />
+        </label>{' '}
+        <button type="submit" data-testid="rate-form-submit" disabled={save.isPending}>
+          Set rate
+        </button>
+        {save.isError && (
+          <span data-testid="rate-form-error">A rate needs a percent of 0.00 or more with up to two decimals.</span>
+        )}
+      </form>
+      <table>
+        <tbody>
+          {GRADES.map((g) => (
+            <tr key={g} data-testid={byGrade.has(g) ? `rate-row-${g}-start` : undefined}>
+              <td>{g}</td>
+              <td data-testid={`rate-current-${g}`}>
+                {byGrade.has(g) ? <span data-testid="rate-pct">{byGrade.get(g)}</span> : 'n/a'}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
diff --git a/src/main/frontend/features/rates/api.ts b/src/main/frontend/features/rates/api.ts
new file mode 100644
index 000000000..50326bf3e
--- /dev/null
+++ b/src/main/frontend/features/rates/api.ts
@@ -0,0 +1,55 @@
+import { getJson, postJson } from '../../api/http';
+import { sheetKey } from '../sheet/api';
+
+/** A grade's rate on the sheet: a percent as two-decimal text. A grade with no rate is not listed. */
+export type Rate = { sheetId: string; grade: string; pct: string };
+export type RateInput = { grade: string; pct: string };
+
+const base = (sheetId: string) => `/api/sheets/${encodeURIComponent(sheetId)}/rates`;
+
+export const ratesKey = (sheetId: string) => [...sheetKey(sheetId), 'rates'] as const;
+
+/** The sheet's rates, by grade. */
+export function listRates(sheetId: string): Promise<Rate[]> {
+  return getJson<Rate[]>(base(sheetId));
+}
+
+/** Set a grade's rate; refused (rejects) when the percent is missing, negative or has more than
+ *  two decimals. */
+export function setRate(sheetId: string, by: string, input: RateInput): Promise<Rate> {
+  return postJson<Rate>(`${base(sheetId)}?by=${encodeURIComponent(by)}`, input);
+}
+
+/** The rate for each grade that has one. */
+export function rateByGrade(rates: Rate[] | undefined): Map<string, string> {
+  return new Map((rates ?? []).map((r) => [r.grade, r.pct]));
+}
+
+/** Two-decimal text as a whole number of hundredths. */
+function hundredths(text: string): bigint {
+  const [whole, frac = ''] = text.trim().split('.');
+  return BigInt(whole || '0') * 100n + BigInt((frac + '00').slice(0, 2));
+}
+
+/** An amount times a percent, divided by 100, rounded half up to two decimals; null (n/a) when
+ *  there is no rate. Exact: worked in whole hundredths. */
+export function dueOf(amount: string, pct: string | undefined): string | null {
+  if (pct === undefined) return null;
+  // amount (1/100) x pct (1/100) / 100 is in 1/1_000_000; to cents is / 10_000, half up.
+  const product = hundredths(amount) * hundredths(pct);
+  const cents = (product + 5_000n) / 10_000n;
+  return formatCents(cents);
+}
+
+/** Add up two-decimal dues, skipping n/a. */
+export function sumDues(dues: Array<string | null>): string {
+  return formatCents(dues.reduce<bigint>((t, d) => (d === null ? t : t + hundredths(d)), 0n));
+}
+
+function formatCents(cents: bigint): string {
+  const frac = (cents % 100n).toString().padStart(2, '0');
+  return `${cents / 100n}.${frac}`;
+}
+
+/** A due as shown: n/a when there is none. */
+export const showDue = (due: string | null) => due ?? 'n/a';
