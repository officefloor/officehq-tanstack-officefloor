@@ -0,0 +1,97 @@
+import { useState } from 'react';
+import type { FormEvent } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { postJson } from '../../api/http';
+import { byUser } from '../session/session';
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { GRADES } from '../people/people';
+import type { Grade } from '../people/people';
+import { rateOf, ratesKey, ratesPath, useRates } from './rates';
+import type { Rate } from './rates';
+
+type Draft = { grade: Grade; pct: string };
+const EMPTY: Draft = { grade: 'A', pct: '' };
+
+// The sheet's rate for each grade: shown per grade (n/a when unset), with a form that sets one.
+function Rates({ sheet, user }: { sheet: string; user: string }) {
+  const queryClient = useQueryClient();
+  const { data: rates = [] } = useRates(sheet);
+  const [draft, setDraft] = useState<Draft>(EMPTY);
+
+  const save = useMutation({
+    mutationFn: (body: Draft) => postJson<Rate[]>(byUser(ratesPath(sheet), user), body),
+    onSuccess: (updated) => {
+      queryClient.setQueryData(ratesKey(sheet), updated);
+      setDraft((d) => ({ ...d, pct: '' }));
+    },
+  });
+
+  const change = (next: Partial<Draft>) => {
+    setDraft((d) => ({ ...d, ...next }));
+    save.reset();
+  };
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    save.reset();
+    // The server refuses a percent that is not 0.00 or more with up to two decimals.
+    save.mutate(draft);
+  };
+
+  return (
+    <section>
+      <h2>Rates</h2>
+      <form onSubmit={submit}>
+        <label>
+          Grade{' '}
+          <select
+            data-testid="rate-form-grade"
+            value={draft.grade}
+            onChange={(e) => change({ grade: e.target.value as Grade })}
+          >
+            {GRADES.map((g) => (
+              <option key={g} value={g}>
+                {g}
+              </option>
+            ))}
+          </select>
+        </label>{' '}
+        <label>
+          Rate %{' '}
+          <input data-testid="rate-form-pct" value={draft.pct} onChange={(e) => change({ pct: e.target.value })} />
+        </label>{' '}
+        <button type="submit" data-testid="rate-form-submit" disabled={save.isPending}>
+          Set rate
+        </button>
+        {save.isError && (
+          <span data-testid="rate-form-error" role="alert">
+            {' '}A rate needs a grade of A, B or C and a percent of 0.00 or more with up to two decimals.
+          </span>
+        )}
+      </form>
+      <table>
+        <thead>
+          <tr>
+            <th>Grade</th>
+            <th>Rate %</th>
+          </tr>
+        </thead>
+        <tbody>
+          {GRADES.map((g) => {
+            const pct = rateOf(rates, g);
+            return (
+              <tr key={g} data-testid={pct === undefined ? undefined : `rate-row-${g}-start`}>
+                <td>{g}</td>
+                <td data-testid={`rate-current-${g}`}>
+                  {pct === undefined ? 'n/a' : <span data-testid="rate-pct">{pct}</span>}
+                </td>
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: 5, Component: Rates });
diff --git a/src/main/frontend/features/rates/rates.ts b/src/main/frontend/features/rates/rates.ts
new file mode 100644
index 00000000..660286e7
--- /dev/null
+++ b/src/main/frontend/features/rates/rates.ts
@@ -0,0 +1,47 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+import type { Grade } from '../people/people';
+
+/** A grade's rate: a percent with two decimals. */
+export type Rate = { grade: Grade; pct: string };
+
+export const ratesKey = (sheet: string) => ['rates', sheet] as const;
+
+export const ratesPath = (sheet: string) => `/api/sheets/${encodeURIComponent(sheet)}/rates`;
+
+/** Every grade's rate on the sheet; a grade with no rate is absent. */
+export function useRates(sheet: string) {
+  return useQuery({
+    queryKey: ratesKey(sheet),
+    queryFn: () => getJson<Rate[]>(ratesPath(sheet)),
+  });
+}
+
+/** The rate for a grade, or undefined when the grade has none. */
+export function rateOf(rates: Rate[], grade: Grade): string | undefined {
+  return rates.find((r) => r.grade === grade)?.pct;
+}
+
+/** A two-decimal string as a whole number of hundredths. */
+export function hundredths(value: string): bigint {
+  const [whole, frac = ''] = value.split('.');
+  return BigInt(whole) * 100n + BigInt(frac.padEnd(2, '0').slice(0, 2));
+}
+
+/** A whole number of hundredths as a two-decimal string. */
+export function twoDecimals(cents: bigint): string {
+  return `${cents / 100n}.${String(cents % 100n).padStart(2, '0')}`;
+}
+
+/** An amount times a percent, divided by 100, in hundredths rounded half up (amounts and rates are
+ *  never negative, so half up is half away from zero); undefined when there is no rate. Worked in
+ *  whole numbers so no float error shows. */
+export function dueCents(amount: string, pct: string | undefined): bigint | undefined {
+  if (pct === undefined) return undefined;
+  return (hundredths(amount) * hundredths(pct) + 5000n) / 10000n;
+}
+
+/** A due as the screen shows it: two decimals, or n/a when there is no rate. */
+export function showDue(cents: bigint | undefined): string {
+  return cents === undefined ? 'n/a' : twoDecimals(cents);
+}
