+# PUT /api/sheets/{sheetId}/rates/{grade} — set the grade's rate. Body {"rate":"12.50"}: a percent of
+# 0.00 or more with up to two decimals. Another grade or a bad rate is refused with 400 and nothing
+# is stored.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRate
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.rate.ApplyRate
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.rate.AuditRateSet
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRate
+  govern: [ transaction ]
