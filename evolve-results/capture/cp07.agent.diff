--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/{grade}.PUT.yml
@@ -0,0 +1,16 @@
+# The audit line is written last, once every rule has passed, so a refused change writes none.
+# Validate first so an unknown grade or invalid percent is a 400 and nothing is written.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRate
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.SaveRate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.rate.AuditRateSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRate
+  govern: [ transaction ]
