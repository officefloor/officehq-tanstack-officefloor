+# PUT /api/sheets/{sheetId}/rates/{grade} — set a grade's rate, a percent with two decimals,
+# replacing any it had. A grade other than A, B or C, or a rate that is not a number 0.00 or more
+# with up to two decimals, is a 400 and writes nothing. Responds with the rate as stored.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRate
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.SaveRate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.rate.RecordRateSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRate
