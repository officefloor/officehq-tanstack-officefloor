diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates.POST.yml
new file mode 100644
index 000000000..d4cdf4080
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates.POST.yml
@@ -0,0 +1,18 @@
+# POST /api/sheets/{sheetId}/rates — set a grade's rate (body: {grade, pct, user}). A grade other
+# than A, B or C, or a pct that is not a number of 0.00 or more with up to two decimals, is refused
+# (400) and nothing is stored. A stored change is recorded in the audit file as RATE_SET; a refused
+# one records nothing.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRate
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.SaveRate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.rate.AuditRateSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRate
+  govern: [ transaction ]
