diff --git a/src/main/frontend/features/rates/rates.slot.tsx b/src/main/frontend/features/rates/rates.slot.tsx
new file mode 100644
index 0000000..788c8d8
--- /dev/null
+++ b/src/main/frontend/features/rates/rates.slot.tsx
@@ -0,0 +1,132 @@
+import { useState } from 'react';
+import type { FormEvent } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { putJson } from '../../api/http';
+import { PersonRow } from '../../slots/defs/personRow';
+import { SheetBody } from '../../slots/defs/sheet';
+import { sumAmounts, useClaims } from '../claims/claims';
+import { GRADES, usePeople } from '../people/people';
+import type { Person } from '../people/people';
+import { dueOn, ratesKey, sumDue, useRateFor, useRates } from './rates';
+import type { Rate } from './rates';
+
+const PCT = /^\d{1,3}(\.\d{1,2})?$/;
+
+/** The sheet's rate for each grade, and the form that sets one. */
+function Rates({ sheetId, user }: { sheetId: string; user: string }) {
+  const queryClient = useQueryClient();
+  const rates = useRates(sheetId);
+  const [grade, setGrade] = useState<string>('A');
+  const [pct, setPct] = useState('');
+  const [error, setError] = useState('');
+
+  const save = useMutation({
+    mutationFn: (body: { grade: string; rate: string }) =>
+      putJson<Rate>(`/api/sheets/${encodeURIComponent(sheetId)}/rates/${body.grade}`, { user, rate: body.rate }),
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey: ratesKey(sheetId) });
+      setPct('');
+    },
+    onError: () => setError('Could not set this rate: it must be a percent, 0.00 to 999.99, with up to two decimals.'),
+  });
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    setError('');
+    if (!PCT.test(pct.trim())) {
+      setError('The rate must be a percent, 0.00 to 999.99, with up to two decimals.');
+      return;
+    }
+    save.mutate({ grade, rate: pct.trim() });
+  };
+
+  return (
+    <section data-testid="rates">
+      <h2>Rates</h2>
+      <form data-testid="rate-form" onSubmit={submit}>
+        <label>
+          Grade{' '}
+          <select
+            data-testid="rate-form-grade"
+            value={grade}
+            onChange={(e) => {
+              setGrade(e.target.value);
+              setError('');
+            }}
+          >
+            {GRADES.map((g) => (
+              <option key={g} value={g}>
+                {g}
+              </option>
+            ))}
+          </select>
+        </label>{' '}
+        <label>
+          Rate %{' '}
+          <input
+            data-testid="rate-form-pct"
+            placeholder="0.00"
+            value={pct}
+            onChange={(e) => {
+              setPct(e.target.value);
+              setError('');
+            }}
+          />
+        </label>{' '}
+        <button type="submit" data-testid="rate-form-submit" disabled={save.isPending}>
+          Set rate
+        </button>
+        {error && (
+          <p data-testid="rate-form-error" role="alert">
+            {error}
+          </p>
+        )}
+      </form>
+      <table>
+        <tbody>
+          {GRADES.map((g) => (
+            <tr key={g} data-testid={`rate-row-${g}-start`}>
+              <td>{g}</td>
+              <td data-testid="rate-pct">
+                <span data-testid={`rate-current-${g}`}>
+                  {rates.data?.find((r) => r.grade === g)?.rate ?? 'n/a'}
+                </span>
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+/** A person's due-total: their claimed times their grade's rate, divided by 100, rounded half up. */
+function PersonDueTotal({ sheetId, person }: { sheetId: string; user: string; person: Person }) {
+  const claims = (useClaims(sheetId).data ?? []).filter((c) => c.personId === person.id);
+  const rate = useRateFor(sheetId, person.grade);
+  return <td data-testid="person-due-total">{dueOn(sumAmounts(claims), rate)}</td>;
+}
+
+/** The sheet's due-total: every person's due-total added up, skipping n/a. */
+function DueTotal({ sheetId }: { sheetId: string; user: string }) {
+  const people = usePeople(sheetId).data ?? [];
+  const claims = useClaims(sheetId).data ?? [];
+  const rates = useRates(sheetId).data ?? [];
+  const dues = people.map((p) =>
+    dueOn(
+      sumAmounts(claims.filter((c) => c.personId === p.id)),
+      rates.find((r) => r.grade === p.grade)?.rate,
+    ),
+  );
+  return (
+    <p>
+      Due total <strong data-testid="rollup-due-total">{sumDue(dues)}</strong>
+    </p>
+  );
+}
+
+export const contributions = [
+  SheetBody.fill({ order: 5, Component: Rates }),
+  SheetBody.fill({ order: 21, Component: DueTotal }),
+  PersonRow.fill({ order: 20, Component: PersonDueTotal }),
+];
diff --git a/src/main/frontend/features/rates/rates.ts b/src/main/frontend/features/rates/rates.ts
new file mode 100644
index 0000000..9298998
--- /dev/null
+++ b/src/main/frontend/features/rates/rates.ts
@@ -0,0 +1,43 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+
+/** A grade's rate on the sheet: a percent with two decimals. A grade with no rate is not listed. */
+export type Rate = { grade: string; rate: string };
+
+export const ratesKey = (sheetId: string) => ['sheet', sheetId, 'rates'] as const;
+
+/** The sheet's rate for each grade that has one. */
+export function useRates(sheetId: string) {
+  return useQuery({
+    queryKey: ratesKey(sheetId),
+    queryFn: () => getJson<Rate[]>(`/api/sheets/${encodeURIComponent(sheetId)}/rates`),
+  });
+}
+
+/** The rate for a grade, or undefined when the grade has none (or the rates are still loading). */
+export function useRateFor(sheetId: string, grade: string): string | undefined {
+  return useRates(sheetId).data?.find((r) => r.grade === grade)?.rate;
+}
+
+/** A two-decimal amount as whole cents, exactly. */
+function toCents(amount: string): bigint {
+  const [whole, frac = ''] = amount.trim().split('.');
+  return BigInt(whole || '0') * 100n + BigInt((frac + '00').slice(0, 2));
+}
+
+function fromCents(cents: bigint): string {
+  return `${cents / 100n}.${String(cents % 100n).padStart(2, '0')}`;
+}
+
+/** Due on an amount: amount times rate, divided by 100, rounded half up to two decimals (exact,
+ *  in integers); 'n/a' when there is no rate. */
+export function dueOn(amount: string, rate: string | undefined): string {
+  if (rate === undefined) return 'n/a';
+  const scaled = toCents(amount) * toCents(rate); // in 1/10000 of a cent
+  return fromCents((scaled + 5000n) / 10000n);
+}
+
+/** Two-decimal amounts added up exactly, skipping 'n/a'. */
+export function sumDue(dues: string[]): string {
+  return fromCents(dues.filter((d) => d !== 'n/a').reduce((total, d) => total + toCents(d), 0n));
+}
