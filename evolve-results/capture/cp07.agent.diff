diff --git a/src/main/frontend/features/rates/rates.slot.tsx b/src/main/frontend/features/rates/rates.slot.tsx
new file mode 100644
index 000000000..7984df578
--- /dev/null
+++ b/src/main/frontend/features/rates/rates.slot.tsx
@@ -0,0 +1,126 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { putJson } from '../../api/http';
+import { PeopleHead, PersonRow } from '../../slots/defs/personRow';
+import { SheetPage } from '../../slots/defs/sheetPage';
+import { total, useClaims } from '../claims/claims';
+import { GRADES, usePeople, type Person } from '../people/people';
+import { due, rateFor, ratesKey, sum, useRates, type Rate } from './rates';
+
+/** The sheet's rate for each grade: the form that sets one, and each grade's current rate. */
+function Rates({ sheetId, user }: { sheetId: string; user: string }) {
+  const rates = useRates(sheetId);
+  const queryClient = useQueryClient();
+  const [grade, setGrade] = useState<string>(GRADES[0]);
+  const [pct, setPct] = useState('');
+
+  const save = useMutation({
+    mutationFn: (v: { grade: string; rate: string }) =>
+      putJson<Rate>(`/api/sheets/${encodeURIComponent(sheetId)}/rates/${encodeURIComponent(v.grade)}`, {
+        rate: v.rate,
+        by: user,
+      }),
+    onSuccess: () => {
+      setPct('');
+      void queryClient.invalidateQueries({ queryKey: ratesKey(sheetId) });
+    },
+  });
+
+  return (
+    <section data-testid="rates">
+      <h3>Rates</h3>
+      <form
+        data-testid="rate-form"
+        onSubmit={(e) => {
+          e.preventDefault();
+          save.reset();
+          save.mutate({ grade, rate: pct });
+        }}
+      >
+        <label>
+          Grade{' '}
+          <select
+            data-testid="rate-form-grade"
+            value={grade}
+            onChange={(e) => {
+              setGrade(e.target.value);
+              save.reset();
+            }}
+          >
+            {GRADES.map((g) => (
+              <option key={g} value={g}>
+                {g}
+              </option>
+            ))}
+          </select>
+        </label>{' '}
+        <label>
+          Rate %{' '}
+          <input
+            data-testid="rate-form-pct"
+            inputMode="decimal"
+            value={pct}
+            onChange={(e) => {
+              setPct(e.target.value);
+              save.reset();
+            }}
+          />
+        </label>{' '}
+        <button type="submit" data-testid="rate-form-submit" disabled={save.isPending}>
+          Set rate
+        </button>
+        {save.isError && (
+          <span data-testid="rate-form-error">The rate must be a percent 0.00 or more, with up to two decimals.</span>
+        )}
+      </form>
+      {rates.isError && <p data-testid="rates-load-error">Could not load rates.</p>}
+      <table data-testid="rates-table">
+        <tbody>
+          {GRADES.map((g) => {
+            const rate = rateFor(rates.data, g);
+            return (
+              <tr key={g} data-testid={rate === undefined ? undefined : `rate-row-${g}-start`}>
+                <td>{g}</td>
+                <td data-testid={`rate-current-${g}`}>{rate === undefined ? 'n/a' : <span data-testid="rate-pct">{rate}</span>}</td>
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+function DueHead() {
+  return <th>Due total</th>;
+}
+
+/** A person's due-total: their claimed at their grade's rate. */
+function PersonDueTotal({ sheetId, person }: { sheetId: string; person: Person }) {
+  const claims = useClaims(sheetId);
+  const rates = useRates(sheetId);
+  const claimed = total(claims.data?.filter((c) => c.personId === person.id) ?? []);
+  return <td data-testid="person-due-total">{due(claimed, rateFor(rates.data, person.grade))}</td>;
+}
+
+/** The sheet's due-total: everyone's due-total added up, skipping n/a. */
+function DueTotal({ sheetId }: { sheetId: string }) {
+  const people = usePeople(sheetId);
+  const claims = useClaims(sheetId);
+  const rates = useRates(sheetId);
+  const dues = (people.data ?? []).map((p) =>
+    due(total(claims.data?.filter((c) => c.personId === p.id) ?? []), rateFor(rates.data, p.grade)),
+  );
+  return (
+    <p>
+      Due total <span data-testid="rollup-due-total">{sum(dues)}</span>
+    </p>
+  );
+}
+
+export const contributions = [
+  SheetPage.fill({ order: 5, Component: Rates }),
+  PeopleHead.fill({ order: 20, Component: DueHead }),
+  PersonRow.fill({ order: 20, Component: PersonDueTotal }),
+  SheetPage.fill({ order: 30, Component: DueTotal }),
+];
diff --git a/src/main/frontend/features/rates/rates.ts b/src/main/frontend/features/rates/rates.ts
new file mode 100644
index 000000000..d1885e2fb
--- /dev/null
+++ b/src/main/frontend/features/rates/rates.ts
@@ -0,0 +1,48 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+
+/** A grade's rate on the sheet: `rate` is a percent as text with two decimals (never a float). */
+export type Rate = { sheetId: string; grade: string; rate: string };
+
+export const ratesKey = (sheetId: string) => ['sheet', sheetId, 'rates'];
+
+/** The sheet's rate for each grade that has one. */
+export function useRates(sheetId: string) {
+  return useQuery({
+    queryKey: ratesKey(sheetId),
+    queryFn: () => getJson<Rate[]>(`/api/sheets/${encodeURIComponent(sheetId)}/rates`),
+  });
+}
+
+/** The rate for a grade, or undefined when the grade has none. */
+export function rateFor(rates: Rate[] | undefined, grade: string): string | undefined {
+  return rates?.find((r) => r.grade === grade)?.rate;
+}
+
+/** A two-decimal number ("12.34") in hundredths, exactly. */
+function hundredths(value: string): bigint {
+  const [whole, frac = ''] = value.trim().split('.');
+  return BigInt(whole || '0') * 100n + BigInt((frac + '00').slice(0, 2));
+}
+
+/** Hundredths shown with two decimals. */
+function shown(h: bigint): string {
+  const sign = h < 0n ? '-' : '';
+  const a = h < 0n ? -h : h;
+  return `${sign}${a / 100n}.${String(a % 100n).padStart(2, '0')}`;
+}
+
+/** What is due on an amount at a rate: amount × rate / 100, rounded half up (away from zero) to two
+ *  decimals; 'n/a' when there is no rate. */
+export function due(amount: string, rate: string | undefined): string {
+  if (rate === undefined) return 'n/a';
+  const p = hundredths(amount) * hundredths(rate); // in 1/10000 of a hundredth
+  const a = p < 0n ? -p : p;
+  const r = (a + 5000n) / 10000n;
+  return shown(p < 0n ? -r : r);
+}
+
+/** Two-decimal values added up, skipping 'n/a'. */
+export function sum(values: string[]): string {
+  return shown(values.filter((v) => v !== 'n/a').reduce((s, v) => s + hundredths(v), 0n));
+}
