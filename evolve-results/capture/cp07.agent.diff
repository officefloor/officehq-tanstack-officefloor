@@ -0,0 +1,79 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { postJson } from '../../api/http';
+import { asString, useSearchParam } from '../../url/useSearchParam';
+import { GRADES } from '../people/usePeople';
+import { NA } from './due';
+import { ratesKey, useRates, type Rate } from './useRates';
+
+// The sheet's rate for each grade (n/a where none is set), and the form that sets one.
+export function RatePanel() {
+  const [sheet] = useSearchParam('sheet', asString);
+  const [user] = useSearchParam('user', asString);
+  const rates = useRates(sheet);
+  const [grade, setGrade] = useState<string>('A');
+  const [pct, setPct] = useState('');
+  const queryClient = useQueryClient();
+  const save = useMutation({
+    mutationFn: (body: { grade: string; rate: string }) =>
+      postJson<Rate[]>(`/api/sheets/${encodeURIComponent(sheet)}/rates`, { ...body, user }),
+    onSuccess: (saved) => {
+      setPct('');
+      queryClient.setQueryData(ratesKey(sheet), saved);
+    },
+  });
+  return (
+    <>
+      <table data-testid="rates">
+        <thead>
+          <tr>
+            <th>Grade</th>
+            <th>Rate %</th>
+          </tr>
+        </thead>
+        <tbody>
+          {GRADES.map((g) => (
+            <tr key={g} data-testid={rates.has(g) ? `rate-row-${g}-start` : undefined}>
+              <td>{g}</td>
+              <td data-testid={`rate-current-${g}`}>
+                {rates.has(g) ? <span data-testid="rate-pct">{rates.get(g)}</span> : NA}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+      <form
+        data-testid="rate-form"
+        onSubmit={(e) => {
+          e.preventDefault();
+          save.reset();
+          save.mutate({ grade, rate: pct.trim() });
+        }}
+      >
+        <select
+          data-testid="rate-form-grade"
+          value={grade}
+          onChange={(e) => {
+            setGrade(e.target.value);
+            save.reset();
+          }}
+        >
+          {GRADES.map((g) => (
+            <option key={g} value={g}>{g}</option>
+          ))}
+        </select>{' '}
+        <input
+          data-testid="rate-form-pct"
+          value={pct}
+          placeholder="Rate %"
+          onChange={(e) => {
+            setPct(e.target.value);
+            save.reset();
+          }}
+        />{' '}
+        <button type="submit" data-testid="rate-form-submit">Set rate</button>
+        {save.isError && <span data-testid="rate-form-error" role="alert"> Could not set the rate: it must be a percent of 0.00 or more with at most two decimals.</span>}
+      </form>
+    </>
+  );
+}
diff --git a/src/main/frontend/features/rates/due.ts b/src/main/frontend/features/rates/due.ts
new file mode 100644
index 00000000..23501400
--- /dev/null
+++ b/src/main/frontend/features/rates/due.ts
@@ -0,0 +1,35 @@
+// Due is worked in exact integers: an amount in cents times a rate in hundredths of a percent is
+// due in millionths, then rounded half up (away from zero) to cents. No float ever touches it.
+
+export const NA = 'n/a';
+
+/** "10.25" -> 1025n. */
+export function toCents(amount: string): bigint {
+  const negative = amount.trim().startsWith('-');
+  const [whole, frac = ''] = amount.trim().replace(/^[-+]/, '').split('.');
+  const cents = BigInt(whole || '0') * 100n + BigInt((frac + '00').slice(0, 2));
+  return negative ? -cents : cents;
+}
+
+/** 1025n -> "10.25". */
+export function formatCents(cents: bigint): string {
+  const negative = cents < 0n;
+  const abs = negative ? -cents : cents;
+  const frac = (abs % 100n).toString().padStart(2, '0');
+  return `${negative ? '-' : ''}${abs / 100n}.${frac}`;
+}
+
+/** The due on an amount of cents at a rate ("12.50"), in cents; null when there is no rate. */
+export function dueCents(cents: bigint, rate: string | undefined): bigint | null {
+  if (rate === undefined) return null;
+  const millionths = cents * toCents(rate);
+  const negative = millionths < 0n;
+  const abs = negative ? -millionths : millionths;
+  const rounded = (abs + 5000n) / 10000n;
+  return negative ? -rounded : rounded;
+}
+
+/** A due for display: two decimals, or n/a. */
+export function showDue(due: bigint | null): string {
+  return due === null ? NA : formatCents(due);
+}
