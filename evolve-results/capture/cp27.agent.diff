+# POST /api/sheets/{sheetId}/people/{personId}/patrons — the person names another person on the sheet
+# as a patron. Body {"patronId":123}. 404 for a person not on the sheet; 422, storing nothing, for a
+# patron not on the sheet, the person themselves, or one already named.
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: patron
+  govern: [ transaction ]
+patron:
+  class: net.officefloor.hq.app.patron.LoadPatron
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.patron.AddPatron
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.patron.AuditPatronAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.patron.RespondWithPatronAdded
+  govern: [ transaction ]
