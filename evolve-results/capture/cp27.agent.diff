@@ -0,0 +1,20 @@
+# POST /api/sheets/{sheetId}/people/{personId}/patrons — name another person on the sheet as the person's patron.
+# A body without patronId, the person themselves, someone not on the sheet or a patron already named is a 400, a person
+# not on the sheet a 404, none writing anything. Responds 201 with the patron.
+validate:
+  class: net.officefloor.hq.app.patron.ValidatePatron
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.patron.AddPatron
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.patron.RecordPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.patron.RespondWithPatronCreated
