+# Name another person on the sheet as a patron of this one. A refused patron (no signed-in user, unknown person
+# or patron, the person themselves, one already named) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.patron.ValidatePatron
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: refuse
+refuse:
+  class: net.officefloor.hq.app.patron.RefusePatron
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.patron.SavePatron
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.patron.AuditPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.patron.RespondWithPatronCreated
+  govern: [ transaction ]
