+# Name another person on the sheet as the person's patron. Refused (400) for themselves, someone
+# already their patron, or someone not on the sheet. Moves no figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidatePatron
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddPatron
+  govern: [ transaction ]
+  next: record
+# Audit only once the patron is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
