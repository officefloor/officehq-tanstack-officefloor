@@ -0,0 +1,25 @@
+# Name another person on the sheet as the person's patron. Validate first so a bad body is a 400,
+# not a 404. Naming a patron moves no figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidatePatron
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddPatron
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the patron is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
