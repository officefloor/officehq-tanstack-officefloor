+# POST /api/sheets/{sheetId}/people/{personId}/patrons — name another person on the sheet as one of
+# the person's patrons; themselves, someone not on the sheet or a patron already named is refused.
+validate:
+  class: net.officefloor.hq.app.person.ValidatePatron
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddPatron
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
