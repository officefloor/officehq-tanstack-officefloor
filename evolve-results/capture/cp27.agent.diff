@@ -0,0 +1,22 @@
+# POST /api/sheets/{sheetId}/people/{personId}/patrons — name another person on the sheet as the
+# person's patron (body: {user, patronId}). Refused (400), storing nothing, when either is not on the
+# sheet, when the patron is the person themselves, or when they are already one of their patrons.
+# A stored patron is recorded in the audit file as PATRON_ADDED.
+validate:
+  class: net.officefloor.hq.app.person.ValidatePatron
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddPatron
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
