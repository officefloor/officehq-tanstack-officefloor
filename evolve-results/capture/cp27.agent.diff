@@ -0,0 +1,21 @@
+# Name another person on the sheet as the person's patron. The audit line is written last, once it
+# is saved, so a refused patron (no such patron, the person themselves, or one already named: 400;
+# no such person: 404) writes none. Patrons move no total, so no rollup is written.
+validate:
+  class: net.officefloor.hq.app.person.ValidatePatron
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddPatron
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
