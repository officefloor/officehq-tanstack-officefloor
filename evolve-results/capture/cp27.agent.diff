@@ -0,0 +1,25 @@
+# Name another person on the sheet as the person's patron. Validate before Load so a bad body is a 400,
+# not masked by a 404; the person themselves, a patron already named or one not on the sheet is refused
+# (400) and writes nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidatePatron
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddPatron
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SavePerson
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.person.AuditPatronAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
