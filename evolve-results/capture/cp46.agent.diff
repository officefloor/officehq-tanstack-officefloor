+# PUT /api/sheets/{sheetId}/claims/{claimId}/resettle — a steward re-freezes a SETTLED claim at the figure it would
+# have today as an open claim bound by no statement. Refused with 422 for anyone else or any other status, and for a
+# claim dated inside a closed period; nothing is stored. 404 for a claim not on the sheet.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: closed
+  govern: [ transaction ]
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplyResettle
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimResettled
+  next: rollup
+  govern: [ transaction ]
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithEditedClaim
+  govern: [ transaction ]
