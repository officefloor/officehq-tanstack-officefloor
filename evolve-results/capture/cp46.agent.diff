@@ -0,0 +1,35 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/resettle — re-settle a SETTLED claim (body {user}): freeze
+# it again at the due it would have today as an OPEN claim bound by no statement (today's rates, grades,
+# floor and late charge), and log a SETTLED line for it. Only a steward re-settles a claim. Refused (400)
+# when the user is not a steward, the claim is not SETTLED or not on the sheet, or its date falls in a
+# closed period; nothing is stored then. A stored re-settle is recorded in the audit file as CLAIM_RESETTLED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateResettle
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: checkResettle
+checkResettle:
+  class: net.officefloor.hq.app.claim.CheckResettle
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyResettle
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimResettled
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
