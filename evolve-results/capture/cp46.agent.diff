--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ValidateClaimResettle.java
@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.rollup.Actor;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateClaimResettle {
+    public void validate(@RequestBody ClaimResettleRequest request, Out<ClaimResettle> body, Out<Actor> actor) {
+        String user = request == null ? null : request.user();
+        actor.set(new Actor(user));
+        body.set(new ClaimResettle(user));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/resettle.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/resettle.POST.yml
new file mode 100644
index 00000000..84f8ef46
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/resettle.POST.yml
@@ -0,0 +1,35 @@
+# Re-settle a SETTLED claim: a steward freezes it again at the figure it would have today as an open
+# claim bound by no statement. Anyone else, any other status or a claim in a closed period is a 409
+# and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimResettle
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimResettle
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimResettled
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
