@@ -0,0 +1,12 @@
+# A steward re-settles a SETTLED claim, fixing its due again at today's live figure. Responds with the sheet's claims.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: resettle
+resettle:
+  class: net.officefloor.hq.app.claim.ResettleClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaims
+  govern: [ transaction ]
