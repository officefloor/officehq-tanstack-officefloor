+# POST /api/sheets/{sheetId}/claims/{claimId}/hold — hold an OPEN or PENDING claim, or release it when held (body
+# {user}): while held and unbound by a statement it counts in no live total (its person's, the sheet's, a period's),
+# as a claim dated within a hold of its person's does; one a statement bound keeps its figure. Refused (400) for a
+# user who may not change the sheet, a claim not on the sheet, or one in any other status; nothing is stored then. A
+# stored toggle is recorded in the audit file as CLAIM_HELD or CLAIM_RELEASED, then any move in the sheet's figures.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateHoldClaim
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkHold
+checkHold:
