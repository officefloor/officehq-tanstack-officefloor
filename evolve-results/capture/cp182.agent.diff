+# POST /api/sheets/{sheetId}/claims/{claimId}/hold — holds an OPEN or PENDING claim, or releases it when held:
+# while open and bound by no statement it counts in no live total; refused (409) for any other status.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.claim.HoldClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimHold
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimHeld
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
