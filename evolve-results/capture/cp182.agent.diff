@@ -0,0 +1,29 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/hold — hold (held: true) or release (held: false) an OPEN or PENDING claim:
+# while held and not bound by a statement it counts in no live total, as a claim dated within a hold of its person
+# does. A claim of any other status is a 409 and a claim not on the sheet a 404, neither writing anything; a claim
+# already as asked is left as it is. Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimHold
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimHold
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimHold
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimHold
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
