--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/hold.POST.yml
@@ -0,0 +1,35 @@
+# Hold an OPEN or PENDING claim, or release a held one: while held it counts in no live total,
+# unless a statement binds it. A claim in any other status is a 409 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimHold
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimHold
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimHeld
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused hold writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimHeld
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
