diff --git a/src/main/resources/db/migration/V104__claim_held.sql b/src/main/resources/db/migration/V104__claim_held.sql
new file mode 100644
index 0000000..a9c20f3
--- /dev/null
+++ b/src/main/resources/db/migration/V104__claim_held.sql
@@ -0,0 +1,4 @@
+-- Whether the claim is held: only an OPEN or PENDING claim is held or released. A held OPEN claim not bound by a
+-- statement is left out of every live total, as a held person's claims are.
+ALTER TABLE claim ADD COLUMN held BOOLEAN NOT NULL DEFAULT FALSE;
+ALTER TABLE claim_history ADD COLUMN held BOOLEAN NOT NULL DEFAULT FALSE;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/hold.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/hold.PUT.yml
new file mode 100644
index 0000000..2be0acc
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/hold.PUT.yml
@@ -0,0 +1,19 @@
+# Hold or release an OPEN or PENDING claim (a toggle): held, an OPEN one not bound by a statement counts in no live total, as a held person's claims do. A refused toggle (another status, unknown claim) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimHold
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimHold
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimHold
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
