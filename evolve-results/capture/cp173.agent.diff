diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-openings.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-openings.POST.yml
new file mode 100644
index 0000000..ed62bb0
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-openings.POST.yml
@@ -0,0 +1,22 @@
+# Paste opening balances: each line name,period,amount (a person on the sheet by name or alias, a period on the sheet,
+# an amount of two decimals, 0.00 or more). Every line is checked first; one failing line refuses the whole paste,
+# which writes nothing, not even an audit line. Each line in order adds its amount to the person's carried figure
+# for the period (OPENING_SET). Responds with how many lines went through.
+validate:
+  class: net.officefloor.hq.app.opening.ValidateOpeningImport
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.opening.CheckOpenings
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.opening.SaveOpenings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.opening.RespondWithOpeningImport
+  govern: [ transaction ]
