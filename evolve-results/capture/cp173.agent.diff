+-- Each person's opening balance for a period: pasted amounts added up, added to the person's
+-- carried figure for that period. A person with no row has no opening balance for it.
+CREATE TABLE period_person_opening (
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    period_name VARCHAR(200) NOT NULL,
+    person_id BIGINT NOT NULL,
+    amount DECIMAL(19, 2) NOT NULL,
+    PRIMARY KEY (sheet_id, period_name, person_id)
+);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/openings/import.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/openings/import.POST.yml
new file mode 100644
index 000000000..31a01b9fb
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/openings/import.POST.yml
@@ -0,0 +1,23 @@
+# Import opening balances: a line of name,period,amount each adds its amount to the person's carried
+# figure for the period. One change: every line is checked (the person on the sheet by name or alias,
+# the period on the sheet, an amount of two decimals, 0.00 or more) before anything is written, so a
+# refused line refuses the whole import (a 400).
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.period.ValidateImportOpenings
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: set
+# Resolves every line, then adds and audits each (OPENING_SET) in order.
+set:
+  class: net.officefloor.hq.app.period.SetImportedOpenings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithImportOpenings
+  govern: [ transaction ]
