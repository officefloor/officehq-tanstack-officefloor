+# Check every pasted opening-balance line first so a refusal writes nothing, then add each line's amount in order.
+# Responds with how many lines went through, and the sheet's periods.
+validate:
+  class: net.officefloor.hq.app.period.ValidateOpeningImport
+  govern: [ transaction ]
+  next: set
+set:
+  class: net.officefloor.hq.app.period.SetImportedOpenings
