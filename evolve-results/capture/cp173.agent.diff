+# POST /api/sheets/{sheetId}/import-openings — paste opening balances as lines of name,period,amount: a person on the
+# sheet by name or alias, a period on the sheet, an amount of 0.00 or more with two decimals. Every line is checked
+# first; a failing line, or no lines at all, is a 400 that writes nothing. Each line then adds its amount to the
+# person's carried figure for the period (a closed period keeps the figure fixed when it was closed), written as
+# OPENING_SET. Responds with how many lines went through.
+validate:
+  class: net.officefloor.hq.app.opening.ValidateImportOpenings
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.opening.AddImportedOpenings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.opening.RespondWithImportOpenings
