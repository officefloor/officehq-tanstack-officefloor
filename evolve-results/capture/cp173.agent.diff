+# POST /api/sheets/{sheetId}/import-openings — add opening balances (body: {text, user}). Each line is
+# name,period,amount: a person on the sheet by name or alias, a period on the sheet and an amount of two
+# decimals, 0.00 or more. Every line is checked first; refused (400), storing nothing and recording nothing,
+# when any line fails or there is no line. Otherwise each amount is added to the person's opening balance for
+# the period (part of their carried figure for it) and recorded as OPENING_SET. Answers {set}.
+validate:
+  class: net.officefloor.hq.app.opening.ValidateOpeningImport
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.opening.SaveOpeningImport
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.opening.RespondWithOpeningImport
+  govern: [ transaction ]
