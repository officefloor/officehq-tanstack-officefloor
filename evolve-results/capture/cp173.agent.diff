+# Paste lines of name,period,amount: each adds its amount to the person's (by name or alias) opening
+# balance for the period, carried into it. Every line is checked before any is saved: one refused
+# line refuses the paste and writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidateImportOpenings
+  next: set
+set:
+  class: net.officefloor.hq.app.period.SetImportedOpenings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithImportOpenings
+  govern: [ transaction ]
