+# POST /api/sheets/{sheetId}/openings/import — add opening balances per pasted line. Body {"text":"..."}, lines of
+# name,period,amount (a person's name or alias on the sheet, ignoring case; a period on the sheet; an amount with two
+# decimals, 0.00 or more). Every line is checked first: 400 for a bad line or none, and then nothing is stored. Otherwise
+# each adds its amount to the person's opening balance for the period, part of their carried figure for it, in order
+# (OPENING_SET). Responds {"set":n}, the lines that went through.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.period.ValidateOpeningImport
+  next: set
+  govern: [ transaction ]
+set:
+  class: net.officefloor.hq.app.period.SetImportedOpenings
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.period.RespondWithOpeningImport
+  govern: [ transaction ]
