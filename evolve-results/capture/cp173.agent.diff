+# POST /api/sheets/{sheetId}/import-openings — add an opening balance per pasted line of name,period,amount, in order:
+# the person on the sheet by name or alias (ignoring case), a period on the sheet by name (ignoring case), an amount
+# 0.00 or more with up to two decimals. Body: { "text": "..." }. Every line is checked before anything is stored, so
+# one refused line imports nothing. Each line adds its amount to the person's carried figure for that period
+# (OPENING_SET name=<name> period=<period> amount=<amount>). Responds { "added": n }, the lines that went through.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: validate
+validate:
+  class: net.officefloor.hq.app.opening.ValidateOpenings
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.opening.ApplyOpenings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.opening.RespondWithImportedOpenings
+  govern: [ transaction ]
