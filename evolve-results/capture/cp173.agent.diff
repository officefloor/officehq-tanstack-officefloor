+# Paste opening balances: lines of name,period,amount, each added to the person's opening balance for the period.
+# Every line is checked before anything is written, so one refusal adds nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: lines
+lines:
+  class: net.officefloor.hq.app.opening.ValidateImportOpenings
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.opening.CheckImportOpenings
+  govern: [ transaction ]
+  next: set
+set:
+  class: net.officefloor.hq.app.opening.SetImportedOpenings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.opening.RespondWithImportOpenings
+  govern: [ transaction ]
