@@ -0,0 +1,12 @@
+# Import lines of grade,rate,from,to, in order, each set as the rate form would set it.
+# Every line is checked before any is saved: one refused line refuses the import and writes nothing.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateImportRates
+  next: set
+set:
+  class: net.officefloor.hq.app.rate.SetImportedRates
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithImportRates
+  govern: [ transaction ]
