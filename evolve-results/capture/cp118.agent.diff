diff --git a/src/main/java/net/officefloor/hq/app/rate/ValidateRateImport.java b/src/main/java/net/officefloor/hq/app/rate/ValidateRateImport.java
new file mode 100644
index 000000000..924b353b3
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rate/ValidateRateImport.java
@@ -0,0 +1,45 @@
+package net.officefloor.hq.app.rate;
+
+import java.util.ArrayList;
+import java.util.List;
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/**
+ * Checks every imported line with exactly the rate form's rules before anything is stored. Each line is
+ * grade,rate,from,to; the from and to may be absent or blank. Blank lines are skipped; an import with no line
+ * is refused.
+ */
+public class ValidateRateImport {
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody RateImportRequest request,
+            Out<RateImportInput> imported, RoleStore roles) throws InvalidSheetException {
+        String user = request == null ? null : request.user();
+        roles.refuseChange(sheetId.trim(), user);
+        String text = request == null || request.text() == null ? "" : request.text();
+        String[] lines = text.split("\\r?\\n");
+        List<RateInput> rates = new ArrayList<>();
+        for (int i = 0; i < lines.length; i++) {
+            String line = lines[i];
+            if (line.trim().isEmpty()) {
+                continue;
+            }
+            String[] fields = line.split(",", -1);
+            if (fields.length < 2 || fields.length > 4) {
+                throw new InvalidSheetException("Line " + (i + 1) + " must be grade,rate,from,to");
+            }
+            try {
+                rates.add(ValidateRate.check(new RateRequest(fields[0].trim(), fields[1],
+                        fields.length > 2 ? fields[2] : "", fields.length > 3 ? fields[3] : "", user)));
+            } catch (InvalidSheetException e) {
+                throw new InvalidSheetException("Line " + (i + 1) + ": " + e.getMessage());
+            }
+        }
+        if (rates.isEmpty()) {
+            throw new InvalidSheetException("There are no rates to import");
+        }
+        imported.set(new RateImportInput(rates));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-rates.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-rates.POST.yml
new file mode 100644
index 000000000..8e0476e1e
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-rates.POST.yml
@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/import-rates — set a rate per imported line, in order (body: {text, user}).
+# Each line is grade,rate,from,to; the from and to may be absent or blank. Every line is first checked
+# with the rate form's rules; refused (400), storing nothing and recording nothing, when any line fails
+# or there is no line. Otherwise every rate is set as the rate form would (replacing one of the same
+# grade and from-date) and recorded as RATE_SET. Answers {set}.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateImport
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.SaveRateImport
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRateImport
+  govern: [ transaction ]
