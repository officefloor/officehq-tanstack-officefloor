+# Rate import: lines of grade,rate,from,to (the from- and to-date may be absent or blank; blank lines are skipped).
+# Every line is checked first with the rate form's rules; any line refused refuses the whole import (400) and nothing
+# is set. Otherwise each is set in order exactly as the rate form sets it (replacing a rate for the same grade and
+# from-date, recorded as RATE_SET with its rollup). Answers how many rates were set.
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.rate.ValidateImportRatesRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.SaveImportedRates
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithImportRatesResult
+  govern: [ transaction ]
