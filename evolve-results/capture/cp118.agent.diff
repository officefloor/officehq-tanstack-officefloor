+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-rates.POST.yml
@@ -0,0 +1,25 @@
+# POST /api/sheets/{sheetId}/import-rates — set a grade's rate per pasted line of grade,rate,from,to (the from-date and
+# to-date may be blank or absent), in order. Body: { "text": "..." }. Every line is checked by the rate form's rules
+# before anything is stored, so one refused line sets nothing. Each line is then set exactly as the rate form would
+# (replacing the grade's rate for the same from-date), recorded as RATE_SET, then the figures it moved.
+# Responds { "set": n }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: validate
+validate:
+  class: net.officefloor.hq.app.importrates.ValidateImportRates
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: set
+set:
+  class: net.officefloor.hq.app.importrates.SetImportedRates
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.importrates.RespondWithRatesSet
+  govern: [ transaction ]
