+# Check every imported line by the rate form's rules first so a refusal writes nothing, then set each line in order
+# as the form would. Responds with how many were set, and the sheet's rates.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateImport
+  govern: [ transaction ]
+  next: set
+set:
+  class: net.officefloor.hq.app.rate.SetImportedRates
+  govern: [ transaction ]
