+# Import rates: lines of grade,rate,from,to (the from and to may be absent or blank), each checked by the
+# rate form's rules. One change: if any line is refused, nothing is set; otherwise each is set in order as
+# the rate form sets it. Answers how many were set.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateImport
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.ImportRates
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRateImport
