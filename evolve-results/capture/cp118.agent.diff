+# POST /api/sheets/{sheetId}/import-rates — set a rate per pasted line of grade,rate,from,to (from and to may be
+# absent or blank), in order. Every line is checked first by the rate form's rules (see the PUT of a rate); a line
+# failing them, or no lines at all, is a 400 that writes nothing. Each line is then set as the form sets one,
+# replacing the grade's rate for the same from-date, written as RATE_SET with the figures it moved. Responds with how
+# many were set.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateImportRates
+  next: set
+set:
+  class: net.officefloor.hq.app.rate.SetImportedRates
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithImportRates
