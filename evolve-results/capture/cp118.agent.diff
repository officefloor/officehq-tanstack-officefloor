diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/import.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/import.POST.yml
new file mode 100644
index 000000000..637ff8c09
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/import.POST.yml
@@ -0,0 +1,22 @@
+# Import rates: a rate per line of grade,rate,from,to (from and to may be absent or blank), in order. One
+# change: every line is checked by the rate form's rules before anything is written, so a refused line
+# refuses the whole import (a 400). Each line is then set as the rate form would set it.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.rate.ValidateImportRates
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: set
+# Saves and audits each rate (RATE_SET, then its ROLLUP lines) in order.
+set:
+  class: net.officefloor.hq.app.rate.SetImportedRates
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithImportRates
+  govern: [ transaction ]
