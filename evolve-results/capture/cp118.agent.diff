@@ -0,0 +1,17 @@
+# Import rates: each line grade,rate,from,to (the last two may be absent or blank), in order, sets the grade's rate as the
+# rate form would (replacing any it had from that same date). Every line is checked first by the rate form's rules; one
+# failing line refuses the whole import, which writes nothing, not even an audit line. Responds with how many were set.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateImport
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: import
+import:
+  class: net.officefloor.hq.app.rate.ImportRates
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRateImport
+  govern: [ transaction ]
