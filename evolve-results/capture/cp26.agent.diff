+package net.officefloor.hq.app;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+
+/**
+ * One (project, tag) pairing — the join that puts a {@link Tag} on a {@link Project}. Mapped to the
+ * {@code project_tag} table created by {@code V17__project_tags.sql}. IDENTITY id so the DB assigns
+ * it on insert (the seed path inserts project_tag rows without an explicit id; GENERATED BY DEFAULT
+ * allows that).
+ */
+@Entity
+@Table(name = "project_tag")
+public class ProjectTag {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "project_id")
+    private Long projectId;
+
+    @Column(name = "tag_id")
+    private Long tagId;
+
+    public Long getId() {
+        return id;
+    }
+
+    public void setId(Long id) {
+        this.id = id;
+    }
+
+    public Long getProjectId() {
+        return projectId;
+    }
+
+    public void setProjectId(Long projectId) {
+        this.projectId = projectId;
+    }
+
+    public Long getTagId() {
+        return tagId;
+    }
+
+    public void setTagId(Long tagId) {
+        this.tagId = tagId;
+    }
+}
