+import { useState } from 'react';
+import { HomeMain } from '../../slots/defs/homeMain';
+import { usePeople } from '../people/people';
+import { useCurrentSheet } from '../../session/session';
+import { type Claim, useClaims } from './claims';
+
+// The duplicate claims: for each person, date and amount with two or more claims (VOID and DELETED
+// claims left out), one line <name> <date> <amount> x<count>; people in list order, then by date,
+// then by amount.
+type Dup = { name: string; date: string; amount: string; count: number };
+
+function duplicates(people: { id: number; name: string }[], claims: Claim[]): Dup[] {
+  const lines: Dup[] = [];
+  for (const person of people) {
+    const groups = new Map<string, Dup>();
+    for (const c of claims) {
+      if (c.personId !== person.id || c.status === 'VOID' || c.status === 'DELETED') continue;
+      const key = `${c.date} ${Number(c.amount).toFixed(2)}`;
+      const g = groups.get(key);
+      if (g) g.count += 1;
+      else groups.set(key, { name: person.name, date: c.date, amount: Number(c.amount).toFixed(2), count: 1 });
+    }
+    lines.push(
+      ...[...groups.values()]
+        .filter((g) => g.count >= 2)
+        .sort((a, b) => a.date.localeCompare(b.date) || Number(a.amount) - Number(b.amount)),
+    );
+  }
+  return lines;
+}
+
+function DuplicateClaims() {
+  const [sheet] = useCurrentSheet();
+  const people = usePeople(sheet);
+  const claims = useClaims(sheet);
+  const [shown, setShown] = useState(false);
+  const lines = shown ? duplicates(people.data ?? [], claims.data ?? []) : [];
+  return (
+    <section>
+      <h2>Duplicate claims</h2>
+      <button type="button" data-testid="dups-show" disabled={sheet === ''} onClick={() => setShown(true)}>
+        Show duplicates
+      </button>
+      <ul>
+        {lines.map((d) => (
+          <li key={`${d.name} ${d.date} ${d.amount}`} data-testid="dup-line">
+            {d.name} {d.date} {d.amount} x{d.count}
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+export const contribution = HomeMain.fill({ order: 36.6, Component: DuplicateClaims });
