+function roundHalfEven(n: bigint, d: bigint): bigint {
+  let q = n / d;
+  let r = n % d;
+  if (r < 0n) {
+    q -= 1n;
+    r += d;
+  }
+  if (r * 2n > d || (r * 2n === d && q % 2n !== 0n)) q += 1n;
