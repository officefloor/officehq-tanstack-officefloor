+# POST /api/sheets/{sheetId}/periods/{periodName}/lock — lock the period (body: {user}); a locked period cannot be
+# reopened. Refused (400) when the user is not a steward, the period is not on the sheet or is already locked;
+# nothing is stored then. Recorded in the audit file as PERIOD_LOCKED.
+validate:
+  class: net.officefloor.hq.app.period.ValidateClose
+  next: lock
+lock:
+  class: net.officefloor.hq.app.period.LockPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodLocked
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithClosedPeriod
+  govern: [ transaction ]
