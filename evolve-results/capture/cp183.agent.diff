@@ -0,0 +1,27 @@
+# Lock a period, by a steward only, so it cannot be reopened until unlocked; an unknown or already locked period, or a user who is
+# not a steward, is refused (400).
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: lock
+lock:
+  class: net.officefloor.hq.app.period.LockPeriod
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SavePeriodLocked
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodLocked
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
