+# Lock a period. Only a steward may; an unknown period is a 400; a lock by anyone else, or of a period
+# already locked, is a 409.
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: lock
+lock:
+  class: net.officefloor.hq.app.period.LockPeriod
+  govern: [ transaction ]
+  next: record
+# Audit only once the period is locked: a refused lock writes no line.
+record:
+  class: net.officefloor.hq.app.period.RecordPeriodLocked
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithLockedPeriod
+  govern: [ transaction ]
