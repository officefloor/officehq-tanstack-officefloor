+# POST /api/sheets/{sheetId}/periods/{periodId}/lock — lock a period (a locked period cannot be reopened). Only a steward
+# may lock. A period not on the sheet or already locked, or a user who is not a steward, is a 400 and writes nothing.
+# Responds with the period as stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriodClose
+  next: load
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: lock
+lock:
+  class: net.officefloor.hq.app.period.LockPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.RecordPeriodLocked
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
