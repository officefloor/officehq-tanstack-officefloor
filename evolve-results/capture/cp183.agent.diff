+# Lock a period (a locked period cannot be reopened). Only a steward may. A refused lock (no signed-in user, not a steward,
+# unknown sheet or period, already locked) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriodClose
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: lock
+lock:
+  class: net.officefloor.hq.app.period.LockPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodLocked
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
