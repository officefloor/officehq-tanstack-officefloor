+# PUT /api/sheets/{sheetId}/periods/{name}/lock — lock a period. Steward only. 409 for a period not on the sheet,
+# already locked, or a user who is not a steward.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: lock
+  govern: [ transaction ]
+lock:
+  class: net.officefloor.hq.app.period.LockPeriod
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodLocked
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
