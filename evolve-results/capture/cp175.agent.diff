+# A steward undoes the transfer that brought the person to this sheet, on the sheet's today they arrived: they are
+# transferred back to the sheet they came from by the transfer rules. Refused (400, nothing written) for anyone else,
+# any later day, or a person who did not arrive by transfer. Responds with this sheet's people.
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoTransfer
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPeople
+  govern: [ transaction ]
+handle:
+  class: net.officefloor.hq.app.person.HandleInvalidPerson
