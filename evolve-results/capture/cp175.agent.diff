+# PUT /api/sheets/{sheetId}/people/{personId}/transfer-undo — a steward undoes the transfer that brought the person
+# here, on the same sheet's today they arrived: they are transferred back to the sheet they came from.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransferUndo
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.ApplyTransfer
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonTransferred
+  govern: [ transaction ]
+  next: undone
+undone:
+  class: net.officefloor.hq.app.person.AuditTransferUndone
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithTransferred
+  govern: [ transaction ]
