+# Undo the transfer that brought the person to this sheet (a steward only, on the sheet's today they arrived): they are transferred back to the sheet they came from by the transfer rules, and PERSON_TRANSFER_UNDONE is written.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransferUndo
+  next: snapshot
+# The sheet's figures before the change, so the change can audit what it moved.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoTransferPerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
