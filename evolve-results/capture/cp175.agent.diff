+# Undo the transfer that brought a person to this sheet: only a steward, only on the sheet-today they arrived, only a
+# person who arrived by transfer. They are transferred back to the sheet they came from exactly as a transfer (see
+# TransferPerson, with its refusals and audit lines), and this sheet then records PERSON_TRANSFER_UNDONE. A refused undo
+# writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransferUndo
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: refuse
+refuse:
+  class: net.officefloor.hq.app.person.RefuseTransferUndo
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonTransferred
+  govern: [ transaction ]
+  next: undone
+undone:
+  class: net.officefloor.hq.app.person.AuditPersonTransferUndone
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
