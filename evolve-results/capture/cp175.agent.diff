+# Undo the transfer that brought a person here: they are transferred back to the sheet they came from, by exactly the
+# transfer's rules and lines, then this sheet records the undo. Every check runs before anything is written.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.ValidateTransferUndo
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.person.CheckTransferUndo
+  govern: [ transaction ]
+  next: rollup-before
+rollup-before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonTransferred
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: audit-to
+audit-to:
+  class: net.officefloor.hq.app.person.RecordPersonArrived
+  govern: [ transaction ]
+  next: undone
+undone:
+  class: net.officefloor.hq.app.person.RecordPersonTransferUndone
+  govern: [ transaction ]
+  next: rollup-undone
+rollup-undone:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
