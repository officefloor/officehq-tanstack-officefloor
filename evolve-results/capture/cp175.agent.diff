+# POST /api/sheets/{sheetId}/people/{personId}/transfer-undo — undo the transfer that brought a person to this sheet, by a
+# steward on the sheet's today they arrived: they are transferred back to the sheet they came from exactly as a transfer
+# does (see transfer.POST.yml, its rules and its lines), then this sheet writes PERSON_TRANSFER_UNDONE name=<name>
+# to=<sheet> and its figures. A user other than a steward, a person who did not arrive by a transfer, any later (or
+# other) day, or anything the transfer refuses is a 400 — none writes anything. Responds with the person as stored there.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransferUndo
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: undo
+undo:
