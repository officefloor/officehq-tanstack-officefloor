@@ -0,0 +1,36 @@
+# POST /api/sheets/{sheetId}/people/{personId}/transfer-undo — undo the transfer that brought a person to this
+# sheet (body: {user}). Only a steward undoes it, and only on the sheet-today the person arrived. The person is
+# transferred back to the sheet they came from by exactly the transfer's rules and lines (see transfer.POST.yml),
+# then this sheet records PERSON_TRANSFER_UNDONE followed by its rollup lines. Refused (400), storing nothing,
+# when the user is not a steward, the person did not arrive by transfer or arrived on another day, or the
+# transfer back is refused.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransferUndo
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: prepare
+prepare:
+  class: net.officefloor.hq.app.person.PrepareTransferUndo
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonTransferred
+  govern: [ transaction ]
+  next: undone
+undone:
+  class: net.officefloor.hq.app.person.AuditPersonTransferUndone
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithTransferred
+  govern: [ transaction ]
