+# On the sheet a transfer brought a person to, a steward undoes it on the same sheet-today they arrived: they are
+# transferred back to the sheet they came from by the transfer rules, and this sheet writes PERSON_TRANSFER_UNDONE.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.TransferUndoPerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
