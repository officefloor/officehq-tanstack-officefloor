+-- The arriving sheet's today when a transferred person arrived (null: not transferred here). The
+-- transfer can be undone on that sheet-today only.
+ALTER TABLE public.person ADD COLUMN origin_date DATE;
+ALTER TABLE asof.person ADD COLUMN origin_date DATE;
+ALTER TABLE asof_hist.person ADD COLUMN origin_date DATE;
+-- The history trigger keeps the column list it was created with: create it again to see the new one.
+DROP TRIGGER public.person_history;
+CREATE TRIGGER person_history AFTER INSERT, UPDATE, DELETE ON public.person FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/transfer-undo.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/transfer-undo.POST.yml
new file mode 100644
index 00000000..b0c873d3
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/transfer-undo.POST.yml
@@ -0,0 +1,40 @@
+# A steward undoes the transfer that brought the person to this sheet, on the sheet-today they
+# arrived: they are transferred back to the sheet they came from by exactly the transfer's rules and
+# audit lines, then this sheet writes PERSON_TRANSFER_UNDONE and the figures it moved. Refused (400)
+# for anyone else, a person who did not arrive by transfer, or any later day.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransferUndo
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoTransfer
+  govern: [ transaction ]
+  next: record
+# The transfer's own lines: this sheet's line and rollup, then the other sheet's.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonTransferred
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: arrived
+arrived:
+  class: net.officefloor.hq.app.person.RecordPersonArrived
+  govern: [ transaction ]
+  next: undone
+# Then this sheet's undo line, and the figures the undo moved.
+undone:
+  class: net.officefloor.hq.app.person.RecordTransferUndone
+  govern: [ transaction ]
+  next: undoneRollup
+undoneRollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
