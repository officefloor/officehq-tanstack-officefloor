diff --git a/src/main/java/net/officefloor/hq/app/person/UndoTransfer.java b/src/main/java/net/officefloor/hq/app/person/UndoTransfer.java
new file mode 100644
index 00000000..3de5927f
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/UndoTransfer.java
@@ -0,0 +1,31 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.claim.Claims;
+import net.officefloor.hq.app.period.Periods;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.setting.Settings;
+import net.officefloor.hq.app.sheet.Sheets;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import net.officefloor.server.http.ServerHttpConnection;
+
+public class UndoTransfer {
+    // Only a steward undoes the transfer that brought a person to this sheet, and only on the sheet-today they arrived:
+    // they are transferred back to the sheet they came from, by exactly the transfer rules.
+    public void undo(@Val Person person, People people, Claims claims, Settings settings, Sheets sheets,
+            Periods periods, Rollup rollup, ServerHttpConnection connection, Out<TransferredPerson> transferredOut,
+            Out<PersonResponse> responseOut) throws PersonTransferRefusedException {
+        if (!Settings.STEWARD.equals(settings.role(person.sheetId(), Audit.user(connection).trim()))) {
+            throw new PersonTransferRefusedException("Only a steward can undo a transfer.");
+        }
+        if (person.origin() == null) {
+            throw new PersonTransferRefusedException("This person did not arrive by transfer.");
+        }
+        if (!sheets.today(person.sheetId()).equals(people.transferredOn(person.id()))) {
+            throw new PersonTransferRefusedException("A transfer can be undone only on the day they arrived.");
+        }
+        TransferPerson.move(person, person.origin(), people, claims, settings, sheets, periods, rollup, transferredOut,
+                responseOut);
+    }
+}
diff --git a/src/main/resources/db/migration/V80__person_transferred_on.sql b/src/main/resources/db/migration/V80__person_transferred_on.sql
new file mode 100644
index 00000000..8da2d6a8
--- /dev/null
+++ b/src/main/resources/db/migration/V80__person_transferred_on.sql
@@ -0,0 +1,7 @@
+-- The sheet's today when a person arrived by transfer (transferred_on); null for a person who was not transferred in.
+-- A transfer may be undone on the sheet it brought them to only on that same sheet-today. Kept in the person's
+-- history too (see V39). The journal trigger is made again around the change, as in V41.
+DROP TRIGGER person_journal;
+ALTER TABLE person ADD COLUMN transferred_on DATE;
+ALTER TABLE person_history ADD COLUMN transferred_on DATE;
+CREATE TRIGGER person_journal AFTER INSERT, UPDATE, DELETE ON person FOR EACH ROW CALL 'net.officefloor.hq.app.history.Journal';
