diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/transfer-undo.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/transfer-undo.POST.yml
new file mode 100644
index 000000000..433a996d7
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/transfer-undo.POST.yml
@@ -0,0 +1,54 @@
+# Undo the transfer that brought a person to this sheet (a steward), on the same sheet's today they
+# arrived: they are transferred back to the sheet they came from, by exactly the transfer's rules and
+# lines, and this sheet then records the undo. Anyone else, a later day, or a person who did not arrive
+# by transfer is refused and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: prepare
+# Who may undo, and when: publishes the transfer back to the sheet they came from.
+prepare:
+  class: net.officefloor.hq.app.person.PrepareTransferUndo
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonTransferred
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: arrived
+arrived:
+  class: net.officefloor.hq.app.person.AuditPersonArrived
+  govern: [ transaction ]
+  next: undone
+# Then this sheet's undo line, followed by the figures the change moved here.
+undone:
+  class: net.officefloor.hq.app.person.AuditPersonTransferUndone
+  govern: [ transaction ]
+  next: undoneRollup
+undoneRollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
