diff --git a/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java b/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java
new file mode 100644
index 00000000..6d02a70e
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java
@@ -0,0 +1,23 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.hq.app.BadRequestException;
+import net.officefloor.hq.app.session.ChangedBy;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** The alias to give: trimmed, required, at most 200 characters, as a name is. Publishes it, with the user making the change. */
+public class ValidateAlias {
+    public void validate(@RequestBody AliasRequest request, Out<AliasInput> alias, Out<ChangedBy> changedBy)
+            throws BadRequestException {
+        ChangedBy by = ChangedBy.of(request == null ? null : request.by());
+        String typed = request == null || request.alias() == null ? "" : request.alias().trim();
+        if (typed.isEmpty()) {
+            throw new BadRequestException("Enter an alias");
+        }
+        if (typed.length() > 200) {
+            throw new BadRequestException("An alias is at most 200 characters");
+        }
+        alias.set(new AliasInput(typed));
+        changedBy.set(by);
+    }
+}
diff --git a/src/main/resources/db/migration/V53__person_alias.sql b/src/main/resources/db/migration/V53__person_alias.sql
new file mode 100644
index 00000000..531a84c4
--- /dev/null
+++ b/src/main/resources/db/migration/V53__person_alias.sql
@@ -0,0 +1,16 @@
+-- A person's aliases: other names they go by, stored trimmed. An alias shares the names' uniqueness on its sheet,
+-- ignoring case and surrounding spaces: no alias equals any name or other alias there (the app refuses one with a
+-- message; this index is the backstop against another alias).
+CREATE TABLE person_alias (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(200) NOT NULL REFERENCES sheet (id),
+    person_id BIGINT       NOT NULL REFERENCES person (id),
+    alias     VARCHAR(200) NOT NULL,
+    alias_key VARCHAR(200) GENERATED ALWAYS AS (LOWER(TRIM(alias)))
+);
+CREATE UNIQUE INDEX person_alias_sheet_key ON person_alias (sheet_id, alias_key);
+
+-- Snapshotted with the rest of the screen (see V40, V41).
+CREATE TABLE hist.person_alias AS SELECT t.*, CAST(NULL AS BIGINT) AS snapshot_id FROM person_alias t WHERE FALSE;
+CREATE INDEX hist_person_alias_snapshot ON hist.person_alias (snapshot_id);
+CREATE TABLE asof.person_alias AS SELECT * FROM person_alias WHERE FALSE;
