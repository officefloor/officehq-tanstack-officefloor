+# POST /api/sheets/{sheetId}/people/{personId}/aliases — add an alias to a person (body: {alias, user}),
+# stored without the spaces around it. The quick-add bar and the paste box find a person by an alias as
+# by their name. Refused (400), storing nothing, when the alias is blank, equals (ignoring case) any
+# name or alias on the sheet, or the person is not on the sheet. A stored alias is recorded in the
+# audit file as PERSON_ALIAS_ADDED.
+validate:
+  class: net.officefloor.hq.app.person.ValidateAlias
+  next: load
+load:
