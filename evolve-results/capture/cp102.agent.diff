@@ -0,0 +1,17 @@
+# Give the person an alias. Refused (400) when blank, or equal (as names are compared) to any name or
+# alias on the sheet. Moves no figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidateAlias
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddAlias
+  govern: [ transaction ]
+  next: record
+# Audit only once the alias is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordAliasAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
