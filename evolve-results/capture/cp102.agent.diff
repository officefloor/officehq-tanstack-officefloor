@@ -0,0 +1,8 @@
+-- A person's aliases: trimmed, each unique on the sheet (ignoring case) among all names and aliases.
+CREATE TABLE person_alias (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    person_id BIGINT NOT NULL REFERENCES person(id),
+    alias VARCHAR(200) NOT NULL
+);
+CREATE INDEX person_alias_sheet ON person_alias(sheet_id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
new file mode 100644
index 000000000..800c32b8a
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
@@ -0,0 +1,29 @@
+# Give the person one more alias. Validate first so a blank alias is a 400, not a 404.
+# Aliases share the names' uniqueness: one taken by any name or alias on the sheet is refused.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateAlias
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddAlias
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the alias is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditAliasAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
