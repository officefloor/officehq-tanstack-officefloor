diff --git a/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java b/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java
new file mode 100644
index 0000000..50ca460
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Bind the body and refuse it before anything is read or written: a signed-in user and an alias that is not blank. */
+public class ValidateAlias {
+    public void validate(@RequestBody AliasRequest request, Out<AliasInput> body) throws InvalidPersonException {
+        if (request == null || request.user() == null || request.user().isBlank()) {
+            throw new InvalidPersonException("Sign in before giving people aliases.");
+        }
+        String alias = request.alias() == null ? "" : request.alias().trim();
+        if (alias.isEmpty()) {
+            throw new InvalidPersonException("An alias is required.");
+        }
+        if (alias.length() > 200) {
+            throw new InvalidPersonException("An alias must be at most 200 characters.");
+        }
+        body.set(new AliasInput(request.user().trim(), alias));
+    }
+}
diff --git a/src/main/resources/db/migration/V63__person_alias.sql b/src/main/resources/db/migration/V63__person_alias.sql
new file mode 100644
index 0000000..7588892
--- /dev/null
+++ b/src/main/resources/db/migration/V63__person_alias.sql
@@ -0,0 +1,12 @@
+-- A person may have aliases, stored trimmed. Aliases share the names' uniqueness: compared as names are (without
+-- regard to case, ignoring surrounding spaces), no alias equals another alias or any name on the sheet.
+CREATE TABLE person_alias (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(100) NOT NULL REFERENCES sheet(id),
+    person_id BIGINT       NOT NULL REFERENCES person(id),
+    alias     VARCHAR(200) NOT NULL,
+    alias_key VARCHAR(200) GENERATED ALWAYS AS (LOWER(TRIM(alias))),
+    made_on   DATE
+);
+CREATE UNIQUE INDEX person_alias_sheet_key ON person_alias(sheet_id, alias_key);
+CREATE INDEX person_alias_person ON person_alias(sheet_id, person_id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
new file mode 100644
index 0000000..a9ae1ff
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
@@ -0,0 +1,20 @@
+# Give a person an alias. A refused alias (no signed-in user, a blank alias, unknown person, an alias equal, as names
+# are compared, to any name or alias on the sheet) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateAlias
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SaveAlias
+  govern: [ transaction ]
