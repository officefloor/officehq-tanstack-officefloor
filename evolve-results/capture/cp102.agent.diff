diff --git a/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java b/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java
new file mode 100644
index 000000000..99b07753a
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/ValidateAlias.java
@@ -0,0 +1,19 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the body: the alias (kept without its outer spaces) and the signed-in user are required. */
+public class ValidateAlias {
+    public void validate(@RequestBody AliasRequest request, Out<AliasValues> values) throws InvalidPersonException {
+        String alias = request == null || request.alias() == null ? "" : request.alias().trim();
+        if (alias.isEmpty()) {
+            throw new InvalidPersonException("An alias is required");
+        }
+        String by = request.by() == null ? "" : request.by().trim();
+        if (by.isEmpty()) {
+            throw new InvalidPersonException("The user adding the alias is required");
+        }
+        values.set(new AliasValues(alias, by));
+    }
+}
diff --git a/src/main/resources/db/migration/V53__person_alias.sql b/src/main/resources/db/migration/V53__person_alias.sql
new file mode 100644
index 000000000..40adeec68
--- /dev/null
+++ b/src/main/resources/db/migration/V53__person_alias.sql
@@ -0,0 +1,10 @@
+-- A person's aliases: each kept without surrounding spaces; alias_key is the alias as names are compared (lower-cased).
+-- An alias is unique on the sheet, and the app keeps it apart from every person's name there too.
+CREATE TABLE person_alias (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(200) NOT NULL,
+    person_id BIGINT       NOT NULL REFERENCES person (id),
+    alias     VARCHAR(500) NOT NULL,
+    alias_key VARCHAR(500) GENERATED ALWAYS AS (LOWER(alias))
+);
+CREATE UNIQUE INDEX person_alias_sheet_key ON person_alias (sheet_id, alias_key);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
new file mode 100644
index 000000000..0bf356289
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
@@ -0,0 +1,20 @@
+# POST /api/sheets/{sheetId}/people/{personId}/aliases — give a person an alias. A blank alias is a 400, a person not on
+# the sheet a 404, and an alias equal (case and outer spaces ignored) to any name or alias on the sheet a 409; none
+# writes anything. The alias is stored without its outer spaces. Responds with the person as stored.
+validate:
+  class: net.officefloor.hq.app.person.ValidateAlias
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddAlias
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordAliasAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
