+-- A person's aliases, kept without surrounding spaces. They share the names' uniqueness on the sheet, compared
+-- without regard to case: alias_key is the lower-cased alias, unique on the sheet (an alias equal to a name is
+-- refused by the app). The quick-add bar and the paste box find a person by an alias as well as by the name.
+CREATE TABLE person_alias (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    person_id BIGINT       NOT NULL REFERENCES person (id),
+    sheet_id  VARCHAR(255) NOT NULL,
+    alias     VARCHAR(255) NOT NULL,
+    alias_key VARCHAR(255) GENERATED ALWAYS AS (LOWER(alias))
+);
+ALTER TABLE person_alias ADD CONSTRAINT person_alias_sheet_key UNIQUE (sheet_id, alias_key);
+CREATE INDEX person_alias_person ON person_alias (person_id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
new file mode 100644
index 00000000..9ec5a78a
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/aliases.POST.yml
@@ -0,0 +1,30 @@
+# POST /api/sheets/{sheetId}/people/{personId}/aliases — give a person an alias. Body {"alias":"..."}; kept
+# without surrounding spaces. A blank alias, or one equal (ignoring case) to any name or alias on the sheet, is
+# refused with 400 and nothing is stored; 404 for a person not on the sheet. No figure changes, so no rollup.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.person.ValidateAlias
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: alias
+  govern: [ transaction ]
+alias:
+  class: net.officefloor.hq.app.person.AliasPerson
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonAliasAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.person.RespondWithEditedPerson
+  govern: [ transaction ]
