+import { PersonCells, PersonColumnHead } from '../../slots/defs/personRow';
+import { SheetBody } from '../../slots/defs/sheetBody';
+import { sumDues } from '../rates/useRates';
+import { useCutTotals } from './useCutTotals';
+
+/** A person's cut total: their cuts across every pool they are a member of, added up. */
+function PersonCutTotal({ sheetId, personId }: { sheetId: string; personId: number }) {
+  const totals = useCutTotals(sheetId);
+  return <td data-testid="person-cut-total">{totals.get(personId) ?? ''}</td>;
+}
+
+/** The sheet's cut total: everyone's cut total added up. */
+function CutTotal({ sheetId }: { sheetId: string }) {
+  const totals = useCutTotals(sheetId);
+  return (
+    <p>
+      Cut total: <strong data-testid="rollup-cut-total">{sumDues([...totals.values()])}</strong>
+    </p>
+  );
+}
+
+export const contributions = [
+  PersonColumnHead.fill({ order: 24, Component: () => <th>Cut</th> }),
+  PersonCells.fill({ order: 24, Component: PersonCutTotal }),
+  SheetBody.fill({ order: 32, Component: ({ sheetId }) => <CutTotal sheetId={sheetId} /> }),
+];
diff --git a/src/main/frontend/features/cuts/useCutTotals.ts b/src/main/frontend/features/cuts/useCutTotals.ts
new file mode 100644
index 000000000..adf393bf5
--- /dev/null
+++ b/src/main/frontend/features/cuts/useCutTotals.ts
@@ -0,0 +1,21 @@
+import { usePeople } from '../people/usePeople';
+import { usePools } from '../pools/usePools';
+import { money, hundredths } from '../rates/useRates';
+
+/** Each person's cut total (two decimals), by person id: their cuts across every pool they are a member
+ *  of, added up; a pool that shows no cut for them adds nothing. */
+export function useCutTotals(sheetId: string): Map<number, string> {
+  const people = usePeople(sheetId);
+  const pools = usePools(sheetId);
+  const totals = new Map<number, string>();
+  if (people.data === undefined || pools.data === undefined) return totals;
+  const cents = new Map<number, bigint>(people.data.map((p) => [p.id, 0n]));
+  for (const pool of pools.data) {
+    for (const m of pool.members) {
+      if (m.personId === null || m.cut === null || !cents.has(m.personId)) continue;
+      cents.set(m.personId, cents.get(m.personId)! + hundredths(m.cut));
+    }
+  }
+  for (const [id, c] of cents) totals.set(id, money(c));
+  return totals;
+}
