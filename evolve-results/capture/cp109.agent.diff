diff --git a/src/main/java/net/officefloor/hq/app/sheet/SheetRegistry.java b/src/main/java/net/officefloor/hq/app/sheet/SheetRegistry.java
new file mode 100644
index 00000000..97ad9435
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/sheet/SheetRegistry.java
@@ -0,0 +1,25 @@
+package net.officefloor.hq.app.sheet;
+
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+
+/** The sheets that exist: every sheet id that has been loaded. */
+@Repository
+public class SheetRegistry {
+
+    private final JdbcTemplate jdbc;
+
+    public SheetRegistry(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** Records that the sheet has been loaded. */
+    public void loaded(String sheet) {
+        jdbc.update("MERGE INTO sheet_loaded (id) KEY (id) VALUES (?)", sheet);
+    }
+
+    /** Whether the sheet has been loaded. */
+    public boolean exists(String sheet) {
+        return jdbc.queryForObject("SELECT COUNT(*) FROM sheet_loaded WHERE id = ?", Integer.class, sheet) > 0;
+    }
+}
diff --git a/src/main/resources/db/migration/V56__sheet_parent.sql b/src/main/resources/db/migration/V56__sheet_parent.sql
new file mode 100644
index 00000000..3752bb6a
--- /dev/null
+++ b/src/main/resources/db/migration/V56__sheet_parent.sql
@@ -0,0 +1,11 @@
+-- One row per sheet id that has been loaded: such a sheet exists, so another sheet may name it as its parent.
+CREATE TABLE sheet_loaded (
+    id VARCHAR(200) PRIMARY KEY
+);
+
+-- Each sheet's parent, by the child's id. Not kept per sheet (no sheet column), so the sheet shown as of a date
+-- keeps the parent it has now: the parent is not dated.
+CREATE TABLE sheet_parent (
+    child  VARCHAR(200) PRIMARY KEY,
+    parent VARCHAR(200) NOT NULL
+);
