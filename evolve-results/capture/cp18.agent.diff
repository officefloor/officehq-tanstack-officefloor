+# Close a period, fixing its due-total. An unknown period is a 400; one already closed is a 409.
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: close
+close:
+  class: net.officefloor.hq.app.period.ClosePeriod
+  govern: [ transaction ]
+  next: record
