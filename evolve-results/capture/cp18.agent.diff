@@ -0,0 +1,18 @@
+# Close a period, fixing its due-total. The audit line is written last, once it is saved, so a
+# refused close (no such period, or already closed: 400) writes none. Closing moves no person's
+# figures, so no rollup is written.
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: close
+close:
+  class: net.officefloor.hq.app.period.ClosePeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodClosed
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithClosedPeriod
+  govern: [ transaction ]
