@@ -1,6 +1,6 @@
 # PUT /api/sheets/{sheetId}/claims/{claimId}/status — change a claim's status by an action: open
 # (DRAFT to OPEN), settle (OPEN to SETTLED) or void (DRAFT or OPEN to VOID). An action the claim's
-# status does not allow, settling by the user who opened the claim, or an unknown action, is a 409
+# status does not allow, a claim dated inside a closed period, settling by the user who opened the claim, or an unknown action, is a 409
 # and a claim not on the sheet a 404, neither writing anything. Opening gives the claim the sheet's
 # next number and records who opened it; voiding clears the number. Responds with the claim as
 # stored.
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/claims.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/claims.POST.yml
index 48c993cf7..63a3d8cd3 100644
--- a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/claims.POST.yml
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/claims.POST.yml
@@ -1,6 +1,6 @@
 # POST /api/sheets/{sheetId}/people/{personId}/claims — add a claim to a person. An amount that is
 # not a number 0.00 or more with up to two decimals, or a date that is not yyyy-MM-dd, is a 400; a
-# person not on the sheet is a 404; neither writes anything. A blank date takes the sheet's today.
+# person not on the sheet is a 404; a date inside a closed period is a 400; none writes anything. A blank date takes the sheet's today.
 # Responds 201 with the claim as stored.
 validate:
   class: net.officefloor.hq.app.claim.ValidateClaim
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodId}/close.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodId}/close.POST.yml
new file mode 100644
index 000000000..d9e720b75
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodId}/close.POST.yml
@@ -0,0 +1,22 @@
+# POST /api/sheets/{sheetId}/periods/{periodId}/close — close a period, fixing its due-total as it is now (later
+# rate changes do not alter it). A period not on the sheet or already closed is a 400 and writes nothing. Once
+# closed, no claim dated inside it can be added, edited, opened, settled or voided. Responds with the period as
+# stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriodClose
+  next: load
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: close
+close:
+  class: net.officefloor.hq.app.period.ClosePeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.RecordPeriodClosed
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
