+++ b/src/main/frontend/features/export/exportPeriods.slot.tsx
@@ -0,0 +1,50 @@
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { useClaims } from '../claims/useClaims';
+import { usePeople } from '../people/usePeople';
+import { personPeriodCarriedCents, personPeriodDueCents, usePeriods } from '../periods/usePeriods';
+import { showDue, useRates } from '../rates/useRates';
+import { useFloor, useLate } from '../settings/useSettings';
+import { useSheetToday } from '../sheet/useSheet';
+import { downloadCsv, useSheetRead } from './csv';
+
+/**
+ * Downloads the period figures as a CSV file: a header line, then one line per person and period,
+ * people in list order and periods in the order added, with the figure and the carried figure as
+ * the person's period cells show them. Quoted and ended as the people export.
+ */
+function ExportPeriods({ sheet }: { user: string; sheet: string }) {
+  const { data: people = [] } = usePeople(sheet);
+  const { data: periods = [] } = usePeriods(sheet);
+  const { data: claims = [] } = useClaims(sheet);
+  const { data: rates = [] } = useRates(sheet);
+  const floor = useFloor(sheet);
+  const late = useLate(sheet);
+  const today = useSheetToday(sheet);
+
+  const read = useSheetRead(sheet);
+
+  const download = () => {
+    const lines = [['person', 'period', 'figure', 'carried']];
+    for (const person of people) {
+      for (const p of periods) {
+        lines.push([
+          person.name,
+          p.name,
+          showDue(personPeriodDueCents(p, person, claims, rates, floor, late, today)),
+          showDue(personPeriodCarriedCents(p, periods, person, claims, rates, floor, late, today)),
+        ]);
+      }
+    }
+    downloadCsv(lines, `periods-${sheet}.csv`);
+  };
+
+  return (
+    <p>
+      <button type="button" data-testid="export-periods" disabled={!read} onClick={download}>
+        Export periods (CSV)
+      </button>
+    </p>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: 12.6, Component: ExportPeriods });
