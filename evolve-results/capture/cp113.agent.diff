@@ -0,0 +1,25 @@
+# POST /api/sheets/{sheetId}/import-people — add a person per pasted line of name,grade,terms,contact, in order.
+# Body: { "text": "..." }. Every line is checked by the person form's rules before anything is stored (a name,
+# ignoring case, or a contact repeated in the paste refuses it too), so one refused line adds nothing.
+# Each person is recorded as the person form records them (PERSON_ADDED, then the figures it moved).
+# Responds { "added": n }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: validate
+validate:
+  class: net.officefloor.hq.app.importpeople.ValidateImportPeople
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.importpeople.AddImportedPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.importpeople.RespondWithImportedPeople
+  govern: [ transaction ]
