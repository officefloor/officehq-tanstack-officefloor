--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/import-people.POST.yml
@@ -0,0 +1,17 @@
+# POST /api/sheets/{sheetId}/import-people — add a person per pasted line, in order (body: {text, user}).
+# Each line is name,grade,terms,contact; terms and contact may be absent or blank. Every line is first
+# checked with the person form's rules (see people.POST.yml), and a name (ignoring case and the spaces
+# around it) or contact given by an earlier line is refused too; refused (400), storing nothing and
+# recording nothing, when any line fails or there is no line. Otherwise every person is added and
+# recorded as PERSON_ADDED (and its ROLLUP), as a single add is. Answers {added}.
+validate:
+  class: net.officefloor.hq.app.peopleimport.ValidateImport
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.peopleimport.SaveImported
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.peopleimport.RespondWithImport
+  govern: [ transaction ]
