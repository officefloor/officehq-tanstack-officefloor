+# Import lines of name,grade,terms,contact: a person per line, in order, each as the person form
+# would add them. Every line is checked by the form's rules before any is saved: one refused line
+# refuses the import and writes nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateImportPeople
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddImportedPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithImportPeople
+  govern: [ transaction ]
