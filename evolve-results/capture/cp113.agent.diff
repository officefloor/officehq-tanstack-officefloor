+# POST /api/sheets/{sheetId}/import-people — add a person per pasted line of name,grade,terms,contact,
+# in order. Every line is checked first by the person form's rules (a name or contact repeated within
+# the import is refused too): when any line is refused nothing is added. Responds with how many were added.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateImport
+  next: create
+create:
+  class: net.officefloor.hq.app.person.ImportPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithImport
