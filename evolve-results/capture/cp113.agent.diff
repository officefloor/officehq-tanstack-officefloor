@@ -0,0 +1,27 @@
+# POST /api/sheets/{sheetId}/people/import — add a person per pasted line. Body {"text":"..."}, lines of
+# name,grade,terms,contact (the last two may be absent or blank). Every line is checked first by the person form's
+# rules: 400 for a bad line, a name or contact already in use, or one repeated in the import (ignoring case) — and
+# then nothing is stored. Each person is recorded as PERSON_ADDED, as the form records one. Responds {"added":n}.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.person.ValidateImport
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.person.AddImportedPeople
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.person.RespondWithImported
+  govern: [ transaction ]
