@@ -0,0 +1,18 @@
+# POST /api/sheets/{sheetId}/import-people — add a person per pasted line of name,grade,terms,contact (terms and
+# contact may be absent or blank), in order. Every line is checked first by the person form's rules (see the add of a
+# person), no name (case ignored) or contact repeated within the paste; a line failing them, or no lines at all, is a
+# 400 (a name or contact already taken a 409) that writes nothing. Otherwise each person is added as the form adds
+# one, written as PERSON_ADDED and then the figures it moved. Responds with how many were added.
+validate:
+  class: net.officefloor.hq.app.person.ValidateImportPeople
+  next: check
+check:
+  class: net.officefloor.hq.app.person.CheckImportedPeople
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.person.AddImportedPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithImportPeople
