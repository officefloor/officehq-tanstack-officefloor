+# Import people: lines of name,grade,terms,contact, each added as the person form adds them. One change:
+# if any line is refused (by the form's rules, or a name or contact given twice), no one is added.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.importing.ValidateImport
+  next: save
+save:
+  class: net.officefloor.hq.app.importing.ImportPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.importing.RespondWithImport
