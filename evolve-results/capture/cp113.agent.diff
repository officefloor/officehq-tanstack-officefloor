diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/import.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/import.POST.yml
new file mode 100644
index 000000000..0dc7beb24
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/import.POST.yml
@@ -0,0 +1,23 @@
+# Import people: a person per line of name,grade,terms,contact, in order. One change: every line is
+# checked by the person form's rules before anything is written (a name or contact repeated within the
+# import refuses it too), so a refused line refuses the whole import. A bad line is a 400, a name or
+# contact already in use a 409.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateImportPeople
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: add
+# Checks every line, then saves and audits each person (PERSON_ADDED, then its ROLLUP lines) in order.
+add:
+  class: net.officefloor.hq.app.person.AddImportedPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithImportPeople
+  govern: [ transaction ]
