+# POST /api/sheets/{sheetId}/settle-batches — records a bulk settle as the sheet's next batch. Body {"claimIds":[...]}:
+# the claims it settled; those on the sheet now SETTLED or PENDING carry the batch's number. With none, no batch is
+# made. Responds with the sheet's last batch number ({last}, null for none).
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.batch.AddSettleBatch
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.batch.RespondWithSettleBatch
+  govern: [ transaction ]
