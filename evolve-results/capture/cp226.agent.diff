diff --git a/src/main/frontend/features/preview/preview.slot.tsx b/src/main/frontend/features/preview/preview.slot.tsx
new file mode 100644
index 00000000..f10e1694
--- /dev/null
+++ b/src/main/frontend/features/preview/preview.slot.tsx
@@ -0,0 +1,40 @@
+import { useState } from 'react';
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { usePreview } from './usePreview';
+
+/** Previews the sheet on this user's screen as if its today were a date (or as it is, when cleared),
+ *  and shows the date previewed. */
+function PreviewPicker() {
+  const [preview, setPreview] = usePreview();
+  const [date, setDate] = useState('');
+
+  return (
+    <form
+      data-testid="preview-form"
+      onSubmit={(e) => {
+        e.preventDefault();
+        const trimmed = date.trim();
+        if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) setPreview(trimmed);
+      }}
+    >
+      Preview: <strong data-testid="sheet-preview">{preview}</strong>{' '}
+      <label>
+        Preview as if today were{' '}
+        <input
+          data-testid="preview-date"
+          placeholder="yyyy-mm-dd"
+          value={date}
+          onChange={(e) => setDate(e.target.value)}
+        />
+      </label>{' '}
+      <button type="submit" data-testid="preview-set">
+        Set
+      </button>{' '}
+      <button type="button" data-testid="preview-clear" onClick={() => setPreview(undefined)}>
+        Clear
+      </button>
+    </form>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: 1, Component: PreviewPicker });
diff --git a/src/main/frontend/features/preview/usePreview.ts b/src/main/frontend/features/preview/usePreview.ts
new file mode 100644
index 00000000..0b2f712e
--- /dev/null
+++ b/src/main/frontend/features/preview/usePreview.ts
@@ -0,0 +1,12 @@
+import { asString, useSearchParam } from '../../url/useSearchParam';
+
+/**
+ * The date this user's screen previews the sheet as of (yyyy-mm-dd), or '' for none. It lives in the
+ * URL (`preview`), so it is this screen's alone. While it is set every read is of the sheet's current
+ * records with that date standing in for the sheet's today; every change still goes to the sheet as
+ * it is, on its real today (see features/asof/useAsOf.ts `useView`).
+ */
+export function usePreview(): [string, (value: string | undefined) => void] {
+  const [preview, setPreview] = useSearchParam('preview', asString);
+  return [preview, setPreview];
+}
