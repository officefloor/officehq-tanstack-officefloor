@@ -0,0 +1,31 @@
+# Put a person on hold, or take them off it when held. An unknown person is a 404.
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.TogglePersonHold
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the hold is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonHold
+  govern: [ transaction ]
