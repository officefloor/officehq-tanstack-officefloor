@@ -0,0 +1,26 @@
+# Put the person on hold, or take them off it when held. The audit line is written once it is saved,
+# then the rollup lines: holding takes the person's OPEN claims out of every live total, releasing
+# puts them back. No such person (404) writes nothing.
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonHold
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
