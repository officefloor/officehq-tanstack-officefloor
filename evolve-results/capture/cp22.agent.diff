+# Put a person on hold, or take them off it. While held, their OPEN claims count in no live total.
+validate:
+  class: net.officefloor.hq.app.person.ValidateHold
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPerson
+  govern: [ transaction ]
+  next: record
+# Audit only once the hold is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonHeld
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
