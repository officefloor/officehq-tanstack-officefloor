+ALTER TABLE person ADD COLUMN held BOOLEAN DEFAULT FALSE NOT NULL;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/hold.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/hold.PUT.yml
new file mode 100644
index 00000000..491d54c2
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/hold.PUT.yml
@@ -0,0 +1,26 @@
+# PUT /api/sheets/{sheetId}/people/{personId}/hold — put a person on hold, or take a held person off it
+# (a toggle; no body). While held, their OPEN claims count in no live total; their SETTLED ones still
+# do. 404 for a person not on the sheet.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: hold
+  govern: [ transaction ]
+hold:
+  class: net.officefloor.hq.app.person.HoldPerson
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonHeld
+  next: rollup
+  govern: [ transaction ]
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.person.RespondWithEditedPerson
+  govern: [ transaction ]
