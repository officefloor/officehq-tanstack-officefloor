+-- (their claimed and due-total, the sheet's totals, a period's due-total); their SETTLED claims still do.
+ALTER TABLE person ADD COLUMN held BOOLEAN NOT NULL DEFAULT FALSE;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/hold.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/hold.POST.yml
