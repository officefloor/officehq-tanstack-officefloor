+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/hold.POST.yml
@@ -0,0 +1,24 @@
+# Put a person on hold, or release them (the body says which). Validate before Load so a bad body is a
+# 400, not masked by a 404; a person already in that state is refused (400) and writes nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateHold
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SavePerson
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonHold
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
