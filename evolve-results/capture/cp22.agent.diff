@@ -0,0 +1,24 @@
+# POST /api/sheets/{sheetId}/people/{personId}/hold — put the person on hold, or take them off it
+# when held. While held their OPEN claims count in no live total; their SETTLED claims still do.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.TogglePersonHold
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonHold
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
