@@ -0,0 +1,27 @@
+# POST /api/sheets/{sheetId}/people/{personId}/hold — put a person on hold, or take them off it when
+# they are held (body: {user}). While held, their OPEN claims count in no live total (their own,
+# the sheet's, a period's); their SETTLED claims still do. Refused (400), storing nothing, when the
+# person is not on the sheet. A stored change is recorded in the audit file as PERSON_HELD or
+# PERSON_RELEASED, followed by how it moved the figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidateHold
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonHeld
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
