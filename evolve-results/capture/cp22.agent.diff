+# Put a person on hold, or take them off it. Validate the body before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.ValidateHold
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: rollup-before
+rollup-before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.HoldPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonHold
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
