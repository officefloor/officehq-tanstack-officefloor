@@ -0,0 +1,25 @@
+# POST /api/sheets/{sheetId}/people/{personId}/hold — put a person on hold (held: true) or take them off it (false).
+# A body without held is a 400, a person not on the sheet a 404, and a person already so a 400, none writing anything.
+# While held, the person's OPEN claims count in no live total; their SETTLED claims still do. Responds with the person
+# as stored.
+validate:
+  class: net.officefloor.hq.app.person.ValidateHold
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonHold
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
