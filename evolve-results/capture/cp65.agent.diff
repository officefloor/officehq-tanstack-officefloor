     /** Whether a claim in this status may move to {@code next}. */
     public boolean allows(ClaimStatus next) {
         return switch (next) {
             case OPEN -> this == DRAFT || this == PENDING;
             case PENDING -> this == OPEN;
             case SETTLED -> this == OPEN || this == PENDING;
