diff --git a/src/main/java/net/officefloor/hq/app/sheet/GuardTodayPermission.java b/src/main/java/net/officefloor/hq/app/sheet/GuardTodayPermission.java
new file mode 100644
index 00000000..f915155c
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/sheet/GuardTodayPermission.java
@@ -0,0 +1,18 @@
+package net.officefloor.hq.app.sheet;
+
+import net.officefloor.hq.app.AuditUser;
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.RequestHeader;
+
+/** Refuses a change of the sheet's today, before anything is written, by a role the sheet's permission matrix does
+ *  not allow to change it (anyone but a viewer, by the standing rule). */
+public class GuardTodayPermission {
+    public void guard(@Val Sheet sheet, @RequestHeader(name = "X-User", required = false) String user,
+            RoleRepository roles) throws InvalidTodayException {
+        String role = roles.roleOf(sheet.getId(), AuditUser.decode(user));
+        if (!sheet.allows("today", role)) {
+            throw InvalidTodayException.refused(role);
+        }
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/sheet/InvalidTodayException.java b/src/main/java/net/officefloor/hq/app/sheet/InvalidTodayException.java
index 4372de2f..628deadc 100644
--- a/src/main/java/net/officefloor/hq/app/sheet/InvalidTodayException.java
+++ b/src/main/java/net/officefloor/hq/app/sheet/InvalidTodayException.java
@@ -1,8 +1,18 @@
 package net.officefloor.hq.app.sheet;
 
-/** A today that is not a calendar date (YYYY-MM-DD). */
+/** A today that is not a calendar date (YYYY-MM-DD), or a change of it by a role the permission matrix does not
+ *  allow. */
 public class InvalidTodayException extends Exception {
     public InvalidTodayException(String value) {
         super("Not a date: " + value);
     }
+
+    private InvalidTodayException(String message, boolean refused) {
+        super(message);
+    }
+
+    /** A change of the sheet's today refused for the role taking it. */
+    public static InvalidTodayException refused(String role) {
+        return new InvalidTodayException("A " + role + " cannot change the sheet's today.", true);
+    }
 }
