@@ -0,0 +1,12 @@
+# Preview a candidate rate for a grade: what it would do to open claims' dues. Saves nothing.
+# Validate first so a bad grade or percent is a 400, not a 404.
+validate:
+  class: net.officefloor.hq.app.rate.ValidatePreview
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithPreview
+  govern: [ readonly-transaction ]
