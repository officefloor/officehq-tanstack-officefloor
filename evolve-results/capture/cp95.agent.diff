+# GET /api/sheets/{sheetId}/rate-preview?grade=A&pct=20.00 — what a candidate rate for a grade would change. Saves nothing.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRatePreview
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRatePreview
+  govern: [ transaction ]
