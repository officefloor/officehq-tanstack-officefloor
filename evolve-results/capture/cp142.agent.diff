@@ -26,4 +26,18 @@ public final class PlanDates {
         }
         return dates;
     }
+
+    /** The plan's first {@code count} dates after the day and on or before its end. */
+    public static List<LocalDate> after(Plan plan, LocalDate day, int count) {
+        List<LocalDate> next = new ArrayList<>();
+        for (LocalDate date : upTo(plan, plan.end())) {
+            if (next.size() == count) {
+                break;
+            }
+            if (date.isAfter(day)) {
+                next.add(date);
+            }
+        }
+        return next;
+    }
 }
diff --git a/src/main/java/net/officefloor/hq/app/plan/PlanView.java b/src/main/java/net/officefloor/hq/app/plan/PlanView.java
new file mode 100644
index 000000000..e3eb9fc97
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/plan/PlanView.java
@@ -0,0 +1,18 @@
+package net.officefloor.hq.app.plan;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.stream.Collectors;
+
+/** A plan as listed: the plan and its next dates — its first five dates after the sheet's today and on or before its
+ *  end (see PlanDates), comma and space separated. */
+public record PlanView(long id, long personId, BigDecimal amount, LocalDate start, Integer every, Integer day,
+        LocalDate end, int generated, String nextDates) {
+
+    public static PlanView of(Plan plan, LocalDate today) {
+        String next = PlanDates.after(plan, today, 5).stream().map(LocalDate::toString)
+                .collect(Collectors.joining(", "));
+        return new PlanView(plan.id(), plan.personId(), plan.amount(), plan.start(), plan.every(), plan.day(),
+                plan.end(), plan.generated(), next);
+    }
+}
