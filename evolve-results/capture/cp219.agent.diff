new file mode 100644
index 000000000..63a212ffb
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/RolloverRepository.java
@@ -0,0 +1,61 @@
+package net.officefloor.hq.app.period;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.Arrays;
+import java.util.List;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+
+/** Each sheet's last rollover, kept so it can be undone: what it generated and the opening balances it set. */
+@Repository
+public class RolloverRepository {
+
+    /** A sheet's last rollover: the fiscal year (FY<yyyy>), who made it, on which sheet-today, and the names of
+     *  the periods it generated. */
+    public record Last(String fy, String by, LocalDate on, List<String> periods) {
+    }
+
+    /** An opening balance a rollover set: the amount added, and whether the opening balance was new. */
+    public record Opening(String period, long personId, BigDecimal amount, boolean created) {
+    }
+
+    private final JdbcTemplate jdbc;
+
+    public RolloverRepository(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** Keep the rollover as the sheet's last, replacing the one before. */
+    public void record(String sheetId, String fy, String by, LocalDate on, List<String> periods, List<Opening> openings) {
+        forget(sheetId);
+        jdbc.update("INSERT INTO sheet_rollover (sheet_id, fy, made_by, made_on, periods) VALUES (?, ?, ?, ?, ?)",
+                sheetId, fy, by, on, String.join(",", periods));
+        for (Opening o : openings) {
+            jdbc.update("INSERT INTO sheet_rollover_opening (sheet_id, period, person_id, amount, created) "
+                    + "VALUES (?, ?, ?, ?, ?)", sheetId, o.period(), o.personId(), o.amount(), o.created());
+        }
+    }
+
+    /** The sheet's last rollover; null when there is none (or it was undone). */
+    public Last last(String sheetId) {
+        return jdbc.query("SELECT fy, made_by, made_on, periods FROM sheet_rollover WHERE sheet_id = ?",
+                (rs, n) -> new Last(rs.getString("fy"), rs.getString("made_by"),
+                        rs.getObject("made_on", LocalDate.class),
+                        rs.getString("periods").isEmpty() ? List.of() : Arrays.asList(rs.getString("periods").split(","))),
+                sheetId).stream().findFirst().orElse(null);
+    }
+
+    /** The opening balances the sheet's last rollover set. */
+    public List<Opening> openings(String sheetId) {
+        return jdbc.query("SELECT period, person_id, amount, created FROM sheet_rollover_opening WHERE sheet_id = ?",
+                (rs, n) -> new Opening(rs.getString("period"), rs.getLong("person_id"), rs.getBigDecimal("amount"),
+                        rs.getBoolean("created")), sheetId);
+    }
+
+    /** Forget the sheet's last rollover. */
+    public void forget(String sheetId) {
+        jdbc.update("DELETE FROM sheet_rollover_opening WHERE sheet_id = ?", sheetId);
+        jdbc.update("DELETE FROM sheet_rollover WHERE sheet_id = ?", sheetId);
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/period/UndoRollover.java b/src/main/java/net/officefloor/hq/app/period/UndoRollover.java
new file mode 100644
index 000000000..10b3381b7
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/UndoRollover.java
@@ -0,0 +1,54 @@
+package net.officefloor.hq.app.period;
+
+import java.util.List;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.claim.Claim;
+import net.officefloor.hq.app.claim.ClaimRepository;
+import net.officefloor.hq.app.setting.Role;
+import net.officefloor.hq.app.setting.RoleRepository;
+import net.officefloor.hq.app.sheet.SheetRepository;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/** Undoes the sheet's last rollover: removes the periods it generated and takes back the opening balances it
+ *  set, recorded as ROLLOVER_UNDONE fy=FY<yyyy>; it is then no longer the last rollover. Refused, with nothing
+ *  written, when there is none, for anyone but the steward who made it, on a sheet-today other than the one it
+ *  was made on, or when a claim (whatever its status) belongs to a period it generated. */
+public class UndoRollover {
+    public void undo(@PathVariable("sheetId") String sheetId,
+            @RequestParam(name = "by", required = false) String by, SheetRepository sheets, PeriodRepository periods,
+            ClaimRepository claims, RoleRepository roles, RolloverRepository rollovers, Audit audit,
+            Out<GeneratePeriodsResult> result) throws InvalidPeriodException, PeriodPermissionException {
+        String id = sheetId.trim();
+        String user = by == null ? "" : by;
+        RolloverRepository.Last last = rollovers.last(id);
+        if (last == null) {
+            throw new InvalidPeriodException("There is no rollover to undo");
+        }
+        if (!Role.STEWARD.equals(roles.roleOf(id, user)) || !last.by().equals(user)) {
+            throw new PeriodPermissionException("Only the steward who rolled the year over can undo it");
+        }
+        if (!last.on().equals(sheets.today(id))) {
+            throw new InvalidPeriodException("A rollover can be undone only on the day it was made");
+        }
+        List<Period> made = last.periods().stream().map((name) -> periods.find(id, name))
+                .filter((p) -> p != null).toList();
+        for (Claim c : claims.list(id)) {
+            if (made.stream().anyMatch((p) -> p.contains(c.getDueBy()))) {
+                throw new InvalidPeriodException("A claim belongs to a period the rollover made");
+            }
+        }
+
+        sheets.open(id, user);
+        for (RolloverRepository.Opening o : rollovers.openings(id)) {
+            periods.takeOpening(id, o.period(), o.personId(), o.amount(), o.created());
+        }
+        for (Period p : made) {
+            periods.remove(id, p.name());
+        }
+        rollovers.forget(id);
+        audit.record("ROLLOVER_UNDONE sheet=" + id + " by=" + user + " fy=" + last.fy());
+        result.set(new GeneratePeriodsResult(made.size()));
+    }
+}
diff --git a/src/main/resources/db/migration/V98__sheet_rollover.sql b/src/main/resources/db/migration/V98__sheet_rollover.sql
new file mode 100644
index 000000000..436eba5c4
--- /dev/null
+++ b/src/main/resources/db/migration/V98__sheet_rollover.sql
@@ -0,0 +1,21 @@
+-- A sheet's last rollover, kept so its steward can undo it on the same sheet-today: the fiscal year rolled
+-- over, who made it and on which sheet-today, and the periods it generated (names, comma separated). A later
+-- rollover replaces it; undoing it removes it.
+CREATE TABLE sheet_rollover (
+    sheet_id VARCHAR(200)  NOT NULL PRIMARY KEY,
+    fy       VARCHAR(10)   NOT NULL,
+    made_by  VARCHAR(255)  NOT NULL,
+    made_on  DATE          NOT NULL,
+    periods  VARCHAR(4000) NOT NULL
+);
+
+-- Each opening balance the sheet's last rollover set: the amount it added to the person's opening balance
+-- for the period, and whether that opening balance was new (made by the rollover).
+CREATE TABLE sheet_rollover_opening (
+    sheet_id  VARCHAR(200)   NOT NULL,
+    period    VARCHAR(200)   NOT NULL,
+    person_id BIGINT         NOT NULL,
+    amount    DECIMAL(19, 2) NOT NULL,
+    created   BOOLEAN        NOT NULL,
+    PRIMARY KEY (sheet_id, period, person_id)
+);
