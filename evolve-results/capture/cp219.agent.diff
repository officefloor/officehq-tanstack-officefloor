@@ -0,0 +1,21 @@
+# POST /api/sheets/{sheetId}/rollover/undo — undo the sheet's last rollover: removes the periods it generated and takes
+# back the opening balances it set, then records ROLLOVER_UNDONE fy=FY<old year>. Refused (400) when there is none to
+# undo, on a later sheet-today than it was made, for anyone but the steward who made it, and when a claim's due-by now
+# falls in one of the periods it generated. Responds { "undone": true }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.rollover.ApplyRolloverUndo
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rollover.RespondWithRolloverUndone
+  govern: [ transaction ]
