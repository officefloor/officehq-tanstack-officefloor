@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/periods/rollover-undo — undo the sheet's last rollover: remove the periods it generated
+# and take back the opening balances it set, then ROLLOVER_UNDONE. Anyone but the steward who made it, a sheet-today
+# other than the one it was made on, a rollover already undone (or none), or a generated period that a claim (whatever
+# its status) now belongs to is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidateRolloverUndo
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.period.UndoRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithRolloverUndone
