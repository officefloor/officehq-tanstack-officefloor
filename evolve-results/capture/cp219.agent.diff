+# Undo the sheet's last rollover: remove the periods it generated and take back the opening balances
+# it set. Only the steward who made it, on the same sheet-today; a generated period a claim belongs to
+# is refused. A refusal is a 400 and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.period.UndoRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
