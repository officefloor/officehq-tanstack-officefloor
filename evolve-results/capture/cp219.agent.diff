+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rollover-undo.POST.yml
@@ -0,0 +1,13 @@
+# Undo the sheet's last rollover. Validate first so anyone but the steward who made it, a later day,
+# or a generated period a claim belongs to is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidateRolloverUndo
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.period.UndoRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithRolloverUndone
+  govern: [ transaction ]
