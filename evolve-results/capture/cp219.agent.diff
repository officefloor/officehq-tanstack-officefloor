diff --git a/src/main/java/net/officefloor/hq/app/period/Rollovers.java b/src/main/java/net/officefloor/hq/app/period/Rollovers.java
new file mode 100644
index 00000000..63662289
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/Rollovers.java
@@ -0,0 +1,75 @@
+package net.officefloor.hq.app.period;
+
+import java.sql.PreparedStatement;
+import java.sql.Statement;
+import java.time.LocalDate;
+import java.util.Arrays;
+import java.util.List;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.support.GeneratedKeyHolder;
+import org.springframework.jdbc.support.KeyHolder;
+import org.springframework.stereotype.Repository;
+
+/** The rollover store: each year end rollover on a sheet, so the last one can be undone. */
+@Repository
+public class Rollovers {
+
+    /** A rollover as made: its id, who made it on which of the sheet's todays, the old fiscal year (FY<yyyy>), the
+     *  periods it generated, and whether it has been undone. */
+    public record Rollover(long id, String user, LocalDate madeOn, String fiscalYear, List<String> periods,
+            boolean undone) {
+    }
+
+    private final JdbcTemplate jdbc;
+
+    public Rollovers(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** Records a rollover of the fiscal year by the user, made on the sheet's today: its id. */
+    public long start(String sheetId, String user, String fiscalYear) {
+        KeyHolder key = new GeneratedKeyHolder();
+        jdbc.update(connection -> {
+            PreparedStatement insert = connection.prepareStatement("INSERT INTO rollover (sheet_id, made_by, made_on,"
+                    + " fiscal_year) VALUES (?, ?, (SELECT today FROM sheet WHERE id = ?), ?)",
+                    Statement.RETURN_GENERATED_KEYS);
+            insert.setString(1, sheetId);
+            insert.setString(2, user);
+            insert.setString(3, sheetId);
+            insert.setString(4, fiscalYear);
+            return insert;
+        }, key);
+        return key.getKey().longValue();
+    }
+
+    /** Whether a rollover of the fiscal year made before the given one still stands (was not undone). */
+    public boolean standsBefore(String sheetId, String fiscalYear, long id) {
+        Integer standing = jdbc.queryForObject("SELECT COUNT(*) FROM rollover WHERE sheet_id = ? AND fiscal_year = ?"
+                + " AND id < ? AND NOT undone", Integer.class, sheetId, fiscalYear, id);
+        return standing != null && standing > 0;
+    }
+
+    /** Records the names of the periods the rollover generated. */
+    public void generated(long id, List<String> periods) {
+        jdbc.update("UPDATE rollover SET periods = ? WHERE id = ?", String.join(",", periods), id);
+    }
+
+    /** The sheet's last rollover, its sheet's row locked until the transaction ends (so it is undone at most
+     *  once); null when the sheet has none. */
+    public Rollover last(String sheetId) {
+        jdbc.query("SELECT id FROM sheet WHERE id = ? FOR UPDATE", (rs, i) -> rs.getString(1), sheetId);
+        List<Rollover> found = jdbc.query("SELECT * FROM rollover WHERE sheet_id = ? ORDER BY id DESC LIMIT 1",
+                (rs, i) -> {
+                    String periods = rs.getString("periods");
+                    return new Rollover(rs.getLong("id"), rs.getString("made_by"), rs.getDate("made_on").toLocalDate(),
+                            rs.getString("fiscal_year"), periods.isEmpty() ? List.of() : Arrays.asList(periods.split(",")),
+                            rs.getBoolean("undone"));
+                }, sheetId);
+        return found.isEmpty() ? null : found.get(0);
+    }
+
+    /** Marks the rollover undone. */
+    public void undone(long id) {
+        jdbc.update("UPDATE rollover SET undone = TRUE WHERE id = ?", id);
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/period/UndoRollover.java b/src/main/java/net/officefloor/hq/app/period/UndoRollover.java
new file mode 100644
index 00000000..4d731882
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/UndoRollover.java
@@ -0,0 +1,57 @@
+package net.officefloor.hq.app.period;
+
+import java.sql.Date;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.opening.Openings;
+import net.officefloor.hq.app.setting.Settings;
+import net.officefloor.hq.app.setting.ViewerRefusedException;
+import net.officefloor.hq.app.sheet.Sheets;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/**
+ * Undoes the sheet's last rollover: by the steward who made it, on the sheet's today it was made, and only while no
+ * claim (of any status) belongs to a period it generated. The periods it generated are removed and the openings it
+ * set taken back, then ROLLOVER_UNDONE with the old fiscal year.
+ */
+public class UndoRollover {
+    public void undo(@PathVariable("sheetId") String sheetId, @RequestBody RolloverUndoRequest request,
+            Rollovers rollovers, Periods periods, Openings openings, Settings settings, Sheets sheets,
+            JdbcTemplate jdbc, Audit audit, ObjectResponse<GenerateResponse> response)
+            throws InvalidPeriodException, ViewerRefusedException {
+        String user = request.user();
+        settings.refuseViewer(sheetId, user);
+        if (!Settings.STEWARD.equals(settings.role(sheetId, user))) {
+            throw new InvalidPeriodException("Only a steward may undo a rollover");
+        }
+        Rollovers.Rollover last = rollovers.last(sheetId);
+        if (last == null || last.undone()) {
+            throw new InvalidPeriodException("There is no rollover to undo");
+        }
+        if (!last.user().equals(user)) {
+            throw new InvalidPeriodException("Only the steward who rolled the year over may undo it");
+        }
+        if (!last.madeOn().equals(sheets.today(sheetId))) {
+            throw new InvalidPeriodException("A rollover can be undone only on the day it was made");
+        }
+        for (String name : last.periods()) {
+            PeriodResponse period = periods.lock(sheetId, name);
+            if (period == null) {
+                continue;
+            }
+            Integer claimed = jdbc.queryForObject(
+                    "SELECT COUNT(*) FROM claim WHERE sheet_id = ? AND claim_date >= ? AND claim_date <= ?", Integer.class,
+                    sheetId, Date.valueOf(period.from()), Date.valueOf(period.to()));
+            if (claimed != null && claimed > 0) {
+                throw new InvalidPeriodException("A claim belongs to period " + name + " the rollover generated");
+            }
+        }
+        last.periods().forEach(name -> periods.remove(sheetId, name));
+        openings.removeByRollover(sheetId, last.id());
+        rollovers.undone(last.id());
+        audit.recordOnCommit("ROLLOVER_UNDONE sheet=" + sheetId + " by=" + user + " fy=" + last.fiscalYear());
+        response.send(new GenerateResponse(last.periods().size(), periods.list(sheetId)));
+    }
+}
diff --git a/src/main/resources/db/migration/V114__rollover.sql b/src/main/resources/db/migration/V114__rollover.sql
