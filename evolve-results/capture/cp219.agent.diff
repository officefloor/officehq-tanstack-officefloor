diff --git a/src/main/java/net/officefloor/hq/app/period/RolloverRepository.java b/src/main/java/net/officefloor/hq/app/period/RolloverRepository.java
new file mode 100644
index 000000000..6a5ab2cd2
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/RolloverRepository.java
@@ -0,0 +1,71 @@
+package net.officefloor.hq.app.period;
+
+import java.sql.PreparedStatement;
+import java.sql.Statement;
+import java.time.LocalDate;
+import java.util.List;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.support.GeneratedKeyHolder;
+import org.springframework.stereotype.Repository;
+
+/** The rollovers store: each rollover made on a sheet, with what it generated and set. */
+@Repository
+public class RolloverRepository {
+
+    private final JdbcTemplate jdbc;
+
+    public RolloverRepository(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** Keep a rollover made now, with the periods it generated and the openings it added. */
+    public void insert(String sheetId, String fy, String by, LocalDate on, List<String> periods,
+            List<Rollover.Opening> openings) {
+        GeneratedKeyHolder key = new GeneratedKeyHolder();
+        jdbc.update((c) -> {
+            PreparedStatement ps = c.prepareStatement("INSERT INTO rollover (sheet_id, fy, made_by, made_on)"
+                    + " VALUES (?, ?, ?, ?)", Statement.RETURN_GENERATED_KEYS);
+            ps.setString(1, sheetId);
+            ps.setString(2, fy);
+            ps.setString(3, by);
+            ps.setObject(4, on);
+            return ps;
+        }, key);
+        long id = key.getKey().longValue();
+        for (String name : periods) {
+            jdbc.update("INSERT INTO rollover_period (rollover_id, period_name) VALUES (?, ?)", id, name);
+        }
+        for (Rollover.Opening o : openings) {
+            jdbc.update("INSERT INTO rollover_opening (rollover_id, period_name, person_id, amount) VALUES (?, ?, ?, ?)",
+                    id, o.periodName(), o.personId(), o.amount());
+        }
+    }
+
+    /** Whether a rollover of the fiscal year stands on the sheet: made, and not undone. */
+    public boolean stands(String sheetId, String fy) {
+        Integer n = jdbc.queryForObject("SELECT COUNT(*) FROM rollover WHERE sheet_id = ? AND fy = ? AND NOT undone",
+                Integer.class, sheetId, fy);
+        return n != null && n > 0;
+    }
+
+    /** The sheet's last rollover, or null when none was ever made. */
+    public Rollover last(String sheetId) {
+        List<Rollover> found = jdbc.query("SELECT id, sheet_id, fy, made_by, made_on, undone FROM rollover"
+                + " WHERE sheet_id = ? ORDER BY id DESC LIMIT 1", (rs, n) -> {
+                    long id = rs.getLong("id");
+                    return new Rollover(id, rs.getString("sheet_id"), rs.getString("fy"), rs.getString("made_by"),
+                            rs.getObject("made_on", LocalDate.class), rs.getBoolean("undone"),
+                            jdbc.queryForList("SELECT period_name FROM rollover_period WHERE rollover_id = ?",
+                                    String.class, id),
+                            jdbc.query("SELECT period_name, person_id, amount FROM rollover_opening WHERE rollover_id = ?",
+                                    (o, m) -> new Rollover.Opening(o.getString("period_name"), o.getLong("person_id"),
+                                            o.getBigDecimal("amount")), id));
+                }, sheetId);
+        return found.isEmpty() ? null : found.get(0);
+    }
+
+    /** Mark the rollover undone: false when it already was, as when another request undid it first. */
+    public boolean markUndone(Rollover rollover) {
+        return jdbc.update("UPDATE rollover SET undone = TRUE WHERE id = ? AND NOT undone", rollover.id()) == 1;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/period/UndoRollover.java b/src/main/java/net/officefloor/hq/app/period/UndoRollover.java
new file mode 100644
index 000000000..b8aae95a4
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/UndoRollover.java
@@ -0,0 +1,55 @@
+package net.officefloor.hq.app.period;
+
+import jakarta.servlet.http.HttpServletRequest;
+import java.util.List;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.claim.Claim;
+import net.officefloor.hq.app.claim.ClaimRepository;
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.hq.app.role.StewardOnlyException;
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+
+/**
+ * Undoes the sheet's last rollover: the periods it generated are removed and the opening balances it
+ * added are taken back; ROLLOVER_UNDONE with its old year. Only the steward who made it may, on the
+ * same sheet-today it was made. Refused when there is no rollover, it is already undone, or a claim
+ * (in any status, voided too) belongs to a period it generated, by its date or its due-by.
+ */
+public class UndoRollover {
+    public void undo(@Val Sheet sheet, PeriodRepository periods, RolloverRepository rollovers, ClaimRepository claims,
+            RoleRepository roles, HttpServletRequest request, Audit audit, Out<GeneratePeriodsResponse> result)
+            throws StewardOnlyException, InvalidPeriodException {
+        String user = Audit.user(request);
+        if (!Role.STEWARD.equals(roles.roleOf(sheet.id(), user))) {
+            throw new StewardOnlyException("Only a steward may undo a rollover");
+        }
+        Rollover last = rollovers.last(sheet.id());
+        if (last == null || last.undone()) throw new InvalidPeriodException("There is no rollover to undo");
+        if (!last.madeBy().equals(user)) {
+            throw new InvalidPeriodException("Only " + last.madeBy() + " may undo their rollover");
+        }
+        if (!last.madeOn().equals(sheet.today())) {
+            throw new InvalidPeriodException("A rollover is undone only on the day it was made");
+        }
+        List<Period> generated = periods.findAll(sheet.id()).stream()
+                .filter((p) -> last.periods().contains(p.name())).toList();
+        for (Claim claim : claims.findAll(sheet.id())) {
+            for (Period p : generated) {
+                if ((claim.getDate() != null && p.contains(claim.getDate()))
+                        || (claim.getDueBy() != null && p.contains(claim.getDueBy()))) {
+                    throw new InvalidPeriodException("A claim belongs to period " + p.name());
+                }
+            }
+        }
+        if (!rollovers.markUndone(last)) throw new InvalidPeriodException("The rollover is already undone");
+        for (Rollover.Opening o : last.openings()) {
+            periods.subtractOpening(sheet.id(), o.periodName(), o.personId(), o.amount());
+        }
+        for (Period p : generated) periods.delete(sheet.id(), p.name());
+        audit.record("ROLLOVER_UNDONE sheet=" + sheet.id() + " by=" + user + " fy=" + last.fy());
+        result.set(new GeneratePeriodsResponse(generated.size()));
+    }
+}
diff --git a/src/main/resources/db/migration/V120__rollover.sql b/src/main/resources/db/migration/V120__rollover.sql
new file mode 100644
index 000000000..d330ff9a4
--- /dev/null
+++ b/src/main/resources/db/migration/V120__rollover.sql
@@ -0,0 +1,22 @@
+-- Each fiscal-year rollover made on a sheet: the old year, who made it and the sheet's today then,
+-- and whether it has been undone. The last one (highest id) is the one an undo takes back.
+CREATE TABLE rollover (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    fy VARCHAR(20) NOT NULL,
+    made_by VARCHAR(200) NOT NULL,
+    made_on DATE NOT NULL,
+    undone BOOLEAN DEFAULT FALSE NOT NULL
+);
+-- The periods a rollover generated.
+CREATE TABLE rollover_period (
+    rollover_id BIGINT NOT NULL REFERENCES rollover(id),
+    period_name VARCHAR(200) NOT NULL
+);
+-- The opening balances a rollover added: the amount added to the person's opening for the period.
+CREATE TABLE rollover_opening (
+    rollover_id BIGINT NOT NULL REFERENCES rollover(id),
+    period_name VARCHAR(200) NOT NULL,
+    person_id BIGINT NOT NULL,
+    amount DECIMAL(19, 2) NOT NULL
+);
