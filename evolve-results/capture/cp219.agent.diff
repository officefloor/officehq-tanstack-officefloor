+++ b/src/main/java/net/officefloor/hq/app/rollover/CheckRolloverUndo.java
@@ -0,0 +1,51 @@
+package net.officefloor.hq.app.rollover;
+
+import java.util.Objects;
+import java.util.Set;
+import java.util.stream.Collectors;
+import net.officefloor.hq.app.claim.ClaimRepository;
+import net.officefloor.hq.app.period.InvalidPeriodException;
+import net.officefloor.hq.app.period.Period;
+import net.officefloor.hq.app.period.PeriodRepository;
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.hq.app.sheet.SheetRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** Refuse an undo unless the sheet's last rollover is not yet undone, was made on the sheet's today by the same user
+ *  (still a steward), and none of the periods it generated has a claim (of any status) dated or due in it; otherwise
+ *  publish the rollover to undo. */
+public class CheckRolloverUndo {
+    public void check(@PathVariable("sheetId") String sheetId, @Val RolloverUndoInput input,
+            RolloverRepository rollovers, PeriodRepository periods, ClaimRepository claims, RoleRepository roles,
+            SheetRepository sheets, Out<RolloverRepository.Rollover> undo) throws InvalidPeriodException {
+        String id = sheetId.trim();
+        periods.lockSheet(id);
+        if (!Role.STEWARD.equals(roles.of(id, input.user()))) {
+            throw new InvalidPeriodException("Only a steward may undo a rollover on this sheet.");
+        }
+        RolloverRepository.Rollover last = rollovers.last(id);
+        if (last == null || last.undone()) {
+            throw new InvalidPeriodException("There is no rollover to undo on this sheet.");
+        }
+        if (!last.madeBy().equals(input.user())) {
+            throw new InvalidPeriodException("Only " + last.madeBy() + ", who made the last rollover, may undo it.");
+        }
+        if (!Objects.equals(last.madeOn(), sheets.today(id))) {
+            throw new InvalidPeriodException("The last rollover can only be undone on the day it was made.");
+        }
+        Set<String> names = Set.copyOf(last.periodNames());
+        var generated = periods.list(id).stream().filter(p -> names.contains(p.name())).toList();
+        Set<String> taken = claims.list(id).stream()
+                .flatMap(c -> generated.stream().filter(p -> p.contains(c.date())
+                        || (c.dueBy() != null && p.contains(c.dueBy()))))
+                .map(Period::name).collect(Collectors.toCollection(java.util.TreeSet::new));
+        if (!taken.isEmpty()) {
+            throw new InvalidPeriodException("A claim now belongs to " + String.join(", ", taken)
+                    + ", which the rollover generated.");
+        }
+        undo.set(last);
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/rollover/RolloverRepository.java b/src/main/java/net/officefloor/hq/app/rollover/RolloverRepository.java
new file mode 100644
index 00000000..946b2161
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rollover/RolloverRepository.java
@@ -0,0 +1,65 @@
+package net.officefloor.hq.app.rollover;
+
+import java.time.LocalDate;
+import java.util.List;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.support.GeneratedKeyHolder;
+import org.springframework.stereotype.Repository;
+
+/** The rollovers made on each sheet, with the periods each generated and the opening balances each set. */
+@Repository
+public class RolloverRepository {
+
+    /** A rollover kept on a sheet. */
+    public record Rollover(long id, String sheetId, String fy, String madeBy, LocalDate madeOn, boolean undone,
+            List<String> periodNames, List<Long> openingIds) {
+    }
+
+    private final JdbcTemplate jdbc;
+
+    public RolloverRepository(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** Keep a rollover just made. */
+    public void insert(String sheetId, String fy, String madeBy, LocalDate madeOn, List<String> periodNames,
+            List<Long> openingIds) {
+        var keys = new GeneratedKeyHolder();
+        jdbc.update(con -> {
+            var ps = con.prepareStatement("INSERT INTO rollover (sheet_id, fy, made_by, made_on) VALUES (?, ?, ?, ?)",
+                    new String[] { "id" });
+            ps.setString(1, sheetId);
+            ps.setString(2, fy);
+            ps.setString(3, madeBy);
+            ps.setObject(4, madeOn);
+            return ps;
+        }, keys);
+        long id = keys.getKey().longValue();
+        periodNames.forEach(name -> jdbc.update("INSERT INTO rollover_period (rollover_id, period_name) VALUES (?, ?)",
+                id, name));
+        openingIds.forEach(openingId -> jdbc.update(
+                "INSERT INTO rollover_opening (rollover_id, opening_id) VALUES (?, ?)", id, openingId));
+    }
+
+    /** Whether the old fiscal year has been rolled over on the sheet and that rollover has not been undone. */
+    public boolean standing(String sheetId, String fy) {
+        return jdbc.queryForObject("SELECT COUNT(*) FROM rollover WHERE sheet_id = ? AND fy = ? AND NOT undone",
+                Integer.class, sheetId, fy) > 0;
+    }
+
+    /** The last rollover made on the sheet (undone or not), or null when none was. */
+    public Rollover last(String sheetId) {
+        return jdbc.query("SELECT * FROM rollover WHERE sheet_id = ? ORDER BY id DESC LIMIT 1", (rs, i) -> {
+            long id = rs.getLong("id");
+            return new Rollover(id, rs.getString("sheet_id"), rs.getString("fy"), rs.getString("made_by"),
+                    rs.getObject("made_on", LocalDate.class), rs.getBoolean("undone"),
+                    jdbc.queryForList("SELECT period_name FROM rollover_period WHERE rollover_id = ?", String.class, id),
+                    jdbc.queryForList("SELECT opening_id FROM rollover_opening WHERE rollover_id = ?", Long.class, id));
+        }, sheetId).stream().findFirst().orElse(null);
+    }
+
+    /** Mark the rollover undone: false when it already was, and nothing is written. */
+    public boolean markUndone(long id) {
+        return jdbc.update("UPDATE rollover SET undone = TRUE WHERE id = ? AND NOT undone", id) == 1;
+    }
+}
