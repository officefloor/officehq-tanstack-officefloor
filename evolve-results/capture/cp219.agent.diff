+# POST /api/sheets/{sheetId}/periods/rollover-undo — undo the sheet's last rollover. Only the steward who made it, on
+# the sheet-today it was made, once, and only while no claim belongs to a period it generated (409 otherwise; nothing
+# is stored when refused). Removes the periods it generated, takes back the opening balances it set, then records
+# ROLLOVER_UNDONE fy=FY<yyyy>. Responds {"fy":"FY<yyyy>","removed":n}.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: undo
+  govern: [ transaction ]
+undo:
+  class: net.officefloor.hq.app.period.UndoRollover
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.period.RespondWithRolloverUndone
+  govern: [ transaction ]
