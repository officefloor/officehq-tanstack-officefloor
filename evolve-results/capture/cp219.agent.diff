+# POST /api/sheets/{sheetId}/periods/rollover-undo — undo the sheet's last rollover (body: {user}). Only the steward
+# who made it, on the sheet-today it was made, while no claim (not deleted) is dated in a period it generated;
+# otherwise refused (400) and nothing is stored. Removes the periods it generated, takes back the opening balances
+# it set, and records ROLLOVER_UNDONE. Answers {fy, removed}.
+validate:
+  class: net.officefloor.hq.app.period.ValidateRolloverUndo
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.period.LoadRolloverUndo
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.period.UndoRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithRolloverUndone
+  govern: [ transaction ]
