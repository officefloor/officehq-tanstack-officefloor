+# Undo the sheet's last year end rollover: removes the periods it generated and takes back the opening balances it set.
+# Refuses anyone but the steward who made it, a sheet-today other than the one it was made on, no rollover to undo, or
+# a generated period a claim belongs to. Responds with the sheet's periods.
+undo:
+  class: net.officefloor.hq.app.period.UndoRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriods
