+# Undo the sheet's last rollover (the steward who made it, on the sheet-day it was made): takes back the opening
+# balances it set, removes the periods it generated, then writes ROLLOVER_UNDONE fy=<old FY>. Refused (nothing
+# written) when there is none left to undo, it was made on an earlier day or by someone else, or a claim now belongs
+# to (is dated or due in) a period it generated.
+validate:
+  class: net.officefloor.hq.app.rollover.ValidateRolloverUndo
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.rollover.CheckRolloverUndo
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.rollover.UndoRollover
+  govern: [ transaction ]
