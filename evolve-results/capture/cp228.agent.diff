diff --git a/src/main/resources/db/migration/V122__crew_member_removed.sql b/src/main/resources/db/migration/V122__crew_member_removed.sql
new file mode 100644
index 000000000..fe7241912
--- /dev/null
+++ b/src/main/resources/db/migration/V122__crew_member_removed.sql
@@ -0,0 +1,9 @@
+-- Crew memberships a merge took away: the member row as it stood (its id keeps its place in the crew's
+-- order) and the sheet's today when it was taken away, so the crews can still be read as of an earlier date.
+CREATE TABLE crew_member_removed (
+    id BIGINT NOT NULL,
+    crew_id BIGINT NOT NULL REFERENCES crew(id),
+    person_id BIGINT NOT NULL REFERENCES person(id),
+    added_on DATE,
+    removed_on DATE
+);
