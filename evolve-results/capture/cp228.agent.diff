 # sheet (one whose from-date falls in it). Generates FY<yyyy+1>'s twelve periods exactly as the fiscal year generator
 # does (PERIOD_ADDED each), then adds each person's open figure at the end of the old year's last period to their
-# carried figure for the new year's first period (OPENING_SET each), then writes ROLLOVER fy=FY<yyyy> periods=<made>.
+# carried figure for the new year's first period (OPENING_SET each), then writes ROLLOVER fy=FY<yyyy> periods=<made>,
+# then soft-closes each old-year period still open, in start-date order, as a soft close does (PERIOD_SOFT_CLOSED each).
 # A refused rollover (no signed-in user, bad year, not a steward, a year with no periods) writes nothing.
 validate:
   class: net.officefloor.hq.app.rollover.ValidateRollover
@@ -25,6 +26,10 @@ audit:
 carry:
