@@ -1,10 +1,22 @@
 package net.officefloor.hq.app.claim;
 
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.hq.app.rate.RateRepository;
 import net.officefloor.plugin.variable.Val;
 
-/** Moves the claim to SETTLED, refusing it when its status does not allow that. */
+/** Moves the claim to SETTLED, refusing it when its status does not allow that, and fixes its due at the
+ *  rate its person's grade has now: amount × rate / 100, rounded half up (none when the grade has no rate). */
 public class SettleClaim {
-    public void apply(@Val Claim claim) throws InvalidClaimStatusException {
+    public void apply(@Val Claim claim, PersonRepository people, RateRepository rates)
+            throws InvalidClaimStatusException {
         ClaimTransition.to(claim, ClaimStatus.SETTLED);
+        Person person = people.findById(claim.getPersonId()).orElseThrow();
+        claim.setSettledDue(rates.findBySheetIdAndGrade(claim.getSheetId(), person.getGrade())
+                .map((r) -> claim.getAmount().multiply(r.getRate())
+                        .divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP))
+                .orElse(null));
     }
 }
diff --git a/src/main/resources/db/migration/V9__claim_settled_due.sql b/src/main/resources/db/migration/V9__claim_settled_due.sql
new file mode 100644
index 0000000..d09b573
--- /dev/null
+++ b/src/main/resources/db/migration/V9__claim_settled_due.sql
@@ -0,0 +1,9 @@
+-- A settled claim's due, fixed when it is settled: amount × its person's grade rate / 100, rounded half
+-- up to two decimals. Later rate changes do not alter it. None while DRAFT or OPEN (their due is live),
+-- nor when the grade had no rate at settling. Claims already settled take it from today's rates.
+ALTER TABLE claim ADD COLUMN settled_due DECIMAL(14, 2);
+UPDATE claim c SET settled_due = (
+    SELECT ROUND(c.amount * r.rate / 100, 2)
+    FROM person p JOIN rate r ON r.sheet_id = p.sheet_id AND r.grade = p.grade
+    WHERE p.id = c.person_id)
+WHERE c.status = 'SETTLED';
