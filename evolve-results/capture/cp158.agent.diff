diff --git a/src/main/frontend/features/columns/columns.slot.tsx b/src/main/frontend/features/columns/columns.slot.tsx
new file mode 100644
index 00000000..df0a20e9
--- /dev/null
+++ b/src/main/frontend/features/columns/columns.slot.tsx
@@ -0,0 +1,33 @@
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { COLUMNS, setColumnShown, useColumnShown, type Column } from './useColumns';
+
+function ColumnBox({ user, column }: { user: string; column: Column }) {
+  const shown = useColumnShown(user, column);
+  return (
+    <label>
+      <input
+        type="checkbox"
+        data-testid={`column-${column}`}
+        checked={shown}
+        onChange={(e) => setColumnShown(user, column, e.target.checked)}
+      />{' '}
+      {column}
+    </label>
+  );
+}
+
+/** The column chooser: a checkbox per switchable column of the people list, for this user's screen. */
+function ColumnChooser({ user }: { user: string; sheet: string }) {
+  return (
+    <section>
+      <h3>Columns</h3>
+      {COLUMNS.map((c) => (
+        <span key={c}>
+          <ColumnBox user={user} column={c} />{' '}
+        </span>
+      ))}
+    </section>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: 9.5, Component: ColumnChooser });
diff --git a/src/main/frontend/features/columns/useColumns.tsx b/src/main/frontend/features/columns/useColumns.tsx
new file mode 100644
index 00000000..7ce0b3c2
--- /dev/null
+++ b/src/main/frontend/features/columns/useColumns.tsx
@@ -0,0 +1,71 @@
+import { useSyncExternalStore } from 'react';
+import type { ReactNode } from 'react';
+
+/** The people list's columns a user can switch off, in the order the chooser lists them. */
+export const COLUMNS = [
+  'claimed',
+  'due-total',
+  'excess',
+  'statement-count',
+  'stated-total',
+  'statement-date',
+  'overdue-count',
+  'overdue-total',
+  'patrons',
+  'backing',
+  'hold',
+  'retired',
+  'terms',
+  'contact',
+  'aliases',
+] as const;
+export type Column = (typeof COLUMNS)[number];
+
+// Which columns each user has switched off. It belongs to the user's screen, not to the sheet:
+// kept in this browser (per user), so loading a sheet leaves it as it is, and nothing is stored.
+const hidden = new Map<string, Set<string>>();
+const listeners = new Set<() => void>();
+const storageKey = (user: string) => `columns-off:${user}`;
+
+function offFor(user: string): Set<string> {
+  let off = hidden.get(user);
+  if (off === undefined) {
+    try {
+      off = new Set<string>(JSON.parse(localStorage.getItem(storageKey(user)) ?? '[]'));
+    } catch {
+      off = new Set<string>();
+    }
+    hidden.set(user, off);
+  }
+  return off;
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function setColumnShown(user: string, column: Column, shown: boolean): void {
+  const off = new Set(offFor(user));
+  if (shown) off.delete(column);
+  else off.add(column);
+  hidden.set(user, off);
+  try {
+    localStorage.setItem(storageKey(user), JSON.stringify([...off]));
+  } catch {
+    /* not kept past this page; still applies now */
+  }
+  listeners.forEach((l) => l());
+}
+
+/** Whether `user`'s screen shows `column` of the people list. */
+export function useColumnShown(user: string, column: Column): boolean {
+  return useSyncExternalStore(subscribe, () => !offFor(user).has(column));
+}
+
+/** Renders its header or cell only while `user`'s screen shows `column`. */
+export function Col({ user, id, children }: { user: string; id: Column; children: ReactNode }) {
+  return useColumnShown(user, id) ? <>{children}</> : null;
+}
