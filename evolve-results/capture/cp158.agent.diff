diff --git a/src/main/frontend/features/columns/chooser.slot.tsx b/src/main/frontend/features/columns/chooser.slot.tsx
new file mode 100644
index 000000000..15c560e86
--- /dev/null
+++ b/src/main/frontend/features/columns/chooser.slot.tsx
@@ -0,0 +1,25 @@
+import { HomeMain } from '../../slots/defs/homeMain';
+import { COLUMNS, useHiddenColumns } from './columns';
+
+// A checkbox per column of the people list: unticked, this screen shows no cell for it.
+function ColumnChooser() {
+  const [hidden, setHidden] = useHiddenColumns();
+  return (
+    <fieldset>
+      <legend>Columns</legend>
+      {COLUMNS.map((c) => (
+        <label key={c}>
+          <input
+            type="checkbox"
+            data-testid={`column-${c}`}
+            checked={!hidden.includes(c)}
+            onChange={(e) => setHidden(e.target.checked ? hidden.filter((h) => h !== c) : [...hidden, c])}
+          />
+          {c}{' '}
+        </label>
+      ))}
+    </fieldset>
+  );
+}
+
+export const contribution = HomeMain.fill({ order: 19.9, Component: ColumnChooser });
diff --git a/src/main/frontend/features/columns/columns.ts b/src/main/frontend/features/columns/columns.ts
new file mode 100644
index 000000000..4c788be2a
--- /dev/null
+++ b/src/main/frontend/features/columns/columns.ts
@@ -0,0 +1,35 @@
+import { asString, useSearchParam } from '../../url/useSearchParam';
+
+/** The people-list columns this screen can switch off, in the order its chooser shows them. */
+export const COLUMNS = [
+  'claimed',
+  'due-total',
+  'excess',
+  'statement-count',
+  'stated-total',
+  'statement-date',
+  'overdue-count',
+  'overdue-total',
+  'patrons',
+  'backing',
+  'hold',
+  'retired',
+  'terms',
+  'contact',
+  'aliases',
+] as const;
+export type Column = (typeof COLUMNS)[number];
+
+/** The columns this screen has switched off (`hiddenColumns`, comma-separated). It belongs to the screen:
+ *  other users' screens, the totals and every other figure are unaffected. */
+export function useHiddenColumns(): [Column[], (value: Column[]) => void] {
+  const [raw, setRaw] = useSearchParam('hiddenColumns', asString);
+  const hidden = raw.split(',').filter((c): c is Column => (COLUMNS as readonly string[]).includes(c));
+  return [hidden, (v) => setRaw(COLUMNS.filter((c) => v.includes(c)).join(',') || undefined)];
+}
+
+/** Whether this screen shows the column; a column switched off has no cell at all. */
+export function useColumnShown(): (column: Column) => boolean {
+  const [hidden] = useHiddenColumns();
+  return (column) => !hidden.includes(column);
+}
