+# The signed-in user switches one people-list column on or off. It changes no sheet, so it is open
+# while viewing as of a date and to a viewer, and writes no audit line. Validate first so a bad
+# value is a 400.
+validate:
+  class: net.officefloor.hq.app.columns.ValidateColumn
+  next: save
+save:
+  class: net.officefloor.hq.app.columns.SaveColumn
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.columns.RespondWithColumns
+  govern: [ transaction ]
