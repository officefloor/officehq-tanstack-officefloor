+# PUT /api/users/{user}/columns/{column}?sheet=<id> — the user switches a column of the people list
+# on or off ({"shown": true | false}), for their own screen on the sheet. Not audited.
+validate:
+  class: net.officefloor.hq.app.user.ValidateColumn
+  next: save
+save:
+  class: net.officefloor.hq.app.user.SaveColumn
+  govern: [ transaction ]
