+# A steward rejects a PENDING claim with a reason: it goes back to OPEN. A missing reason is refused (400),
+# any other status (409) and a user who is not a steward (403); none writes anything.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRejection
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: check
+# A claim dated inside a closed period is refused (409) and writes nothing.
+check:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.RejectClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimRejected
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
