+-- The rest of the sheet kept in history too, so the whole screen can be shown as of a date (see V39 and AsOf):
+-- the sheet itself, statements, periods and their fixed figures, claim logs, patrons, watches, delegations and roles.
+-- A column added to one of these tables must be added to its history too.
+CREATE TABLE sheet_history AS SELECT * FROM sheet;
+CREATE TABLE statement_history AS SELECT * FROM statement;
+CREATE TABLE period_history AS SELECT * FROM period;
+CREATE TABLE period_person_total_history AS SELECT * FROM period_person_total;
+CREATE TABLE claim_log_history AS SELECT * FROM claim_log;
+CREATE TABLE person_patron_history AS SELECT * FROM person_patron;
+CREATE TABLE person_watch_history AS SELECT * FROM person_watch;
+CREATE TABLE delegation_history AS SELECT * FROM delegation;
+CREATE TABLE sheet_role_history AS SELECT * FROM sheet_role;
+
+ALTER TABLE sheet_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE sheet_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE sheet_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE statement_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE statement_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE statement_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE period_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE period_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE period_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE period_person_total_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE period_person_total_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE period_person_total_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE claim_log_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE claim_log_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE claim_log_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE person_patron_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE person_patron_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE person_patron_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE person_watch_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE person_watch_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE person_watch_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE delegation_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE delegation_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE delegation_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+ALTER TABLE sheet_role_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE sheet_role_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE sheet_role_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+
+CREATE INDEX sheet_history_key ON sheet_history (id);
+CREATE INDEX statement_history_key ON statement_history (sheet_id, person_id, id);
+CREATE INDEX period_history_key ON period_history (sheet_id, name);
+CREATE INDEX period_person_total_history_key ON period_person_total_history (sheet_id, period_name, person_id);
+CREATE INDEX claim_log_history_key ON claim_log_history (sheet_id, claim_id, id);
+CREATE INDEX person_patron_history_key ON person_patron_history (person_id, patron_id);
+CREATE INDEX person_watch_history_key ON person_watch_history (person_id, id);
+CREATE INDEX delegation_history_key ON delegation_history (sheet_id, id);
+CREATE INDEX sheet_role_history_key ON sheet_role_history (sheet_id, user_name);
+
+CREATE TRIGGER sheet_journal AFTER INSERT, UPDATE, DELETE ON sheet FOR EACH ROW CALL 'net.officefloor.hq.app.history.Journal';
+CREATE TRIGGER statement_journal AFTER INSERT, UPDATE, DELETE ON statement FOR EACH ROW CALL 'net.officefloor.hq.app.history.Journal';
+CREATE TRIGGER period_journal AFTER INSERT, UPDATE, DELETE ON period FOR EACH ROW CALL 'net.officefloor.hq.app.history.Journal';
