+package net.officefloor.hq.app.pool;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** A pool needs a name, kept trimmed. */
+public class ValidatePool {
+    public void validate(@RequestBody PoolRequest request, Out<PoolInput> body) throws InvalidPoolException {
+        String name = request == null || request.name() == null ? "" : request.name().trim();
+        if (name.isEmpty()) throw new InvalidPoolException("A pool name is required");
+        if (name.length() > 200) throw new InvalidPoolException("A pool name is at most 200 characters");
+        body.set(new PoolInput(name));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java b/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java
new file mode 100644
index 000000000..5ac1e2736
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java
@@ -0,0 +1,29 @@
+package net.officefloor.hq.app.pool;
+
+import java.math.BigDecimal;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** A member needs a pool, a person, and a share with at most two decimals, more than 0.00 and at most 100.00. */
+public class ValidatePoolMember {
+    private static final BigDecimal HUNDRED = new BigDecimal("100.00");
+
+    public void validate(@RequestBody PoolMemberRequest request, Out<PoolMemberInput> body) throws InvalidPoolException {
+        if (request == null) throw new InvalidPoolException("A pool member is required");
+        String pool = request.pool() == null ? "" : request.pool().trim();
+        if (pool.isEmpty()) throw new InvalidPoolException("A pool is required");
+        long personId;
+        try {
+            personId = Long.parseLong(request.personId() == null ? "" : request.personId().trim());
+        } catch (NumberFormatException e) {
+            throw new InvalidPoolException("A person is required");
+        }
+        String text = request.share() == null ? "" : request.share().trim();
+        if (!text.matches("\\d+(\\.\\d{1,2})?")) throw new InvalidPoolException("A share is a number with at most two decimals");
+        BigDecimal share = new BigDecimal(text).setScale(2);
+        if (share.signum() <= 0 || share.compareTo(HUNDRED) > 0) {
+            throw new InvalidPoolException("A share is more than 0.00 and at most 100.00");
+        }
+        body.set(new PoolMemberInput(pool, personId, share));
+    }
+}
diff --git a/src/main/resources/db/migration/V65__pool.sql b/src/main/resources/db/migration/V65__pool.sql
new file mode 100644
index 000000000..03bf8f49f
--- /dev/null
+++ b/src/main/resources/db/migration/V65__pool.sql
@@ -0,0 +1,16 @@
+-- A sheet's pools: a trimmed name, at most once per sheet. A pool's members are people on the sheet,
+-- each at most once per pool, with a share percent (two decimals, more than 0.00, at most 100.00).
+-- A person can be in several pools.
+CREATE TABLE pool (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    name VARCHAR(200) NOT NULL,
+    UNIQUE (sheet_id, name)
+);
+CREATE TABLE pool_member (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    pool_id BIGINT NOT NULL REFERENCES pool(id),
+    person_id BIGINT NOT NULL REFERENCES person(id),
+    share DECIMAL(5, 2) NOT NULL,
+    UNIQUE (pool_id, person_id)
+);
