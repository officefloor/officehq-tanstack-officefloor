+# POST /api/sheets/{sheetId}/pools — add a pool to the sheet; refused for a blank name or one already
+# used. A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.pool.ValidatePool
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.pool.AddPool
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.pool.RecordPoolAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.pool.RespondWithPools
