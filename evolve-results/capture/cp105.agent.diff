index 000000000..5da3f31a5
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools.POST.yml
@@ -0,0 +1,24 @@
+# Add a pool to the sheet. A blank name, or one already on the sheet, is refused (a 400) and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.pool.ValidatePool
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.pool.SavePool
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.pool.AuditPoolAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.pool.RespondWithPool
+  govern: [ transaction ]
