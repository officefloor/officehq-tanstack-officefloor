diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools.POST.yml
new file mode 100644
index 00000000..ff740bfb
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools.POST.yml
@@ -0,0 +1,17 @@
+# Add a pool. Validate first so a blank or repeated name is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.pool.ValidatePool
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.pool.SavePool
+  govern: [ transaction ]
+  next: record
+# Audit only once the pool is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.pool.RecordPoolAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.pool.RespondWithPools
+  govern: [ transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools/members.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools/members.POST.yml
