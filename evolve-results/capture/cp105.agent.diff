+package net.officefloor.hq.app.pool;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidatePool {
+
+    // The name, trimmed, must not be blank, nor already a pool of the sheet.
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody PoolRequest body, Pools pools,
+            Out<Pool> pool) throws PoolRefusedException {
+        String sheet = sheetId.trim();
+        String name = body == null || body.name() == null ? "" : body.name().trim();
+        if (name.isEmpty()) {
+            throw new PoolRefusedException("Give the pool a name.");
+        }
+        if (pools.has(sheet, name)) {
+            throw new PoolRefusedException("\"" + name + "\" is already a pool.");
+        }
+        pool.set(new Pool(sheet, name));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java b/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java
new file mode 100644
index 00000000..8faf1655
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java
@@ -0,0 +1,43 @@
+package net.officefloor.hq.app.pool;
+
+import java.math.BigDecimal;
+import java.util.regex.Pattern;
+import net.officefloor.hq.app.person.People;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidatePoolMember {
+
+    private static final Pattern SHARE = Pattern.compile("\\d+(\\.\\d{1,2})?");
+
+    private static final BigDecimal HUNDRED = new BigDecimal("100.00");
+
+    // The pool and the person must be of the sheet, the person not already in the pool; the share has at most two
+    // decimals, more than 0.00 and at most 100.00.
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody PoolMemberRequest body, Pools pools,
+            People people, Out<PoolMember> member) throws PoolRefusedException {
+        String sheet = sheetId.trim();
+        String pool = body == null || body.pool() == null ? "" : body.pool().trim();
+        if (!pools.has(sheet, pool)) {
+            throw new PoolRefusedException("Choose a pool.");
+        }
+        Person person = body.personId() == null ? null : people.find(sheet, body.personId());
+        if (person == null) {
+            throw new PoolRefusedException("Choose a person.");
+        }
+        if (pools.isMember(sheet, pool, person.id())) {
+            throw new PoolRefusedException(person.name() + " is already in the pool.");
+        }
+        String typed = body.share() == null ? "" : body.share().trim();
+        if (!SHARE.matcher(typed).matches()) {
+            throw new PoolRefusedException("Give the share as a percent with at most two decimals.");
+        }
+        BigDecimal share = new BigDecimal(typed).setScale(2);
+        if (share.signum() <= 0 || share.compareTo(HUNDRED) > 0) {
+            throw new PoolRefusedException("The share must be more than 0.00 and at most 100.00.");
+        }
+        member.set(new PoolMember(sheet, pool, person.id(), person.name(), share));
+    }
+}
diff --git a/src/main/resources/db/migration/V54__pool.sql b/src/main/resources/db/migration/V54__pool.sql
new file mode 100644
index 00000000..87337ecc
--- /dev/null
+++ b/src/main/resources/db/migration/V54__pool.sql
@@ -0,0 +1,17 @@
+-- The sheet's pools: a name (trimmed, at most once per sheet), listed in the order added.
+CREATE TABLE pool (
+    sheet_id VARCHAR(255) NOT NULL,
+    name VARCHAR(255) NOT NULL,
+    listed BIGINT NOT NULL,
+    PRIMARY KEY (sheet_id, name)
+);
+-- A pool's members: a person of the sheet, at most once per pool, with a share percent (two decimals, above 0.00 and
+-- at most 100.00). A person can be in several pools. A retired member's share counts 0.00 toward the pool's total.
+CREATE TABLE pool_member (
+    sheet_id VARCHAR(255) NOT NULL,
+    pool_name VARCHAR(255) NOT NULL,
+    person_id BIGINT NOT NULL,
+    share DECIMAL(5, 2) NOT NULL,
+    listed BIGINT NOT NULL,
+    PRIMARY KEY (sheet_id, pool_name, person_id)
+);
