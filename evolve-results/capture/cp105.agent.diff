index 00000000..1e6a7af3
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools/members.POST.yml
@@ -0,0 +1,18 @@
+# Add a member to a pool. Validate first so a person already in the pool, or a bad share, is a 400
+# and writes nothing.
+validate:
+  class: net.officefloor.hq.app.pool.ValidatePoolMember
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.pool.SavePoolMember
+  govern: [ transaction ]
+  next: record
+# Audit only once the member is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.pool.RecordPoolMemberAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.pool.RespondWithPools
+  govern: [ transaction ]
