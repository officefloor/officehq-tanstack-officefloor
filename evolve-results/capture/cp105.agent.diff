+# POST /api/sheets/{sheetId}/pools — adds a pool to the sheet (body: {name, user}), trimmed. A blank name,
+# one already a pool, or a viewer is refused (400) and nothing is stored. Recorded as POOL_ADDED.
+validate:
+  class: net.officefloor.hq.app.pool.ValidatePool
+  next: save
+save:
+  class: net.officefloor.hq.app.pool.SavePool
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.pool.AuditPoolAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.pool.RespondWithPoolAdded
+  govern: [ transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools/{poolId}/members.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pools/{poolId}/members.POST.yml
