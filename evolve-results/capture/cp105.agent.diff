+# POST /api/sheets/{sheetId}/pools/{poolId}/members — adds a person to a pool with a share percent (body:
+# {personId, share, user}). A person already in the pool, a share not more than 0.00 and at most 100.00 with
+# at most two decimals, or a viewer is refused (400) and nothing is stored. Recorded as POOL_MEMBER_ADDED.
+validate:
+  class: net.officefloor.hq.app.pool.ValidateMember
+  next: save
+save:
+  class: net.officefloor.hq.app.pool.SaveMember
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.pool.AuditMemberAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.pool.RespondWithMemberAdded
+  govern: [ transaction ]
