--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/pool-members.POST.yml
@@ -0,0 +1,24 @@
+# Add a person to a pool with a share. A person already in the pool, or a share not more than 0.00 and
+# at most 100.00 with two decimals, is refused (a 400) and writes nothing.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.pool.ValidatePoolMember
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.pool.SavePoolMember
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.pool.AuditPoolMemberAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.pool.RespondWithPoolMember
+  govern: [ transaction ]
