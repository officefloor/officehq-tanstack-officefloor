diff --git a/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java b/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java
new file mode 100644
index 00000000..44eaf4fc
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/pool/ValidatePoolMember.java
@@ -0,0 +1,26 @@
+package net.officefloor.hq.app.pool;
+
+import java.math.BigDecimal;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the member's person and share from the body; refuses a missing person, or a share that is not a number
+ *  with at most two decimals, more than 0.00 and at most 100.00. */
+public class ValidatePoolMember {
+    private static final BigDecimal HUNDRED = new BigDecimal("100.00");
+
+    public void validate(@RequestBody PoolMemberRequest request, Out<ValidPoolMember> body) throws InvalidPoolException {
+        if (request == null || request.personId() == null) {
+            throw new InvalidPoolException("Choose a person for the pool.");
+        }
+        String share = request.share() == null ? "" : request.share().trim();
+        if (!share.matches("\\d{1,3}(\\.\\d{1,2})?")) {
+            throw new InvalidPoolException("A share is a percent with at most two decimals.");
+        }
+        BigDecimal value = new BigDecimal(share).setScale(2);
+        if (value.signum() <= 0 || value.compareTo(HUNDRED) > 0) {
+            throw new InvalidPoolException("A share must be more than 0.00 and at most 100.00.");
+        }
+        body.set(new ValidPoolMember(request.personId(), value));
+    }
+}
diff --git a/src/main/resources/db/migration/V60__pool.sql b/src/main/resources/db/migration/V60__pool.sql
new file mode 100644
index 00000000..08fd899d
--- /dev/null
+++ b/src/main/resources/db/migration/V60__pool.sql
@@ -0,0 +1,16 @@
+-- A sheet's pools: a trimmed name, on the sheet at most once (ignoring case).
+CREATE TABLE pool (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet (id),
+    name VARCHAR(255) NOT NULL
+);
+CREATE UNIQUE INDEX pool_sheet_name ON pool (sheet_id, name);
+-- A pool's members: a person of the sheet, in the pool at most once, with a share percent (more than 0.00, at most
+-- 100.00). A person can be in several pools. A retired member's share counts as 0.00 toward the pool's total.
+CREATE TABLE pool_member (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    pool_id BIGINT NOT NULL REFERENCES pool (id),
+    person_id BIGINT NOT NULL REFERENCES person (id),
+    share DECIMAL(5, 2) NOT NULL
+);
+CREATE UNIQUE INDEX pool_member_pool_person ON pool_member (pool_id, person_id);
