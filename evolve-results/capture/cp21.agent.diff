@@ -0,0 +1,20 @@
+# POST /api/sheets/{sheetId}/people/{personId}/retire — retire a person from a date (blank: the sheet's today). A date
+# that is not yyyy-MM-dd is a 400 and a person not on the sheet a 404, neither writing anything. The person counts as
+# retired at once, whatever the date; no claim of theirs may then be dated after it. Responds with the person as stored.
+validate:
+  class: net.officefloor.hq.app.person.ValidateRetire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
