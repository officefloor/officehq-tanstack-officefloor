+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/retire.POST.yml
@@ -0,0 +1,21 @@
+# Retire the person from a date (blank: the sheet's today). The audit line is written last, once it
+# is saved, so a refused retire (bad date: 400, no such person: 404) writes none. Retiring moves no
+# total — a retired person's claims keep counting — so no rollup is written.
+validate:
+  class: net.officefloor.hq.app.person.ValidateRetire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
