+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.ApplyRetire
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonRetired
+  govern: [ transaction ]
+  next: respond
+respond:
