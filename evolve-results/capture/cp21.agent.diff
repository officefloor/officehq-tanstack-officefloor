@@ -0,0 +1,25 @@
+# Retire a person from a date (blank: the sheet's today). Validate first so a bad date is a 400,
+# not a 404. Retiring moves no figures: their claims keep counting.
+validate:
+  class: net.officefloor.hq.app.person.ValidateRetire
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePerson
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the retirement is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
