+# Retire a person from a date (blank: the sheet's today). Moves no figures: their claims keep counting.
+validate:
+  class: net.officefloor.hq.app.person.ValidateRetire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePerson
+  govern: [ transaction ]
+  next: record
+# Audit only once the retirement is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
