+# POST /api/sheets/{sheetId}/people/{personId}/retire — retire a person from a date (blank: the
+# sheet's today); a date that is not a date is refused. Their claims keep counting in every total.
+validate:
+  class: net.officefloor.hq.app.person.ValidateRetire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
