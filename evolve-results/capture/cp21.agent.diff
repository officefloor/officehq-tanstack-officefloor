index 0000000..72edb47
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/retire.PUT.yml
@@ -0,0 +1,20 @@
+# Retire a person from a date (blank: the sheet's today). A claim dated after it is then refused; their claims keep
+# counting in every total. A refused retire (no signed-in user, bad date, unknown person) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateRetire
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SaveRetire
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/quick-add.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/quick-add.POST.yml
index b9f9b6a..30aa6f7 100644
--- a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/quick-add.POST.yml
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/quick-add.POST.yml
@@ -1,6 +1,6 @@
 # Quick-add a DRAFT claim for the named person, dated the sheet's today with an empty note; a name new to the
 # sheet adds the person first with grade A. One change: a refused quick-add (no name, bad amount, unknown sheet,
-# today in a closed period) adds no person and writes nothing, not even an audit line.
+# today in a closed period, or after the person's retirement date) adds no person and writes nothing, not even an audit line.
 validate:
   class: net.officefloor.hq.app.quickadd.ValidateQuickAdd
   next: load
@@ -15,6 +15,10 @@ closed:
 person:
   class: net.officefloor.hq.app.quickadd.FindOrAddQuickAddPerson
   govern: [ transaction ]
+  next: retired
+retired:
+  class: net.officefloor.hq.app.claim.RefuseRetiredNewClaim
+  govern: [ transaction ]
   next: before
 before:
   class: net.officefloor.hq.app.rollup.TakeRollup
