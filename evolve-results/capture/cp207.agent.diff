+# Roll a fiscal year (yyyy) over, by a steward only: generate the next fiscal year's twelve monthly periods exactly as
+# period-generate-fy does, and add each person's open figure at the end of the old year's last period to their opening
+# balance for the new year's first period (OPENING_SET), then write ROLLOVER. A year with no periods is refused.
+# Answers how many periods were made.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: rollover
+rollover:
+  class: net.officefloor.hq.app.period.RolloverYear
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
