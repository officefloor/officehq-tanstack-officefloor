@@ -0,0 +1,20 @@
+# POST /api/sheets/{sheetId}/periods/rollover — roll a fiscal year over (body: {year, user}). Only a steward may,
+# of a year (YYYY) with periods on the sheet; otherwise refused (400) and nothing is stored. Generates the next
+# fiscal year's twelve months exactly as periods/generate-fy does, then adds each person's open figure at the end
+# of the old year's last period to their opening balance for the new year's first period (OPENING_SET each) and
+# records ROLLOVER. Answers {generated}.
+validate:
+  class: net.officefloor.hq.app.period.ValidateRollover
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: carry
+carry:
+  class: net.officefloor.hq.app.period.CarryRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
+  govern: [ transaction ]
