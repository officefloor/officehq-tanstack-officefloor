+# POST /api/sheets/{sheetId}/rollover — roll the fiscal year over. Body: { "year": "yyyy" } (the old fiscal year, named
+# by the calendar year its first day falls in). Generates the next fiscal year's twelve periods exactly as generate-fy
+# does, and adds each person's open figure at the end of the old year's last period (the dues of their claims that
+# count whose due-by falls in a period of the old year, OPEN or PENDING at that period's end) to their opening balance
+# for the new year's first period (OPENING_SET each), then records ROLLOVER fy=FY<year> periods=<made>. Refuses a year
+# that is not four digits, a year with no periods, and anyone but a steward. Responds { "made": n }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: validate
+validate:
+  class: net.officefloor.hq.app.rollover.ValidateRollover
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.rollover.ApplyRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rollover.RespondWithRolledOver
+  govern: [ transaction ]
