@@ -0,0 +1,9 @@
+# The year end rollover, by a steward only: generates the next fiscal year's twelve periods as the fiscal year
+# generator does, then carries each person's open figure at the end of the old year's last period into their
+# opening for the new year's first period (OPENING_SET), then ROLLOVER.
+validate:
+  class: net.officefloor.hq.app.period.ValidateRollover
+  next: rollover
+rollover:
+  class: net.officefloor.hq.app.period.RollOver
+  govern: [ transaction ]
