+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rollover.POST.yml
@@ -0,0 +1,31 @@
+# Roll the year over (a steward only): FY<yyyy> is the old fiscal year, which must have at least one period on the
+# sheet (one whose from-date falls in it). Generates FY<yyyy+1>'s twelve periods exactly as the fiscal year generator
+# does (PERIOD_ADDED each), then adds each person's open figure at the end of the old year's last period to their
+# carried figure for the new year's first period (OPENING_SET each), then writes ROLLOVER fy=FY<yyyy> periods=<made>.
+# A refused rollover (no signed-in user, bad year, not a steward, a year with no periods) writes nothing.
+validate:
+  class: net.officefloor.hq.app.rollover.ValidateRollover
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.rollover.CheckRollover
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SaveGeneratedPeriods
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodsGenerated
+  govern: [ transaction ]
+  next: carry
+carry:
+  class: net.officefloor.hq.app.rollover.CarryOpenFigures
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rollover.RespondWithRollover
+  govern: [ transaction ]
