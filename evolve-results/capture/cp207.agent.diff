@@ -0,0 +1,18 @@
+# Roll a fiscal year over. Validate first so a bad year, anyone but a steward, or a year with no
+# periods is a 400 and writes nothing; it hands the next fiscal year's months to the period generator.
+validate:
+  class: net.officefloor.hq.app.period.ValidateRollover
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: carry
+# Each person's open figure at the old year's end is added to their opening for the new year's first period.
+carry:
+  class: net.officefloor.hq.app.period.CarryRollover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithRollover
+  govern: [ transaction ]
