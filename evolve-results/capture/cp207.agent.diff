+# Validate first so anyone but a steward, a bad year or a year with no periods is a 400 and writes nothing; Generate
+# adds the next fiscal year's months exactly as the fiscal year generator does; Carry adds each person's open figure at
+# the old year's end to their opening for the new year's first period and audits the rollover. Responds with how many
+# periods were made and the sheet's periods.
+validate:
+  class: net.officefloor.hq.app.period.ValidateRollover
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: carry
+carry:
+  class: net.officefloor.hq.app.period.CarryOpenings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
