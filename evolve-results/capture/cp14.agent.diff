index 4555c6bd..7391fcd0 100644
--- a/src/main/frontend/api/http.ts
+++ b/src/main/frontend/api/http.ts
@@ -1,7 +1,13 @@
 // The app's fetch surface. A non-2xx REJECTS, so useQuery/useMutation surface the failure instead
 // of a silent `if (res.ok)` that leaves the UI showing stale data.
+/** A write refused because the record was saved by someone else since it was loaded (409). */
+export class ConflictError extends Error {}
+
 async function send<T>(path: string, init?: RequestInit): Promise<T> {
   const res = await fetch(path, init);
+  if (res.status === 409) {
+    throw new ConflictError(`${init?.method ?? 'GET'} ${path} -> 409`);
+  }
   if (!res.ok) {
     throw new Error(`${init?.method ?? 'GET'} ${path} -> ${res.status}`);
   }
diff --git a/src/main/frontend/api/useSubmitOnce.ts b/src/main/frontend/api/useSubmitOnce.ts
new file mode 100644
index 00000000..3fb2bb2b
--- /dev/null
+++ b/src/main/frontend/api/useSubmitOnce.ts
@@ -0,0 +1,22 @@
+import { useRef } from 'react';
+
+/**
+ * Guard a form's submit so a second submit while the first is still unanswered (a double click)
+ * sends nothing. The guard is a ref, set synchronously, so it holds before React re-renders the
+ * button as disabled.
+ *
+ *     const once = useSubmitOnce();
+ *     once(() => save.mutateAsync(body));
+ */
+export function useSubmitOnce() {
+  const busy = useRef(false);
+  return (run: () => Promise<unknown>) => {
+    if (busy.current) return;
+    busy.current = true;
+    run()
+      .catch(() => undefined) // the mutation's onError shows the refusal
+      .finally(() => {
+        busy.current = false;
+      });
+  };
+}
