--- a/src/main/frontend/api/http.ts
+++ b/src/main/frontend/api/http.ts
@@ -1,9 +1,16 @@
 // The app's fetch surface. A non-2xx REJECTS, so useQuery/useMutation surface the failure instead
 // of a silent `if (res.ok)` that leaves the UI showing stale data.
+// A non-2xx answer: its status tells a refusal (400) from a conflict with someone else's save (409).
+export class HttpError extends Error {
+  constructor(message: string, readonly status: number) {
+    super(message);
+  }
+}
+
 async function send<T>(path: string, init?: RequestInit): Promise<T> {
   const res = await fetch(path, init);
   if (!res.ok) {
-    throw new Error(`${init?.method ?? 'GET'} ${path} -> ${res.status}`);
+    throw new HttpError(`${init?.method ?? 'GET'} ${path} -> ${res.status}`, res.status);
   }
   return res.status === 204 ? (undefined as T) : ((await res.json()) as T);
 }
diff --git a/src/main/frontend/api/submitOnce.ts b/src/main/frontend/api/submitOnce.ts
new file mode 100644
index 00000000..c7957422
--- /dev/null
+++ b/src/main/frontend/api/submitOnce.ts
@@ -0,0 +1,15 @@
+import { useRef } from 'react';
+import type { UseMutationResult } from '@tanstack/react-query';
+
+// Submits a mutation at most once at a time: a second submit (a double click) before the first has
+// answered is dropped, so it stores one record, not two. `isPending` alone is not enough: it only
+// disables the button once React has re-rendered, which a fast second click can beat.
+export function useSubmitOnce<D, V, C>(mutation: UseMutationResult<D, Error, V, C>) {
+  const busy = useRef(false);
+  return (variables: V) => {
+    if (busy.current) return;
+    busy.current = true;
+    mutation.reset();
+    mutation.mutateAsync(variables).catch(() => undefined).finally(() => { busy.current = false; });
+  };
+}
