+# POST /api/sheets/{sheetId}/claims/{claimId}/redate — re-date an OPEN or PENDING claim (body {date, user}).
+# The claim keeps its due-by and any figure a statement bound it to; its period follows the new date, and
+# while the sheet numbers by period and the period changes, it takes the next number of its new period's
+# sequence (its old number is never given again). Refused (400) when the user is not a steward, the date
+# does not parse or is after the date the person is retired from, the claim is not OPEN or PENDING or not
+# on the sheet, or its date or the new date falls in a closed period; nothing is stored then. A stored
+# re-dating is recorded in the audit file as CLAIM_REDATED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRedate
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: checkRedate
+checkRedate:
+  class: net.officefloor.hq.app.claim.CheckRedate
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRedate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimRedated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
