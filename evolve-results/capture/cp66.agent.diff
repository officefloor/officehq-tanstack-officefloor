+# A steward's re-date of an OPEN or PENDING claim. Refused for anyone else, a date after its person's retirement, or
+# a claim in a closed period or a new date inside one. Its due-by and any statement figure stay; its period follows.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: redate
+redate:
+  class: net.officefloor.hq.app.claim.ValidateRedate
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  govern: [ transaction ]
+  next: rollup-before
+rollup-before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRedate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimRedated
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
