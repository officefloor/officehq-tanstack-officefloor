+# POST /api/sheets/{sheetId}/claims/{claimId}/redate?date=yyyy-MM-dd — a steward re-dates an OPEN or
+# PENDING claim; refused (409) for anyone else or any other status, (400) for a date that is not a date
+# or is after its person's retirement, (423) for a claim dated in a closed period or a new date inside one.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: redate
+redate:
+  class: net.officefloor.hq.app.claim.RedateClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveRedating
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimRedated
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
