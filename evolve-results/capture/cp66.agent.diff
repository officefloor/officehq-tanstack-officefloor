+# A steward re-dates an OPEN or PENDING claim ({"date": "yyyy-MM-dd"}), keeping its due-by and any figure a statement bound. Responds with the sheet's claims.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRedate
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: redate
+redate:
+  class: net.officefloor.hq.app.claim.RedateClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaims
+  govern: [ transaction ]
