+++ b/src/main/java/net/officefloor/hq/app/claim/ValidateRedate.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the body: a re-dating needs a real date (yyyy-MM-dd), the claim's new date. */
+public class ValidateRedate {
+    public void validate(@RequestBody RedateRequest request, Out<ClaimRedating> redating)
+            throws InvalidClaimStatusException {
+        String date = request == null || request.date() == null ? "" : request.date().trim();
+        LocalDate parsed;
+        try {
+            parsed = LocalDate.parse(date);
+        } catch (DateTimeParseException e) {
+            throw new InvalidClaimStatusException("A re-dating needs the claim's new date");
+        }
+        redating.set(new ClaimRedating(parsed, request.by() == null ? "" : request.by().trim(), null));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/date.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/date.PUT.yml
new file mode 100644
index 000000000..ebc86ed59
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/date.PUT.yml
@@ -0,0 +1,31 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/date — re-date an OPEN or PENDING claim, by a steward. Its due-by stays as
+# it was fixed, a figure a statement bound it to stays bound, and its period follows the new date: while per-period
+# numbering is on and the period changes, it takes the next number of its new period's sequence (its old number is
+# never given again). Anyone but a steward, any other claim, a claim dated inside a closed period, a new date inside
+# one, after the person's retirement or not a date, is a 409 and a claim not on the sheet a 404, neither writing
+# anything. Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRedate
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRedate
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveRedate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimRedated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
