+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/redate.POST.yml
@@ -0,0 +1,49 @@
+# Re-date an OPEN or PENDING claim (a steward). A date after its person's retirement, or inside a
+# closed period, a claim in a closed period, or anyone but a steward is refused and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRedate
+  govern: [ transaction ]
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+# A claim dated inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.RedateClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimRedated
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
