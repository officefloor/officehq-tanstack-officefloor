+# PUT /api/sheets/{sheetId}/claims/{claimId}/date — a steward re-dates an OPEN or PENDING claim. Body
+# {"date":"yyyy-mm-dd"}. Its due-by and any statement figure stay; its period follows the new date, and while the sheet
+# numbers by period a change of period gives it the next number of its new period (the old one is never reused).
+# Refused with 422 for anyone but a steward, any other status, a date after its person's retirement, or a claim dated
+# in a closed period or a new date inside one; nothing is stored. 404 for a claim not on the sheet.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: closed
+  govern: [ transaction ]
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRedate
+  next: audit
+  govern: [ transaction ]
+audit:
