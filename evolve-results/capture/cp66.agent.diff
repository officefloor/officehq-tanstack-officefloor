@@ -0,0 +1,17 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.People;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.plugin.variable.Val;
+
+/** Runs after the claim is saved, so a refused re-dating writes no audit line. */
+public class RecordClaimRedated {
+    public void record(@Val ClaimRedate change, @Val Claim claim, People people, Audit audit) {
+        Person person = people.find(claim.getSheetId(), claim.getPersonId());
+        audit.record("CLAIM_REDATED sheet=" + claim.getSheetId() + " by=" + change.user()
+                + " person=" + person.getName() + " amount=" + claim.getAmount().toPlainString()
+                + " date=" + claim.getDate() + (claim.getNumber() != null ? " number=" + claim.getNumber() : "")
+                + " old=" + change.old() + " new=" + change.date());
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/ValidateClaimRedate.java b/src/main/java/net/officefloor/hq/app/claim/ValidateClaimRedate.java
new file mode 100644
index 00000000..e5a618a0
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ValidateClaimRedate.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import net.officefloor.hq.app.rollup.Actor;
+import net.officefloor.hq.app.sheet.InvalidSheetRequestException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateClaimRedate {
+    public void validate(@RequestBody ClaimRedateRequest request, Out<ClaimRedate> body, Out<Actor> actor)
+            throws InvalidSheetRequestException {
+        String raw = request == null || request.date() == null ? "" : request.date().trim();
+        try {
+            actor.set(new Actor(request.user()));
+            body.set(new ClaimRedate(LocalDate.parse(raw), request.user()));
+        } catch (DateTimeParseException e) {
+            throw new InvalidSheetRequestException("Not a date (yyyy-mm-dd): " + raw);
+        }
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/redate.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/redate.POST.yml
new file mode 100644
index 00000000..1b529a52
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/redate.POST.yml
@@ -0,0 +1,36 @@
+# A steward re-dates an OPEN or PENDING claim. Validate before Load so a bad date is a 400, not a
+# 404; anyone but a steward, a claim not OPEN or PENDING, a closed period or a date after the
+# person's retirement is a 409 (or the period's / retirement's refusal) and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimRedate
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimRedate
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimRedated
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
