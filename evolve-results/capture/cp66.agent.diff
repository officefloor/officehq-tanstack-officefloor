@@ -0,0 +1,28 @@
+# Validate before Load so an invalid body is a 400, not masked by a 404.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRedate
+  next: snapshot
+# The sheet's figures before the change, so the change can audit what it moved.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRedate
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveRedate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimRedated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
