+# Settle the selected claims together. Each that can be settled is settled (or goes PENDING) and
+# audited as a single settle would be, in list order; each that cannot is left as it is. Answers
+# how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkSettle
+  next: settle
+settle:
+  class: net.officefloor.hq.app.claim.SettleClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkSettle
+  govern: [ transaction ]
