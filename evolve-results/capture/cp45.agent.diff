@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/bulk-settle — settle the selected claims together. Each selected claim is settled by the
+# signed-in user exactly as the single settle does (see ApplyClaimStatus), in list order: people in the order they were
+# added, a person's claims newest first; one that goes to PENDING counts as settled, and each writes its own
+# CLAIM_SETTLED or CLAIM_PENDING and figure lines. Each that cannot be settled (or is not on the sheet) is left as it is
+# and counted refused. Responds with how many were settled and how many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkSettle
+  next: settle
+settle:
+  class: net.officefloor.hq.app.claim.SettleClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkSettle
