@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/bulk-settle — settle the selected claims together (body {claimIds, user}).
+# Each selected claim is settled in list order — people in the order they were added, a person's
+# claims newest first — by exactly the rules of a single settle by the user, and recorded as a single
+# settle is (CLAIM_SETTLED, or CLAIM_PENDING for a clerk above the clerk limit, which counts as
+# settled); each that a single settle would refuse is refused and left as it is. Answers
+# {settled, refused}. Refused (400) only when no claim is selected.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkSettle
+  next: settle
+settle:
+  class: net.officefloor.hq.app.claim.SettleClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkSettle
+  govern: [ transaction ]
