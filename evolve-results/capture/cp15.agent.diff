+# Take a person's statement: records their due-total and binds their claims that count to their figures now.
+# A refused statement (no signed-in user, unknown person) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.statement.ValidateStatement
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.statement.SaveStatement
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.statement.AuditStatement
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
