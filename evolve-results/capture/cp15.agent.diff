+# Take a person's statement: record their due-total and bind their counting claims to their figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidateStatement
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: take
+take:
+  class: net.officefloor.hq.app.person.TakeStatement
+  govern: [ transaction ]
+  next: record
+# Audit only once the statement is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordStatement
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
