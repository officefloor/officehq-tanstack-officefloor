+# POST /api/sheets/{sheetId}/people/{personId}/statement — take a statement of the person (body:
+# {user}) on the sheet's today: records their due-total and binds each of their claims that counts
+# to its figure now (a claim that does not count is unbound). Refused (400) when the person is not on
+# the sheet; nothing is stored then. A stored statement is recorded in the audit file as STATEMENT.
+validate:
+  class: net.officefloor.hq.app.statement.ValidateStatement
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: take
+take:
+  class: net.officefloor.hq.app.statement.TakeStatement
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.statement.AuditStatement
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
