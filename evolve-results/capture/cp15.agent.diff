@@ -0,0 +1,21 @@
+# POST /api/sheets/{sheetId}/people/{personId}/statements — take the person's statement on the sheet's
+# today: records their due-total and binds each of their claims that counts to the figure it has now
+# (one that does not count is unbound). A person not on the sheet is a 404 and writes nothing.
+# Responds 201 with the statement.
+validate:
+  class: net.officefloor.hq.app.statement.ValidateStatement
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: take
+take:
+  class: net.officefloor.hq.app.statement.TakeStatement
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.statement.RecordStatementTaken
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.statement.RespondWithStatementCreated
