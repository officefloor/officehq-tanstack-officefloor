@@ -0,0 +1,17 @@
+# Import people pasted as lines of name,grade. Every line is checked first with the form's rules;
+# any bad line refuses the whole import (400, with the bad line numbers) and writes nothing.
+check:
+  class: net.officefloor.hq.app.person.CheckImport
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SaveImport
+  govern: [ transaction ]
+  next: audit
+# Record the people only once they are all saved, so a refused import writes no audit line.
+audit:
+  class: net.officefloor.hq.app.person.AuditImport
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithImport
