+# Take a person's statement: record their due-total now and bind each of their counting claims to the
+# figure it has now (unbinding the rest); a person not on the sheet is refused (404).
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: take
+take:
+  class: net.officefloor.hq.app.statement.TakeStatement
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.statement.AuditStatement
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
