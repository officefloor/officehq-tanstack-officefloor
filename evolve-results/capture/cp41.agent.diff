diff --git a/src/main/frontend/features/claims/useSheetTotals.ts b/src/main/frontend/features/claims/useSheetTotals.ts
new file mode 100644
index 00000000..cef1444d
--- /dev/null
+++ b/src/main/frontend/features/claims/useSheetTotals.ts
@@ -0,0 +1,33 @@
+import { gradeOn, heldOnBy, usePeople } from '../people/usePeople';
+import { rateOn, totalDue, useRates } from '../rates/useRates';
+import { useFloor, useLate } from '../settings/useSettings';
+import { useSheetToday } from '../sheet/useSheet';
+import { claimed, live, overdueFigures, personDueCents, useClaims } from './useClaims';
+
+/**
+ * The sheet's totals: its claimed-total, everyone's counted (OPEN or SETTLED) claims added up
+ * (not OPEN ones dated within their person's hold, unless stated), and its due-total, everyone's due-total
+ * added up (a person whose due-total is n/a is skipped), and how many of the claims that count are
+ * overdue, with their dues added up. One place, so every screen repeating a total shows the same figure.
+ */
+export function useSheetTotals(sheet: string) {
+  const { data: all = [] } = useClaims(sheet);
+  const { data: people = [] } = usePeople(sheet);
+  const claims = live(all, heldOnBy(people));
+  const { data: rates = [] } = useRates(sheet);
+  const today = useSheetToday(sheet);
+  const floor = useFloor(sheet);
+  const late = useLate(sheet);
+  const dues = people.map((p) =>
+    personDueCents(claims.filter((c) => c.personId === p.id), floor, rateOn(rates, gradeOn(p, today), today), (d) => rateOn(rates, gradeOn(p, d), d), late),
+  );
+  const over = people.map((p) =>
+    overdueFigures(claims.filter((c) => c.personId === p.id), late, floor, (d) => rateOn(rates, gradeOn(p, d), d)),
+  );
+  return {
+    claimedTotal: claimed(claims),
+    dueTotal: totalDue(dues),
+    overdueCount: over.reduce((n, o) => n + o.count, 0),
+    overdueTotal: totalDue(over.map((o) => o.cents)),
+  };
+}
diff --git a/src/main/frontend/features/header/header.slot.tsx b/src/main/frontend/features/header/header.slot.tsx
new file mode 100644
index 00000000..dd32cba2
--- /dev/null
+++ b/src/main/frontend/features/header/header.slot.tsx
@@ -0,0 +1,38 @@
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { STATUSES, useClaims } from '../claims/useClaims';
+import { useSheetTotals } from '../claims/useSheetTotals';
+import { usePeople } from '../people/usePeople';
+
+/**
+ * The sheet's header, shown at all times: how many people are on the sheet (retired ones
+ * included), how many claims have each status (as the summary counts them), and the sheet's
+ * due-total and overdue-total (as the totals work them out).
+ */
+function SheetHeader({ sheet }: { user: string; sheet: string }) {
+  const { data: all = [] } = useClaims(sheet);
+  const { data: everyone = [] } = usePeople(sheet);
+  const { dueTotal, overdueTotal } = useSheetTotals(sheet);
+  return (
+    <header data-testid="sheet-header">
+      <span>
+        People: <strong data-testid="header-people-count">{everyone.length}</strong>
+      </span>
+      {STATUSES.map((s) => (
+        <span key={s}>
+          {' '}
+          {s}: <strong data-testid={`header-claims-${s}-count`}>{all.filter((c) => c.status === s).length}</strong>
+        </span>
+      ))}
+      <span>
+        {' '}
+        Due: <strong data-testid="header-due-total">{dueTotal}</strong>
+      </span>
+      <span>
+        {' '}
+        Overdue: <strong data-testid="header-overdue-total">{overdueTotal}</strong>
+      </span>
+    </header>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: -100, Component: SheetHeader });
