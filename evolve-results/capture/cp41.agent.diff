+import { SheetPage } from '../../slots/defs/sheetPage';
+import { usePeople } from '../people/people';
+import { STATUSES, useSheetDueTotal, useSheetOverdue, useStatusCounts } from './totals';
+
+/** The sheet's header counters, at the top of the sheet: its people (retired included), its claims per status
+ *  (as the summary counts them), and its due-total and overdue-total (as the rollups show them). */
+function Header({ sheetId }: { sheetId: string }) {
+  const people = usePeople(sheetId);
+  const withStatus = useStatusCounts(sheetId);
+  const dueTotal = useSheetDueTotal(sheetId);
+  const overdue = useSheetOverdue(sheetId);
+
+  return (
+    <header data-testid="header">
+      People <span data-testid="header-people-count">{(people.data ?? []).length}</span>
+      {STATUSES.map((s) => (
+        <span key={s}>
+          {' · '}
+          {s} <span data-testid={`header-claims-${s}-count`}>{withStatus(s)}</span>
+        </span>
+      ))}
+      {' · '}Due total <span data-testid="header-due-total">{dueTotal}</span>
+      {' · '}Overdue total <span data-testid="header-overdue-total">{overdue.total}</span>
+    </header>
+  );
+}
+
+export const contribution = SheetPage.fill({ order: -10, Component: Header });
diff --git a/src/main/frontend/features/header/totals.ts b/src/main/frontend/features/header/totals.ts
new file mode 100644
index 000000000..db54b7fab
--- /dev/null
+++ b/src/main/frontend/features/header/totals.ts
@@ -0,0 +1,44 @@
+import { live, useClaims, type ClaimStatus } from '../claims/claims';
+import { overdue } from '../overdue/overdue';
+import { usePeople } from '../people/people';
+import { personDue, sum, useRates } from '../rates/rates';
+import { useFloor, useLate } from '../settings/settings';
+
+// The sheet-wide figures shown in more than one place (the rollups, the summary and the header), worked out once
+// here so every place that shows one shows the same value.
+
+/** The statuses claims are counted by. */
+export const STATUSES: readonly ClaimStatus[] = ['DRAFT', 'OPEN', 'PENDING', 'SETTLED', 'VOID'];
+
+/** The sheet's due-total: everyone's due-total added up, skipping n/a. */
+export function useSheetDueTotal(sheetId: string): string {
+  const people = usePeople(sheetId);
+  const claims = useClaims(sheetId);
+  const rates = useRates(sheetId);
+  const late = useLate(sheetId);
+  const floor = useFloor(sheetId);
+  return sum(
+    (people.data ?? []).map((p) =>
+      personDue(live(claims.data?.filter((c) => c.personId === p.id) ?? [], [p]), rates.data, p, late, floor),
+    ),
+  );
+}
+
+/** The sheet's overdue count and overdue-total: everyone's added up. */
+export function useSheetOverdue(sheetId: string): { count: number; total: string } {
+  const people = usePeople(sheetId);
+  const claims = useClaims(sheetId);
+  const rates = useRates(sheetId);
+  const floor = useFloor(sheetId);
+  const late = useLate(sheetId);
+  const all = (people.data ?? []).map((p) =>
+    overdue(live(claims.data?.filter((c) => c.personId === p.id) ?? [], [p]), rates.data, p, late, floor),
+  );
+  return { count: all.reduce((n, o) => n + o.count, 0), total: sum(all.map((o) => o.total)) };
+}
+
+/** How many of the sheet's claims have each status. */
+export function useStatusCounts(sheetId: string): (status: ClaimStatus) => number {
+  const claims = useClaims(sheetId);
+  return (status) => (claims.data ?? []).filter((c) => c.status === status).length;
+}
