@@ -0,0 +1,17 @@
+# POST /api/sheets/{sheetId}/bulk-hold — hold the selected people together (body {personIds, from,
+# to, user}). Each selected person, in list order (by their positions), gets the hold exactly as
+# the row's hold would (a blank from-date takes the sheet's today, a blank to-date has no end),
+# recorded as PERSON_HELD, then how it moved the sheet's figures. Answers {held}. Refused (400),
+# storing nothing, when no person is selected, one is not on the sheet, a date is not valid, the
+# to-date is before the from-date, or the sheet is archived. A viewer holds no one: answers
+# {held: 0}, storing and recording nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkHold
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkHold
+  govern: [ transaction ]
