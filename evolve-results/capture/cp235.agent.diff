@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/bulk-hold — add a hold on each selected person together, in list order,
+# each as the row's hold would: from a from-date (blank: the sheet's today) to an optional to-date.
+# Refused (400) with no one selected, a date that is not a date, or a to-date before the from-date,
+# or on an archived sheet; a viewer may hold no one, so for a viewer nothing is written and none are
+# counted. Responds with how many were held.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkHold
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.BulkHoldPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkHold
