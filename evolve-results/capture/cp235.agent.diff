@@ -0,0 +1,13 @@
+# POST /api/sheets/{sheetId}/bulk-hold — hold the selected people together from a from-date (blank: the sheet's today)
+# until an optional to-date. A date that is not yyyy-MM-dd, or a to-date before the from-date, is a 400 and writes
+# nothing. Each selected person on the sheet, in list order (see the people's move), is held exactly as the row's hold
+# would (see HoldPeople): PERSON_HELD and the figures it moved. Responds with how many were held.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkHold
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkHold
