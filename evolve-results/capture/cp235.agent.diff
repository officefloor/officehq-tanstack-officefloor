@@ -0,0 +1,19 @@
+# Hold the selected people together from a from-date (blank for the sheet's today) to an optional
+# to-date, in list order, each exactly as the row's hold would. A bad date, or a to-date before the
+# from-date, is a 400: refused before anything is read or written. A viewer may change nothing, nor
+# anyone on an archived sheet: every selected person is refused and none is held.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkHold
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: hold
+# Each person held is audited as it is held: its own line, then the figures it moved.
+hold:
+  class: net.officefloor.hq.app.person.HoldSelectedPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkHold
+  govern: [ transaction ]
