+# Hold the selected people together, from a date (blank: the sheet's today) to an optional date.
+# Each, in list order, gets the hold as the row's hold would, audited as that would be. Answers how
+# many were held.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkHold
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.HoldPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkHold
+  govern: [ transaction ]
