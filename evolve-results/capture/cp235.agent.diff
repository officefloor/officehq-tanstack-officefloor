+# Hold the selected people together from a from-date (blank: the sheet's today) to an optional to-date, in list
+# order. Each is held exactly as the row's hold would, with its PERSON_HELD line and then how the sheet's figures
+# moved over it. A refused request (no user, no people, a bad date) writes nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkHold
+  next: hold
+hold:
+  class: net.officefloor.hq.app.person.BulkHoldPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkHold
+  govern: [ transaction ]
