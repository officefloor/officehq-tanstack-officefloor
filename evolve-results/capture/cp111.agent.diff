+# Transfer a person to another sheet (see TransferPerson): they arrive there with their grades, terms, contact,
+# aliases and claims, and leave this sheet entirely; both sheets' figures follow. A refused transfer (no signed-in
+# user, not a steward, unknown person, retired, this sheet's own id, an archived sheet, a name, alias or contact
+# already on the other sheet) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransfer
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonTransferred
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
