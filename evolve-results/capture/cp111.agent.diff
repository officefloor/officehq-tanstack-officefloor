+# Transfer a person to another sheet by id (a steward). Validate first so a bad body (no sheet, or
+# this sheet's own id) is a 400, not a 404. Anyone else, a retired person, or a name, alias or contact
+# already on the other sheet, is refused and writes nothing. The person and their claims arrive on the
+# other sheet and leave this one entirely.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransfer
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the transfer is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonTransferred
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved on this sheet.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: arrived
+# Then the other sheet's line, and the figures the arrival moved there.
+arrived:
+  class: net.officefloor.hq.app.person.AuditPersonArrived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
