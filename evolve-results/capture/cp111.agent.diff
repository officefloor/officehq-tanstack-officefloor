+# POST /api/sheets/{sheetId}/people/{personId}/transfer — a steward transfers the person to another sheet by id. Body
+# {"toSheetId":"..."}. The person arrives there with every grade they were given (and its from-date), their terms,
+# contact and aliases, and their claims with their status, dates, notes, frozen figures, comments and logs; each
+# numbered claim takes the next number of the other sheet, in the order the claims were opened (by the sheet's today
+# when each was opened, then the order they were added). Figures a statement bound are lost (no statements go with
+# them) and references are not carried. They leave this sheet entirely: patron links, pool memberships, holds,
+# watches and closed-period figures are dropped. 422, storing nothing, for anyone but a steward, a retired person, no
+# sheet id or this sheet's own, an archived sheet, or a name, alias or contact of theirs already on the other sheet;
+# 404 for a person not on the sheet. Responds with the person as they arrived.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: load
