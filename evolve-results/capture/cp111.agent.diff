@@ -0,0 +1,33 @@
+# POST /api/sheets/{sheetId}/people/{personId}/transfer — transfer a person to another sheet by id, by a steward. The person
+# arrives there with every grade they were given (and its from-date), their terms, contact and aliases, and their claims
+# with their status, dates, notes, tags, frozen figures and logs; each claim that had a number receives the next number of
+# the other sheet, in the order the claims were opened (by the sheet's today when each was opened, then as added). Figures
+# a statement bound are lost and their statement count starts at 0; references are not carried. They leave this sheet
+# entirely (patron links, pool memberships, holds and watches dropped). A body without the sheet is a 400, a person not on
+# the sheet a 404; a user other than a steward, a retired person, this sheet's own id, an archived sheet, or a name, alias
+# or contact already on the other sheet is a 400 — none writes anything. Responds with the person as stored there.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransfer
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.person.CheckTransfer
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonTransferred
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithTransfer
