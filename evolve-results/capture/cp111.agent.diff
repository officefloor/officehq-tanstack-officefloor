+# POST /api/sheets/{sheetId}/people/{personId}/transfer — transfer a person to another sheet by id (body:
+# {to, user}). Only a steward transfers. The person arrives on the other sheet with every grade (and its
+# from-date), their terms, contact and aliases, and their claims with their status, dates, notes, frozen
+# figures, logs and comments; each claim that had a number takes the other sheet's next number, in the order
+# the claims were opened (by the sheet's today when each was opened, then the order they were added). Figures a
+# statement bound are lost, the statement count starts at 0 and references are not carried. They leave this
+# sheet entirely (patron links, pool memberships, holds, statements and watches dropped). Refused (400),
+# storing nothing, when the user is not a steward, the person is not on the sheet or is retired, the other
+# sheet is missing, this sheet or archived, or already has their name, an alias of theirs or their contact.
+# A stored transfer is recorded as PERSON_TRANSFERRED on both sheets, each followed by its rollup lines.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransfer
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonTransferred
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithTransferred
+  govern: [ transaction ]
