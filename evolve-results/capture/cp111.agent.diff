+# A steward transfers a person to another sheet by id (not this one; not a retired person; no name, alias or
+# contact of theirs already there): their grades, terms, contact, aliases and claims go with them, and they
+# leave this sheet.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
