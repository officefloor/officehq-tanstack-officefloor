--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/transfer.POST.yml
@@ -0,0 +1,32 @@
+# A steward transfers the person to another sheet by its id: they arrive there with their grades,
+# terms, contact, aliases and claims (renumbered there), and leave this sheet entirely. Refused (400)
+# for anyone else, a retired person, this sheet's own id, or a name, alias or contact already there.
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransfer
+  next: snapshot
+# Keep this sheet's figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: record
+# Audit only once the transfer is saved: this sheet's line, then its rollup lines.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonTransferred
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: arrived
+# The other sheet's line, then its rollup lines.
+arrived:
+  class: net.officefloor.hq.app.person.RecordPersonArrived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
