+# POST /api/sheets/{sheetId}/people/{personId}/transfer — a steward transfers the person to another
+# sheet by id (to): they arrive there with their grades, terms, contact, aliases and claims (renumbered
+# on the other sheet) and leave this one entirely (see TransferPerson). Anyone else, a retired person,
+# this sheet's own id, or a name, alias or contact already on the other sheet, is refused.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateTransfer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: transfer
+transfer:
+  class: net.officefloor.hq.app.person.TransferPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonTransferred
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: arrive
+arrive:
+  class: net.officefloor.hq.app.person.RecordPersonArrived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
