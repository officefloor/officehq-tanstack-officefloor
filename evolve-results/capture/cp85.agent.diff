@@ -1,8 +1,18 @@
 import { isDeferred, isOpen, type Claim } from './useClaims';
+import type { Grace } from './useGrace';
 
 /** A claim's due-by: fixed when it was created, from the terms of its person's grade in force on its date. */
 export const dueBy = (c: Claim) => c.dueBy;
 
-/** A claim is overdue when it is OPEN (or PENDING), not deferred, and its due-by is before the sheet's today. */
-export const isOverdue = (c: Claim, today: string | undefined) =>
-  isOpen(c) && !isDeferred(c, today) && today !== undefined && dueBy(c) < today;
+/** The date a claim's lateness counts from: its due-by plus its grace days (see useGrace). */
+export function lateFrom(c: { dueBy?: string; personId?: string; date: string }, grace?: Grace): string {
+  const days = grace === undefined ? 0 : grace(c);
+  if (!c.dueBy || days === 0) return c.dueBy ?? '';
+  const d = new Date(`${c.dueBy}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().slice(0, 10);
+}
+
+/** A claim is overdue when it is OPEN (or PENDING), not deferred, and its due-by plus its grace days is before the sheet's today. */
+export const isOverdue = (c: Claim, today: string | undefined, grace?: Grace) =>
+  isOpen(c) && !isDeferred(c, today) && today !== undefined && lateFrom(c, grace) < today;
diff --git a/src/main/frontend/features/claims/useGrace.ts b/src/main/frontend/features/claims/useGrace.ts
new file mode 100644
index 00000000..1ef87526
--- /dev/null
+++ b/src/main/frontend/features/claims/useGrace.ts
@@ -0,0 +1,17 @@
+import { gradeOn, usePeople } from '../people/usePeople';
+import { inForce, useSettings } from '../settings/useSettings';
+
+/** A claim's grace days: those of its person's grade in force on its date, as in force on that date (0 for none). */
+export type Grace = (claim: { personId?: string; date: string }) => number;
+
+export function useGrace(sheet: string): Grace {
+  const settings = useSettings(sheet);
+  const people = usePeople(sheet);
+  const byId = new Map(people.map((p) => [p.id, p]));
+  return (claim) => {
+    const person = claim.personId === undefined ? undefined : byId.get(claim.personId);
+    if (person === undefined) return 0;
+    const days = inForce(settings, `grace-${gradeOn(person, claim.date)}`, claim.date, '');
+    return days === '' ? 0 : Number.parseInt(days, 10);
+  };
+}
