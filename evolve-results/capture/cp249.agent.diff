+            <li key={i} data-testid="policy-line">
+              {`${i + 1} ${v.from ?? 'start'} ${v.key}=${v.value} ${under.get(i + 1) ?? 0}`}
+            </li>
+          ))}
+        </ol>
+      )}
+    </section>
+  );
+}
