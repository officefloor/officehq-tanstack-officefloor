+# A steward merges the person into another on the sheet ({"into": <person id>}): refused (400, nothing written) for
+# anyone else, the same person, or either of them retired. Responds with the sheet's people.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMerge
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: merge
+merge:
+  class: net.officefloor.hq.app.person.MergePerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPeople
+  govern: [ transaction ]
