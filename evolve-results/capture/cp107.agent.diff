+# POST /api/sheets/{sheetId}/people/{personId}/merge — merge a person into another on the sheet, by a steward. The merged
+# person's claims move to the other (numbers and dates kept, listed after the other's in the order they were added, each
+# losing any figure a statement bound); their name and aliases become the other's aliases; their patrons are added to the
+# other's (not the other themselves, no repeats), anyone naming them as patron names the other instead (no repeats), and
+# their pool memberships move to the other (shares added where the other is already a member). Their statements, holds,
+# watchers and contact are dropped, and they leave the sheet. A body without the person merged into is a 400, a person not
+# on the sheet a 404; a user other than a steward, a merge into the same person or one not on the sheet, or either of them
+# retired, is a 400 — none writes anything. Responds with the person merged into, as stored.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMerge
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.person.CheckMerge
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: merge
+merge:
+  class: net.officefloor.hq.app.person.MergePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonMerged
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithMerge
