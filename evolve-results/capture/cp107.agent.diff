+# A steward merges the person into another on the sheet: their claims, aliases, patrons and pool
+# memberships move to the other, and they leave the list. Refused (400) for anyone else, the person
+# themselves, or either of them retired.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMerge
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: merge
+merge:
+  class: net.officefloor.hq.app.person.MergePerson
+  govern: [ transaction ]
+  next: record
+# Audit only once the merge is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonMerged
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
