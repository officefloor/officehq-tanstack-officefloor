+-- A person merged into another: the id of the person they were merged into. A merged person is
+-- kept for the sheet's history but leaves the list, and no change can be made to them. Null: not merged.
+ALTER TABLE person ADD COLUMN merged_into BIGINT;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge.POST.yml
new file mode 100644
index 000000000..8867c335b
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge.POST.yml
@@ -0,0 +1,40 @@
+# Merge a person into another on the sheet (a steward). Validate first so a bad body is a 400, not
+# a 404. Anyone else, the same person, or either of them retired, is refused and writes nothing.
+# The merged person's claims move to the other, and the merged person leaves the list.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateMerge
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: merge
+merge:
+  class: net.officefloor.hq.app.person.MergePerson
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the merge is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMerged
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
