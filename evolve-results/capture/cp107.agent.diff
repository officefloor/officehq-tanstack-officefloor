index 000000000..5a18b71f0
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge.POST.yml
@@ -0,0 +1,32 @@
+# POST /api/sheets/{sheetId}/people/{personId}/merge — merge a person into another on the sheet (body:
+# {into, user}, `into` the other's id). Only a steward merges. The person's claims move to the other
+# (numbers and dates kept, listed after the other's in the order they were added, each losing any figure a
+# statement bound); their name and aliases become the other's aliases; their patrons are added to the
+# other's (not the other themselves, none twice), anyone naming them as patron names the other instead
+# (none twice), and their pool memberships move to the other (shares added where the other is already a
+# member). Their statements, holds, watchers and contact are dropped, and they leave the sheet. Refused
+# (400), storing nothing, when the user is not a steward, either person is not on the sheet, they are the
+# same person, or either is retired. A stored merge is recorded in the audit file as PERSON_MERGED,
+# followed by how it moved the figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMerge
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: merge
+merge:
+  class: net.officefloor.hq.app.person.MergePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMerged
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithMerged
+  govern: [ transaction ]
