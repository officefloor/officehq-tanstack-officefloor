@@ -0,0 +1,38 @@
+# PUT /api/sheets/{sheetId}/people/{personId}/merge — a steward merges the person into another person of the sheet.
+# Body: { "intoId": <id> }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateMerge
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.ApplyMerge
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMerged
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithMergedInto
+  govern: [ transaction ]
