+# Merge a person into another (see MergePerson): the merged person leaves the sheet and every total follows.
+# A refused merge (no signed-in user, not a steward, unknown person, the same person, either retired) writes nothing,
+# not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMerge
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: merge
+merge:
+  class: net.officefloor.hq.app.person.MergePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMerged
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditMergeRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
