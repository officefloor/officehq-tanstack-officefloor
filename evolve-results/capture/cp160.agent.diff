+                BigDecimal figure = lateness.due(claim, rates.forClaim(claim).find(sheetId, person.gradeOn(claim.getDate()), claim.getDate()));
+                if (figure != null) {
+                    total = total.add(figure);
+                }
+            }
+            totals.put(person.getId(), total);
+        }
