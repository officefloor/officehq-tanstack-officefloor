+
+/** Works out one descendant sheet's own counts and hands them up; shows nothing. */
+function Descendant({ sheetId, user, report }: { sheetId: string; user: string; report: (id: string, c: Counts) => void }) {
+  const c = useCounts(sheetId, user);
+  useEffect(() => { if (c) report(sheetId, c); }, [sheetId, JSON.stringify(c)]);
+  return null;
