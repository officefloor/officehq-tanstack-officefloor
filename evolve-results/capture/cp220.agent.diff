         plans.changeAmount(plan.id(), today, amount);
         audit.recordOnCommit("PLAN_CHANGED sheet=" + sheetId + " by=" + request.user() + " name=" + (person != null ? person.getName() : "")
                 + " start=" + plan.start() + " amount=" + amount.toPlainString());
