new file mode 100644
index 000000000..90be17980
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unstate.POST.yml
@@ -0,0 +1,11 @@
+# A steward cancels a person's last statement: the claims it bound are live again, the count goes down by
+# one, and the person shows the statement before it (or nothing).
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: cancel
+cancel:
+  class: net.officefloor.hq.app.statement.CancelStatement
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
