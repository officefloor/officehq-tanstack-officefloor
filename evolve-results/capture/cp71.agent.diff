@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.statement;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.plugin.variable.Val;
+
+/** Record the statement cancelled in the audit file, with its due-total as the screen showed it (n/a when none). */
+public class AuditStatementCancelled {
+    public void audit(@Val StatementRequest request, @Val Statement statement, Audit audit) {
+        audit.record("STATEMENT_CANCELLED sheet=" + statement.sheetId() + " by=" + request.user()
+                + " name=" + statement.name()
+                + " due-total=" + (statement.dueTotal() != null ? statement.dueTotal().toPlainString() : "n/a"));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/statement/CancelStatement.java b/src/main/java/net/officefloor/hq/app/statement/CancelStatement.java
new file mode 100644
index 0000000..ea05492
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/statement/CancelStatement.java
@@ -0,0 +1,41 @@
+package net.officefloor.hq.app.statement;
+
+import net.officefloor.hq.app.claim.Claim;
+import net.officefloor.hq.app.claim.ClaimRepository;
+import net.officefloor.hq.app.person.InvalidPersonException;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.hq.app.person.PersonResponse;
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+
+/** Cancel the person's last statement: only a steward may, and only of a person with a statement. The claims it
+ *  bound become live again (a figure an earlier statement bound them to is not restored), there is one statement
+ *  fewer, and the row shows the one before it (or none). Publishes the cancelled statement (its due-total; the
+ *  claims it bound). */
+public class CancelStatement {
+    public void cancel(@Val StatementRequest request, @Val Person loaded, PersonRepository people,
+            ClaimRepository claims, RoleRepository roles, Out<Statement> statement, Out<PersonResponse> saved)
+            throws InvalidPersonException {
+        if (!Role.STEWARD.equals(roles.of(loaded.sheetId(), request.user()))) {
+            throw new InvalidPersonException("Only a steward may cancel a statement.");
+        }
+        people.lock(loaded);
+        Person person = people.find(loaded.sheetId(), loaded.id());
+        if (person.statementCount() == 0) {
+            throw new InvalidPersonException(person.name() + " has no statement to cancel.");
+        }
+        int bound = 0;
+        for (Claim c : claims.listForPerson(person.sheetId(), person.id())) {
+            if (c.stated()) {
+                bound++;
+                claims.state(c, false, null);
+            }
+        }
+        people.unstated(person);
+        statement.set(new Statement(person.sheetId(), person.name(), person.statedTotal(), bound));
+        saved.set(PersonResponse.from(people.find(person.sheetId(), person.id())));
+    }
+}
diff --git a/src/main/resources/db/migration/V46__person_statement.sql b/src/main/resources/db/migration/V46__person_statement.sql
new file mode 100644
index 0000000..5c29401
--- /dev/null
+++ b/src/main/resources/db/migration/V46__person_statement.sql
@@ -0,0 +1,13 @@
+-- Each statement taken of a person, in the order taken: its due-total (NULL when it was n/a) and date. The person
+-- keeps the last one's on their row; cancelling the last one removes it, and the row shows the one before it. A
+-- person stated before keeps their last statement here (the earlier ones were not kept).
+CREATE TABLE person_statement (
+    id             BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id       VARCHAR(100) NOT NULL REFERENCES sheet(id),
+    person_id      BIGINT       NOT NULL REFERENCES person(id),
+    due_total      DECIMAL(14, 2),
+    statement_date DATE
+);
+CREATE INDEX person_statement_sheet ON person_statement(sheet_id, person_id);
+INSERT INTO person_statement (sheet_id, person_id, due_total, statement_date)
+    SELECT sheet_id, id, stated_total, statement_date FROM person WHERE statement_count > 0;
