@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.plugin.variable.Val;
+
+/** Runs after the statement is cancelled: the cancelled statement's due-total. */
+public class RecordStatementCancelled {
+    public void record(@Val Statement statement, @Val Person person, Audit audit) {
+        audit.record("STATEMENT_CANCELLED sheet=" + person.getSheetId() + " by=" + statement.user()
+                + " name=" + person.getName()
+                + " due-total=" + (statement.dueTotal() != null ? statement.dueTotal().toPlainString() : "n/a"));
+    }
+}
diff --git a/src/main/resources/db/migration/V45__statement_history.sql b/src/main/resources/db/migration/V45__statement_history.sql
new file mode 100644
index 00000000..332a0b71
--- /dev/null
+++ b/src/main/resources/db/migration/V45__statement_history.sql
@@ -0,0 +1,16 @@
+-- Every statement taken for a person, numbered from 1 in the order taken (`seq`), with its
+-- due-total (null when n/a) and date: so cancelling the last one can show the one before it.
+-- The person's statement_count, stated_total and statement_date stay the last one's.
+CREATE TABLE person_statement (
+    id          BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id    VARCHAR(200) NOT NULL,
+    person_id   BIGINT       NOT NULL REFERENCES person (id),
+    seq         INT          NOT NULL,
+    stated_total DECIMAL(14,2),
+    statement_date DATE      NOT NULL
+);
+CREATE INDEX person_statement_person ON person_statement (person_id, seq);
+-- A statement taken before this was kept is known only as the last one.
+INSERT INTO person_statement (sheet_id, person_id, seq, stated_total, statement_date)
+    SELECT sheet_id, id, statement_count, stated_total, statement_date FROM person
+    WHERE statement_count > 0 AND statement_date IS NOT NULL;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unstate.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unstate.POST.yml
new file mode 100644
index 00000000..2be92d88
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/unstate.POST.yml
@@ -0,0 +1,27 @@
+# Cancel a person's last statement (a steward only): the claims it bound become live again, and the
+# person shows the statement before it, or none.
+validate:
+  class: net.officefloor.hq.app.person.ValidateStatement
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: cancel
+cancel:
+  class: net.officefloor.hq.app.person.CancelStatement
+  govern: [ transaction ]
+  next: record
+# Audit only once the statement is cancelled.
+record:
+  class: net.officefloor.hq.app.person.RecordStatementCancelled
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
