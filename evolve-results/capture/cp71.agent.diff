+# PUT /api/sheets/{sheetId}/people/{personId}/unstate — a steward cancels the person's last statement.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: cancel
+cancel:
+  class: net.officefloor.hq.app.statement.CancelStatement
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.statement.AuditStatementCancelled
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
