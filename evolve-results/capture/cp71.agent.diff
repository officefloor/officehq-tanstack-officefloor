+# A steward cancels the person's last statement. Responds with the sheet's statements.
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: cancel
+cancel:
+  class: net.officefloor.hq.app.statement.CancelStatement
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.statement.RespondWithStatements
+  govern: [ transaction ]
