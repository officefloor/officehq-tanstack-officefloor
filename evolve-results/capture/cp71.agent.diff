@@ -0,0 +1,36 @@
+# Cancel a person's last statement: the claims it bound become live again. Only a steward may, and
+# only when the person has a statement. An unknown person is a 404.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: cancel
+cancel:
+  class: net.officefloor.hq.app.statement.CancelStatement
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the cancellation is saved.
+audit:
+  class: net.officefloor.hq.app.statement.AuditStatementCancelled
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
