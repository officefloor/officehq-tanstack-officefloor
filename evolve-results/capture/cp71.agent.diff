diff --git a/src/main/java/net/officefloor/hq/app/statement/CancelStatement.java b/src/main/java/net/officefloor/hq/app/statement/CancelStatement.java
new file mode 100644
index 000000000..b0765615c
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/statement/CancelStatement.java
@@ -0,0 +1,52 @@
+package net.officefloor.hq.app.statement;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.BadRequestException;
+import net.officefloor.hq.app.CurrentUser;
+import net.officefloor.hq.app.claim.Claim;
+import net.officefloor.hq.app.claim.ClaimRepository;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.settings.SettingsRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** A steward cancels a person's last statement: the claims it bound are unbound (live again — a figure a
+ *  statement before it bound is not restored), the statement count goes down by one, and the person shows
+ *  the due-total and date of the statement before it (or nothing). Refused for anyone but a steward, and
+ *  for a person with no statement. */
+public class CancelStatement {
+    public void cancel(@PathVariable("sheetId") String sheetId, @PathVariable("personId") String personId,
+            ServerHttpConnection connection, PersonRepository people, ClaimRepository claims,
+            SettingsRepository settings, Audit audit, Rollup rollup, Out<Person> person) throws BadRequestException {
+        String by = CurrentUser.require(connection);
+        String id = sheetId == null ? "" : sheetId.trim();
+        long pid;
+        try {
+            pid = Long.parseLong(personId == null ? "" : personId.trim());
+        } catch (NumberFormatException e) {
+            throw new BadRequestException("no such person");
+        }
+        Person found = people.find(id, pid);
+        if (found == null) {
+            throw new BadRequestException("no such person");
+        }
+        if (!settings.role(id, by).equals(SettingsRepository.STEWARD)) {
+            throw new BadRequestException("only a steward can cancel a statement");
+        }
+        if (found.statementCount() <= 0) {
+            throw new BadRequestException(found.name() + " has no statement to cancel");
+        }
+        Rollup.Snapshot before = rollup.take(id);
+        for (Claim c : claims.ofPerson(id, pid)) {
+            claims.bind(id, c.id(), false, null, false);
+        }
+        people.unstated(id, pid);
+        audit.record("STATEMENT_CANCELLED sheet=" + id + " by=" + by + " name=" + found.name()
+                + " due-total=" + found.statedTotal());
+        rollup.record(id, by, before);
+        person.set(people.find(id, pid));
+    }
+}
diff --git a/src/main/resources/db/migration/V47__statement_history.sql b/src/main/resources/db/migration/V47__statement_history.sql
new file mode 100644
index 000000000..20abe6d84
--- /dev/null
+++ b/src/main/resources/db/migration/V47__statement_history.sql
@@ -0,0 +1,15 @@
+-- Each statement taken of a person, numbered 1, 2, ... in the order taken, with its due-total (as shown,
+-- so possibly 'n/a') and date. The person's stated_total and statement_date are those of the highest
+-- numbered one; cancelling the last statement removes it, and the person then shows the one before it
+-- (or nothing). A statement taken before this table only has its last one recorded.
+CREATE TABLE person_statement (
+    sheet_id       VARCHAR(200) NOT NULL REFERENCES sheet (id),
+    person_id      BIGINT NOT NULL,
+    seq            BIGINT NOT NULL,
+    due_total      VARCHAR(20),
+    statement_date DATE NOT NULL,
+    PRIMARY KEY (sheet_id, person_id, seq)
+);
+INSERT INTO person_statement (sheet_id, person_id, seq, due_total, statement_date)
+    SELECT sheet_id, id, statement_count, stated_total, statement_date FROM person
+    WHERE statement_count > 0 AND statement_date IS NOT NULL;
