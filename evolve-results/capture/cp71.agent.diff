@@ -0,0 +1,27 @@
+# POST /api/sheets/{sheetId}/people/{personId}/unstate — cancel the person's last statement (body:
+# {user}): removes it and unbinds every claim it bound, so they follow their live figures again (a
+# figure bound by an earlier statement is not restored). Refused (400) unless a steward cancels, or when
+# the person is not on the sheet or has no statement; nothing is stored then. A cancelled statement is
+# recorded in the audit file as STATEMENT_CANCELLED.
+validate:
+  class: net.officefloor.hq.app.statement.ValidateCancelStatement
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: cancel
+cancel:
+  class: net.officefloor.hq.app.statement.CancelStatement
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.statement.AuditStatementCancelled
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
