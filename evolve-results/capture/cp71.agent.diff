+# Cancel a person's last statement: the claims it bound become live again, and the row shows the statement before it.
+# A refused cancel (no signed-in user, not a steward, unknown person, no statement) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.statement.ValidateStatement
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: cancel
+cancel:
+  class: net.officefloor.hq.app.statement.CancelStatement
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.statement.AuditStatementCancelled
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditStatementRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
