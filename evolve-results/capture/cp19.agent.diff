+# POST /api/sheets/{sheetId}/quick-add — add a DRAFT claim (the sheet's today, empty note) to the
+# named person, adding them first with grade A when the name is not on the sheet. Refused like the
+# person and claim forms, before anything is written: a refusal leaves no new person behind.
+validate:
+  class: net.officefloor.hq.app.quick.ValidateQuickAdd
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.quick.FindOrAddPerson
+  govern: [ transaction ]
+  next: claimBefore
+claimBefore:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: create
+create:
+  class: net.officefloor.hq.app.claim.AddClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimAdded
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
