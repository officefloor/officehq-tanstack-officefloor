+  class: net.officefloor.hq.app.quickadd.ValidateQuickAdd
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: closed
+closed:
+  class: net.officefloor.hq.app.quickadd.RefuseClosedQuickAdd
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.quickadd.FindOrAddQuickAddPerson
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: save
+save:
