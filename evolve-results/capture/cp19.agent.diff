@@ -0,0 +1,38 @@
+# Quick-add a DRAFT claim by person name, creating the person (grade A) when the name is not on the
+# sheet. One change: everything is checked before anything is saved, so a refused claim leaves no
+# new person behind and writes nothing.
+validate:
+  class: net.officefloor.hq.app.quickadd.ValidateQuickAdd
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: find
+find:
+  class: net.officefloor.hq.app.quickadd.FindQuickAddPerson
+  govern: [ transaction ]
+  next: refuse
+refuse:
+  class: net.officefloor.hq.app.quickadd.RefuseClosedQuickAdd
+  govern: [ transaction ]
+  next: savePerson
+savePerson:
+  class: net.officefloor.hq.app.quickadd.SaveQuickAddPerson
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.claim.BuildClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: record
+record:
+  class: net.officefloor.hq.app.quickadd.RecordQuickAdd
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimCreated
+  govern: [ transaction ]
