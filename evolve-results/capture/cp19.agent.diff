+  govern: [ transaction ]
+  next: rollup-before
+rollup-before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.claim.BuildClaim
+  govern: [ transaction ]
+  next: audit
+audit:
