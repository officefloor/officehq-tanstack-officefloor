+# The quick-add bar: a DRAFT claim, dated the sheet's today with an empty note, for the named person,
+# who is added with grade A when not on the sheet. One change: every rule of the person and claim
+# forms is checked before anything is written, so a refused quick-add adds no person and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateQuickAdd
+  next: unclosed
+unclosed:
+  class: net.officefloor.hq.app.claim.CheckQuickAddOpen
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.claim.ResolveQuickPerson
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: create
+create:
+  class: net.officefloor.hq.app.claim.CreateClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimAdded
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
