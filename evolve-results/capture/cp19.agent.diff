@@ -0,0 +1,42 @@
+# The quick-add bar: a DRAFT claim of the given amount, dated the sheet's today with an empty note,
+# for the named person, who is created with grade A when not on the sheet. Validate first so an
+# empty name or a bad amount is a 400 and writes nothing; a sheet's today inside a closed period is
+# refused (409) before a new person is saved.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateQuickClaim
+  next: find
+find:
+  class: net.officefloor.hq.app.claim.FindQuickPerson
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.claim.CheckQuickClaimPeriod
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.claim.SaveQuickPerson
+  govern: [ transaction ]
+  next: auditPerson
+auditPerson:
+  class: net.officefloor.hq.app.claim.AuditQuickPersonAdded
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.claim.BuildClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
