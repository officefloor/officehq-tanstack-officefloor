@@ -0,0 +1,37 @@
+# POST /api/sheets/{sheetId}/quick-add — add a DRAFT claim for the named person, dated the sheet's today with
+# an empty note, adding the person (grade A) first when the name is not on the sheet. Body:
+# { "name": "...", "amount": "12.50" }. Every check runs before anything is stored, so a refusal adds nobody.
+validate:
+  class: net.officefloor.hq.app.quickadd.ValidateQuickAdd
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.quickadd.CheckQuickAddDate
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.quickadd.FindOrAddPerson
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.claim.BuildClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimAdded
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
