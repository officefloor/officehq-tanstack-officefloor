+# Validate every person and claim rule first so a refusal writes nothing, then find or add the
+# person and add the draft claim (the claim form's BuildClaim). Responds with people and claims.
+validate:
+  class: net.officefloor.hq.app.quickadd.ValidateQuickAdd
+  govern: [ transaction ]
+  next: resolve
+resolve:
+  class: net.officefloor.hq.app.quickadd.ResolveQuickAddPerson
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.claim.BuildClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.quickadd.RespondWithQuickAdd
+  govern: [ transaction ]
