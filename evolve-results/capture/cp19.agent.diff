+# The quick-add bar: a claim for a person named in the body, adding the person when needed.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateQuickClaim
+  next: snapshot
+# The sheet's figures before the change, so the change can audit what it moved.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
