@@ -0,0 +1,20 @@
+package net.officefloor.hq.app.quick;
+
+import net.officefloor.hq.app.claim.ClaimInput;
+import net.officefloor.hq.app.claim.ClaimRequest;
+import net.officefloor.hq.app.claim.InvalidClaimException;
+import net.officefloor.hq.app.person.InvalidPersonException;
+import net.officefloor.hq.app.person.PersonRequest;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Checks the name by the person form's rules and the amount by the claim form's: dated today, no note. */
+public class ValidateQuickAdd {
+    public void validate(@RequestBody QuickAddRequest request, Out<QuickAdd> quickOut, Out<ClaimInput> claimOut)
+            throws InvalidPersonException, InvalidClaimException {
+        String name = PersonRequest.checkName(request == null ? null : request.name());
+        ClaimInput claim = ClaimInput.from(new ClaimRequest(request.amount(), "", ""));
+        quickOut.set(new QuickAdd(name));
+        claimOut.set(claim);
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/quick.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/quick.POST.yml
new file mode 100644
index 000000000..954c7398d
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/quick.POST.yml
@@ -0,0 +1,53 @@
+# Quick-add: a DRAFT claim for the named person, dated the sheet's today with no note, adding the
+# person (grade A) when the name is not on the sheet. One change: every rule is checked before
+# anything is written, so a refusal leaves no new person behind. A bad name or amount is a 400.
+validate:
+  class: net.officefloor.hq.app.quick.ValidateQuickAdd
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: find
+find:
+  class: net.officefloor.hq.app.quick.FindQuickAddPerson
+  govern: [ transaction ]
+  next: closed
+# A claim dated inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.quick.CheckQuickAddPeriod
+  govern: [ transaction ]
+  next: savePerson
+savePerson:
+  class: net.officefloor.hq.app.quick.SaveQuickAddPerson
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.claim.BuildClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: auditPerson
+# Every rule has passed and the change is saved: the person's lines (when they are new), then the
+# figures they moved, then the claim's. A DRAFT claim moves no figures, so the rollup is the person's.
+auditPerson:
+  class: net.officefloor.hq.app.quick.AuditQuickAddPerson
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
