@@ -0,0 +1,10 @@
+package net.officefloor.hq.app.sheet;
+
+import net.officefloor.hq.app.setting.ViewerRefusedException;
+
+/** A change asked for on an archived sheet: everything stays visible and nothing changes, so it is refused and nothing is written. */
+public class SheetArchivedException extends ViewerRefusedException {
+    public SheetArchivedException() {
+        super("The sheet is archived: nothing on it can change");
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/sheet/Sheets.java b/src/main/java/net/officefloor/hq/app/sheet/Sheets.java
index d5bd6894..fbcc66f8 100644
--- a/src/main/java/net/officefloor/hq/app/sheet/Sheets.java
+++ b/src/main/java/net/officefloor/hq/app/sheet/Sheets.java
@@ -50,4 +50,15 @@ public class Sheets {
     public void setToday(String sheetId, LocalDate today) {
         jdbc.update("MERGE INTO sheet (id, today) KEY (id) VALUES (?, ?)", sheetId, Date.valueOf(today));
     }
+
+    /** Whether the sheet is archived: everything on it stays visible and every change to it is refused. */
+    public boolean archived(String sheetId) {
+        today(sheetId); // the sheet's row holds the flag
+        return Boolean.TRUE.equals(jdbc.queryForObject("SELECT archived FROM sheet WHERE id = ?", Boolean.class, sheetId));
+    }
+
+    public void archive(String sheetId) {
+        today(sheetId);
+        jdbc.update("UPDATE sheet SET archived = TRUE WHERE id = ?", sheetId);
+    }
 }
