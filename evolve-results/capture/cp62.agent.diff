diff --git a/src/main/java/net/officefloor/hq/app/sheet/RefuseArchived.java b/src/main/java/net/officefloor/hq/app/sheet/RefuseArchived.java
new file mode 100644
index 00000000..8307de98
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/sheet/RefuseArchived.java
@@ -0,0 +1,12 @@
+package net.officefloor.hq.app.sheet;
+
+import org.springframework.web.bind.annotation.PathVariable;
+
+public class RefuseArchived {
+    // An archived sheet keeps everything visible and changes nothing: every write is refused before anything is read, stored or recorded.
+    public void refuse(@PathVariable("sheetId") String sheetId, Sheets sheets) throws SheetArchivedException {
+        if (sheets.isArchived(sheetId.trim())) {
+            throw new SheetArchivedException("The sheet is archived: it can change nothing.");
+        }
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/sheet/RefuseNonSteward.java b/src/main/java/net/officefloor/hq/app/sheet/RefuseNonSteward.java
