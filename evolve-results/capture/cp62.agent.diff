+# POST /api/sheets/{sheetId}/archive — a steward archives the sheet: everything stays visible and every
+# change to it is refused from then on. Anyone else (and an archived sheet) is refused.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archive
+archive:
+  class: net.officefloor.hq.app.sheet.ArchiveSheet
+  govern: [ transaction ]
+  next: record
+record:
+  class: net.officefloor.hq.app.sheet.RecordSheetArchived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheet
