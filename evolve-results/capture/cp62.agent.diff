@@ -0,0 +1,15 @@
+# Archive the sheet: a steward only, and only once. A refused archive writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateArchive
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.sheet.SaveArchive
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheet
+  govern: [ transaction ]
