diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/archive.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/archive.POST.yml
new file mode 100644
index 00000000..5988413e
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/archive.POST.yml
@@ -0,0 +1,16 @@
+# Archive the sheet. Only a steward may; an archived sheet is refused by ViewerGuard before this
+# runs. Audit only once the change is saved: a refused change writes no line.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateArchive
+  next: archive
+archive:
+  class: net.officefloor.hq.app.sheet.ArchiveSheet
+  govern: [ transaction ]
+  next: record
+record:
+  class: net.officefloor.hq.app.sheet.RecordSheetArchived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheet
+  govern: [ transaction ]
