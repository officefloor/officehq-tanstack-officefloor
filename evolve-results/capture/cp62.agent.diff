@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/archive — archive the sheet: it stays visible and every change to it is refused from then
+# on (see ViewerGuard). Only a steward may archive; a user who is not a steward, or a sheet already archived, is a 400
+# and writes nothing. Responds with the sheet as stored.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateArchive
+  next: archive
+archive:
+  class: net.officefloor.hq.app.sheet.ArchiveSheet
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.sheet.RecordSheetArchived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheet
