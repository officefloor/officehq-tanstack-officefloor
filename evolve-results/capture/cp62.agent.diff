--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/archive.POST.yml
@@ -0,0 +1,17 @@
+# POST /api/sheets/{sheetId}/archive — archive the sheet (body: {user}). Only a steward may, and only
+# once; anyone else, or a sheet already archived, is refused (400) and nothing is stored. An archived
+# sheet stays visible and refuses every change. Recorded in the audit file as SHEET_ARCHIVED.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateArchive
+  next: save
+save:
+  class: net.officefloor.hq.app.sheet.SaveArchive
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.sheet.AuditArchived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheet
+  govern: [ transaction ]
