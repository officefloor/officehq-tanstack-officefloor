+++ b/src/main/java/net/officefloor/hq/app/sheet/SheetStore.java
@@ -28,4 +28,23 @@ public class SheetStore {
     public void setToday(String sheetId, LocalDate today) {
         jdbc.update("MERGE INTO sheet (id, today) KEY (id) VALUES (?, ?)", sheetId, today);
     }
+
+    /** Whether the sheet is archived: visible, but every change to it is refused. */
+    public boolean archived(String sheetId) {
+        List<Boolean> found = jdbc.query("SELECT archived FROM sheet WHERE id = ?",
+                (rs, i) -> rs.getBoolean(1), sheetId);
+        return !found.isEmpty() && found.get(0);
+    }
+
+    /** Archives the sheet, keeping its today as it reads now. */
+    public void archive(String sheetId) {
+        jdbc.update("MERGE INTO sheet (id, today, archived) KEY (id) VALUES (?, ?, TRUE)", sheetId, today(sheetId));
+    }
+
+    /** Refuses any change to an archived sheet. */
+    public void refuseArchived(String sheetId) throws InvalidSheetException {
+        if (archived(sheetId)) {
+            throw new InvalidSheetException("The sheet is archived");
+        }
+    }
 }
diff --git a/src/main/java/net/officefloor/hq/app/sheet/ValidateArchive.java b/src/main/java/net/officefloor/hq/app/sheet/ValidateArchive.java
new file mode 100644
index 000000000..d55735db6
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/sheet/ValidateArchive.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.sheet;
+
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Refuses archiving by anyone but a steward, and archiving a sheet already archived. */
+public class ValidateArchive {
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody ArchiveRequest request,
+            Out<ArchiveRequest> body, RoleStore roles, SheetStore sheets) throws InvalidSheetException {
+        String sheet = sheetId.trim();
+        String user = request == null || request.user() == null ? "" : request.user().trim();
+        if (roles.find(sheet, user) != Role.STEWARD) {
+            throw new InvalidSheetException("Only a steward can archive the sheet");
+        }
+        sheets.refuseArchived(sheet);
+        body.set(new ArchiveRequest(user));
+    }
+}
