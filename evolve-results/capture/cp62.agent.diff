@@ -0,0 +1,23 @@
+# A steward archives the sheet: everything stays visible, every change after is refused. Anyone else, or a sheet
+# already archived, is refused and nothing is written.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: by
+by:
+  class: net.officefloor.hq.app.sheet.ValidateArchive
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.sheet.ApplyArchive
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.sheet.RecordSheetArchived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheetToday
+  govern: [ transaction ]
