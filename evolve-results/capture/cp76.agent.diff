diff --git a/src/main/java/net/officefloor/hq/app/rollup/AuditSnapshots.java b/src/main/java/net/officefloor/hq/app/rollup/AuditSnapshots.java
new file mode 100644
index 00000000..3eef8c39
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rollup/AuditSnapshots.java
@@ -0,0 +1,18 @@
+package net.officefloor.hq.app.rollup;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.plugin.variable.Val;
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.web.bind.annotation.PathVariable;
+
+public class AuditSnapshots {
+    // Once the sheet's today is changed: one SNAPSHOT per person, in list order, with the due-total as it stood on the
+    // day being left (the figures taken before the change), before any period closes and before the ROLLUP lines.
+    public void audit(@PathVariable("sheetId") String sheetId, @Val Figures before, ServerHttpConnection connection,
+            Audit audit) {
+        String sheet = sheetId.trim();
+        String user = Audit.user(connection);
+        before.people().values().forEach(person -> audit.record(
+                Audit.line("SNAPSHOT", sheet, user, "name=" + person.name(), "due-total=" + person.dueTotal())));
+    }
+}
