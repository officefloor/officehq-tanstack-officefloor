diff --git a/src/main/java/net/officefloor/hq/app/claim/ValidateBulkReassign.java b/src/main/java/net/officefloor/hq/app/claim/ValidateBulkReassign.java
new file mode 100644
index 000000000..134b93b9f
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ValidateBulkReassign.java
@@ -0,0 +1,43 @@
+package net.officefloor.hq.app.claim;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateBulkReassign {
+    public void validate(@RequestBody BulkReassignRequest request, Out<BulkReassignInput> body) throws InvalidSheetException {
+        if (request == null || request.claimIds() == null || request.claimIds().isEmpty()) {
+            throw new InvalidSheetException("Select the claims to move");
+        }
+        String to = request.to() == null ? "" : request.to().trim();
+        if (to.isEmpty()) {
+            throw new InvalidSheetException("Choose the person to move the claims to");
+        }
+        long toId;
+        try {
+            toId = Long.parseLong(to);
+        } catch (NumberFormatException e) {
+            throw new InvalidSheetException("No such person: " + to);
+        }
+        Set<String> seen = new LinkedHashSet<>();
+        List<Long> ids = new ArrayList<>();
+        for (String raw : request.claimIds()) {
+            String id = raw == null ? "" : raw.trim();
+            if (!seen.add(id)) {
+                continue;
+            }
+            Long parsed = null;
+            try {
+                parsed = Long.parseLong(id);
+            } catch (NumberFormatException e) {
+                // not an id: no such claim, refused
+            }
+            ids.add(parsed);
+        }
+        body.set(new BulkReassignInput(ids, toId, request.user()));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-reassign.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-reassign.POST.yml
new file mode 100644
index 000000000..0fb03f01b
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-reassign.POST.yml
@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/bulk-reassign — move the selected claims to another person together (body
+# {claimIds, to, user}, `to` the person's id). Each selected claim is moved in list order — people in the
+# order they were added, a person's claims newest first — by exactly the rules of a single move by the user
+# (who may, which statuses, closed periods, retirement), and recorded as a single move is (CLAIM_REASSIGNED
+# and its rollup lines); each that a single move would refuse is refused and left as it is. Answers
+# {reassigned, refused}. Refused (400) only when no claim or no person is chosen.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkReassign
+  next: reassign
+reassign:
+  class: net.officefloor.hq.app.claim.ReassignClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkReassign
+  govern: [ transaction ]
