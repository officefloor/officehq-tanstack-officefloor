@@ -0,0 +1,18 @@
+# Move the selected claims to one person together, in list order, by the rules of moving one. Each
+# that cannot be moved is refused and left as it is; the response tells how many were moved and how
+# many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkReassign
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: reassign
+# Each claim moved is audited as it is moved: its own line, then the figures it moved.
+reassign:
+  class: net.officefloor.hq.app.claim.ReassignSelectedClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkReassign
+  govern: [ transaction ]
