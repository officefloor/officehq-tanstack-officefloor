+# Move the selected claims to another person together. Each that can move is moved and audited as a
+# single reassignment would be, with the figures it moved, in list order; each that cannot is left
+# as it is. Answers how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkReassign
+  next: reassign
+reassign:
+  class: net.officefloor.hq.app.claim.ReassignClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkReassign
+  govern: [ transaction ]
