+# Move the selected claims together to one person, in list order, by the signed-in user. Each that can be moved is
+# moved (audited and rolled up as a single move is); each that cannot is left as it is. Responds with how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkReassign
+  next: reassign
+reassign:
+  class: net.officefloor.hq.app.claim.BulkReassignClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkReassign
+  govern: [ transaction ]
