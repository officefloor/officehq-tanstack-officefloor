+package net.officefloor.hq.app.claim;
+
+import java.util.List;
+import java.util.Objects;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the body: the selected claim ids (each once; a missing list is none), the person they move to (a move needs
+ *  one) and who moves them. */
+public class ValidateBulkReassign {
+    public void validate(@RequestBody BulkReassignRequest request, Out<BulkReassignRequest> body)
+            throws InvalidClaimStatusException {
+        if (request == null || request.personId() == null) {
+            throw new InvalidClaimStatusException("A move needs the person the claims move to");
+        }
+        List<Long> ids = request.claimIds() == null ? List.of()
+                : request.claimIds().stream().filter(Objects::nonNull).distinct().toList();
+        String by = request.by() == null ? "" : request.by().trim();
+        body.set(new BulkReassignRequest(ids, request.personId(), by));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-reassign.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-reassign.POST.yml
new file mode 100644
index 000000000..ec2b55235
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-reassign.POST.yml
@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/bulk-reassign — move the selected claims to one person together. Each selected claim is
+# moved by the signed-in user exactly as the single move does (see ApplyReassign), in list order: people in the order
+# they were added, a person's claims newest first; each writes its own CLAIM_REASSIGNED and figure lines. A claim
+# already the person's counts as moved. Each that cannot be moved (or is not on the sheet) is left as it is and counted
+# refused. No person named is a 409. Responds with how many were moved and how many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkReassign
+  next: reassign
+reassign:
+  class: net.officefloor.hq.app.claim.ReassignClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkReassign
