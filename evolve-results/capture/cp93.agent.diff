@@ -0,0 +1,15 @@
+# Move the selected claims to another person together, in list order (people as added, each one's claims newest
+# first). One that cannot be moved is left as it is; answers how many were moved and how many refused.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: selected
+selected:
+  class: net.officefloor.hq.app.claim.ValidateBulkReassign
+  next: reassign
+reassign:
+  class: net.officefloor.hq.app.claim.ReassignClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkReassign
+  govern: [ transaction ]
