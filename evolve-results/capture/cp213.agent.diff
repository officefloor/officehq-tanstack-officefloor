@@ -0,0 +1,15 @@
+package net.officefloor.hq.app.plan;
+
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.hq.app.sheet.SheetRepository;
+import net.officefloor.plugin.variable.Val;
+
+/** Refuses a plan sheet that is not one of the sheet's descendants (its children, their children, and so on). A plan
+ *  naming no sheet is not checked. */
+public class ValidatePlanSheet {
+    public void validate(@Val PlanInput input, @Val Sheet sheet, SheetRepository sheets) throws InvalidPlanException {
+        if (input.sheet() != null && !sheets.descendantsOf(sheet.getId()).contains(input.sheet())) {
+            throw new InvalidPlanException("The sheet " + input.sheet() + " is not a descendant of this sheet.");
+        }
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/sheet/SheetRepository.java b/src/main/java/net/officefloor/hq/app/sheet/SheetRepository.java
index b87836a3..371c39e3 100644
--- a/src/main/java/net/officefloor/hq/app/sheet/SheetRepository.java
+++ b/src/main/java/net/officefloor/hq/app/sheet/SheetRepository.java
@@ -1,6 +1,10 @@
 package net.officefloor.hq.app.sheet;
 
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.HashSet;
 import java.util.List;
+import java.util.Set;
 import org.springframework.data.jpa.repository.JpaRepository;
 import org.springframework.data.jpa.repository.Query;
 import org.springframework.data.repository.query.Param;
@@ -14,4 +18,19 @@ public interface SheetRepository extends JpaRepository<Sheet, String> {
     /** The parent sheet a sheet names (its undated parent setting); empty (or a null value) when none. */
     @Query("select s.value from SheetSetting s where s.sheet.id = :sheetId and s.key = 'parent'")
     List<String> parentsOf(@Param("sheetId") String sheetId);
+
+    /** The ids of the sheet's descendants: its children, their children, and so on. */
+    default Set<String> descendantsOf(String sheetId) {
+        Set<String> seen = new HashSet<>();
+        Deque<String> todo = new ArrayDeque<>();
+        todo.push(sheetId);
+        while (!todo.isEmpty()) {
+            for (String child : childrenOf(todo.pop())) {
+                if (!child.equals(sheetId) && seen.add(child)) {
+                    todo.push(child);
+                }
+            }
+        }
+        return seen;
+    }
 }
