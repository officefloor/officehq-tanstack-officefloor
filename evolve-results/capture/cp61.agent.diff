@@ -0,0 +1,18 @@
+# Delegate the steward role to a user for a from-date to a to-date. Validate first so a refused
+# delegation (not by a steward, or a to-date before the from-date) is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.settings.ValidateDelegation
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.settings.SaveDelegation
+  govern: [ transaction ]
+  next: record
+# Audit only once the delegation is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.settings.RecordDelegated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.settings.RespondWithSettings
+  govern: [ transaction ]
