+# A steward delegates the steward role to a user for a from-date and a to-date, inclusive.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.delegation.ValidateDelegation
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.delegation.SaveDelegation
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.delegation.AuditDelegated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.delegation.RespondWithDelegation
+  govern: [ transaction ]
