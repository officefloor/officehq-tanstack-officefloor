+# POST /api/sheets/{sheetId}/delegations — a steward delegates the steward role to a user name. Body
+# {"user":"wes","from":"yyyy-mm-dd","to":"yyyy-mm-dd"}, both dates inclusive; a blank from-date is the sheet's today,
+# a blank to-date the from-date. Anyone but a steward, a blank user, a date that is not real, or a to-date before the
+# from-date is refused with 400 and nothing is stored or recorded.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.setting.ValidateDelegation
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.setting.ApplyDelegation
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.setting.AuditDelegated
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.setting.RespondWithDelegation
+  govern: [ transaction ]
