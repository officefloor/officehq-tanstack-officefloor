+# anyone but a steward, a blank name or a to-date before the from-date is refused (400).
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: validate
+validate:
+  class: net.officefloor.hq.app.setting.ValidateDelegationRequest
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.setting.SaveDelegation
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.setting.AuditDelegated
+  govern: [ transaction ]
+  next: settings
+settings:
+  class: net.officefloor.hq.app.setting.LoadSettings
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.setting.RespondWithSettings
+  govern: [ transaction ]
