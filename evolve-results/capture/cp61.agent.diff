+# POST /api/sheets/{sheetId}/delegations — a steward delegates the steward role to a user for a from- and to-date,
+# both inclusive (a blank from-date is the sheet's today, a blank to-date the from-date). Anyone but a steward, a blank
+# user, a bad date or a to-date before the from-date is a 400 and writes nothing. Responds 201 with the delegation.
+validate:
+  class: net.officefloor.hq.app.role.ValidateDelegation
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.role.SaveDelegation
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.role.RecordDelegated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.role.RespondWithDelegationCreated
