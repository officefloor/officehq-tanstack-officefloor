+# A steward delegates the steward role to a user for a from-date to a to-date. Validate the body before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: delegate
+delegate:
+  class: net.officefloor.hq.app.access.ValidateDelegate
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.access.ApplyDelegate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.access.RecordDelegated
+  govern: [ transaction ]
+  next: respond
