+# POST /api/sheets/{sheetId}/delegations — a steward delegates the steward role to a user for a
+# from-date..to-date, inclusive (body: {user, from, to, by}). Anyone but a steward, or a to-date
+# before the from-date, is refused (400) and nothing is stored. Recorded as DELEGATED.
+validate:
+  class: net.officefloor.hq.app.role.ValidateDelegation
+  next: save
+save:
+  class: net.officefloor.hq.app.role.SaveDelegation
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.role.AuditDelegated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.role.RespondWithDelegation
+  govern: [ transaction ]
