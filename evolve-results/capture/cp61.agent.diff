@@ -0,0 +1,22 @@
+# POST /api/sheets/{sheetId}/delegations — a steward delegates the steward role. Body: { "user", "from", "to" }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.role.ValidateDelegation
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.role.ApplyDelegation
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.role.AuditDelegated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.role.RespondWithDelegation
+  govern: [ transaction ]
