+            repository.saveDated(sheet.id(), DatedSettings.REVIEW_THRESHOLD,
+                    DatedSettings.fromOr(threshold.from(), sheet.today()),
+                    threshold.value() == null ? null : threshold.value().toPlainString());
+        }
+    }
+}
