diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review.POST.yml
new file mode 100644
index 000000000..e64b06935
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/review.POST.yml
@@ -0,0 +1,60 @@
+# Review a claim in REVIEW (a steward): it is OPEN, numbered then. A change its status does not allow
+# is a 409, and anyone not a steward is refused; both write nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+# A claim due by a date inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: cap
+# A claim whose period caps open claims, its person already at the cap, is a 409 and writes nothing.
+cap:
+  class: net.officefloor.hq.app.period.CheckPeriodCap
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ReviewClaim
+  govern: [ transaction ]
+  next: number
+# Takes the sheet's next number only once the review is allowed.
+number:
+  class: net.officefloor.hq.app.claim.NumberReviewedClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: log
+# The status it was saved at, with who, when and its due then.
+log:
+  class: net.officefloor.hq.app.claim.LogClaimStatus
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReviewed
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
