+# GET /api/sheets/{sheetId}/claims/{claimId}/timeline — the audit lines about the claim, newest first, exactly as the
+# audit file holds them: those carrying number=<its number>, or for a claim with no number those naming its person,
+# amount and date together. 404 for a claim not on the sheet.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: respond
+  govern: [ readonly-transaction ]
+respond:
+  class: net.officefloor.hq.app.auditview.RespondWithClaimTimeline
+  govern: [ readonly-transaction ]
