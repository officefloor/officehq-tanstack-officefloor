+# The claim's timeline: the sheet's audit lines about it, newest first, as the audit file holds
+# them — the lines carrying its number, or, for a claim with no number, the unnumbered lines naming
+# its person, amount and date together. Reads the file; records nothing.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimTimeline
+  govern: [ readonly-transaction ]
