+# GET /api/sheets/{sheetId}/claims/{claimId}/timeline — the audit lines about the claim, newest first, as the file
+# holds them. Reads the file; writes nothing.
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: claim
+claim:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimTimeline
+  govern: [ transaction ]
