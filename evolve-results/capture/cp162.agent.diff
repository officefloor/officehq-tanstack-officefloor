--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/timeline.GET.yml
@@ -0,0 +1,10 @@
+# GET /api/sheets/{sheetId}/claims/{claimId}/timeline — the audit lines about the claim as the file holds them, newest
+# first: those carrying number=<its number>, or for a claim with no number those (carrying no number) naming its
+# person, amount and date together. An unknown claim is a 404.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimTimeline
+  govern: [ readonly-transaction ]
