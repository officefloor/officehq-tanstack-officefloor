+# The claim's audit lines as the audit file holds them, newest first: those carrying its number, or for
+# a claim with no number those naming its person, amount and date together.
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ readonly-transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimTimeline
+  govern: [ readonly-transaction ]
