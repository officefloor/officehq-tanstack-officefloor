@@ -0,0 +1,10 @@
+# GET /api/sheets/{sheetId}/claims/{claimId}/timeline — the audit lines about the claim, newest first, read from
+# the audit file: those carrying its number, or for a claim with no number those (with no number) naming its
+# person, amount and date together. 400 for a claim not on the sheet.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimTimeline
+  govern: [ readonly-transaction ]
