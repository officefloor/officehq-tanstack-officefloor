+# A claim's timeline: the sheet's audit lines about it as the file holds them, newest first. It records nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimTimeline
+  govern: [ readonly-transaction ]
