+# A claim's timeline: the audit lines about it, newest first, exactly as the audit file holds them — those carrying
+# number=<its number>, or for a claim with no number those naming its person, amount and date. 404 for an unknown claim.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.audit.RespondWithClaimTimeline
+  govern: [ readonly-transaction ]
