diff --git a/src/main/resources/db/migration/V37__setting_perm.sql b/src/main/resources/db/migration/V37__setting_perm.sql
new file mode 100644
index 000000000..b8c3949c1
--- /dev/null
+++ b/src/main/resources/db/migration/V37__setting_perm.sql
@@ -0,0 +1,10 @@
+-- A sheet's permission matrix: for each action (open, settle, void, reassign, close, reopen) the
+-- roles that may take it, a comma separated list of clerk and steward. Not dated. An action with no
+-- row, or a blank list, keeps the standing rule: open, settle, void and close by clerk and steward;
+-- reassign and reopen by steward.
+CREATE TABLE setting_perm (
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    action VARCHAR(20) NOT NULL,
+    roles VARCHAR(200) NOT NULL,
+    PRIMARY KEY (sheet_id, action)
+);
