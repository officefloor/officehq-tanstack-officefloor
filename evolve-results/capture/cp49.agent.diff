+# POST /api/sheets/{sheetId}/claims/paste — add a DRAFT claim per pasted line. Body {"text":"..."}, lines of
+# name,amount,date,note (a blank date is the sheet's today; the note may hold commas or be absent). Every line is
+# checked first, by the claim form's rules and against a person of that name (ignoring case) on the sheet: 400 for a
+# bad line or a name not on the sheet, 422 for a date inside a closed period or after the person's retirement —
+# and then nothing is stored. Responds {"added":n}.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.claim.ValidatePaste
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.claim.AddPastedClaims
+  next: rollup
+  govern: [ transaction ]
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithPasted
+  govern: [ transaction ]
