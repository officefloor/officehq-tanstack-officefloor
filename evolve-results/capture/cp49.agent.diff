+# Paste claims: lines of name,amount,date,note, each a draft claim for the named person (who must be on
+# the sheet), checked by the claim form's rules. One change: if any line is refused, nothing is added.
+validate:
+  class: net.officefloor.hq.app.paste.ValidatePaste
+  next: save
+save:
+  class: net.officefloor.hq.app.paste.PasteClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.paste.RespondWithPaste
