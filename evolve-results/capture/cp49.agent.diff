@@ -0,0 +1,30 @@
+# Paste: a DRAFT claim per line of name,amount,date,note (the note may hold commas; a blank date is the sheet's
+# today; the note may be absent), in order, for the person on the sheet with that name (ignoring case). Every line
+# is checked first with the claim form's rules (and its name must be on the sheet); any line refused refuses the
+# whole paste (400) and nothing is added. Answers how many claims were added.
+validate:
+  class: net.officefloor.hq.app.paste.ValidatePasteRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: people
+people:
+  class: net.officefloor.hq.app.paste.FindPastedPeople
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.paste.SavePastedClaims
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.paste.RespondWithPasteResult
+  govern: [ transaction ]
