@@ -0,0 +1,17 @@
+# Paste claims: each line name,amount,date,note adds a DRAFT claim for the named person, in order. Every line is
+# checked first by the claim form's rules (and the name must be on the sheet); one failing line refuses the whole
+# paste, which writes nothing, not even an audit line. Responds with how many were added.
+validate:
+  class: net.officefloor.hq.app.claim.ValidatePaste
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: paste
+paste:
+  class: net.officefloor.hq.app.claim.PasteClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithPaste
+  govern: [ transaction ]
