+# Check every pasted line by the claim form's rules first so a refusal writes nothing, then add a draft claim per
+# line, in order. Responds with how many were added, and the claims.
+validate:
+  class: net.officefloor.hq.app.paste.ValidatePaste
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.paste.AddPastedClaims
+  govern: [ transaction ]
