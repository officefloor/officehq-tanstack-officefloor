--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/paste-claims.POST.yml
@@ -0,0 +1,25 @@
+# POST /api/sheets/{sheetId}/paste-claims — add a DRAFT claim per pasted line of name,amount,date,note, in order,
+# for the named person on the sheet. Body: { "text": "..." }. Every line is checked by the claim form's rules
+# before anything is stored, so one refused line adds nothing. Responds { "added": n }.
+validate:
+  class: net.officefloor.hq.app.paste.ValidatePaste
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.paste.AddPastedClaims
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.paste.RespondWithPastedClaims
+  govern: [ transaction ]
