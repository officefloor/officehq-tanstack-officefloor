+# The paste box: lines of name,amount,date,note, each a DRAFT claim for the named person. Every line
+# is checked by the claim form's rules before any is added; one refused line adds nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidatePasteClaims
+  next: snapshot
+# The sheet's figures before the change, so the change can audit what it moved.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SavePasteClaims
+  govern: [ transaction ]
