+# POST /api/sheets/{sheetId}/paste-claims — add a DRAFT claim per pasted line of name,amount,date,note,
+# in order, to the named person. Every line is checked first by the claim form's rules: when any line
+# is refused nothing is added. Responds with how many were added.
+validate:
+  class: net.officefloor.hq.app.paste.ValidatePaste
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: paste
+paste:
+  class: net.officefloor.hq.app.paste.PasteClaims
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.paste.RespondWithPaste
