+# Paste lines of name,amount,date,note: a DRAFT claim per line, in order, for the named person. Every line is
+# checked with the claim form's rules before anything is written, so one refusal adds nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: lines
+lines:
+  class: net.officefloor.hq.app.claim.ValidatePaste
+  next: add
+add:
+  class: net.officefloor.hq.app.claim.AddPastedClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithPaste
+  govern: [ transaction ]
