--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/paste-claims.POST.yml
@@ -0,0 +1,17 @@
+# POST /api/sheets/{sheetId}/paste-claims — add a DRAFT claim per pasted line, in order (body: {text,
+# user}). Each line is name,amount,date,note: the name must be on the sheet (ignoring case and the
+# spaces around it), the date may be blank for the sheet's today, the note may hold commas or be
+# absent. Every line is first checked with the claim form's rules; refused (400), storing nothing and
+# recording nothing, when any line fails or there is no line. Otherwise every claim is added and
+# recorded as CLAIM_ADDED, as a single add is. Answers {added}.
+validate:
+  class: net.officefloor.hq.app.paste.ValidatePaste
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.paste.SavePasted
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.paste.RespondWithPaste
+  govern: [ transaction ]
