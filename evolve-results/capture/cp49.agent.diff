+# Paste lines of name,amount,date,note: a DRAFT claim per line, in order, for the named person.
+# Every line is checked by the claim form's rules before any is saved: one refused line refuses the
+# paste and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidatePasteClaims
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.claim.AddPastedClaims
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithPasteClaims
+  govern: [ transaction ]
