+package net.officefloor.hq.app.setting;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/** Records the period numbering from date just saved (blank: off), even when it is the one the sheet had; nothing when it was left as it is. */
+public class AuditPeriodNumberingFrom {
+    public void audit(@Val PeriodNumberingFrom from, @Val Sheet sheet, @RequestParam("user") String user, Audit audit) {
+        if (!from.given()) {
+            return;
+        }
+        audit.record("SETTING_CHANGED sheet=" + sheet.id() + " by=" + user + " key=period-numbering-from value="
+                + (from.value() == null ? "" : from.value().toString()));
+    }
+}
