@@ -0,0 +1,16 @@
+package net.officefloor.hq.app.claim;
+
+import java.util.LinkedHashSet;
+import net.officefloor.hq.app.sheet.InvalidSheetRequestException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateBulkVoid {
+    public void validate(@RequestBody BulkVoidRequest request, Out<BulkVoid> body) throws InvalidSheetRequestException {
+        if (request == null || request.claimIds() == null || request.claimIds().isEmpty()) {
+            throw new InvalidSheetRequestException("Select the claims to void");
+        }
+        String reason = request.reason() == null || request.reason().isBlank() ? null : request.reason().trim();
+        body.set(new BulkVoid(new LinkedHashSet<>(request.claimIds()), request.user(), reason));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/VoidClaims.java b/src/main/java/net/officefloor/hq/app/claim/VoidClaims.java
new file mode 100644
index 00000000..503a5f8d
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/VoidClaims.java
@@ -0,0 +1,50 @@
+package net.officefloor.hq.app.claim;
+
+import java.util.List;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.period.ClosedPeriods;
+import net.officefloor.hq.app.period.PeriodClosedException;
+import net.officefloor.hq.app.person.People;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.Watches;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.rollup.Snapshot;
+import net.officefloor.hq.app.settings.Settings;
+import net.officefloor.hq.app.sheet.Sheets;
+import net.officefloor.hq.app.voidreason.VoidReasons;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** Voids each selected claim that can be voided, in list order (people in list order, each
+ *  person's newest claim first), with the chosen void reason. Each is voided as a single void
+ *  would be — its own audit line, then the figures it moved; one that cannot be voided (or is not
+ *  on the sheet) is left as it is and counted as refused. */
+public class VoidClaims {
+    public void voidAll(@PathVariable("sheetId") String sheetId, @Val BulkVoid bulk, Claims claims, People people,
+            ClaimNumbers numbers, Figures figures, ClosedPeriods closedPeriods, Settings settings, Rollup rollup,
+            ClaimLog log, Sheets sheets, Watches watches, Audit audit, VoidReasons voidReasons, Out<BulkVoidResult> result) {
+        ClaimStatusChange change = new ClaimStatusChange(ClaimAction.VOID, bulk.user(), bulk.reason());
+        ApplyClaimStatus apply = new ApplyClaimStatus();
+        RecordClaimStatusChanged record = new RecordClaimStatusChanged();
+        List<Claim> all = claims.onSheet(sheetId);
+        int voided = 0;
+        for (Person person : people.onSheet(sheetId)) {
+            for (Claim listed : all) {
+                if (listed.getPersonId() != person.getId() || !bulk.claimIds().contains(listed.getId())) continue;
+                Claim claim = claims.find(sheetId, listed.getId());
+                Snapshot before = rollup.snapshot(sheetId);
+                try {
+                    apply.apply(change, claim, numbers, people, figures, closedPeriods, settings, log, sheets, voidReasons);
+                } catch (ClaimStatusRefusedException | PeriodClosedException e) {
+                    continue;
+                }
+                claims.save(claim);
+                record.record(change, claim, people, log, watches, audit);
+                rollup.record(sheetId, before, bulk.user());
+                voided++;
+            }
+        }
+        result.set(new BulkVoidResult(voided, bulk.claimIds().size() - voided));
+    }
+}
