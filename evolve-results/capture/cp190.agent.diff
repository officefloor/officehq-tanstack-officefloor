+++ b/src/main/java/net/officefloor/hq/app/claim/BulkVoidClaims.java
@@ -0,0 +1,50 @@
+package net.officefloor.hq.app.claim;
+
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.BadRequestException;
+import net.officefloor.hq.app.CurrentUser;
+import net.officefloor.hq.app.period.PeriodRepository;
+import net.officefloor.hq.app.person.WatchRepository;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.settings.SettingsRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Void the selected claims together with one reason, in list order (people in list order, each person's claims
+ *  newest first), each by exactly the rules of voiding one claim ({@link ClaimStatusChange}). A claim that cannot
+ *  be voided is left as it is and counted as refused. */
+public class BulkVoidClaims {
+    public void voidClaims(@PathVariable("sheetId") String sheetId, @RequestBody BulkVoidRequest request,
+            ServerHttpConnection connection, ClaimRepository repository, PeriodRepository periods,
+            SettingsRepository settings, Audit audit, Rollup rollup, WatchRepository watches,
+            Out<BulkVoidResult> result) throws BadRequestException {
+        String by = CurrentUser.require(connection);
+        String id = sheetId == null ? "" : sheetId.trim();
+        Set<Long> selected = new LinkedHashSet<>();
+        if (request != null && request.claimIds() != null) {
+            for (Long cid : request.claimIds()) {
+                if (cid != null) selected.add(cid);
+            }
+        }
+        if (selected.isEmpty()) {
+            throw new BadRequestException("select at least one claim");
+        }
+        List<Claim> found = repository.inListOrder(id, selected);
+        int refused = selected.size() - found.size();
+        int voided = 0;
+        for (Claim c : found) {
+            try {
+                ClaimStatusChange.apply(id, c.id(), "void", request.reason(), by, repository, periods, settings, audit, rollup, watches);
+                voided++;
+            } catch (BadRequestException e) {
+                refused++;
+            }
+        }
+        result.set(new BulkVoidResult(voided, refused));
+    }
+}
