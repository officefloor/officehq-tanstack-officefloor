@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/bulk-void — void the selected claims together (body {claimIds, user, reason}).
+# Each selected claim is voided in list order — people by their positions, a person's claims newest
+# first — by exactly the rules of a single void by the user with the reason (a void reason needed while
+# the sheet has any), and recorded as a single void is (CLAIM_VOIDED, then how it moved the sheet's
+# figures). Each that a single void would refuse, or that is not on the sheet, is refused and left as it
+# is, writing nothing. Answers {voided, refused}. Refused (400) only when no claim is selected.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkVoid
+  next: void
+void:
+  class: net.officefloor.hq.app.claim.VoidClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkVoid
+  govern: [ transaction ]
