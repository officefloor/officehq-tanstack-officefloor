+# Void the selected claims together. Each that can be voided is voided (and audited, with the
+# figures it moved) as a single void would be, in list order; each that cannot is left as it is.
+# Answers how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkVoid
+  next: void
+void:
+  class: net.officefloor.hq.app.claim.VoidClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkVoid
+  govern: [ transaction ]
