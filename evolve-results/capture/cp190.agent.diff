+  next: selected
+selected:
+  class: net.officefloor.hq.app.claim.ValidateBulkVoid
+  next: void
+void:
+  class: net.officefloor.hq.app.claim.VoidClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkVoid
+  govern: [ transaction ]
