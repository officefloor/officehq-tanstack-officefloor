@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/bulk-void — void the selected claims together, with the void reason chosen (if any). Each
+# selected claim is voided as the single void does (see status.PUT.yml), in list order: people by their place in the
+# list, a person's claims newest first, each writing its own CLAIM_VOIDED and the figures it moved. Each the single
+# void would refuse (or not on the sheet) is left as it is and counted refused. Responds with how many were voided and
+# how many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkVoid
+  next: void
+void:
+  class: net.officefloor.hq.app.claim.VoidClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkVoid
