+# Void the selected claims together, in list order, by the signed-in user, with the void reason chosen (required while
+# the sheet has void reasons). Each that can be voided is voided (logged, audited and rolled up as a single void is);
+# each that cannot is left as it is. Responds with how many of each.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkVoid
+  next: void
+void:
+  class: net.officefloor.hq.app.claim.BulkVoidClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkVoid
+  govern: [ transaction ]
