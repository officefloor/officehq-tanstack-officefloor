+# POST /api/sheets/{sheetId}/bulk-void — void the selected claims together, in list order, each by the rules
+# of voiding one (with the reason chosen, while the sheet has void reasons); each that cannot be voided is
+# left as it is. Responds with how many were voided and how many refused.
+void:
+  class: net.officefloor.hq.app.claim.BulkVoidClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkVoid
