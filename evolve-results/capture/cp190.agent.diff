@@ -0,0 +1,18 @@
+# Void the selected claims together with one reason, in list order, by the rules of voiding one. Each
+# that cannot be voided is refused and left as it is; the response tells how many were voided and how
+# many refused.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateBulkVoid
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: voidClaims
+# Each claim voided is audited as it is voided: its own line, then the figures it moved.
+voidClaims:
+  class: net.officefloor.hq.app.claim.VoidSelectedClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithBulkVoid
+  govern: [ transaction ]
