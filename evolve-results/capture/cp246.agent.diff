+import { PeopleHead, PersonRow } from '../../slots/defs/personRow';
+import { useClaims, type ClaimStatus } from '../claims/claims';
+import { type Person } from '../people/people';
+
+/** The statuses a person's claims are counted by on their row. */
+const COUNTED: readonly ClaimStatus[] = ['OPEN', 'SETTLED'];
+
+function ClaimCountsHead() {
+  return (
+    <>
+      {COUNTED.map((s) => (
+        <th key={s}>{s === 'OPEN' ? 'Open' : 'Settled'}</th>
+      ))}
+    </>
+  );
+}
+
+/** How many of the person's claims have each counted status (as the header counts them: the status itself). */
+function PersonClaimCounts({ sheetId, person }: { sheetId: string; person: Person }) {
+  const claims = useClaims(sheetId);
+  const mine = claims.data?.filter((c) => c.personId === person.id) ?? [];
+  return (
+    <>
+      {COUNTED.map((s) => (
+        <td key={s} data-testid={`person-claims-${s}-count`}>
+          {mine.filter((c) => c.status === s).length}
+        </td>
+      ))}
+    </>
+  );
+}
+
+export const contributions = [
+  PeopleHead.fill({ order: 27, Component: ClaimCountsHead }),
+  PersonRow.fill({ order: 27, Component: PersonClaimCounts }),
+];
