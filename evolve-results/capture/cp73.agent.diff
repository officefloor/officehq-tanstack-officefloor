@@ -0,0 +1,24 @@
+package net.officefloor.hq.app.history;
+
+import java.time.LocalDate;
+import java.util.Arrays;
+import java.util.stream.Collectors;
+
+/** Reads a table as it stood at the end of a date, from the versions {@link HistoryTrigger} keeps: each row's
+ *  last version made while the sheet's today was on or before the date, unless that version deleted it. A
+ *  change made while the sheet's today was after the date does not count, whenever it was made. */
+public final class History {
+    private History() {
+    }
+
+    /** A table expression, named as the table, for use in place of it in a query's FROM: the table's rows
+     *  (each identified by {@code keys}, comma separated) as they stood at the end of {@code date}. */
+    public static String asOf(String table, String keys, LocalDate date) {
+        String on = "DATE '" + date + "'";
+        String same = Arrays.stream(keys.split(",")).map(String::trim).map(k -> "l." + k + " = h." + k)
+                .collect(Collectors.joining(" AND "));
+        return "(SELECT h.* FROM " + table + "_hist h WHERE h.hist_made_on <= " + on + " AND NOT EXISTS (SELECT 1 FROM "
+                + table + "_hist l WHERE " + same + " AND l.hist_made_on <= " + on + " AND l.hist_seq > h.hist_seq) AND NOT h.hist_gone) "
+                + table;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/history/HistoryTrigger.java b/src/main/java/net/officefloor/hq/app/history/HistoryTrigger.java
new file mode 100644
index 000000000..f53936b84
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/history/HistoryTrigger.java
@@ -0,0 +1,67 @@
+package net.officefloor.hq.app.history;
+
+import java.sql.Connection;
+import java.sql.Date;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+import org.h2.api.Trigger;
+
+/** Keeps every version of a row of the table it is set on in {@code <table>_hist}: after each insert or
+ *  update the new row, after a delete the old one marked gone, each with the sheet's today when the change
+ *  was made (the real date when the sheet has none set) and the next {@code hist_seq}. See {@link History}. */
+public class HistoryTrigger implements Trigger {
+
+    private String insert;
+
+    private int columns;
+
+    private int sheetColumn;
+
+    @Override
+    public void init(Connection conn, String schemaName, String triggerName, String tableName, boolean before,
+            int type) throws SQLException {
+        List<String> names = new ArrayList<>();
+        try (ResultSet rs = conn.getMetaData().getColumns(null, schemaName, tableName, null)) {
+            while (rs.next()) {
+                names.add(rs.getString("COLUMN_NAME"));
+            }
+        }
+        columns = names.size();
+        sheetColumn = names.indexOf("SHEET_ID");
+        StringBuilder sql = new StringBuilder("INSERT INTO \"" + schemaName + "\".\"" + tableName
+                + "_HIST\" (HIST_SEQ, HIST_MADE_ON, HIST_GONE");
+        for (String name : names) {
+            sql.append(", \"").append(name).append('"');
+        }
+        sql.append(") VALUES (NEXT VALUE FOR \"").append(schemaName).append("\".HIST_SEQ, ?, ?");
+        sql.append(", ?".repeat(columns)).append(')');
+        insert = sql.toString();
+    }
+
+    @Override
+    public void fire(Connection conn, Object[] oldRow, Object[] newRow) throws SQLException {
+        Object[] row = newRow != null ? newRow : oldRow;
+        try (PreparedStatement ps = conn.prepareStatement(insert)) {
+            ps.setDate(1, Date.valueOf(today(conn, row[sheetColumn])));
+            ps.setBoolean(2, newRow == null);
+            for (int i = 0; i < columns; i++) {
+                ps.setObject(i + 3, row[i]);
+            }
+            ps.executeUpdate();
+        }
+    }
+
+    /** The sheet's today, as {@code SheetStore} reads it. */
+    private static LocalDate today(Connection conn, Object sheetId) throws SQLException {
+        try (PreparedStatement ps = conn.prepareStatement("SELECT today FROM sheet WHERE id = ?")) {
+            ps.setObject(1, sheetId);
+            try (ResultSet rs = ps.executeQuery()) {
+                return rs.next() ? rs.getObject(1, LocalDate.class) : LocalDate.now();
+            }
+        }
+    }
+}
