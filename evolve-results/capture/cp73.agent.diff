diff --git a/src/main/java/net/officefloor/hq/app/history/AsOf.java b/src/main/java/net/officefloor/hq/app/history/AsOf.java
new file mode 100644
index 00000000..28fb25ac
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/history/AsOf.java
@@ -0,0 +1,66 @@
+package net.officefloor.hq.app.history;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Supplier;
+
+/**
+ * Reading a sheet as it stood at the end of a date. While {@link #on} runs its work, the stores read the tables a
+ * person's figures come from ({@link #table}) out of their history, each row as the last change made while the sheet's
+ * today was on or before the date left it (later changes do not count), and that date stands in for the sheet's today.
+ */
+public final class AsOf {
+
+    /** The columns that name a row of each table kept in history. */
+    private static final Map<String, List<String>> KEYS = Map.of(
+            "claim", List.of("id"),
+            "person", List.of("id"),
+            "person_grade", List.of("person_id", "from_date"),
+            "person_hold", List.of("id"),
+            "rate", List.of("sheet_id", "grade", "from_date"),
+            "setting", List.of("sheet_id", "setting_key"),
+            "setting_from", List.of("sheet_id", "setting_key", "from_date"));
+
+    private static final ThreadLocal<LocalDate> DATE = new ThreadLocal<>();
+
+    private AsOf() {
+    }
+
+    /** Runs the work reading the store as it stood at the end of {@code date}. */
+    public static <T> T on(LocalDate date, Supplier<T> work) {
+        LocalDate was = DATE.get();
+        DATE.set(date);
+        try {
+            return work.get();
+        } finally {
+            DATE.set(was);
+        }
+    }
+
+    /** The date the store is read as of; null when it is read as it is now. */
+    public static LocalDate date() {
+        return DATE.get();
+    }
+
+    /** The table to read FROM, named {@code table} in the query: as it is now, or as it stood at the end of the date. */
+    public static String table(String table) {
+        return table(table, table);
+    }
+
+    /** The table to read FROM, named {@code alias} in the query: as it is now, or as it stood at the end of the date. */
+    public static String table(String table, String alias) {
+        LocalDate date = DATE.get();
+        if (date == null) {
+            return table + " " + alias;
+        }
+        String on = "DATE '" + date + "'";
+        StringBuilder same = new StringBuilder();
+        for (String key : KEYS.get(table)) {
+            same.append(" AND x.").append(key).append(" IS NOT DISTINCT FROM h.").append(key);
+        }
+        return "(SELECT * FROM " + table + "_history h WHERE h.history_on <= " + on + " AND NOT h.history_gone"
+                + " AND NOT EXISTS (SELECT 1 FROM " + table + "_history x WHERE x.history_on <= " + on
+                + " AND x.history_seq > h.history_seq" + same + ")) " + alias;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/history/Journal.java b/src/main/java/net/officefloor/hq/app/history/Journal.java
new file mode 100644
index 00000000..bb825258
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/history/Journal.java
@@ -0,0 +1,73 @@
+package net.officefloor.hq.app.history;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+import org.h2.api.Trigger;
+
+/**
+ * Copies every row a change writes to its table's history ({@code <table>_history}), with the sheet's today when the
+ * change was made; a deleted row is copied as it was, marked gone. See {@link AsOf} for how the history is read back.
+ */
+public class Journal implements Trigger {
+
+    private List<String> columns;
+    private String insert;
+    private int sheetColumn;
+    private int personColumn;
+
+    @Override
+    public void init(Connection conn, String schemaName, String triggerName, String tableName, boolean before, int type)
+            throws SQLException {
+        columns = new ArrayList<>();
+        try (ResultSet rs = conn.getMetaData().getColumns(null, schemaName, tableName, null)) {
+            while (rs.next()) {
+                columns.add(rs.getString("COLUMN_NAME"));
+            }
+        }
+        sheetColumn = columns.indexOf("SHEET_ID");
+        personColumn = columns.indexOf("PERSON_ID");
+        insert = "INSERT INTO " + tableName + "_HISTORY (" + String.join(", ", columns)
+                + ", HISTORY_ON, HISTORY_GONE) VALUES (" + "?, ".repeat(columns.size()) + "?, ?)";
+    }
+
+    @Override
+    public void fire(Connection conn, Object[] oldRow, Object[] newRow) throws SQLException {
+        Object[] row = newRow != null ? newRow : oldRow;
+        try (PreparedStatement ps = conn.prepareStatement(insert)) {
+            for (int i = 0; i < columns.size(); i++) {
+                ps.setObject(i + 1, row[i]);
+            }
+            ps.setObject(columns.size() + 1, today(conn, sheetOf(conn, row)));
+            ps.setBoolean(columns.size() + 2, newRow == null);
+            ps.executeUpdate();
+        }
+    }
+
+    /** The row's sheet: its own, else its person's. */
+    private String sheetOf(Connection conn, Object[] row) throws SQLException {
+        if (sheetColumn >= 0) {
+            return (String) row[sheetColumn];
+        }
+        try (PreparedStatement ps = conn.prepareStatement("SELECT sheet_id FROM person WHERE id = ?")) {
+            ps.setObject(1, row[personColumn]);
+            try (ResultSet rs = ps.executeQuery()) {
+                return rs.next() ? rs.getString(1) : null;
+            }
+        }
+    }
+
+    /** The sheet's today: the real date for a sheet never stored. */
+    private static LocalDate today(Connection conn, String sheetId) throws SQLException {
+        try (PreparedStatement ps = conn.prepareStatement("SELECT today_date FROM sheet WHERE id = ?")) {
+            ps.setString(1, sheetId);
+            try (ResultSet rs = ps.executeQuery()) {
+                return rs.next() ? rs.getObject(1, LocalDate.class) : LocalDate.now();
+            }
+        }
+    }
+}
