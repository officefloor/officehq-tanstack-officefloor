diff --git a/src/main/java/net/officefloor/hq/app/claim/SaveClaimStatus.java b/src/main/java/net/officefloor/hq/app/claim/SaveClaimStatus.java
index c1b78abd2..22fd99919 100644
--- a/src/main/java/net/officefloor/hq/app/claim/SaveClaimStatus.java
+++ b/src/main/java/net/officefloor/hq/app/claim/SaveClaimStatus.java
@@ -1,9 +1,32 @@
 package net.officefloor.hq.app.claim;
 
+import net.officefloor.plugin.variable.Out;
 import net.officefloor.plugin.variable.Val;
 
+/**
+ * Stores the new status. Opening gives the claim the sheet's next number. A change another user made first (the
+ * stored status is no longer the one this change started from) is refused, and the transaction gives back the number.
+ */
 public class SaveClaimStatus {
-    public void save(@Val Claim claim, ClaimRepository claims) {
-        claims.updateStatus(claim);
+    public void save(@Val Claim claim, ClaimRepository claims, Out<Claim> saved,
+            Out<ClaimNumber> number) throws InvalidClaimStatusException {
+        Claim toSave = claim;
+        if (claim.status() == ClaimStatus.OPEN) {
+            long next = claims.nextNumber(claim.sheetId());
+            toSave = new Claim(claim.id(), claim.sheetId(), claim.personId(), claim.amount(), claim.date(),
+                    claim.note(), claim.status(), next);
+            number.set(new ClaimNumber(next));
+        }
+        ClaimStatus from = switch (claim.status()) {
+            case OPEN -> ClaimStatus.DRAFT;
+            case SETTLED -> ClaimStatus.OPEN;
+            default -> null;
+        };
+        boolean stored = from != null ? claims.updateStatus(toSave, from)
+                : claims.updateStatus(toSave, ClaimStatus.DRAFT) || claims.updateStatus(toSave, ClaimStatus.OPEN);
+        if (!stored) {
+            throw new InvalidClaimStatusException("The claim was changed by someone else");
+        }
+        saved.set(toSave);
     }
 }
diff --git a/src/main/resources/db/migration/V7__claim_number.sql b/src/main/resources/db/migration/V7__claim_number.sql
new file mode 100644
index 000000000..f2cf0f3e8
--- /dev/null
+++ b/src/main/resources/db/migration/V7__claim_number.sql
@@ -0,0 +1,8 @@
+-- A claim's number: given when the claim is opened, the next on its sheet (1, 2, ...), with no
+-- gaps and never reused. A draft has none, and voiding a claim clears it. The last number given on
+-- each sheet is kept in claim_number_seq, so a cleared number is never given again.
+ALTER TABLE claim ADD COLUMN claim_number BIGINT;
+CREATE TABLE claim_number_seq (
+    sheet_id    VARCHAR(200) PRIMARY KEY,
+    last_number BIGINT NOT NULL
+);
