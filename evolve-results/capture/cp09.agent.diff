diff --git a/src/main/frontend/ui/money.ts b/src/main/frontend/ui/money.ts
new file mode 100644
index 0000000..f3a8537
--- /dev/null
+++ b/src/main/frontend/ui/money.ts
@@ -0,0 +1,6 @@
+// How money is displayed everywhere: a dollar sign and two decimal places, like "$100.00".
+// Shared so every figure that is money reads the same, rather than each feature spelling out
+// its own .toFixed(2). Composed, not branched — callers pass a number and get the canonical string.
+export function formatMoney(amount: number): string {
+  return `$${Number(amount).toFixed(2)}`;
+}
