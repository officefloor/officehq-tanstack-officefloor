diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimNumber.java b/src/main/java/net/officefloor/hq/app/claim/ClaimNumber.java
new file mode 100644
index 0000000..eec4ce3
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimNumber.java
@@ -0,0 +1,10 @@
+package net.officefloor.hq.app.claim;
+
+/** The number an audit line about a claim carries; null when the claim has none. */
+public record ClaimNumber(Integer value) {
+
+    /** The audit field for the number, to go at the end of the line; empty when there is none. */
+    public String auditField() {
+        return value == null ? "" : " number=" + value;
+    }
+}
