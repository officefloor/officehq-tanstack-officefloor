diff --git a/src/main/java/net/officefloor/hq/app/claim/NumberClaim.java b/src/main/java/net/officefloor/hq/app/claim/NumberClaim.java
new file mode 100644
index 000000000..4be3a0ae7
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/NumberClaim.java
@@ -0,0 +1,11 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Val;
+
+/** Gives a claim being opened the sheet's next number; refused when another request opened it first. */
+public class NumberClaim {
+    public void number(@Val Claim claim, ClaimRepository repository) throws InvalidClaimStatusException {
+        if (!repository.markOpened(claim)) throw new InvalidClaimStatusException(ClaimStatus.DRAFT, ClaimStatus.OPEN);
+        claim.setNumber(repository.nextNumber(claim.getSheetId()));
+    }
+}
diff --git a/src/main/resources/db/migration/V8__claim_number.sql b/src/main/resources/db/migration/V8__claim_number.sql
new file mode 100644
index 000000000..09e79de41
--- /dev/null
+++ b/src/main/resources/db/migration/V8__claim_number.sql
@@ -0,0 +1,4 @@
+-- A claim's number: given when it is opened, the next on its sheet (1, 2, ...), with no gaps and
+-- never reused. A draft has none; voiding a claim clears it. The sheet keeps the last number given.
+ALTER TABLE sheet ADD COLUMN last_claim_number INT NOT NULL DEFAULT 0;
+ALTER TABLE claim ADD COLUMN claim_number INT;
