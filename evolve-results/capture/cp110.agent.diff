+# The sheet's descendants' ids: its children (the sheets naming it as their parent), theirs and so on, nearest first.
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ readonly-transaction ]
+  next: descendants
+descendants:
+  class: net.officefloor.hq.app.sheet.LoadDescendants
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithDescendants
+  govern: [ readonly-transaction ]
