--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades/retire.POST.yml
@@ -0,0 +1,25 @@
+# Retire a grade on the sheet: it can no longer be chosen for a new person or in an edit; people
+# already on it keep it. A grade other than A, B or C, or one already retired, is refused (a 400)
+# and writes nothing. A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGrade
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: retire
+retire:
+  class: net.officefloor.hq.app.grade.RetireGrade
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.grade.AuditGradeRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
