@@ -0,0 +1,18 @@
+# POST /api/sheets/{sheetId}/grades/retire — retires a grade on the sheet (body: {grade, user}). A grade other
+# than A, B or C, one already retired, or a viewer is refused (400) and nothing is stored. Recorded as
+# GRADE_RETIRED. People on the grade keep it, but it can no longer be chosen for a new person or in an edit
+# (by the person form, a bulk grade or an import); the quick add's default grade falls back to A.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeRetire
+  next: save
+save:
+  class: net.officefloor.hq.app.grade.SaveGradeRetired
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.grade.AuditGradeRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGradeRetired
+  govern: [ transaction ]
