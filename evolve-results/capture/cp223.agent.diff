+# Retire a grade on the sheet: people on it keep it, but it cannot be chosen for a new person or in an edit (the form,
+# the row's grade, a bulk grade, an import; a quick-add's default grade falls back to A). A refused retire (no user,
+# not A, B or C, already retired) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeRetire
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.grade.SaveGradeRetire
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.grade.AuditGradeRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
