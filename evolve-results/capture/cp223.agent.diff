+# Retire a grade. Validate first so an unknown or already retired grade is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateRetireGrade
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.grade.SaveGradeRetired
+  govern: [ transaction ]
+  next: record
+# Audit only once the retirement is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.grade.RecordGradeRetired
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGrades
+  govern: [ transaction ]
