diff --git a/src/main/frontend/features/periods/usePeriodDueTotal.ts b/src/main/frontend/features/periods/usePeriodDueTotal.ts
new file mode 100644
index 00000000..9601012e
--- /dev/null
+++ b/src/main/frontend/features/periods/usePeriodDueTotal.ts
@@ -0,0 +1,25 @@
+import { countsLive, useClaims } from '../claims/useClaims';
+import { gradeOn, usePeople } from '../people/usePeople';
+import { claimDue, toCents } from '../rates/due';
+import { rateOn, useRates } from '../rates/useRates';
+import { useFloor, useLatePct, useTerms } from '../settings/useSettings';
+import { useSheetToday } from '../sheet/useSheetToday';
+import { periodOf, usePeriods, type Period } from './usePeriods';
+
+/** A period's due-total: the dues, late charges included, of the claims that count whose date falls
+ *  in it, leaving out a held person's OPEN claims (a claim whose due is n/a adds nothing); a closed
+ *  period gives the due-total fixed when it was closed. */
+export function usePeriodDueTotal(sheet: string): (period: Period) => bigint {
+  const periods = usePeriods(sheet);
+  const people = usePeople(sheet);
+  const claims = useClaims(sheet);
+  const rates = useRates(sheet);
+  const floor = useFloor(sheet);
+  const late = { pct: useLatePct(sheet), terms: useTerms(sheet), today: useSheetToday(sheet) };
+  const personOf = new Map(people.map((p) => [p.id, p]));
+  const heldOf = new Map(people.map((p) => [p.id, p.held]));
+  return (period: Period) =>
+    period.closed ? toCents(period.closedTotal) : claims
+      .filter((c) => personOf.has(c.personId) && countsLive(c, heldOf.get(c.personId)!) && periodOf(periods, c.date)?.name === period.name)
+      .reduce((sum, c) => sum + (claimDue(c, rateOn(rates, gradeOn(personOf.get(c.personId)!, c.date), c.date), floor, late) ?? 0n), 0n);
+}
diff --git a/src/main/frontend/features/summary/SummaryPanel.tsx b/src/main/frontend/features/summary/SummaryPanel.tsx
new file mode 100644
index 00000000..8a6ce897
--- /dev/null
+++ b/src/main/frontend/features/summary/SummaryPanel.tsx
@@ -0,0 +1,89 @@
+import { asString, useSearchParam } from '../../url/useSearchParam';
+import type { Claim } from '../claims/useClaims';
+import { GRADES, gradeOn, type Person } from '../people/usePeople';
+import { usePeriodDueTotal } from '../periods/usePeriodDueTotal';
+import { usePeriods } from '../periods/usePeriods';
+import { formatCents } from '../rates/due';
+
+const STATUSES = ['DRAFT', 'OPEN', 'PENDING', 'SETTLED', 'VOID'] as const;
+
+// The sheet at a glance, worked from the same figures the lists show. Per grade: how many people
+// are on it today (retired people left out) and their due-totals added up (skipping n/a). Per
+// period: its due-total, as the period list shows it. Per status: how many claims have it.
+export function SummaryPanel({
+  people,
+  claims,
+  today,
+  totalOf,
+}: {
+  people: Person[];
+  claims: Claim[];
+  today: string | undefined;
+  totalOf: (person: Person) => bigint | null;
+}) {
+  const [sheet] = useSearchParam('sheet', asString);
+  const periods = usePeriods(sheet);
+  const periodDueTotal = usePeriodDueTotal(sheet);
+  const current = people.filter((p) => !p.retired);
+  const onSheet = new Set(people.map((p) => p.id));
+  const sheetClaims = claims.filter((c) => onSheet.has(c.personId));
+  return (
+    <section data-testid="summary">
+      <h3>Summary</h3>
+      <table>
+        <thead>
+          <tr>
+            <th>Grade</th>
+            <th>People</th>
+            <th>Due</th>
+          </tr>
+        </thead>
+        <tbody>
+          {GRADES.map((g) => {
+            const onGrade = current.filter((p) => gradeOn(p, today) === g);
+            const due = onGrade.reduce((sum, p) => sum + (totalOf(p) ?? 0n), 0n);
+            return (
+              <tr key={g}>
+                <td>{g}</td>
+                <td data-testid={`summary-grade-${g}-count`}>{onGrade.length}</td>
+                <td data-testid={`summary-grade-${g}-due-total`}>{formatCents(due)}</td>
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+      <table>
+        <thead>
+          <tr>
+            <th>Period</th>
+            <th>Due</th>
+          </tr>
+        </thead>
+        <tbody>
+          {periods.map((p) => (
+            <tr key={p.name}>
+              <td>{p.name}</td>
+              <td data-testid={`summary-period-${p.name}-due-total`}>{formatCents(periodDueTotal(p))}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+      <table>
+        <thead>
+          <tr>
+            <th>Status</th>
+            <th>Claims</th>
+          </tr>
+        </thead>
+        <tbody>
+          {STATUSES.map((s) => (
+            <tr key={s}>
+              <td>{s}</td>
+              <td data-testid={`summary-status-${s}-count`}>{sheetClaims.filter((c) => c.status === s).length}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
