 import { useQuery } from '@tanstack/react-query';
 import { getJson } from '../../api/http';
 import { sheetKey } from '../sheet/sheet';
+import { type Claim, counts, live } from '../claims/claims';
+import type { Person } from '../people/people';
+import { type Late, type Rate, claimDue, dueTotal } from '../rates/rates';
 
 /** A period: its name (unique on the sheet), its from and to dates (yyyy-MM-dd, inclusive), whether
  *  it is closed and, once closed, the due-total fixed on closing (null while open). No two periods on
@@ -26,3 +29,22 @@ export const contains = (period: Period, date: string) => period.from <= date &&
 export function periodOf(periods: Period[] | undefined, date: string): Period | undefined {
   return (periods ?? []).find((p) => contains(p, date));
 }
+
+/** A period's due-total as the list shows it: the total fixed on closing, else the sum of the figures
+ *  of the claims that count whose date falls in it, skipping n/a. */
+export function periodDue(
+  period: Period,
+  claims: Claim[] | undefined,
+  people: Person[] | undefined,
+  rates: Rate[] | undefined,
+  floor: string | undefined,
+  late: Late,
+): string {
+  if (period.closed && period.total !== null) return period.total;
+  const gradesOf = new Map((people ?? []).map((p) => [p.id, p.grades]));
+  return dueTotal(
+    live(claims ?? [], people)
+      .filter((c) => counts(c) && contains(period, c.date) && gradesOf.has(c.personId))
+      .map((c) => claimDue(c, rates, gradesOf.get(c.personId)!, floor, late)),
+  );
+}
diff --git a/src/main/frontend/features/summary/summary.slot.tsx b/src/main/frontend/features/summary/summary.slot.tsx
new file mode 100644
index 000000000..84dd7be52
--- /dev/null
+++ b/src/main/frontend/features/summary/summary.slot.tsx
@@ -0,0 +1,92 @@
+import { HomeMain } from '../../slots/defs/homeMain';
+import { useCurrentSheet } from '../../session/session';
+import { live, useClaims } from '../claims/claims';
+import { GRADES, gradeOn, usePeople } from '../people/people';
+import { periodDue, usePeriods } from '../periods/periods';
+import { dueTotal, personDue, useRates } from '../rates/rates';
+import { useSettings } from '../settings/settings';
+import { useSheetToday } from '../sheet/sheet';
+import { lateOf } from '../overdue/overdue';
+
+/** Every status the summary counts, whether or not a claim can reach it. */
+const STATUSES = ['DRAFT', 'OPEN', 'PENDING', 'SETTLED', 'VOID'] as const;
+
+// The sheet at a glance, worked out from the same figures the lists show: per grade, the people on it
+// today (retired people excluded) and their due-totals added up (skipping n/a); per period, its
+// due-total; per status, how many claims have it.
+function Summary() {
+  const [sheet] = useCurrentSheet();
+  const people = usePeople(sheet);
+  const claims = useClaims(sheet);
+  const periods = usePeriods(sheet);
+  const rates = useRates(sheet);
+  const today = useSheetToday(sheet);
+  const settings = useSettings(sheet).data;
+  const floor = settings?.floor;
+  const late = lateOf(settings, today);
+
+  const active = (people.data ?? []).filter((p) => !p.retired);
+  const onGrade = (grade: string) => active.filter((p) => gradeOn(p.grades, today) === grade);
+  const dueOf = (p: (typeof active)[number]) =>
+    personDue(live((claims.data ?? []).filter((c) => c.personId === p.id), [p]), rates.data, p.grades, today, floor, late);
+
+  return (
+    <section data-testid="summary">
+      <h2>Summary</h2>
+      <table>
+        <thead>
+          <tr>
+            <th>Grade</th>
+            <th>People</th>
+            <th>Due total</th>
+          </tr>
+        </thead>
+        <tbody>
+          {GRADES.map((g) => (
+            <tr key={g}>
+              <td>{g}</td>
+              <td data-testid={`summary-grade-${g}-count`}>{onGrade(g).length}</td>
+              <td data-testid={`summary-grade-${g}-due-total`}>{dueTotal(onGrade(g).map(dueOf))}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+      <table>
+        <thead>
+          <tr>
+            <th>Period</th>
+            <th>Due total</th>
+          </tr>
+        </thead>
+        <tbody>
+          {(periods.data ?? []).map((p) => (
+            <tr key={p.name}>
+              <td>{p.name}</td>
+              <td data-testid={`summary-period-${p.name}-due-total`}>
+                {periodDue(p, claims.data, people.data, rates.data, floor, late)}
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+      <table>
+        <thead>
+          <tr>
+            <th>Status</th>
+            <th>Claims</th>
+          </tr>
+        </thead>
+        <tbody>
+          {STATUSES.map((s) => (
+            <tr key={s}>
+              <td>{s}</td>
+              <td data-testid={`summary-status-${s}-count`}>{(claims.data ?? []).filter((c) => c.status === s).length}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+export const contribution = HomeMain.fill({ order: 46, Component: Summary });
