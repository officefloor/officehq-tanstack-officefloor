 import { getJson, postJson } from '../../api/http';
+import { counts, liveClaims, type Claim } from '../claims/api';
+import { gradeOn, type Person } from '../people/api';
+import { claimDue, sumDues, type Late, type Rate } from '../rates/api';
 import { sheetKey } from '../sheet/api';
 
 /** A period on the sheet: a name (unique on the sheet) and its from and to dates (yyyy-MM-dd), both
@@ -39,3 +42,13 @@ export function closePeriod(sheetId: string, by: string, name: string): Promise<
 export function reopenPeriod(sheetId: string, by: string, name: string): Promise<Period> {
   return postJson<Period>(`${base(sheetId)}/${encodeURIComponent(name)}/reopen?by=${encodeURIComponent(by)}`, {});
 }
+
+/** A period's due-total as its row shows it: once closed, the one fixed when it was closed; else the
+ *  due of the live claims that count whose date falls in it (n/a ones skipped). */
+export function periodDueTotal(p: Period, claims: Claim[], people: Person[] | undefined, rates: Rate[] | undefined,
+  floor: string, late: Late): string {
+  if (p.closed && p.closedTotal !== null) return p.closedTotal;
+  const personOf = new Map((people ?? []).map((q) => [q.id, q]));
+  return sumDues(liveClaims(claims, people).filter(counts).filter((c) => p.from <= c.date && c.date <= p.to)
+    .map((c) => claimDue(c, rates, (d) => { const q = personOf.get(c.personId); return q ? gradeOn(q, d) : ''; }, floor, late)));
+}
diff --git a/src/main/frontend/features/summary/Summary.tsx b/src/main/frontend/features/summary/Summary.tsx
new file mode 100644
index 000000000..4b4ddd6fa
--- /dev/null
+++ b/src/main/frontend/features/summary/Summary.tsx
@@ -0,0 +1,63 @@
+import { useQuery } from '@tanstack/react-query';
+import { claimsKey, listClaims, liveClaims } from '../claims/api';
+import { GRADES, gradeOn, listPeople, peopleKey } from '../people/api';
+import { listPeriods, periodDueTotal, periodsKey } from '../periods/api';
+import { listRates, personDue, rateByGrade, ratesKey, sumDues } from '../rates/api';
+import { useFloor, useLate } from '../settings/api';
+import { useSheetToday } from '../sheet/api';
+
+/** Every status a claim's count is shown for. */
+const STATUSES = ['DRAFT', 'OPEN', 'PENDING', 'SETTLED', 'VOID'] as const;
+
+/** The sheet's summary, agreeing with the lists: per grade, how many people not retired are on it
+ *  today and their due-totals added up (n/a ones skipped); per period, its due-total; per status,
+ *  how many claims have it. */
+export function Summary({ sheetId, user }: { sheetId: string; user: string }) {
+  const people = useQuery({ queryKey: peopleKey(sheetId), queryFn: () => listPeople(sheetId) });
+  const claims = useQuery({ queryKey: claimsKey(sheetId), queryFn: () => listClaims(sheetId) });
+  const rates = useQuery({ queryKey: ratesKey(sheetId), queryFn: () => listRates(sheetId) });
+  const periods = useQuery({ queryKey: periodsKey(sheetId), queryFn: () => listPeriods(sheetId) });
+  const floor = useFloor(sheetId);
+  const today = useSheetToday(sheetId, user);
+  const charges = useLate(sheetId, today);
+  const byGrade = rateByGrade(rates.data, today);
+  const all = claims.data ?? [];
+  const active = (people.data ?? []).filter((p) => !p.retired);
+  const dueOf = (p: (typeof active)[number]) => personDue(liveClaims(all.filter((c) => c.personId === p.id), [p]),
+    rates.data, (d) => gradeOn(p, d), byGrade.get(p.grade), floor, charges);
+
+  return (
+    <section>
+      <h3>Summary</h3>
+      <table>
+        <tbody>
+          {GRADES.map((g) => {
+            const on = active.filter((p) => p.grade === g);
+            return (
+              <tr key={g}>
+                <td>Grade {g}</td>
+                <td>People <span data-testid={`summary-grade-${g}-count`}>{on.length}</span></td>
+                <td>Due <span data-testid={`summary-grade-${g}-due-total`}>{sumDues(on.map(dueOf))}</span></td>
+              </tr>
+            );
+          })}
+          {(periods.data ?? []).map((p) => (
+            <tr key={p.name}>
+              <td>Period {p.name}</td>
+              <td />
+              <td>Due <span data-testid={`summary-period-${p.name}-due-total`}>
+                {periodDueTotal(p, all, people.data, rates.data, floor, charges)}</span></td>
+            </tr>
+          ))}
+          {STATUSES.map((s) => (
+            <tr key={s}>
+              <td>{s}</td>
+              <td>Claims <span data-testid={`summary-status-${s}-count`}>{all.filter((c) => c.status === s).length}</span></td>
+              <td />
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  );
+}
