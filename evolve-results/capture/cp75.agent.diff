+# Give the selected people a grade together: each, in list order (the order they were added), gets the
+# grade from the from-date (blank: the sheet's today) exactly as the person form would save it. Answers
+# how many were graded.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: grade
+grade:
+  class: net.officefloor.hq.app.person.BulkGradePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkGrade
