+# POST /api/sheets/{sheetId}/bulk-grade — give the selected people a grade together, from a date (blank: the sheet's
+# today). An invalid grade or date is a 400 and writes nothing. Each selected person on the sheet, in list order (the
+# order they were added), is edited exactly as the person form would (see GradePeople): the grade recorded from the
+# date, PERSON_EDITED and the figures it moved. Responds with how many were changed.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkGrade
+  next: grade
+grade:
+  class: net.officefloor.hq.app.person.GradePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkGrade
