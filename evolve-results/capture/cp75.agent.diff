@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/bulk-grade — give the selected people a grade together from a date
+# (blank: the sheet's today), in list order, each as the person form would. Refused (400) with no
+# one selected, a grade not A, B or C, or a from-date not a date; a viewer, or an archived sheet, is
+# refused before anything is read or written. Responds with how many were given the grade.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkGrade
+  next: grade
+grade:
+  class: net.officefloor.hq.app.person.BulkGradePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkGrade
