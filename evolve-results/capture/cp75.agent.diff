+# Give the selected people a grade together. Each, in list order, gets the grade from the from-date
+# (blank: the sheet's today) as saving the person form would, audited as that would be. Answers how
+# many were changed.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkGrade
+  next: grade
+grade:
+  class: net.officefloor.hq.app.person.GradePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkGrade
+  govern: [ transaction ]
