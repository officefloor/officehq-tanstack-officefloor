+# Give the selected people a grade together, from a date, in list order (people as added). Each is edited exactly
+# as the person form would (the same PERSON_EDITED and rollup lines); answers how many were changed.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: selected
+selected:
+  class: net.officefloor.hq.app.person.ValidateBulkGrade
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: grade
+grade:
+  class: net.officefloor.hq.app.person.GradePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkGrade
+  govern: [ transaction ]
