@@ -0,0 +1,13 @@
+# Give the selected people a grade together from a from-date (blank: the sheet's today), in list order. Each is
+# graded exactly as the person form's edit would (name and terms kept), with its PERSON_EDITED line and then how the
+# sheet's figures moved over it. A refused request (no user, no people, a bad grade or date) writes nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkGrade
+  next: grade
+grade:
+  class: net.officefloor.hq.app.person.BulkGradePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkGrade
+  govern: [ transaction ]
