+# Give the selected people a grade together, from a from-date (blank for the sheet's today), in list
+# order, each exactly as the person form would. A viewer may change nothing, and a bad grade or
+# from-date is a 400: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkGrade
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: grade
+# Each person graded is audited as it is graded: its own line, then the figures it moved.
+grade:
+  class: net.officefloor.hq.app.person.GradeSelectedPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkGrade
+  govern: [ transaction ]
