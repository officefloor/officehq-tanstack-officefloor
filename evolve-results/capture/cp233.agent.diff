@@ -0,0 +1,35 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/due-by — set a DRAFT, OPEN or PENDING claim's due-by directly
+# (body {date, user}). The due-by stays as set: a holiday added later does not move it; overdue, the late
+# charge, grace and the claim's period follow it. Refused (400) when the user is not a steward, the date does
+# not parse, the claim is not DRAFT, OPEN or PENDING or not on the sheet, or its due-by (old or new) falls in a
+# closed period; nothing is stored then. A stored setting is recorded in the audit file as CLAIM_DUE_BY_SET.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateDueBy
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: checkDueBy
+checkDueBy:
+  class: net.officefloor.hq.app.claim.CheckDueBy
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyDueBy
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimDueBySet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
