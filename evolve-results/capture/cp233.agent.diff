index 000000000..1ecfb4fb9
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/due-by.PUT.yml
@@ -0,0 +1,29 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/due-by — set a DRAFT, OPEN or PENDING claim's due-by directly, by a steward.
+# It stays as set (a holiday added later does not move it); overdue, the late charge, grace and its period follow it.
+# Anyone but a steward, any other claim, a due-by (old or new) inside a closed period or not a date, is a 409 and a
+# claim not on the sheet a 404, neither writing anything. Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateDueBy
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyDueBy
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveDueBy
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimDueBySet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
