diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/due-by.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/due-by.POST.yml
new file mode 100644
index 000000000..3a0c82180
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/due-by.POST.yml
@@ -0,0 +1,47 @@
+# Set a DRAFT, OPEN or PENDING claim's due-by directly (a steward). It stays as set: a holiday added
+# later does not move it. A claim due by a date inside a closed period, a new due-by inside one, any
+# other status, or anyone but a steward is refused and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateDueBy
+  govern: [ transaction ]
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+# A claim due by a date inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+# Checks the rules and writes the due-by only when none refuses it.
+apply:
+  class: net.officefloor.hq.app.claim.SetClaimDueBy
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimDueBySet
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
