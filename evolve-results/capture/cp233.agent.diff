--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ValidateClaimDueBySet.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import net.officefloor.hq.app.rollup.Actor;
+import net.officefloor.hq.app.sheet.InvalidSheetRequestException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateClaimDueBySet {
+    public void validate(@RequestBody ClaimDueBySetRequest request, Out<ClaimDueBySet> body, Out<Actor> actor)
+            throws InvalidSheetRequestException {
+        String raw = request == null || request.dueBy() == null ? "" : request.dueBy().trim();
+        try {
+            actor.set(new Actor(request.user()));
+            body.set(new ClaimDueBySet(LocalDate.parse(raw), request.user()));
+        } catch (DateTimeParseException e) {
+            throw new InvalidSheetRequestException("Not a date (yyyy-mm-dd): " + raw);
+        }
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/due-by.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/due-by.POST.yml
new file mode 100644
index 00000000..1212d438
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/due-by.POST.yml
@@ -0,0 +1,36 @@
+# A steward sets a DRAFT, OPEN or PENDING claim's due-by directly. Validate before Load so a bad
+# date is a 400, not a 404; anyone but a steward, any other status or a closed period is a 409 (or
+# the period's refusal) and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimDueBySet
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimDueBySet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimDueBySet
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimDueBySet
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
