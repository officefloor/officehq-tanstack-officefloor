@@ -0,0 +1,33 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/due-by?date=yyyy-MM-dd — a steward sets the due-by of a
+# DRAFT, OPEN or PENDING claim directly; refused (409) for anyone else or any other status, (400) for a
+# date that is not a date, (423) for a claim due by (or to be due by) a day in a closed period.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: set
+set:
+  class: net.officefloor.hq.app.claim.SetClaimDueBy
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveDueBySetting
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimDueBySet
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
