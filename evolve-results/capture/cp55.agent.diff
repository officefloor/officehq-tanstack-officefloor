diff --git a/src/main/java/net/officefloor/hq/app/period/AutoClosePeriods.java b/src/main/java/net/officefloor/hq/app/period/AutoClosePeriods.java
new file mode 100644
index 00000000..1af17244
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/AutoClosePeriods.java
@@ -0,0 +1,37 @@
+package net.officefloor.hq.app.period;
+
+import java.time.LocalDate;
+import java.util.Comparator;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.access.RoleRepository;
+import net.officefloor.hq.app.access.SettingRepository;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.session.ChangedBy;
+import net.officefloor.hq.app.sheet.SheetResponse;
+import net.officefloor.plugin.variable.Val;
+
+/**
+ * Once the sheet's today is set: with grace days on, closes every open period whose to-date plus the grace days is
+ * before the new today, in order of their to-dates, as a close by hand would (one the user may not close is left
+ * open), each writing PERIOD_CLOSED with auto=yes.
+ */
+public class AutoClosePeriods {
+    public void close(@Val SheetResponse sheet, @Val LocalDate today, @Val ChangedBy by, PeriodRepository repository,
+            RoleRepository roles, SettingRepository settings, Rollup rollup, Audit audit) {
+        Integer grace = settings.graceDays(sheet.id());
+        if (grace == null) {
+            return;
+        }
+        if (!settings.allows(sheet.id(), "close", roles.roleOf(sheet.id(), by.name()))) {
+            return;
+        }
+        for (Period period : repository.list(sheet.id()).stream()
+                .filter(p -> !p.closed() && p.to().plusDays(grace).isBefore(today))
+                .sorted(Comparator.comparing(Period::to).thenComparing(Period::id)).toList()) {
+            Period closed = ClosePeriod.fix(period, repository, rollup);
+            if (closed != null) {
+                audit.record(RecordPeriodClosed.line(closed, by) + " auto=yes");
+            }
+        }
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/period/ClosePeriod.java b/src/main/java/net/officefloor/hq/app/period/ClosePeriod.java
index 435aa8c2..89101fce 100644
--- a/src/main/java/net/officefloor/hq/app/period/ClosePeriod.java
+++ b/src/main/java/net/officefloor/hq/app/period/ClosePeriod.java
@@ -21,12 +21,21 @@ public class ClosePeriod {
         if (period.closed()) {
             throw new BadRequestException("That period is already closed");
         }
+        Period fixed = fix(period, repository, rollup);
+        if (fixed == null) {
+            throw new BadRequestException("The period was closed by someone else; reload the sheet");
+        }
+        closed.set(new ClosedPeriod(fixed));
+    }
+
+    /** Closes the open period, fixing its due-total and each person's as they are now; null when someone else closed it first. */
+    static Period fix(Period period, PeriodRepository repository, Rollup rollup) {
         Map<Long, BigDecimal> personTotals = rollup.dueBetweenByPerson(period.sheetId(), period.from(), period.to());
         BigDecimal total = personTotals.values().stream().reduce(BigDecimal.ZERO.setScale(2), BigDecimal::add);
         if (!repository.close(period.id(), total, personTotals)) {
-            throw new BadRequestException("The period was closed by someone else; reload the sheet");
+            return null;
         }
-        closed.set(new ClosedPeriod(new Period(period.id(), period.sheetId(), period.name(), period.from(),
-                period.to(), true, total, personTotals)));
+        return new Period(period.id(), period.sheetId(), period.name(), period.from(), period.to(), true, total,
+                personTotals);
     }
 }
