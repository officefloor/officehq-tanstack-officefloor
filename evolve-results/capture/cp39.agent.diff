@@ -0,0 +1,60 @@
+package net.officefloor.hq.app.claim;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** One line of a claim's status log: a status it entered, who made the change, the sheet's today then and the
+ * claim's due as it was worked out at that moment (null: n/a). */
+@Entity
+@Table(name = "claim_log")
+public class ClaimLog {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "claim_id", nullable = false)
+    private Long claimId;
+
+    @Column(nullable = false)
+    private String status;
+
+    @Column(name = "by_user", nullable = false)
+    private String byUser;
+
+    @Column(name = "on_date", nullable = false)
+    private LocalDate onDate;
+
+    @Column(precision = 19, scale = 2)
+    private BigDecimal due;
+
+    protected ClaimLog() {
+    }
+
+    public ClaimLog(Claim claim, String byUser, LocalDate onDate, BigDecimal due) {
+        this.sheetId = claim.getSheetId();
+        this.claimId = claim.getId();
+        this.status = claim.getStatus().name();
+        this.byUser = byUser;
+        this.onDate = onDate;
+        this.due = due;
+    }
+
+    public Long getClaimId() {
+        return claimId;
+    }
+
+    /** The line as the screen shows it: <STATUS> by <user> on <date> due=<due>. */
+    public String line() {
+        return status + " by " + byUser + " on " + onDate + " due=" + (due == null ? "n/a" : due.setScale(2).toPlainString());
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimLogRepository.java b/src/main/java/net/officefloor/hq/app/claim/ClaimLogRepository.java
new file mode 100644
index 00000000..75d34d10
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimLogRepository.java
@@ -0,0 +1,26 @@
+package net.officefloor.hq.app.claim;
+
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+import org.springframework.data.jpa.repository.JpaRepository;
+
+public interface ClaimLogRepository extends JpaRepository<ClaimLog, Long> {
+
+    /** The sheet's log lines, oldest first. */
+    List<ClaimLog> findBySheetIdOrderByIdAsc(String sheetId);
+
+    /** The claim's log lines, oldest first. */
+    List<ClaimLog> findByClaimIdOrderByIdAsc(Long claimId);
+
+    /** The claim's log as the screen shows it, oldest first. */
+    default List<String> linesOf(Claim claim) {
+        return findByClaimIdOrderByIdAsc(claim.getId()).stream().map(ClaimLog::line).toList();
+    }
+
+    /** The log of each claim on the sheet as the screen shows it, oldest first, by claim id. */
+    default Map<Long, List<String>> linesOnSheet(String sheetId) {
+        return findBySheetIdOrderByIdAsc(sheetId).stream().collect(Collectors.groupingBy(ClaimLog::getClaimId,
+                Collectors.mapping(ClaimLog::line, Collectors.toList())));
+    }
+}
