@@ -0,0 +1,39 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.hq.app.rate.RateRepository;
+import net.officefloor.hq.app.setting.SettingRepository;
+import net.officefloor.hq.app.sheet.SheetRepository;
+import org.springframework.stereotype.Service;
+
+/** Writes a claim's status log: once a saved claim's status differs from the one it was loaded with (a new
+ *  claim has none, so its DRAFT is logged), a line with that status, the user, the sheet's today and the
+ *  claim's due as computed now (see {@link ClaimDue}). */
+@Service
+public class ClaimLog {
+    private final ClaimLogRepository log;
+    private final PersonRepository people;
+    private final RateRepository rates;
+    private final SettingRepository settings;
+    private final SheetRepository sheets;
+
+    public ClaimLog(ClaimLogRepository log, PersonRepository people, RateRepository rates, SettingRepository settings,
+            SheetRepository sheets) {
+        this.log = log;
+        this.people = people;
+        this.rates = rates;
+        this.settings = settings;
+        this.sheets = sheets;
+    }
+
+    void record(Claim claim, String user) {
+        if (claim.getStatus() == claim.getLoggedStatus()) {
+            return;
+        }
+        LocalDate today = sheets.findById(claim.getSheetId()).orElseThrow().getToday();
+        log.save(new ClaimLogEntry(claim, user == null ? "" : user.trim(), today,
+                ClaimDue.now(claim, people, rates, settings, sheets)));
+        claim.markLogged();
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimLogEntry.java b/src/main/java/net/officefloor/hq/app/claim/ClaimLogEntry.java
new file mode 100644
index 0000000..b5658b2
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimLogEntry.java
@@ -0,0 +1,78 @@
+package net.officefloor.hq.app.claim;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.EnumType;
+import jakarta.persistence.Enumerated;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+
+/** One line of a claim's status log: a status it took, who made the change, the sheet's today then and the
+ *  claim's due as computed at that moment (none when no rate applied). */
+@Entity
+@Table(name = "claim_log")
+public class ClaimLogEntry {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "claim_id", nullable = false)
+    private Long claimId;
+
+    @Enumerated(EnumType.STRING)
+    @Column(name = "status", nullable = false)
+    private ClaimStatus status;
+
+    @Column(name = "by_user", nullable = false)
+    private String by;
+
+    @Column(name = "log_date", nullable = false)
+    private LocalDate date;
+
+    @Column(name = "due", precision = 14, scale = 2)
+    private BigDecimal due;
+
+    protected ClaimLogEntry() {
+    }
+
+    public ClaimLogEntry(Claim claim, String by, LocalDate date, BigDecimal due) {
+        this.sheetId = claim.getSheetId();
+        this.claimId = claim.getId();
+        this.status = claim.getStatus();
+        this.by = by;
+        this.date = date;
+        this.due = due;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public Long getClaimId() {
+        return claimId;
+    }
+
+    public ClaimStatus getStatus() {
+        return status;
+    }
+
+    public String getBy() {
+        return by;
+    }
+
+    public LocalDate getDate() {
+        return date;
+    }
+
+    public BigDecimal getDue() {
+        return due;
+    }
+}
