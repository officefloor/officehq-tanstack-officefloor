@@ -0,0 +1,24 @@
+# Change a plan's amount on the sheet's today: claims generated from then on take it, claims already
+# generated keep theirs. An amount the claim form would refuse is a 400 and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlanAmount
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: loadPlan
+loadPlan:
+  class: net.officefloor.hq.app.plan.LoadPlan
+  govern: [ transaction ]
+  next: change
+change:
+  class: net.officefloor.hq.app.plan.ChangePlanAmount
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPausedPlan
+  govern: [ transaction ]
