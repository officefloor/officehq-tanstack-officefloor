+# POST /api/sheets/{sheetId}/plans/{planId}/amount — change the plan's amount from the sheet's today; an amount
+# the claim form would refuse (or negative) is refused. Claims already made keep their amount.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlanAmount
+  next: load
+load:
+  class: net.officefloor.hq.app.plan.LoadPlan
+  govern: [ transaction ]
+  next: change
+change:
+  class: net.officefloor.hq.app.plan.ChangePlanAmount
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
