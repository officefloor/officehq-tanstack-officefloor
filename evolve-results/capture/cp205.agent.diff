@@ -0,0 +1,19 @@
+package net.officefloor.hq.app.plan;
+
+import java.time.LocalDate;
+import net.officefloor.hq.app.sheet.SheetRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+
+/** Change the loaded plan's amount from the sheet's today. Refused when the sheet has no today. */
+public class SavePlanAmount {
+    public void save(@Val PlanAmountInput input, @Val Plan loaded, SheetRepository sheets, PlanRepository repository,
+            Out<PlanResponse> saved) throws InvalidPlanException {
+        LocalDate today = sheets.today(loaded.sheetId());
+        if (today == null) {
+            throw new InvalidPlanException("Set the sheet's today before changing a plan.");
+        }
+        repository.changeAmount(loaded.id(), today, input.amount(), input.user());
+        saved.set(PlanResponse.from(repository.find(loaded.sheetId(), loaded.id()), today));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/plan/ValidatePlanAmount.java b/src/main/java/net/officefloor/hq/app/plan/ValidatePlanAmount.java
new file mode 100644
index 0000000..55b6931
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/plan/ValidatePlanAmount.java
@@ -0,0 +1,20 @@
+package net.officefloor.hq.app.plan;
+
+import java.math.BigDecimal;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Bind the body and refuse it before anything is read: a signed-in user, and an amount that is a number, not below
+ *  0.00, with up to two decimals (as a plan is added with). */
+public class ValidatePlanAmount {
+    public void validate(@RequestBody PlanAmountRequest request, Out<PlanAmountInput> body) throws InvalidPlanException {
+        if (request == null || request.user() == null || request.user().isBlank()) {
+            throw new InvalidPlanException("Sign in before changing plans.");
+        }
+        String amount = request.amount() == null ? "" : request.amount().trim();
+        if (!amount.matches("\\d{1,12}(\\.\\d{1,2})?")) {
+            throw new InvalidPlanException("The amount must be a number, not below 0.00, with up to two decimals.");
+        }
+        body.set(new PlanAmountInput(request.user().trim(), new BigDecimal(amount).setScale(2)));
+    }
+}
diff --git a/src/main/resources/db/migration/V111__plan_change.sql b/src/main/resources/db/migration/V111__plan_change.sql
new file mode 100644
index 0000000..1f2a6cb
--- /dev/null
+++ b/src/main/resources/db/migration/V111__plan_change.sql
@@ -0,0 +1,10 @@
+-- A plan's amount changes: the new amount, on the sheet's today then, and by whom. plan.amount holds the plan's current
+-- amount, which the claims generated from then on are made of; claims already generated keep theirs.
+CREATE TABLE plan_change (
+    id         BIGINT AUTO_INCREMENT PRIMARY KEY,
+    plan_id    BIGINT         NOT NULL REFERENCES plan(id) ON DELETE CASCADE,
+    changed_on DATE           NOT NULL,
+    amount     DECIMAL(14, 2) NOT NULL,
+    changed_by VARCHAR(100)   NOT NULL
+);
+CREATE INDEX plan_change_plan ON plan_change(plan_id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/plans/{planId}/amount.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/plans/{planId}/amount.POST.yml
new file mode 100644
index 0000000..5c19353
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/plans/{planId}/amount.POST.yml
@@ -0,0 +1,21 @@
+# Change a plan's amount from the sheet's today: the claims generated from then on are made of the new amount, those
+# already generated keep theirs. A refused change (a bad amount, no today, unknown plan) writes nothing, not even an
+# audit line.
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlanAmount
+  next: load
+load:
+  class: net.officefloor.hq.app.plan.LoadPlan
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.plan.SavePlanAmount
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.plan.AuditPlanAmount
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
+  govern: [ transaction ]
