+# POST /api/sheets/{sheetId}/plans/{planId}/amount — Changes the plan's amount from the sheet's today: an amount the plan
+# form takes; any other, or a plan not on the sheet, is a 400, none writing anything. The claims generated from then on
+# take the new amount; those already made keep theirs. Writes PLAN_CHANGED. Responds 204.
+load:
+  class: net.officefloor.hq.app.plan.LoadPlan
+  govern: [ transaction ]
+  next: change
+change:
+  class: net.officefloor.hq.app.plan.ChangePlanAmount
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithNoContent
