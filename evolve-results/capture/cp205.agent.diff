+# Change a plan's amount from the sheet's today (a bad amount is refused). Answers the sheet's plans.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: change
+change:
+  class: net.officefloor.hq.app.plan.ChangePlanAmount
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.plan.LoadPlans
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlans
