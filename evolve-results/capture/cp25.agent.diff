diff --git a/src/main/frontend/features/overdue/overdue.slot.tsx b/src/main/frontend/features/overdue/overdue.slot.tsx
new file mode 100644
index 000000000..24a03abcc
--- /dev/null
+++ b/src/main/frontend/features/overdue/overdue.slot.tsx
@@ -0,0 +1,59 @@
+import { SheetBody } from '../../slots/defs/sheetBody';
+import { PersonHead, PersonRow } from '../../slots/defs/personRow';
+import { usePeople } from '../people/people';
+import type { Person } from '../people/people';
+import { useClaims } from '../claims/claims';
+import { sumDue, useRates } from '../rates/rates';
+import { useSheetToday } from '../sheet/sheet';
+import { useFloor, useTerms } from '../access/access';
+import { personOverdue } from './overdue';
+
+function OverdueHead() {
+  return (
+    <>
+      <th>Overdue</th>
+      <th>Overdue due</th>
+    </>
+  );
+}
+
+// A person's overdue claims that count: how many, and their due added up.
+function PersonOverdue({ sheetId, person }: { sheetId: string; person: Person }) {
+  const claims = (useClaims(sheetId).data ?? []).filter((c) => c.personId === person.id);
+  const rates = useRates(sheetId).data ?? [];
+  const today = useSheetToday(sheetId);
+  const terms = useTerms(sheetId);
+  const floor = useFloor(sheetId);
+  const { count, total } = personOverdue(rates, person.grade, today, terms, claims, person.held, floor);
+  return (
+    <>
+      <td data-testid="person-overdue-count">{count}</td>
+      <td data-testid="person-overdue-total">{total}</td>
+    </>
+  );
+}
+
+// The sheet's overdue claims that count: everyone's overdue count and overdue-total added up.
+function OverdueTotal({ sheetId }: { sheetId: string }) {
+  const people = usePeople(sheetId).data ?? [];
+  const claims = useClaims(sheetId).data ?? [];
+  const rates = useRates(sheetId).data ?? [];
+  const today = useSheetToday(sheetId);
+  const terms = useTerms(sheetId);
+  const floor = useFloor(sheetId);
+  const each = people.map((p) =>
+    personOverdue(rates, p.grade, today, terms, claims.filter((c) => c.personId === p.id), p.held, floor),
+  );
+  return (
+    <p>
+      Overdue: <strong data-testid="rollup-overdue-count">{each.reduce((n, o) => n + o.count, 0)}</strong>, due{' '}
+      <strong data-testid="rollup-overdue-total">{sumDue(each.map((o) => o.total))}</strong>
+    </p>
+  );
+}
+
+export const contributions = [
+  SheetBody.fill({ order: 25, Component: OverdueTotal }),
+  PersonHead.fill({ order: 25, Component: OverdueHead }),
+  PersonRow.fill({ order: 25, Component: PersonOverdue }),
+];
diff --git a/src/main/frontend/features/overdue/overdue.ts b/src/main/frontend/features/overdue/overdue.ts
new file mode 100644
index 000000000..9712d9c66
--- /dev/null
+++ b/src/main/frontend/features/overdue/overdue.ts
@@ -0,0 +1,38 @@
+import type { Grade } from '../people/people';
+import { counts } from '../claims/claims';
+import type { Claim } from '../claims/claims';
+import { claimDue, rateOn, sumDue } from '../rates/rates';
+import type { Rate } from '../rates/rates';
+
+/** A date (yyyy-MM-dd) and a number of days after it, as yyyy-MM-dd. Worked in UTC so no zone shifts it. */
+export function addDays(date: string, days: number): string {
+  const [y, m, d] = date.split('-').map(Number);
+  return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
+}
+
+/** A claim's due-by: its date plus the sheet's terms (days). */
+export const dueBy = (claim: Claim, terms: number): string => addDays(claim.date, terms);
+
+/** Whether a claim is overdue: OPEN, and its due-by before the sheet's `today`. */
+export const isOverdue = (claim: Claim, terms: number, today: string): boolean =>
+  claim.status === 'OPEN' && today !== '' && dueBy(claim, terms) < today;
+
+/**
+ * A person's overdue claims that count (none while they are `held`, as an OPEN claim then counts in
+ * no total): how many, and their due figures added up, skipping n/a.
+ */
+export function personOverdue(
+  rates: Rate[],
+  grade: Grade,
+  today: string,
+  terms: number,
+  claims: Claim[],
+  held: boolean,
+  floor: string,
+): { count: number; total: string } {
+  const overdue = claims.filter((c) => counts(c, held) && isOverdue(c, terms, today));
+  return {
+    count: overdue.length,
+    total: sumDue(overdue.map((c) => claimDue(c, rateOn(rates, grade, c.date), floor))),
+  };
+}
