@@ -0,0 +1,64 @@
+import { HomeMain } from '../../slots/defs/homeMain';
+import { PersonColumnHeads, PersonColumns } from '../../slots/defs/personColumns';
+import { type Person, usePeople } from '../people/people';
+import { useCurrentSheet } from '../../session/session';
+import { useSheetToday } from '../sheet/sheet';
+import { counts, live, useClaims } from '../claims/claims';
+import { useSettings } from '../settings/settings';
+import { dueTotal, useRates } from '../rates/rates';
+import { overdueFigures } from './overdue';
+
+// A person's overdue count and overdue-total (the due of their overdue claims that count), and the sheet's.
+function OverdueHead() {
+  return (
+    <>
+      <th>Overdue</th>
+      <th>Overdue total</th>
+    </>
+  );
+}
+
+function useOverdue() {
+  const [sheet] = useCurrentSheet();
+  const claims = useClaims(sheet);
+  const rates = useRates(sheet);
+  const today = useSheetToday(sheet);
+  const settings = useSettings(sheet).data;
+  return (person: Person) =>
+    overdueFigures(
+      live((claims.data ?? []).filter((c) => c.personId === person.id), [person]).filter(counts),
+      rates.data,
+      person.grade,
+      settings?.floor,
+      settings?.terms,
+      today,
+    );
+}
+
+function PersonOverdue({ person }: { person: Person }) {
+  const { count, total } = useOverdue()(person);
+  return (
+    <>
+      <td data-testid="person-overdue-count">{count}</td>
+      <td data-testid="person-overdue-total">{total}</td>
+    </>
+  );
+}
+
+function OverdueTotal() {
+  const [sheet] = useCurrentSheet();
+  const people = usePeople(sheet);
+  const figures = (people.data ?? []).map(useOverdue());
+  return (
+    <p>
+      Overdue <strong data-testid="rollup-overdue-count">{figures.reduce((n, f) => n + f.count, 0)}</strong>{' '}
+      Overdue total <strong data-testid="rollup-overdue-total">{dueTotal(figures.map((f) => f.total))}</strong>
+    </p>
+  );
+}
+
+export const contributions = [
+  PersonColumnHeads.fill({ order: 17, Component: OverdueHead }),
+  PersonColumns.fill({ order: 17, Component: PersonOverdue }),
+  HomeMain.fill({ order: 36, Component: OverdueTotal }),
+];
diff --git a/src/main/frontend/features/overdue/overdue.ts b/src/main/frontend/features/overdue/overdue.ts
new file mode 100644
index 000000000..205ad7a2d
--- /dev/null
+++ b/src/main/frontend/features/overdue/overdue.ts
@@ -0,0 +1,31 @@
+import type { Claim } from '../claims/claims';
+import { type Rate, claimDue, dueTotal } from '../rates/rates';
+
+/** The terms a sheet has until they are set: 14 days. */
+export const DEFAULT_TERMS = '14';
+
+/** The claim's due-by (yyyy-MM-dd): its date plus the terms (whole days) in force. */
+export function dueBy(claim: Claim, terms: string | undefined): string {
+  const d = new Date(`${claim.date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + Number(terms ?? DEFAULT_TERMS));
+  return d.toISOString().slice(0, 10);
+}
+
+/** Whether the claim is overdue: it is OPEN and its due-by is before the sheet's today. */
+export function overdue(claim: Claim, terms: string | undefined, today: string | undefined): boolean {
+  return claim.status === 'OPEN' && today !== undefined && dueBy(claim, terms) < today;
+}
+
+/** A person's overdue claims among these (their claims that count): how many, and the sum of their
+ *  figures at the person's grade, skipping n/a. */
+export function overdueFigures(
+  claims: Claim[],
+  rates: Rate[] | undefined,
+  grade: string,
+  floor: string | undefined,
+  terms: string | undefined,
+  today: string | undefined,
+): { count: number; total: string } {
+  const late = claims.filter((c) => overdue(c, terms, today));
+  return { count: late.length, total: dueTotal(late.map((c) => claimDue(c, rates, grade, floor))) };
+}
