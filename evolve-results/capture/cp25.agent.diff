+    @Query("SELECT new net.officefloor.hq.app.ProjectView(p.id, p.name, c.name, p.archived) "
             + "FROM Project p, Client c WHERE p.clientId = c.id AND p.clientId = :clientId "
-            + "ORDER BY p.id ASC")
