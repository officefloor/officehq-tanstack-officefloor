+# Merge a grade into another: validate first so a refused merge writes nothing.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeMerge
+  next: merge
+merge:
+  class: net.officefloor.hq.app.grade.MergeGrade
+  govern: [ transaction ]
