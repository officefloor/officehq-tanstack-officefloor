+# POST /api/sheets/{sheetId}/grades/merge — merge a grade into another (a steward only). Body: { "from": "A|B|C", "into": "A|B|C" }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.GuardArchived
+  next: validate
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeMerge
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.grade.ApplyGradeMerge
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGradeMerged
+  govern: [ transaction ]
