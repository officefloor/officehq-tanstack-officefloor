@@ -0,0 +1,18 @@
+# POST /api/sheets/{sheetId}/grades/merge — merge a grade into another: every person whose grade in force on the sheet's
+# today is the merged grade is given the other from the sheet's today, in list order, each exactly as the person form
+# would (PERSON_EDITED and the figures it moved; see MergeGrade). The same grade twice, a grade other than A, B or C, a
+# merger who is not a steward, or the other grade retired when anyone is to be given it, is a 400 and writes nothing.
+# Writes GRADE_MERGED before the edits. Responds with how many people were given the other grade.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateMergeGrade
+  next: steward
+steward:
+  class: net.officefloor.hq.app.grade.CheckGradeMerger
+  govern: [ transaction ]
+  next: merge
+merge:
+  class: net.officefloor.hq.app.grade.MergeGrade
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithMergeGrade
