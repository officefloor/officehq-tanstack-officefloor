+# Merge a grade into another (a steward only; the same grade twice is refused): everyone whose grade in
+# force on the sheet's today is the merged grade gets the other from the sheet's today, in list order,
+# exactly as the person form would. Answers how many were moved.
+guard:
+  class: net.officefloor.hq.app.history.RefuseAsOf
+  next: merge
+merge:
+  class: net.officefloor.hq.app.person.MergeGrade
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithGradeMerge
