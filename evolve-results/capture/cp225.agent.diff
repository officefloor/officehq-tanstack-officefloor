@@ -0,0 +1,19 @@
+package net.officefloor.hq.app.grade;
+
+import net.officefloor.hq.app.setting.Settings;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Refuses a grade other than A, B or C, or the same grade twice, before anything is read. */
+public class ValidateGradeMerge {
+    public void validate(@RequestBody GradeMergeRequest request, Out<GradeMergeRequest> body)
+            throws InvalidGradeException {
+        String from = request == null || request.from() == null ? "" : request.from().trim();
+        String into = request == null || request.into() == null ? "" : request.into().trim();
+        if (!Settings.GRADES.contains(from) || !Settings.GRADES.contains(into)) {
+            throw new InvalidGradeException("A grade is one of A, B or C");
+        }
+        if (from.equals(into)) throw new InvalidGradeException("A grade cannot be merged into itself");
+        body.set(new GradeMergeRequest(from, into));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades/merge.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades/merge.POST.yml
new file mode 100644
index 000000000..c67ca20b6
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades/merge.POST.yml
@@ -0,0 +1,32 @@
+# Merge a grade into another (a steward): everyone whose grade in force today is the merged grade is
+# given the other from the sheet's today, in list order, each exactly as the person form would. A grade
+# other than A, B or C, the same grade twice, a retired grade to merge into, or anyone but a steward, is
+# refused and writes nothing. A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeMerge
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: merge
+# Its own line first, then each person graded: their PERSON_EDITED line, then the figures it moved.
+merge:
+  class: net.officefloor.hq.app.grade.MergeGrade
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures the whole merge moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGradeMerge
+  govern: [ transaction ]
