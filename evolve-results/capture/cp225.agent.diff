--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades/merge.POST.yml
@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/grades/merge — merges a grade into another (body: {from, into, user}). Only a
+# steward may; anyone else, the same grade twice, a grade other than A, B or C, or an archived sheet is refused
+# (400) and nothing is stored. Recorded as GRADE_MERGED from=<grade> into=<grade>; then every person whose grade
+# in force on the sheet's today is the merged grade is given the other from the sheet's today, in list order,
+# exactly as the person form's edit would (PERSON_EDITED, then how it moved the sheet's figures), and then how
+# the merge as a whole moved them. A retired into-grade is refused as the person form's edit would. Answers {from, into, merged}.
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeMerge
+  next: merge
+merge:
+  class: net.officefloor.hq.app.grade.MergeGrade
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithGradeMerged
+  govern: [ transaction ]
