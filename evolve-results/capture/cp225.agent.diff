+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/grades/merge.POST.yml
@@ -0,0 +1,31 @@
+# POST /api/sheets/{sheetId}/grades/merge — merges a grade into another. Body {"from":"A|B|C","into":"A|B|C"}. Only a
+# steward merges; the same grade twice, or a retired grade to merge into, is refused with 422 and nothing is stored or
+# recorded. Records GRADE_MERGED, then each person on the merged grade today is edited as the person form would, then
+# the ROLLUP lines for the merge as a whole. Responds with the grades and how many people were given the other grade.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.grade.ValidateGradeMerge
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: merge
+  govern: [ transaction ]
+merge:
+  class: net.officefloor.hq.app.grade.MergeGrade
+  next: rollup
+  govern: [ transaction ]
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.grade.RespondWithMerge
+  govern: [ transaction ]
