+  govern: [ transaction ]
+  next: closed
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: lock
+lock:
+  class: net.officefloor.hq.app.claim.LockClaim
+  govern: [ transaction ]
+  next: respond
+respond:
