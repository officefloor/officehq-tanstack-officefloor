+# POST /api/sheets/{sheetId}/claims/{claimId}/unlock — cancel a claim's editor (body {user}): releases the
+# user's lock on the claim; a lock another user holds stays. Records nothing in the audit file.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyUnlock
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
