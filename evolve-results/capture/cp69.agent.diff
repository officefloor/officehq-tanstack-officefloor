+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateLock {
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody LockRequest request, Out<LockInput> body, RoleStore roles) throws InvalidSheetException {
+        roles.refuseChange(sheetId.trim(), request == null ? null : request.user());
+        body.set(new LockInput(request.user() == null ? "" : request.user().trim()));
+    }
+}
