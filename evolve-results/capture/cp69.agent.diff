@@ -0,0 +1,21 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/lock — open a claim's editor: locks the claim for the user until its edit
+# is saved, the editor is cancelled (PUT .../unlock) or the sheet's today changes. A claim that is not a DRAFT, one
+# dated inside a closed period, or one another user holds is a 409 and a claim not on the sheet a 404, neither
+# writing anything (a viewer is refused before, see ViewerGuard). Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateLock
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyLock
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveLock
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/unlock.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/unlock.PUT.yml
new file mode 100644
index 000000000..7de2ed377
--- /dev/null
