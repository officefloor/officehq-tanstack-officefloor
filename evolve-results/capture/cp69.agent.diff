+-- The user whose open editor locks a claim against everyone else's edit button: null when no editor holds it.
+-- Released when that editor is saved or cancelled, and on every claim of the sheet when its today changes.
+ALTER TABLE claim ADD COLUMN locked_by VARCHAR(200);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheet}/claims/{claim}/lock.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheet}/claims/{claim}/lock.POST.yml
new file mode 100644
index 00000000..77fa0983
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheet}/claims/{claim}/lock.POST.yml
@@ -0,0 +1,12 @@
+# Open a claim's editor: lock it for the user against every other user's edit button (only a DRAFT outside a closed period). Responds with the sheet's claims.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: lock
+lock:
+  class: net.officefloor.hq.app.claim.LockClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaims
+  govern: [ transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheet}/claims/{claim}/unlock.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheet}/claims/{claim}/unlock.POST.yml
new file mode 100644
index 00000000..7b550b2e
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheet}/claims/{claim}/unlock.POST.yml
@@ -0,0 +1,12 @@
+# Cancel a claim's editor: release the user's lock on it. Responds with the sheet's claims.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: unlock
+unlock:
+  class: net.officefloor.hq.app.claim.UnlockClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaims
+  govern: [ transaction ]
