@@ -0,0 +1,15 @@
+# PUT /api/sheets/{sheetId}/claims/{claimId}/unlock — cancel a claim's editor: releases the lock the user holds on it
+# (a lock another user holds is kept). A claim not on the sheet is a 404. Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateLock
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: release
+release:
+  class: net.officefloor.hq.app.claim.ReleaseLock
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
