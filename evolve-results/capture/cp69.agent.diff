@@ -0,0 +1,21 @@
+# Open a claim's editor (its edit button): the claim is locked for every other user until the editor
+# is saved or cancelled, or the sheet's today changes. A claim another user has locked, one that is no
+# longer a DRAFT, or one dated in a closed period is a 409 and takes no lock. Writes no audit line.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimLock
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimLock
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimLock
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
