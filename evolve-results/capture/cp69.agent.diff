--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lock.POST.yml
@@ -0,0 +1,26 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/lock — open a claim's editor (body {user}): locks the claim
+# for every other user until the editor is saved or cancelled (unlock) or the sheet's today changes.
+# Refused (400) for a viewer, a claim not on the sheet, one that is not a DRAFT, one whose date falls in a
+# closed period, or one another user has locked; nothing is stored then. Records nothing in the audit file.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateLock
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkDraft
+checkDraft:
+  class: net.officefloor.hq.app.claim.CheckClaimDraft
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyLock
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/unlock.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/unlock.POST.yml
