+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lock.POST.yml
@@ -0,0 +1,17 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/lock — open a claim's editor, locking it for other users
+# until it is saved or cancelled or the sheet's today changes; refused (409) when it is not a DRAFT,
+# (423) when dated in a closed period, (412) when another user holds its lock.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: lock
+lock:
+  class: net.officefloor.hq.app.claim.LockClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/unlock.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/unlock.POST.yml
new file mode 100644
index 000000000..d3df7db30
--- /dev/null
