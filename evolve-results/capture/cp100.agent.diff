+# Checks a bulk settle before it settles anything: every ticked claim must be one the signed-in user's own settle
+# would not refuse (going PENDING is not a refusal); any one refused refuses the whole bulk settle (400). Writes nothing.
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: check
+check:
+  class: net.officefloor.hq.app.claim.CheckBulkSettle
+  govern: [ readonly-transaction ]
