@@ -0,0 +1,11 @@
+# POST /api/sheets/{sheetId}/bulk-settle — settles the ticked claims all or nothing. Body {"claimIds":[...]}, in list
+# order. Each is settled as settling it alone would (one going to PENDING counts as settled), in one transaction: if any
+# is refused (or the user is a viewer, or the sheet archived), none is settled, all count as refused and nothing is
+# stored or recorded. Otherwise they form the sheet's next settle batch, recorded after the claims' own lines as
+# BATCH_SETTLED batch=<n> count=<claims> total=<their SETTLED frozen figures added up>.
+# Responds {settled, refused, last}. The step owns its transaction, so it is not governed here.
+apply:
+  class: net.officefloor.hq.app.batch.ApplyBulkSettle
+  next: respond
+respond:
+  class: net.officefloor.hq.app.batch.RespondWithBulkSettle
