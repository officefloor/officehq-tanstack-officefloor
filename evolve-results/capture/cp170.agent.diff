+// The rate calendar: for each grade and each month of the sheet's today's calendar year, the rate in force on the first day of
+// that month (n/a when none).
+function RateCalendar({ sheetId }: { sheetId: string }) {
+  const rates = useRates(sheetId);
+  const today = useSheetToday(sheetId).data?.today;
+  if (today === undefined) return null;
+  const year = today.slice(0, 4);
+  const months = Array.from({ length: 12 }, (_, i) => `${year}-${String(i + 1).padStart(2, '0')}`);
+  return (
+    <table data-testid="rate-calendar">
+      <thead>
+        <tr>
+          <th>Grade</th>
+          {months.map((m) => (
+            <th key={m}>{m}</th>
+          ))}
+        </tr>
+      </thead>
+      <tbody>
+        {GRADES.map((g) => (
+          <tr key={g}>
+            <td>{g}</td>
+            {months.map((m) => {
+              const r = rateOn(rates.data ?? [], g, `${m}-01`);
+              return (
+                <td key={m} data-testid={`rate-month-${g}-${m}`}>
+                  {r ? showHundredths(toHundredths(r.rate)) : NA}
+                </td>
+              );
+            })}
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
+
 // The rate preview: how many OPEN and PENDING claims of people on a grade (on the claim's date) would show a different due if a
 // candidate rate applied to that grade on every date, and the sum of new due minus current due. A settled or bound claim keeps
 // its figure, so it never changes. Nothing is saved. Changing the grade or the rate clears the result shown.
