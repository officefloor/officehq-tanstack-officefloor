+/** Whether a claim is pending-late: PENDING, and its pending day (the sheet's today when it last went to
+ *  PENDING, from its status log) plus the sheet's pending SLA days is before the sheet's today. Never
+ *  while the sheet has no pending SLA. */
+export function usePendingLate(sheet: string): (claim: { status: string; log: string[] }) => boolean {
+  const sla = useSettings(sheet).data?.pendingSla ?? null;
+  const today = useSheetToday(sheet);
+  return (claim) => {
+    if (sla === null || today === '' || claim.status !== 'PENDING') return false;
+    const day = [...claim.log].reverse().map((l) => /^PENDING by .* on (\d{4}-\d{2}-\d{2}) /.exec(l)).find((m) => m)?.[1];
+    if (!day) return false;
+    const due = new Date(`${day}T00:00:00Z`);
+    due.setUTCDate(due.getUTCDate() + sla);
+    return due.toISOString().slice(0, 10) < today;
+  };
+}
