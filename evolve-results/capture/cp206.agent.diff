+  const ids = new Set<number>([self.id]);
+  for (const c of crews.data) {
+    const members = [c.leadId, ...c.members.map((m) => m.personId)];
+    if (members.includes(self.id)) members.forEach((id) => ids.add(id));
+  }
+  return (p) => ids.has(p.id);
+}
 
