+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/approver.POST.yml
@@ -0,0 +1,29 @@
+# Set the person's approver: a user who may approve or reject their PENDING claims as a steward
+# may (not one they opened or last edited). Blank clears it. Validate first so a bad name is a 400.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateApprover
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: approver
+approver:
+  class: net.officefloor.hq.app.person.SetApprover
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the approver is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditApproverSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
