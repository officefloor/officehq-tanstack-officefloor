+# Set a person's approver: a user name who may approve or reject the person's PENDING claims as a steward may (not
+# one they opened or last edited); setting it again replaces it, a blank name clears it. A refused set (no signed-in
+# user, a name with spaces, unknown person) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.approver.ValidateApprover
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.approver.SaveApprover
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.approver.AuditApproverSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.approver.RespondWithApprover
+  govern: [ transaction ]
