diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/approver.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/approver.POST.yml
new file mode 100644
index 000000000..7492de646
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/approver.POST.yml
@@ -0,0 +1,21 @@
+# POST /api/sheets/{sheetId}/people/{personId}/approver — makes the user the person's approver (replacing any): they
+# may approve or reject the person's PENDING claims as a steward may (see ApplyClaimStatus). A blank user, one not a
+# single word, or a body without by is a 400 and a person not on the sheet a 404, none writing anything. Responds with
+# the approver.
+validate:
+  class: net.officefloor.hq.app.person.ValidateApprover
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.ApplyApprover
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordApproverSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithApprover
