+# Set a person's approver, who may approve or reject their pending claims as a steward may (a viewer is refused).
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateApprover
+  next: set
+set:
+  class: net.officefloor.hq.app.person.SetApprover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
