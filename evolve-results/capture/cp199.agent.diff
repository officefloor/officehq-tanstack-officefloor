@@ -0,0 +1,16 @@
+# Sets a person's approver: a user who may approve or reject their PENDING claims as a steward may.
+validate:
+  class: net.officefloor.hq.app.person.ValidateApprover
+  next: set
+set:
+  class: net.officefloor.hq.app.person.SetApprover
+  govern: [ transaction ]
+  next: record
+# Audit only once the approver is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordApproverSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
