+# Sets the person's approver (a user name; blank clears it). Validate before load so a bad body is a 400, not masked by a 404. Responds with the sheet's people.
+validate:
+  class: net.officefloor.hq.app.person.ValidateApprover
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.SetApprover
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPeople
+  govern: [ transaction ]
