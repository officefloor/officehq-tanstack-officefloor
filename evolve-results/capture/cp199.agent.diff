@@ -0,0 +1,23 @@
+# POST /api/sheets/{sheetId}/people/{personId}/approver — set a person's approver (body: {approver, user}): a
+# user name, or blank to clear it. Setting it again replaces it. The approver may approve or reject the person's
+# PENDING claims as a steward may (not one they opened or last edited). Refused (400), storing nothing, when the
+# user may not change the sheet, the name has a space in it or the person is not on the sheet. A stored approver
+# is recorded in the audit file as APPROVER_SET.
+validate:
+  class: net.officefloor.hq.app.person.ValidateApprover
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: set
+set:
+  class: net.officefloor.hq.app.person.SetApprover
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditApproverSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
