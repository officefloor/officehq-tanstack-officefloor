@@ -0,0 +1,23 @@
+# POST /api/sheets/{sheetId}/people/{personId}/approver — names the user ({"user": ...}; blank: none) who
+# may approve or reject the person's PENDING claims as a steward may, replacing any before.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateApprover
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: set
+set:
+  class: net.officefloor.hq.app.person.SetApprover
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordApproverSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
