+# Undo the last merge into the person (a steward only, the one who merged, on the sheet's today it was made): the merged person is back with the claims that came from them and their own aliases, and PERSON_MERGE_UNDONE is written.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMergeUndo
+  next: snapshot
+# The sheet's figures before the change, so the change can audit what it moved.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoMergePerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
