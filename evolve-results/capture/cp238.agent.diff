diff --git a/src/main/java/net/officefloor/hq/app/person/UndoMerge.java b/src/main/java/net/officefloor/hq/app/person/UndoMerge.java
new file mode 100644
index 00000000..a06273cf
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/person/UndoMerge.java
@@ -0,0 +1,37 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.setting.Settings;
+import net.officefloor.hq.app.sheet.Sheets;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import net.officefloor.server.http.ServerHttpConnection;
+
+public class UndoMerge {
+    // Only the steward who made the last merge into the person undoes it, and only on the sheet-today it was made: the
+    // merged person is back with the claims and aliases that went with them.
+    public void undo(@Val Person person, People people, Settings settings, Sheets sheets, ServerHttpConnection connection,
+            Out<MergeUndone> undoneOut, Out<PersonResponse> responseOut) throws PersonMergeRefusedException {
+        String user = Audit.user(connection).trim();
+        if (!Settings.STEWARD.equals(settings.role(person.sheetId(), user))) {
+            throw new PersonMergeRefusedException("Only a steward can undo a merge.");
+        }
+        MergeKept merge = people.lastMerge(person.sheetId(), person.id());
+        if (merge == null || merge.undone()) {
+            throw new PersonMergeRefusedException("There is no merge into this person to undo.");
+        }
+        if (!merge.mergedBy().equals(user)) {
+            throw new PersonMergeRefusedException("Only the steward who made a merge can undo it.");
+        }
+        if (!sheets.today(person.sheetId()).equals(merge.mergedOn())) {
+            throw new PersonMergeRefusedException("A merge can be undone only on the day it was made.");
+        }
+        if (people.personNamed(person.sheetId(), merge.name())) {
+            throw new PersonMergeRefusedException("Another person now has the name " + merge.name() + ".");
+        }
+        people.undoMerge(person.sheetId(), merge, person.id());
+        Person restored = people.find(person.sheetId(), merge.fromId());
+        undoneOut.set(new MergeUndone(restored, person));
+        responseOut.set(PersonResponse.from(restored, sheets.today(person.sheetId())));
+    }
+}
diff --git a/src/main/resources/db/migration/V100__person_merge.sql b/src/main/resources/db/migration/V100__person_merge.sql
new file mode 100644
index 00000000..245d9845
--- /dev/null
+++ b/src/main/resources/db/migration/V100__person_merge.sql
@@ -0,0 +1,42 @@
+-- The merges done on a sheet, kept so the last merge into a person can be undone on the sheet-today it was made: the
+-- merged person as they were (their id, name, grades, terms, contact and tags), who merged them and on what day, and
+-- which claims and aliases went with them to the person merged into. An undone merge is marked so.
+CREATE TABLE person_merge (
+    id              BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id        VARCHAR(255) NOT NULL,
+    into_id         BIGINT       NOT NULL,
+    from_id         BIGINT       NOT NULL,
+    name            VARCHAR(255) NOT NULL,
+    grade           VARCHAR(1)   NOT NULL,
+    terms           INT,
+    contact         VARCHAR(255),
+    tags            VARCHAR(4000),
+    origin_sheet_id VARCHAR(255),
+    origin_name     VARCHAR(255),
+    transferred_on  DATE,
+    merged_by       VARCHAR(255) NOT NULL,
+    merged_on       DATE         NOT NULL,
+    undone          BOOLEAN DEFAULT FALSE NOT NULL
+);
+CREATE INDEX person_merge_into ON person_merge (sheet_id, into_id, id);
+CREATE TABLE person_merge_claim (
+    merge_id BIGINT NOT NULL,
+    claim_id BIGINT NOT NULL
+);
+CREATE INDEX person_merge_claim_merge ON person_merge_claim (merge_id);
+-- The aliases that went with the merged person: their own, and the alias their name became.
+CREATE TABLE person_merge_alias (
+    merge_id BIGINT NOT NULL,
+    alias_id BIGINT NOT NULL
+);
+CREATE INDEX person_merge_alias_merge ON person_merge_alias (merge_id);
+CREATE TABLE person_merge_grade (
+    merge_id  BIGINT     NOT NULL,
+    from_date DATE       NOT NULL,
+    grade     VARCHAR(1) NOT NULL
+);
+CREATE TABLE person_merge_terms (
+    merge_id  BIGINT NOT NULL,
+    from_date DATE   NOT NULL,
+    terms     INT
+);
