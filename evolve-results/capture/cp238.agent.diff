+# The steward who made the last merge into the person undoes it, on the sheet-today it was made: the
+# merged person is back at the end of the list with the claims that came from them (numbers and
+# status as they are now) and their own aliases, which leave this person's; patron and pool changes
+# stay. Refused (400) for anyone else, any later day, or a person with no merge to undo.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMergeUndo
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoMerge
+  govern: [ transaction ]
+  next: record
+record:
+  class: net.officefloor.hq.app.person.RecordMergeUndone
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
