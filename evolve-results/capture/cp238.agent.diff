@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.person;
+
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Refuses a merge undo by anyone but a steward. */
+public class ValidateMergeUndo {
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody MergeUndoRequest request,
+            RoleStore roles, Out<MergeUndoRequest> body) throws InvalidSheetException {
+        String user = request == null || request.user() == null ? "" : request.user().trim();
+        roles.refuseChange(sheetId.trim(), user);
+        if (roles.find(sheetId.trim(), user) != Role.STEWARD) {
+            throw new InvalidSheetException("Only a steward may undo a merge");
+        }
+        body.set(new MergeUndoRequest(user));
+    }
+}
diff --git a/src/main/resources/db/migration/V100__person_merge.sql b/src/main/resources/db/migration/V100__person_merge.sql
new file mode 100644
index 000000000..fc1edb4cd
--- /dev/null
+++ b/src/main/resources/db/migration/V100__person_merge.sql
@@ -0,0 +1,40 @@
+-- Each merge of a person into another, kept so the last merge into a person can be undone on the sheet-today it
+-- was made by the steward who made it: the merged person's own row (name, terms, contact, tags, where they came
+-- from, version), their grades and dated terms, the alias rows that moved with them (their name's alias among
+-- them) and the claims that came from them. An undone merge is marked so.
+CREATE TABLE person_merge (
+    id            BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id      VARCHAR(255) NOT NULL,
+    from_id       BIGINT       NOT NULL,
+    into_id       BIGINT       NOT NULL,
+    merged_by     VARCHAR(255) NOT NULL,
+    merged_on     DATE,
+    undone        BOOLEAN      DEFAULT FALSE NOT NULL,
+    name          VARCHAR(255) NOT NULL,
+    terms         INT,
+    contact       VARCHAR(255),
+    tags          VARCHAR(4000),
+    origin        VARCHAR(255),
+    arrived_on    DATE,
+    version       BIGINT       NOT NULL,
+    name_alias_id BIGINT
+);
+CREATE INDEX person_merge_into ON person_merge (sheet_id, into_id, id);
+CREATE TABLE person_merge_grade (
+    merge_id  BIGINT      NOT NULL,
+    from_date DATE        NOT NULL,
+    grade     VARCHAR(255) NOT NULL
+);
+CREATE TABLE person_merge_terms (
+    merge_id  BIGINT NOT NULL,
+    from_date DATE   NOT NULL,
+    terms     INT
+);
+CREATE TABLE person_merge_alias (
+    merge_id BIGINT NOT NULL,
+    alias_id BIGINT NOT NULL
+);
+CREATE TABLE person_merge_claim (
+    merge_id BIGINT NOT NULL,
+    claim_id BIGINT NOT NULL
+);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge-undo.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge-undo.POST.yml
new file mode 100644
index 000000000..1cb6e889c
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge-undo.POST.yml
@@ -0,0 +1,33 @@
+# POST /api/sheets/{sheetId}/people/{personId}/merge-undo — undo the last merge into a person (body: {user}). Only
+# the steward who made the merge undoes it, and only on the sheet-today it was made. The merged person is back at
+# the end of the list (under their id, with their grades and terms) with the claims that came from them, as they
+# are now, and their own aliases, which leave the other's; patron and pool changes stay. Refused (400), storing
+# nothing, when the user is not a steward or not the one who merged, the person has no merge to undo (or its undo
+# is done), the merge was made on another day, or the merged person's name is now taken. A stored undo is recorded
+# in the audit file as PERSON_MERGE_UNDONE, followed by how it moved the figures.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMergeUndo
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: prepare
+prepare:
+  class: net.officefloor.hq.app.person.PrepareMergeUndo
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoMerge
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMergeUndone
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithMergeUndone
+  govern: [ transaction ]
