+# Undo the last merge into the person. Anyone but the steward who made it, any sheet-today but the one it was made on,
+# or a person with no merge to undo is refused (400); a person not on the sheet (404). The merged person is back at the
+# end of the list with the claims that came from them (as they are now) and their own aliases, which leave this
+# person's; patron and pool changes stay. Followed by its rollup.
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.person.CheckMergeUndo
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoMerge
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMergeUndone
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithMergeUndone
+  govern: [ transaction ]
