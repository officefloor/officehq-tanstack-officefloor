@@ -0,0 +1,26 @@
+# Undo the last merge into a person (see UndoMerge): only the steward who made it, only on the sheet-today it was made.
+# The merged person is back at the end of the list with the claims that came from them and their own aliases; patron
+# and pool changes stay. A refused undo (no signed-in user, not a steward, no merge to undo, someone else's merge,
+# another day) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.person.ValidateMergeUndo
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoMerge
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonMergeUndone
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
