+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/merge-undo.POST.yml
@@ -0,0 +1,30 @@
+# POST /api/sheets/{sheetId}/people/{personId}/merge-undo — whoever made the last merge into the person
+# undoes it, on the sheet's today it was made (see UndoMerge): the merged person is back at the end of
+# the list with the claims that came from them and their own aliases; patron and pool changes stay.
+# Then PERSON_MERGE_UNDONE and the sheet's figures are recorded. Anyone else, any later day, or a person
+# with no merge to undo, is refused. A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoMerge
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonMergeUndone
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithMergeUndone
