+# The steward who made the last merge into a person undoes it on the same sheet-today it was made: the merged person
+# is back with the claims that came from them and their own aliases, and the sheet writes PERSON_MERGE_UNDONE.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.MergeUndoPerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
