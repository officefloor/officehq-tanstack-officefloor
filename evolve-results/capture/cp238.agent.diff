+# The steward who merged a person into this one undoes the last such merge, on the sheet's today it was made: the merged
+# person is back at the end of the list with the claims that came from them and their own aliases. Refused (400,
+# nothing written) for anyone else, any later day, or a person with no merge to undo. Responds with the sheet's people.
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: undo
+undo:
+  class: net.officefloor.hq.app.person.UndoMerge
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPeople
+  govern: [ transaction ]
