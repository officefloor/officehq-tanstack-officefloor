@@ -0,0 +1,30 @@
+# Flag a person with a reason until a date (blank: the sheet's today). Only a steward may: anyone
+# else is a 403. Validate first so a blank reason is a 400, not a 404. While the sheet's today is on
+# or before the until-date, only a steward may open a claim of theirs.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateFlag
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: flag
+flag:
+  class: net.officefloor.hq.app.person.FlagPerson
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the flag is saved.
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonFlagged
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
