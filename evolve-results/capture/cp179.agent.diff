+# POST /api/sheets/{sheetId}/people/{personId}/flag — a steward flags the person with a reason until
+# a date (blank: the sheet's today), replacing any flag before; a blank reason, a date that is not a
+# date, and anyone but a steward are refused. While the sheet's today is on or before the until-date
+# the row shows the reason and only a steward may open the person's claims.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateFlag
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: flag
+flag:
+  class: net.officefloor.hq.app.person.FlagPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonFlagged
+  govern: [ transaction ]
