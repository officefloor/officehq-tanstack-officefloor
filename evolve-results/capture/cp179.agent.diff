+# POST /api/sheets/{sheetId}/people/{personId}/flag — flag a person with a reason until a date (blank: the sheet's today),
+# replacing any flag they had. A blank reason or a date that is not yyyy-MM-dd is a 400, as is a user who is not a steward,
+# and a person not on the sheet a 404, none writing anything. While the sheet's today is on or before the until-date only a
+# steward may open a claim of theirs. Responds with the person as stored.
+validate:
+  class: net.officefloor.hq.app.person.ValidateFlag
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: flag
+flag:
+  class: net.officefloor.hq.app.person.FlagPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonFlagged
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
