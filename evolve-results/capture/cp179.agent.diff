@@ -0,0 +1,15 @@
+# A steward flags the person with a reason until a date. Validate before load so a bad body is a 400, not masked by a 404. Responds with the sheet's people.
+validate:
+  class: net.officefloor.hq.app.person.ValidateFlag
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: flag
+flag:
+  class: net.officefloor.hq.app.person.FlagPerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPeople
+  govern: [ transaction ]
