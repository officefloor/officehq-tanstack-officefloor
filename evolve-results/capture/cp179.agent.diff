+# Flag a person with a reason until a date; only a steward may. Validate the body before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: flag
+flag:
+  class: net.officefloor.hq.app.person.ValidateFlag
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
