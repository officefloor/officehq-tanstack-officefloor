+# A steward flags a person with a reason until a date (a viewer, a non-steward or a blank reason is refused).
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateFlag
+  next: flag
+flag:
+  class: net.officefloor.hq.app.person.FlagPerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
