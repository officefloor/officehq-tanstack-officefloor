+ALTER TABLE person ADD COLUMN flag_until DATE;
+ALTER TABLE person_merged ADD COLUMN flag_reason VARCHAR(500) BEFORE merged_on;
+ALTER TABLE person_merged ADD COLUMN flag_until DATE BEFORE merged_on;
