@@ -0,0 +1,17 @@
+# A steward flags a person with a reason until a date: while the sheet's today is on or before it,
+# only a steward may open a claim of theirs.
+validate:
+  class: net.officefloor.hq.app.person.ValidateFlag
+  next: flag
+flag:
+  class: net.officefloor.hq.app.person.FlagPerson
+  govern: [ transaction ]
+  next: record
+# Audit only once the flag is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordPersonFlagged
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
