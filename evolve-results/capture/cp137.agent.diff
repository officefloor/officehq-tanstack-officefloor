+                rs -> {
+                    lines.computeIfAbsent(String.valueOf(rs.getLong("claim_id")), k -> new ArrayList<>())
+                            .add(rs.getString("label") + " " + rs.getInt("qty") + " x " + money(rs.getBigDecimal("unit")));
+                }, sheetId);
+        return lines;
+    }
+
