diff --git a/src/main/resources/db/migration/V74__claim_line.sql b/src/main/resources/db/migration/V74__claim_line.sql
new file mode 100644
index 00000000..21604ddb
--- /dev/null
+++ b/src/main/resources/db/migration/V74__claim_line.sql
@@ -0,0 +1,19 @@
+-- A DRAFT claim's lines, in the order added: each a label, a whole quantity (at least 1) and a unit
+-- amount (two decimals). A claim with lines has the quantities times the unit amounts as its amount.
+CREATE TABLE claim_line (
+    id       BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200)  NOT NULL,
+    claim_id BIGINT        NOT NULL REFERENCES claim (id),
+    label    VARCHAR(2000) NOT NULL,
+    qty      INT           NOT NULL,
+    unit     DECIMAL(19,2) NOT NULL
+);
+CREATE INDEX claim_line_sheet ON claim_line (sheet_id, claim_id, id);
+
+CREATE TABLE asof.claim_line AS SELECT * FROM public.claim_line WHERE FALSE;
+CREATE TABLE asof_hist.claim_line AS SELECT * FROM public.claim_line WHERE FALSE;
+ALTER TABLE asof_hist.claim_line ADD COLUMN h_seq BIGINT NOT NULL;
+ALTER TABLE asof_hist.claim_line ADD COLUMN h_made_on DATE;
+ALTER TABLE asof_hist.claim_line ADD COLUMN h_op CHAR(1) NOT NULL;
+CREATE INDEX claim_line_hist_sheet ON asof_hist.claim_line (sheet_id, h_seq);
+CREATE TRIGGER claim_line_history AFTER INSERT, UPDATE, DELETE ON public.claim_line FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml
new file mode 100644
index 00000000..b7cf0c90
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml
@@ -0,0 +1,34 @@
+# Add a line to a DRAFT claim, as an edit of it: the claim's amount becomes its lines added up. A line
+# with no label, a quantity under 1 or a unit amount of more than two decimals is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimLine
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimLine
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimLine
+  govern: [ transaction ]
+  next: record
+# Audit only once the line is saved: a refused line writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimLineAdded
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
