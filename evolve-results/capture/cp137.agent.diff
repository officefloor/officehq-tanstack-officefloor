+-- A draft claim's lines, oldest first (by id): each with its trimmed label, a whole quantity of at
+-- least 1 and a unit amount with two decimals; while a claim has lines its amount is their total.
+-- The sheet's today when the line was added, so the sheet read as of a date shows the lines it had.
+CREATE TABLE claim_line (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    claim_id BIGINT NOT NULL REFERENCES claim(id),
+    label VARCHAR(200) NOT NULL,
+    qty INT NOT NULL,
+    unit DECIMAL(17, 2) NOT NULL,
+    on_date DATE NOT NULL
+);
+CREATE INDEX claim_line_sheet ON claim_line(sheet_id, claim_id, id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml
new file mode 100644
index 000000000..9012cc470
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml
@@ -0,0 +1,51 @@
+# Add a line to a draft claim: its amount becomes its lines' total. Adding a line is an edit of the
+# claim, so the edit's rules hold: a bad line is a 400; a claim that is not a draft, whose editor
+# another user has open, or due by a date inside a closed period is a 409; all write nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateLine
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: locked
