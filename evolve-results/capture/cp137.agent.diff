@@ -0,0 +1,27 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/lines — add a line to a claim: a label, a quantity (a whole number, at
+# least 1) and a unit amount (two decimals). The claim's amount becomes its lines' quantities times unit amounts added
+# up, kept as an edit by who added it, and CLAIM_LINE_ADDED is audited. Only a DRAFT claim whose due-by is not inside a
+# closed period and that no other user is editing takes a line: any other is a 400, as are invalid values, and a claim
+# not on the sheet is a 404, none writing anything (a viewer, an archived sheet and the as-of view are refused before,
+# see ViewerGuard). Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateLine
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyLine
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveLine
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordLineAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
