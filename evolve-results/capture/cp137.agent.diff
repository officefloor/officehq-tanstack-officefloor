diff --git a/src/main/resources/db/migration/V65__claim_line.sql b/src/main/resources/db/migration/V65__claim_line.sql
new file mode 100644
index 000000000..6fe1fc20b
--- /dev/null
+++ b/src/main/resources/db/migration/V65__claim_line.sql
@@ -0,0 +1,12 @@
+-- A DRAFT claim's lines: a label, a whole quantity (at least 1) and a unit amount (two decimals).
+-- A claim with lines has the quantities times the unit amounts, added up, as its amount.
+-- Listed in the order they were added (by id).
+CREATE TABLE claim_line (
+    id       BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200)   NOT NULL REFERENCES sheet (id),
+    claim_id BIGINT         NOT NULL REFERENCES claim (id),
+    label    VARCHAR(2000)  NOT NULL,
+    qty      INT            NOT NULL,
+    unit     DECIMAL(19, 2) NOT NULL
+);
+CREATE INDEX claim_line_sheet ON claim_line (sheet_id, claim_id, id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml
