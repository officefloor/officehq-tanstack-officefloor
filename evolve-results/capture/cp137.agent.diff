@@ -0,0 +1,40 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/line — add a line to a draft claim (body {user, label, qty, unit}):
+# the line is kept, in the order added, and the claim's amount becomes its lines' quantities times unit amounts,
+# added up. An edit of the claim: the user becomes its edited-by. Refused (400) for a viewer, a claim not on the
+# sheet, an empty label, a quantity that is not a whole number of at least 1, a unit amount that is not a number
+# with up to two decimals, a claim that is not a DRAFT, one whose due-by falls in a closed period, or one another
+# user has locked; nothing is stored then. A kept line is recorded in the audit file as CLAIM_LINE_ADDED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateLine
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkLock
+checkLock:
+  class: net.officefloor.hq.app.claim.CheckLineLock
+  govern: [ transaction ]
+  next: checkDraft
+checkDraft:
+  class: net.officefloor.hq.app.claim.CheckClaimDraft
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyLine
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimLineAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
