index 000000000..4f423846e
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/lines.POST.yml
@@ -0,0 +1,25 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/lines?label=&qty=&unit= — add a line to a DRAFT claim, its
+# amount becoming its lines' total; counts as editing it: refused (409) for a claim not a DRAFT, (423) for
+# one due by a day in a closed period, (412) while another user holds its lock, (400) for a bad line.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.claim.AddClaimLine
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimLine
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimLineAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
