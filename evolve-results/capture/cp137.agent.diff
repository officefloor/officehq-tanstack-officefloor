+                        rs.getString("added_by"), rs.getObject("added_on", LocalDate.class), rs.getString("label"),
+                        rs.getInt("qty"), rs.getBigDecimal("unit").setScale(2))); },
+                sheetId, asOf == null ? null : Date.valueOf(asOf), asOf == null ? null : Date.valueOf(asOf));
+        return out;
