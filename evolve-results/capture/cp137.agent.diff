+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/** Records the line just added to the claim, with its person's name and its new amount, then the line's fields. */
+public class AuditClaimLineAdded {
+    public void audit(@Val Claim claim, @Val ClaimLine line, PersonRepository people,
+            @RequestParam("user") String user, Audit audit) {
+        Person person = people.find(claim.sheetId(), claim.personId());
+        audit.record("CLAIM_LINE_ADDED sheet=" + claim.sheetId() + " by=" + user + " person="
+                + (person == null ? "" : person.name()) + " amount=" + claim.amount().setScale(2).toPlainString()
+                + " date=" + claim.date() + Claim.auditNumber(claim.number()) + " label=" + line.label()
+                + " qty=" + line.qty() + " unit=" + line.unit().setScale(2).toPlainString());
+    }
+}
