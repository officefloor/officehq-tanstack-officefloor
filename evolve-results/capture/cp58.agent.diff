+# PUT /api/sheets/{sheetId}/people/{personId}/watch — the signed-in user (X-User) starts or stops watching the
+# person. Body {"watched":true|false}. Setting it to what it already is stores and records nothing. 404 for a
+# person not on the sheet; 403 for a viewer.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.watch.ValidateWatch
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.watch.ApplyWatch
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.watch.RespondWithWatch
+  govern: [ transaction ]
