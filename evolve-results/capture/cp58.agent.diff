+# POST /api/sheets/{sheetId}/people/{personId}/watch — toggle whether the user watches the person (body:
+# {user}): starts watching when they do not, stops when they do. Refused (400), storing nothing, when no
+# user is given or the person is not on the sheet. A stored toggle is recorded in the audit file as
+# PERSON_WATCHED or PERSON_UNWATCHED. A watcher is told (NOTIFY) of each claim of the person's settled,
+# approved or re-settled.
+validate:
+  class: net.officefloor.hq.app.watch.ValidateWatch
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: toggle
+toggle:
+  class: net.officefloor.hq.app.watch.ToggleWatch
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.watch.AuditWatch
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
