+# Start or stop the signed-in user watching a person. Per user: each sees only their own watches.
+validate:
+  class: net.officefloor.hq.app.person.ValidateWatch
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: toggle
+toggle:
+  class: net.officefloor.hq.app.person.ToggleWatch
+  govern: [ transaction ]
+  next: record
+# Audit only once the watch is saved.
+record:
+  class: net.officefloor.hq.app.person.RecordWatchToggled
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithWatch
+  govern: [ transaction ]
