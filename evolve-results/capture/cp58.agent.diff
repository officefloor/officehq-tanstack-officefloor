+# POST /api/sheets/{sheetId}/people/{personId}/watch — the signed-in user starts ({"on": true}) or stops
+# ({"on": false}) watching the person, for themselves only; nothing changes when that is already so.
+# A claim of a watched person settled, approved or re-settled notifies each watcher (NOTIFY).
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.person.ValidateWatch
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: watch
+watch:
+  class: net.officefloor.hq.app.person.WatchPerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonWatched
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithWatch
