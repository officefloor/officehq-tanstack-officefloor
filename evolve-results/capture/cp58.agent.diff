+# Start or stop the signed-in user watching a person (per user). Asking for the state already held changes nothing
+# and writes no audit line. A refused watch (no signed-in user, unknown person) writes nothing.
+validate:
+  class: net.officefloor.hq.app.watch.ValidateWatch
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.watch.SaveWatch
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.watch.AuditPersonWatched
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.watch.RespondWithWatch
+  govern: [ transaction ]
