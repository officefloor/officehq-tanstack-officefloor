+# PUT /api/sheets/{sheetId}/people/{personId}/watch — the signed-in user starts or stops watching the person.
+# Body: { "on": true | false }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.watch.ValidateWatch
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: person
+person:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.watch.ApplyWatch
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.watch.AuditWatch
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
