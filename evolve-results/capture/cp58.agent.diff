+# POST /api/sheets/{sheetId}/people/{personId}/watch — the signed-in user starts (on: true) or stops (on: false)
+# watching the person. A body without on or by, starting to watch a person already watched, or stopping watching one
+# not watched, is a 400 and a person not on the sheet a 404, none writing anything. Responds with the watch.
+validate:
+  class: net.officefloor.hq.app.watch.ValidateWatch
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.watch.ApplyWatch
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.watch.RecordWatchChanged
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.watch.RespondWithWatch
