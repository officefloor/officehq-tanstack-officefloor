+package net.officefloor.hq.app.person;
+
+import net.officefloor.plugin.variable.Val;
+
+/** Refuse renaming a person to a name another person on the sheet already has. */
+public class ValidatePersonName {
+    public void validate(@Val PersonRequest request, @Val Person loaded, PersonRepository repository)
+            throws DuplicatePersonNameException {
+        if (repository.nameInUse(loaded.sheetId(), request.name(), loaded.id())) {
+            throw new DuplicatePersonNameException(request.name());
+        }
+    }
+}
diff --git a/src/main/resources/db/migration/V4__person_name_unique.sql b/src/main/resources/db/migration/V4__person_name_unique.sql
new file mode 100644
index 0000000..3622f1d
--- /dev/null
+++ b/src/main/resources/db/migration/V4__person_name_unique.sql
@@ -0,0 +1,5 @@
+-- A person's name is unique on the sheet, compared without regard to case and ignoring surrounding
+-- spaces. Names are stored trimmed; name_key is the comparison form the unique index holds.
+UPDATE person SET name = TRIM(name);
+ALTER TABLE person ADD COLUMN name_key VARCHAR(200) GENERATED ALWAYS AS (LOWER(TRIM(name)));
+CREATE UNIQUE INDEX person_sheet_name ON person(sheet_id, name_key);
