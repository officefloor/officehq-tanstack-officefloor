diff --git a/src/main/resources/db/migration/V3__person_name_unique.sql b/src/main/resources/db/migration/V3__person_name_unique.sql
new file mode 100644
index 0000000..06d5e51
--- /dev/null
+++ b/src/main/resources/db/migration/V3__person_name_unique.sql
@@ -0,0 +1,5 @@
+-- A person's name is unique on the sheet, compared without regard to case. Names are stored
+-- without surrounding spaces; name_key is the name as compared.
+UPDATE person SET name = TRIM(name);
+ALTER TABLE person ADD COLUMN name_key VARCHAR(200) GENERATED ALWAYS AS (LOWER(name));
+CREATE UNIQUE INDEX person_sheet_name ON person (sheet_id, name_key);
