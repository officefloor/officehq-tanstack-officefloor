+# Clone the sheet to another id (a steward). Validate first so a blank id is a 400, not a 404. Anyone
+# else, or an id already used, is refused and writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateClone
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: clone
+clone:
+  class: net.officefloor.hq.app.sheet.CloneSheet
+  govern: [ transaction ]
+  next: audit
+# Last before the response: the clone is saved. This sheet's line, then the clone's first lines.
+audit:
+  class: net.officefloor.hq.app.sheet.AuditSheetCloned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithClone
+  govern: [ transaction ]
