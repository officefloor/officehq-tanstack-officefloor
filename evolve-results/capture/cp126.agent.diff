+# A steward clones the sheet to another, never used, id ({"to": <sheet id>}): refused (400, nothing written) for
+# anyone else or a sheet already used. Responds with the id cloned to.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateClone
+  next: clone
+clone:
+  class: net.officefloor.hq.app.sheet.CloneSheet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithClone
+  govern: [ transaction ]
