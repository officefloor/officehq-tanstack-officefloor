+# PUT /api/sheets/{sheetId}/clone — a steward clones the sheet to another id, one never used.
+# Body: { "toSheet": "<sheet id>" }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateClone
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.sheet.ApplyClone
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.sheet.AuditSheetCloned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithCloned
+  govern: [ transaction ]
