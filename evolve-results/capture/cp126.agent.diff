+package net.officefloor.hq.app.sheet;
+
+import net.officefloor.hq.app.rollup.Actor;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateClone {
+    public void validate(@RequestBody CloneRequest request, Out<CloneRequest> body, Out<Actor> actor)
+            throws InvalidSheetRequestException {
+        if (request == null || request.to() == null || request.to().isBlank()) {
+            throw new InvalidSheetRequestException("Enter the id of the sheet to clone to");
+        }
+        body.set(request);
+        actor.set(new Actor(request.user()));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/clone.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/clone.POST.yml
new file mode 100644
index 00000000..808c086a
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/clone.POST.yml
@@ -0,0 +1,19 @@
+# A steward clones the sheet to another id, which must never have been used: the clone gets this
+# sheet's today, settings, roles, rates, holidays, void reasons, templates, people, pools, periods
+# (all open) and claims (numbered afresh there); statements are not copied. Refused (400) for anyone
+# else, or another sheet already used.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateClone
+  next: clone
+clone:
+  class: net.officefloor.hq.app.sheet.CloneSheet
+  govern: [ transaction ]
+  next: record
+# Audit only once the clone is saved: this sheet's line, then the clone's line and its rollup lines.
+record:
+  class: net.officefloor.hq.app.sheet.RecordSheetCloned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithClone
+  govern: [ transaction ]
