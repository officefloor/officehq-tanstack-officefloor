+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/clone.POST.yml
@@ -0,0 +1,24 @@
+# Clone the sheet to another id (SHEET_CLONE_MADE here; SHEET_CLONED, then its rollup, on the clone). Anyone but a
+# steward, or a sheet already used, is refused (400). See SheetCloner for what the clone gets.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetCloneRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: check
+check:
