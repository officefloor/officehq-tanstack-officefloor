@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/clone — clone the sheet to another id (see CloneRepository for what is copied). Only a
+# steward may clone, and only to an id never used (never loaded, nothing kept for it); otherwise a 400 that writes
+# nothing. Responds with the clone made.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateClone
+  next: clone
+clone:
