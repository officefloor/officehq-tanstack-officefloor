@@ -0,0 +1,20 @@
+package net.officefloor.hq.app.sheet;
+
+import net.officefloor.hq.app.BadRequestException;
+import net.officefloor.hq.app.session.ChangedBy;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Which sheet to clone the sheet to. Publishes it, with the user making the change. */
+public class ValidateClone {
+    public void validate(@RequestBody CloneRequest request, Out<CloneInput> clone, Out<ChangedBy> changedBy)
+            throws BadRequestException {
+        ChangedBy by = ChangedBy.of(request == null ? null : request.by());
+        String to = request == null || request.to() == null ? "" : request.to().trim();
+        if (to.isEmpty() || to.length() > 200) {
+            throw new BadRequestException("Enter the sheet id to clone to");
+        }
+        clone.set(new CloneInput(to));
+        changedBy.set(by);
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/clone.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/clone.POST.yml
new file mode 100644
index 00000000..3fcd4c66
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/clone.POST.yml
@@ -0,0 +1,23 @@
+# A steward clones the sheet to another sheet id, which must never have been used. Anyone else, or a sheet already
+# used, is refused and nothing is written.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: clone
+clone:
+  class: net.officefloor.hq.app.sheet.ValidateClone
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.sheet.CloneSheet
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.sheet.RecordSheetCloned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithClone
+  govern: [ transaction ]
