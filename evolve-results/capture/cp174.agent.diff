+# A steward waives an OPEN or PENDING claim's late charge (once): from then on it bears none. Responds with the sheet's claims.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: waive
+waive:
+  class: net.officefloor.hq.app.claim.WaiveClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaims
+  govern: [ transaction ]
