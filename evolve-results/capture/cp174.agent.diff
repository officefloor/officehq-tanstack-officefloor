@@ -0,0 +1,35 @@
+# A steward waives an OPEN or PENDING claim's late charge: from then on it bears none. Anyone but a
+# steward, a claim in any other status, or one already waived is a 409 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimWaive
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimWaive
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimWaived
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused waiver writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimWaived
