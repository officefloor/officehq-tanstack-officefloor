+# Waive an OPEN or PENDING claim's late charge (a steward only): it bears no late charge from then on, overdue or not. A refused waiver (not a steward, another status, already waived, unknown claim) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateWaive
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveWaive
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimWaived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
