+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.plugin.variable.Val;
+
+/** Record the stored waiver in the audit file, naming the claim like every claim line. */
+public class AuditClaimWaived {
+    public void audit(@Val WaiveInput input, @Val Claim loaded, @Val ClaimResponse saved, PersonRepository people,
+            Audit audit) {
+        var person = people.find(loaded.sheetId(), loaded.personId());
+        audit.record("CLAIM_WAIVED sheet=" + loaded.sheetId() + " by=" + input.user()
+                + " person=" + person.name() + " amount=" + saved.amount() + " date=" + saved.date()
+                + (saved.number() != null ? " number=" + saved.number() : ""));
+    }
+}
