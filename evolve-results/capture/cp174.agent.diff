diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/waive.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/waive.POST.yml
new file mode 100644
index 000000000..998515624
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/waive.POST.yml
@@ -0,0 +1,27 @@
+# Waive an OPEN or PENDING claim's late charge, once. Anyone but a steward is a 403; a claim in any
+# other status, or one already waived, is a 409. A refusal writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+# Checks the rules and writes the waiver only when none refuses it.
+apply:
+  class: net.officefloor.hq.app.claim.WaiveClaim
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the waiver is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimWaived
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
