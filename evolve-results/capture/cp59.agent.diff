--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-periods.POST.yml
@@ -0,0 +1,25 @@
+# POST /api/sheets/{sheetId}/generate-periods — add one period per calendar month from the from-date's month to the
+# to-date's month, each from the first to the last day of its month, named yyyy-mm. A month whose name the sheet
+# already has, or whose days overlap a period, is left out. Body: { "from": "YYYY-MM-DD", "to": "YYYY-MM-DD" }
+# (a blank date is the sheet's today). A to-date before the from-date is refused. Responds { "generated": n }.
+guard:
+  class: net.officefloor.hq.app.role.GuardViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.period.ValidateGeneratePeriods
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadOrCreateSheet
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodsGenerated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
