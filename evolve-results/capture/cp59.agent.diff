+# POST /api/sheets/{sheetId}/periods/generate — generate one period per calendar month from the from-date's month to
+# the to-date's month, each from the first to the last day of its month and named yyyy-mm, each written as
+# PERIOD_ADDED. A month whose name is already a period of the sheet, or whose days overlap one, is left out. A blank
+# date takes the sheet's today. A date that is not yyyy-MM-dd, or a to-date before the from-date, is a 400 and writes
+# nothing. Responds with how many were made.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGeneratePeriods
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
