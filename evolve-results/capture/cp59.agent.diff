--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-periods.POST.yml
@@ -0,0 +1,13 @@
+# Generate a period per calendar month between two dates. Validate first so a to-date before the
+# from-date is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGeneratePeriods
+  next: generate
+# Each month left out when its name is taken or its days overlap a period; audits each one made.
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
