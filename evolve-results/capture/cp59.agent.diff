+# Generate one period per calendar month from the from-date's month to the to-date's month, each named yyyy-mm and
+# running from the first to the last day of its month. A month whose name is already a period, or whose days overlap
+# a period on the sheet, is left out. A refused generate (bad dates, to before from, unknown sheet) writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriodGenerate
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SaveGeneratedPeriods
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodsGenerated
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriodsGenerated
+  govern: [ transaction ]
