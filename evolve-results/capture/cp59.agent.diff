+# Generate periods: one per calendar month from the from-date's month to the to-date's month (a blank date is the
+# sheet's today), each from the month's first to its last day, named yyyy-mm. A month whose name is already a period
+# on the sheet, or whose days overlap one, is left out and the others are still made, each audited as PERIOD_ADDED.
+# A bad date or a to-date before the from-date is refused (400). Answers how many were made.
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.period.BuildGeneratedPeriods
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SaveGeneratedPeriods
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditGeneratedPeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
