@@ -0,0 +1,26 @@
+package net.officefloor.hq.app.period;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateGeneratePeriods {
+    public void validate(@RequestBody GeneratePeriodsRequest request, Out<GeneratePeriodsInput> body)
+            throws InvalidPeriodException {
+        LocalDate from = date(request == null ? null : request.from(), "from");
+        LocalDate to = date(request == null ? null : request.to(), "to");
+        if (to == null) throw new InvalidPeriodException("A to-date is required");
+        body.set(new GeneratePeriodsInput(from, to));
+    }
+
+    private static LocalDate date(String raw, String which) throws InvalidPeriodException {
+        String value = raw == null ? "" : raw.trim();
+        if (value.isEmpty()) return null;
+        try {
+            return LocalDate.parse(value);
+        } catch (DateTimeParseException e) {
+            throw new InvalidPeriodException("A " + which + "-date is a date, yyyy-MM-dd");
+        }
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate.POST.yml
new file mode 100644
index 000000000..7d5ca15c1
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate.POST.yml
@@ -0,0 +1,21 @@
+# Generate monthly periods between two dates. Validate first so a bad date is a 400, not a 404.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.period.ValidateGeneratePeriods
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: generate
+# Against the sheet: a blank from-date is its today; a to-date before it is refused; each month
+# whose name is used or whose days overlap a period is left out, the others made and audited.
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
