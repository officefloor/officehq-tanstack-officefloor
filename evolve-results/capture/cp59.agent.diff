--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/generate.POST.yml
@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/periods/generate — make one period per calendar month (body: {from, to,
+# user}; dates yyyy-MM-dd, a blank one the sheet's today), from the from-date's month to the
+# to-date's month, each running from the first to the last day of its month and named yyyy-mm. A
+# month whose name is already a period on the sheet (ignoring case), or whose days overlap a period
+# on the sheet, is left out and the others are still made; each made is recorded as PERIOD_ADDED.
+# Answers {generated}. A bad date or a to before the from is refused (400) and nothing is stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGenerate
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
+  govern: [ transaction ]
