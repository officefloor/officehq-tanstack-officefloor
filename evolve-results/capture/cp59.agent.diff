+# Validate first so a bad date or a to-date before the from-date is a 400; Generate adds each month not already
+# a period nor overlapping one. Responds with how many were made and the sheet's periods.
+validate:
+  class: net.officefloor.hq.app.period.ValidateGeneratePeriods
+  next: generate
+generate:
+  class: net.officefloor.hq.app.period.GeneratePeriods
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGeneratedPeriods
+  govern: [ transaction ]
