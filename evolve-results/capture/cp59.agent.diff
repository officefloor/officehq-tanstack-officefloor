+# POST /api/sheets/{sheetId}/periods/generate — make a period per calendar month. Body
+# {"from":"2026-02-15","to":"2026-04-10"}: one period per month from the from-date's month to the
+# to-date's month, each from its first to its last day, named yyyy-mm. A month whose name is taken or
+# whose days overlap a period on the sheet is left out. A bad date or a to-date before the from-date
+# is refused with 400 and nothing is stored. Responds {"made":n}.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.period.ValidateGeneratePeriods
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.period.AddGeneratedPeriods
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodsGenerated
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.period.RespondWithGenerated
+  govern: [ transaction ]
