@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** A move names the person it moves the claim to; it is kept trimmed. */
+public class ValidateReassign {
+    public void validate(@RequestBody ReassignRequest request, Out<ReassignRequest> body) throws InvalidClaimException {
+        String personId = request == null || request.personId() == null ? "" : request.personId().trim();
+        if (personId.isEmpty()) throw new InvalidClaimException("A move needs the person it moves the claim to");
+        body.set(new ReassignRequest(personId));
+    }
+}
diff --git a/src/main/resources/db/migration/V27__claim_listed.sql b/src/main/resources/db/migration/V27__claim_listed.sql
new file mode 100644
index 000000000..1081755de
--- /dev/null
+++ b/src/main/resources/db/migration/V27__claim_listed.sql
@@ -0,0 +1,7 @@
+-- Where a claim is listed: claims are listed newest first by this, not by id, so a claim moved to
+-- another person is listed as that person's newest. A claim takes the sheet's next place when it is
+-- made and again when it is moved; the sheet keeps the last place given.
+ALTER TABLE sheet ADD COLUMN last_claim_listed BIGINT NOT NULL DEFAULT 0;
+ALTER TABLE claim ADD COLUMN listed BIGINT NOT NULL DEFAULT 0;
+UPDATE claim SET listed = id;
+UPDATE sheet SET last_claim_listed = COALESCE((SELECT MAX(c.id) FROM claim c WHERE c.sheet_id = sheet.id), 0);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml
new file mode 100644
index 000000000..3c838b36b
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml
@@ -0,0 +1,45 @@
+# Move a DRAFT, OPEN or PENDING claim to another person on the sheet (a steward). A settled or
+# voided claim, a clerk, or a person not on the sheet is refused and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateReassign
+  govern: [ transaction ]
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+# A claim dated inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ReassignClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReassigned
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
