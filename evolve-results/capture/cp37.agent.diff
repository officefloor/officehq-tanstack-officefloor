@@ -0,0 +1,14 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the move from the body, refusing one that names no person. */
+public class ValidateReassignment {
+    public void validate(@RequestBody ReassignRequest request, Out<Reassignment> reassignmentOut) throws InvalidClaimException {
+        if (request == null || request.personId() == null) {
+            throw new InvalidClaimException("A claim must be moved to a person.");
+        }
+        reassignmentOut.set(new Reassignment(request.personId()));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml
new file mode 100644
index 0000000..647cd82
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml
@@ -0,0 +1,30 @@
+# A steward moves a DRAFT, OPEN or PENDING claim to another person on the sheet; it keeps its number and date.
+# A body naming no person, or not another person on the sheet, is refused (400), a SETTLED or VOID claim (409)
+# and a user who is not a steward (403); none writes anything.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateReassignment
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: check
+# A claim dated inside a closed period is refused (409) and writes nothing.
+check:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ReassignClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReassigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
