+# Move a claim to another person on the sheet (the body's personId). Only a steward moves a claim, and only a DRAFT,
+# OPEN or PENDING one; a SETTLED or VOID claim, the claim's own person, an unknown person or one retired before the
+# claim's date is refused (400) and writes nothing. A claim dated inside a closed period is refused (400).
+# The claim keeps its number and date, loses any figure a statement bound it to (live again), and is listed as its
+# new person's newest claim.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateReassignRequest
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkPeriod
+checkPeriod:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriodOpen
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.claim.CheckClaimReassign
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: reassign
+reassign:
+  class: net.officefloor.hq.app.claim.ReassignClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReassigned
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
