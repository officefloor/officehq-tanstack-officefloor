+# PUT /api/sheets/{sheetId}/claims/{claimId}/person — move a DRAFT, OPEN or PENDING claim to another person on the
+# sheet, by a steward. The claim keeps its number and date, loses any figure a statement bound it to, and is listed as
+# its new person's newest claim. A clerk, a SETTLED or VOID claim, a correction, a claim dated inside a closed period,
+# a move to its own person, to no person on the sheet or to one retired before its date, is a 409 and a claim not on
+# the sheet a 404, neither writing anything. Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateReassign
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyReassign
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveReassign
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimReassigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
