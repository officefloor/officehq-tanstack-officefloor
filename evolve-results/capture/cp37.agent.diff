+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateReassign {
+    public void validate(@RequestBody ReassignRequest request, Out<ReassignRequest> body) throws InvalidClaimException {
+        if (request.toPersonId() == null || request.toPersonId().isBlank()) {
+            throw new InvalidClaimException("No person chosen to move the claim to");
+        }
+        body.set(request);
+    }
+}
diff --git a/src/main/resources/db/migration/V25__claim_listed.sql b/src/main/resources/db/migration/V25__claim_listed.sql
new file mode 100644
index 00000000..8cda470b
--- /dev/null
+++ b/src/main/resources/db/migration/V25__claim_listed.sql
@@ -0,0 +1,5 @@
+-- Claims are listed newest first by listed_seq, not by id: a claim moved to another person is
+-- listed as that person's newest claim, whatever its date. A new claim, and a moved one, takes the
+-- next listed_seq after every claim's; claims already stored keep their order (their id).
+ALTER TABLE claim ADD COLUMN listed_seq BIGINT;
+UPDATE claim SET listed_seq = id;
