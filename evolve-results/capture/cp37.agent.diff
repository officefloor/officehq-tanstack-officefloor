@@ -0,0 +1,37 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/reassign — move a claim to another person on the sheet
+# (body {to, user}, `to` the person's id). Only a steward moves a claim, and only a DRAFT, OPEN or
+# PENDING one that is not a correction; it keeps its number and date, loses any figure a statement
+# bound it to, and is listed as its new person's newest claim. Refused (400) when the user is not a
+# steward, the claim is SETTLED or VOID, the claim or the person is not on the sheet, the person is
+# the claim's own, the claim's date falls in a closed period or after the date the person is
+# retired from; nothing is stored then. A stored move is recorded in the audit file as CLAIM_REASSIGNED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateReassign
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: checkReassign
+checkReassign:
+  class: net.officefloor.hq.app.claim.CheckReassign
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyReassign
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReassigned
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
