+++ b/src/main/java/net/officefloor/hq/app/claim/ValidateClaimReassign.java
@@ -0,0 +1,17 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.rollup.Actor;
+import net.officefloor.hq.app.sheet.InvalidSheetRequestException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateClaimReassign {
+    public void validate(@RequestBody ClaimReassignRequest request, Out<ClaimReassignment> body, Out<Actor> actor)
+            throws InvalidSheetRequestException {
+        if (request == null || request.toPersonId() == null) {
+            throw new InvalidSheetRequestException("A reassignment needs the person to move the claim to");
+        }
+        actor.set(new Actor(request.user()));
+        body.set(new ClaimReassignment(request.toPersonId(), request.user()));
+    }
+}
diff --git a/src/main/resources/db/migration/V26__claim_listed.sql b/src/main/resources/db/migration/V26__claim_listed.sql
new file mode 100644
index 00000000..17b7c0c6
--- /dev/null
+++ b/src/main/resources/db/migration/V26__claim_listed.sql
@@ -0,0 +1,8 @@
+-- Claims are listed newest first by `listed`: a new claim takes the next value of claim_listed, and
+-- a claim reassigned to another person takes the next one again, so it is listed as that person's
+-- newest claim whatever its date. Claims already kept are listed by id, as before.
+CREATE SEQUENCE claim_listed START WITH 1000000000;
+ALTER TABLE claim ADD COLUMN listed BIGINT DEFAULT NEXT VALUE FOR claim_listed;
+UPDATE claim SET listed = id;
+ALTER TABLE claim ALTER COLUMN listed SET NOT NULL;
+CREATE INDEX claim_sheet_listed ON claim (sheet_id, listed);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml
new file mode 100644
index 00000000..b5580ad7
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/reassign.POST.yml
@@ -0,0 +1,35 @@
+# Move a claim to another person on the sheet. Validate before Load so a body naming no person is a
+# 400, not a 404; a claim that cannot move (not a steward, SETTLED or VOID) is a 409 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimReassign
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimReassign
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveReassignedClaim
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimReassigned
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
