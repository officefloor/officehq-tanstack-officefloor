+package net.officefloor.hq.app.rollup;
+
+import net.officefloor.hq.app.claim.ReassignInput;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** Record, after the change's own lines, how the sheet's figures moved over it. */
+public class AuditReassignRollup {
+    public void audit(@PathVariable("sheetId") String sheetId, @Val ReassignInput request, @Val Rollup before,
+            Rollups rollups) {
+        rollups.record(sheetId.trim(), request.user(), before);
+    }
+}
