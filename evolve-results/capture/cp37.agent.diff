+# Move a claim to another person on the sheet (a steward's): only a DRAFT, OPEN or PENDING claim moves. It keeps its
+# number and date, is unbound from any statement figure and is listed as its new person's newest claim.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: reassign
+reassign:
+  class: net.officefloor.hq.app.claim.ValidateReassign
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  govern: [ transaction ]
+  next: rollup-before
+rollup-before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyReassign
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimReassigned
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
