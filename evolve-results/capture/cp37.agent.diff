@@ -0,0 +1,15 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the reassign body once, refusing one that names no person. */
+public class ValidateReassign {
+    public void validate(@RequestBody ReassignRequest request, Out<ReassignRequest> body)
+            throws InvalidClaimStatusChangeException {
+        if (request == null || request.to() == null) {
+            throw new InvalidClaimStatusChangeException("A reassign names the person the claim moves to");
+        }
+        body.set(request);
+    }
+}
diff --git a/src/main/resources/db/migration/V23__claim_listed.sql b/src/main/resources/db/migration/V23__claim_listed.sql
new file mode 100644
index 00000000..c9db0b71
--- /dev/null
+++ b/src/main/resources/db/migration/V23__claim_listed.sql
@@ -0,0 +1,4 @@
+-- Where a claim is listed among the claims of its sheet: newest first by this. A claim takes the sheet's next one
+-- when it is added, and again when it is reassigned, so a moved claim lists as its new person's newest whatever its date.
+ALTER TABLE claim ADD COLUMN listed BIGINT;
+UPDATE claim SET listed = id;
