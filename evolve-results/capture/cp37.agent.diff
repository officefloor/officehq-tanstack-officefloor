+# PUT /api/sheets/{sheetId}/claims/{claimId}/person — a steward moves a DRAFT, OPEN or PENDING claim to another person
+# on the sheet (body: {"personId": n}). It keeps its number and date, loses any figure a statement bound it to, and
+# lists as its new person's newest claim. 422 for anything refused (not a steward, a settled or voided claim, a
+# correction, no such other person, a date after their retirement, or a claim dated inside a closed period);
+# 404 for a claim not on the sheet.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: closed
+  govern: [ transaction ]
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplyReassign
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReassigned
+  next: rollup
+  govern: [ transaction ]
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithEditedClaim
+  govern: [ transaction ]
