+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the reassign's body once for later steps; refuses (400) one that names no person. */
+public class ValidateReassignRequest {
+    public void validate(@RequestBody ReassignRequest request, Out<ReassignRequest> body) throws InvalidClaimException {
+        if (request == null || request.personId() == null) {
+            throw new InvalidClaimException("Choose the person to move the claim to.");
+        }
+        body.set(request);
+    }
+}
diff --git a/src/main/resources/db/migration/V27__claim_listed.sql b/src/main/resources/db/migration/V27__claim_listed.sql
new file mode 100644
index 000000000..472ce5333
--- /dev/null
+++ b/src/main/resources/db/migration/V27__claim_listed.sql
@@ -0,0 +1,5 @@
+-- Where a claim is listed among its person's: newest (highest) first. A new claim takes the next value; a claim
+-- moved to another person takes the next value again, so it is listed as its new person's newest claim.
+CREATE SEQUENCE claim_listed_seq START WITH 1;
+ALTER TABLE claim ADD COLUMN listed BIGINT DEFAULT NEXT VALUE FOR claim_listed_seq NOT NULL;
+CREATE INDEX claim_sheet_listed ON claim (sheet_id, listed);
