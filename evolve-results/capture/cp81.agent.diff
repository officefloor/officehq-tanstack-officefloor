@@ -0,0 +1,27 @@
+# Remind an OPEN or PENDING claim on the sheet's today. A claim in any other status, or one already
+# reminded on the sheet's today, is a 409 and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+# Checks the rules and writes the reminded date only when none refuses it.
+apply:
+  class: net.officefloor.hq.app.claim.RemindClaim
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the reminder is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
