+# POST /api/sheets/{sheetId}/claims/{claimId}/remind — remind an OPEN or PENDING claim on the sheet's
+# today; refused (409) for any other status, or when it was already reminded on that day.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: remind
+remind:
+  class: net.officefloor.hq.app.claim.RemindClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveReminder
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
