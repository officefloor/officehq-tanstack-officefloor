+-- Every reminder written for a claim: the sheet's today when it was written. A claim is reminded at most once per
+-- sheet-today; its reminded date is the last of these (as of a date: the last on or before it).
+CREATE TABLE claim_reminder (
+    id          BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id    VARCHAR(200) NOT NULL,
+    claim_id    BIGINT       NOT NULL REFERENCES claim (id),
+    reminded_on DATE         NOT NULL,
+    CONSTRAINT claim_reminder_unique UNIQUE (sheet_id, claim_id, reminded_on)
+);
diff --git a/src/main/resources/db/migration/V41__claim_edit.sql b/src/main/resources/db/migration/V41__claim_edit.sql
new file mode 100644
index 000000000..b13086643
--- /dev/null
+++ b/src/main/resources/db/migration/V41__claim_edit.sql
@@ -0,0 +1,13 @@
+-- The values a claim had before each edit, and the sheet's today when the edit was made, in the order made: a sheet
+-- shown as of a date shows each claim with the values it had before its first edit after that date.
+CREATE TABLE claim_edit (
+    id         BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id   VARCHAR(200)   NOT NULL,
+    claim_id   BIGINT         NOT NULL REFERENCES claim (id),
+    amount     DECIMAL(19, 2) NOT NULL,
+    claim_date DATE           NOT NULL,
+    note       VARCHAR(2000)  NOT NULL,
+    corrects   VARCHAR(250),
+    made_on    DATE           NOT NULL
+);
+CREATE INDEX claim_edit_sheet ON claim_edit (sheet_id, claim_id, id);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.POST.yml
