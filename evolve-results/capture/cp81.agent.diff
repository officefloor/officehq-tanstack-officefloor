+-- per sheet-today, and only while OPEN or PENDING.
+ALTER TABLE claim ADD COLUMN reminded_on DATE;
+ALTER TABLE claim_history ADD COLUMN reminded_on DATE;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.PUT.yml
new file mode 100644
index 0000000..05278ce
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.PUT.yml
@@ -0,0 +1,19 @@
+# Remind an OPEN or PENDING claim: it shows the sheet's today as its reminded date. A claim is reminded at most once per sheet-today. A refused reminder (another status, already reminded today, unknown claim) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRemind
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveRemind
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
