+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRemind
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReminded
+  next: respond
+  govern: [ transaction ]
+respond:
