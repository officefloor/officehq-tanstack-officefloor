+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateRemind {
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody RemindRequest request, Out<RemindInput> body, RoleStore roles) throws InvalidSheetException {
+        roles.refuseChange(sheetId.trim(), request == null ? null : request.user());
+        body.set(new RemindInput(request == null ? null : request.user()));
+    }
+}
diff --git a/src/main/resources/db/migration/V41__claim_reminded.sql b/src/main/resources/db/migration/V41__claim_reminded.sql
new file mode 100644
index 000000000..873f8a712
--- /dev/null
+++ b/src/main/resources/db/migration/V41__claim_reminded.sql
@@ -0,0 +1,8 @@
+-- The last sheet's today a reminder was written for an OPEN or PENDING claim; null when never reminded.
+-- Kept in claim_hist too (see V39__history.sql). H2 re-initialises the history trigger under the
+-- table's temporary copy name while it adds a column, so the trigger is set again afterwards.
+DROP TRIGGER claim_history;
+ALTER TABLE claim ADD COLUMN reminded_on DATE;
+ALTER TABLE claim_hist ADD COLUMN reminded_on DATE;
+CREATE TRIGGER claim_history AFTER INSERT, UPDATE, DELETE ON claim FOR EACH ROW
+    CALL 'net.officefloor.hq.app.history.HistoryTrigger';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.POST.yml
new file mode 100644
index 000000000..066511463
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.POST.yml
@@ -0,0 +1,26 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/remind — remind an OPEN or PENDING claim (body {user}): its
+# reminded date becomes the sheet's today. Refused (400) for a viewer, a claim not on the sheet, one in any
+# other status, or one already reminded on the sheet's today; nothing is stored then. A stored reminder is
+# recorded in the audit file as REMIND.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRemind
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkRemind
+checkRemind:
+  class: net.officefloor.hq.app.claim.CheckRemind
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRemind
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
