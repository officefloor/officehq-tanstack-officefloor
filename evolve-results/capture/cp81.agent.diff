+# Remind an OPEN or PENDING claim: records the sheet's today as the day it was last reminded and writes REMIND.
+# A claim in any other status, or one already reminded on the sheet's today, is refused (400) and writes nothing.
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.claim.CheckClaimRemind
+  govern: [ transaction ]
+  next: remind
+remind:
+  class: net.officefloor.hq.app.claim.RemindClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
