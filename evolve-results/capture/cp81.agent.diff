+# Remind an OPEN or PENDING claim, once per sheet-today. Refused for any other status, or a second reminder the same day.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: remind
+remind:
+  class: net.officefloor.hq.app.claim.ValidateRemind
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyRemind
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
