+# Remind an OPEN or PENDING claim, at most once per sheet-today. Responds with the sheet's claims.
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: remind
+remind:
+  class: net.officefloor.hq.app.claim.RemindClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaims
+  govern: [ transaction ]
