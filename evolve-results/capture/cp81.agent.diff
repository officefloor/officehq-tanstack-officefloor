+# POST /api/sheets/{sheetId}/claims/{claimId}/remind — remind an OPEN or PENDING claim: the sheet's today becomes its
+# reminded date and REMIND is audited. A claim in any other status, or one already reminded on the sheet's today, is a
+# 409 and a claim not on the sheet a 404, neither writing anything (a viewer is refused before, see ViewerGuard).
+# Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateRemind
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveReminder
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
