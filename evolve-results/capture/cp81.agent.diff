new file mode 100644
index 00000000..74c8430f
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/remind.POST.yml
@@ -0,0 +1,26 @@
+# Remind an OPEN or PENDING claim: it shows the sheet's today as its reminded date. Once per
+# sheet-today: a second reminder the same day, or a claim in any other status, is a 409 and writes
+# nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimRemind
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimRemind
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimReminded
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused reminder writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimReminded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
