+# Pause a running plan from the sheet's today (pausing a paused plan is refused). Answers the sheet's plans.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: pause
+pause:
+  class: net.officefloor.hq.app.plan.PausePlan
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.plan.LoadPlans
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlans
