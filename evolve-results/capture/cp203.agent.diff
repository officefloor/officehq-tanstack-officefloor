@@ -0,0 +1,63 @@
+package net.officefloor.hq.app.plan;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.time.LocalDate;
+
+/** A pause of a plan: the day it was paused and the day it was resumed (null while still paused). The plan's dates on
+ *  or after the first and before the second are skipped. */
+@Entity
+@Table(name = "plan_pause")
+public class PlanPause {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "plan_id", nullable = false)
+    private Long planId;
+
+    @Column(name = "paused_on", nullable = false)
+    private LocalDate pausedOn;
+
+    @Column(name = "resumed_on")
+    private LocalDate resumedOn;
+
+    protected PlanPause() {
+    }
+
+    public PlanPause(Long planId, LocalDate pausedOn, LocalDate resumedOn) {
+        this.planId = planId;
+        this.pausedOn = pausedOn;
+        this.resumedOn = resumedOn;
+    }
+
+    /** Whether the plan date falls in this pause, and so is skipped. */
+    public boolean skips(LocalDate date) {
+        return !date.isBefore(pausedOn) && (resumedOn == null || date.isBefore(resumedOn));
+    }
+
+    public boolean isOpen() {
+        return resumedOn == null;
+    }
+
+    public void resume(LocalDate on) {
+        this.resumedOn = on;
+    }
+
+    public Long getPlanId() {
+        return planId;
+    }
+
+    public LocalDate getPausedOn() {
+        return pausedOn;
+    }
+
+    public LocalDate getResumedOn() {
+        return resumedOn;
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/plan/PlanPauseRepository.java b/src/main/java/net/officefloor/hq/app/plan/PlanPauseRepository.java
