+# POST /api/sheets/{sheetId}/plans/{planId}/pause — pause (body: {on: true, user}) or resume ({on: false, user})
+# a plan on the sheet's today. A plan date on or after the day it was paused and before the day it was resumed
+# is skipped, not postponed: generate makes nothing for it and the next dates leave it out. Refused (400),
+# storing nothing, by a viewer, on an archived sheet, for a plan not on the sheet, or when pausing a paused
+# plan or resuming a running one. Recorded as PLAN_PAUSED or PLAN_RESUMED. Answers the plan.
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlanPause
+  next: load
+load:
+  class: net.officefloor.hq.app.plan.LoadPlan
+  govern: [ transaction ]
+  next: pause
+pause:
+  class: net.officefloor.hq.app.plan.PausePlan
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
+  govern: [ transaction ]
