diff --git a/src/main/java/net/officefloor/hq/app/plan/ResumePlan.java b/src/main/java/net/officefloor/hq/app/plan/ResumePlan.java
new file mode 100644
index 00000000..e84d547a
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/plan/ResumePlan.java
@@ -0,0 +1,15 @@
+package net.officefloor.hq.app.plan;
+
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.plugin.variable.Val;
+
+/** Resumes the plan on the sheet's today: its dates from the day it was paused up to the day before are skipped, not
+ *  postponed. Refuses a plan that is not paused. */
+public class ResumePlan {
+    public void resume(@Val Sheet sheet, @Val Plan plan, PlanPauseRepository pauses) throws InvalidPlanException {
+        PlanPause open = pauses.findByPlanIdOrderByIdAsc(plan.getId()).stream().filter(PlanPause::isOpen).findFirst()
+                .orElseThrow(() -> new InvalidPlanException("The plan is not paused."));
+        open.resume(sheet.getToday());
+        pauses.saveAndFlush(open);
+    }
+}
diff --git a/src/main/resources/db/migration/V94__plan_pause.sql b/src/main/resources/db/migration/V94__plan_pause.sql
new file mode 100644
index 00000000..ad653791
--- /dev/null
+++ b/src/main/resources/db/migration/V94__plan_pause.sql
@@ -0,0 +1,9 @@
+-- A plan's pauses: paused on a day (the sheet's today) and resumed on a later one (null while it is still paused).
+-- A plan date on or after the day it was paused and before the day it was resumed is skipped, not postponed.
+CREATE TABLE plan_pause (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    plan_id BIGINT NOT NULL REFERENCES plan (id),
+    paused_on DATE NOT NULL,
+    resumed_on DATE
+);
+CREATE INDEX plan_pause_plan ON plan_pause (plan_id, id);
