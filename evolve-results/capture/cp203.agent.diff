+# POST /api/sheets/{sheetId}/plans/{planId}/pause — pause the plan from the sheet's today; pausing a paused plan is refused.
+# A plan date on or after the day paused and before the day resumed is skipped, not postponed.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.plan.LoadPlan
+  govern: [ transaction ]
+  next: pause
+pause:
+  class: net.officefloor.hq.app.plan.PausePlan
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
