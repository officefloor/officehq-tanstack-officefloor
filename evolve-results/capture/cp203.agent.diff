+# Pauses the plan from the sheet's today: refused (400, nothing written) when it is already paused.
+# Responds with the sheet's plans.
+load:
+  class: net.officefloor.hq.app.plan.LoadPlan
+  govern: [ transaction ]
+  next: pause
+pause:
+  class: net.officefloor.hq.app.plan.PausePlan
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlans
+  govern: [ transaction ]
