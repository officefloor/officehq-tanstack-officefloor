diff --git a/src/main/frontend/features/locale/Fig.tsx b/src/main/frontend/features/locale/Fig.tsx
new file mode 100644
index 00000000..3c8f9119
--- /dev/null
+++ b/src/main/frontend/features/locale/Fig.tsx
@@ -0,0 +1,11 @@
+import { useCurrentSheet, useCurrentUser } from '../session/session';
+import { showFigure, useLocale } from './locale';
+
+/** A cell's text as the signed-in user's locale shows it (see {@link showFigure}). Wrap every figure the screen
+ *  shows in it; never an input's value, an export or anything sent to the server. */
+export function Fig({ children }: { children: string | number | null | undefined }) {
+  const [sheet] = useCurrentSheet();
+  const [user] = useCurrentUser();
+  const { data } = useLocale(sheet, user);
+  return <>{showFigure(children == null ? '' : String(children), data?.locale)}</>;
+}
diff --git a/src/main/frontend/features/locale/locale.slot.tsx b/src/main/frontend/features/locale/locale.slot.tsx
new file mode 100644
index 00000000..6e57a9a6
--- /dev/null
+++ b/src/main/frontend/features/locale/locale.slot.tsx
@@ -0,0 +1,65 @@
+import { useState } from 'react';
+import type { FormEvent } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { postJson } from '../../api/http';
+import { useSubmitOnce } from '../../query/useSubmitOnce';
+import { byUser } from '../session/session';
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { LOCALES, localeKey, localePath, useLocale } from './locale';
+import type { Locale, UserLocale } from './locale';
+
+// The signed-in user's locale: how the screen shows them figures. Each user has their own (en unless chosen); it
+// changes nothing on the sheet, so it is not audited.
+function UserLocalePanel({ sheet, user }: { sheet: string; user: string }) {
+  const queryClient = useQueryClient();
+  const { data } = useLocale(sheet, user);
+  const current = data?.locale ?? '';
+  const [draft, setDraft] = useState<Locale | ''>('');
+
+  const save = useMutation({
+    mutationFn: (locale: Locale) => postJson<UserLocale>(byUser(localePath(sheet), user), { locale }),
+    onSuccess: (updated) => {
+      queryClient.setQueryData(localeKey(sheet, user), updated);
+      setDraft('');
+    },
+  });
+  const send = useSubmitOnce(save);
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    send(draft === '' ? (current === '' ? 'en' : current) : draft);
+  };
+
+  return (
+    <form onSubmit={submit}>
+      <label>
+        Locale{' '}
+        <select
+          data-testid="user-locale"
+          value={draft === '' ? current : draft}
+          onChange={(e) => {
+            setDraft(e.target.value as Locale);
+            save.reset();
+          }}
+        >
+          {LOCALES.map((l) => (
+            <option key={l} value={l}>
+              {l}
+            </option>
+          ))}
+        </select>
+      </label>{' '}
+      <button type="submit" data-testid="user-locale-save" disabled={save.isPending}>
+        Save locale
+      </button>{' '}
+      now <span data-testid="user-locale-current">{current}</span>
+      {save.isError && (
+        <span data-testid="user-locale-error" role="alert">
+          {' '}The locale must be en or de.
+        </span>
+      )}
+    </form>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: -9.5, Component: UserLocalePanel });
diff --git a/src/main/frontend/features/locale/locale.ts b/src/main/frontend/features/locale/locale.ts
new file mode 100644
index 00000000..213b3fc6
--- /dev/null
+++ b/src/main/frontend/features/locale/locale.ts
@@ -0,0 +1,35 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJsonNow } from '../../api/http';
+import { byUser } from '../session/session';
+
+/** How the screen shows figures to a user: en as they are kept (1234.56), de with a dot every three digits and a
+ *  comma before the decimals (1.234,56). Entries are typed, and exports and audit lines written, as en whatever it is. */
+export type Locale = 'en' | 'de';
+
+export const LOCALES: Locale[] = ['en', 'de'];
+
+export type UserLocale = { locale: Locale };
+
+export const localeKey = (sheet: string, user: string) => ['locale', sheet, user] as const;
+
+export const localePath = (sheet: string) => `/api/sheets/${encodeURIComponent(sheet)}/locale`;
+
+/** The signed-in user's locale on the sheet (en unless chosen); read as it is now, whatever the as-of date. */
+export function useLocale(sheet: string, user: string) {
+  return useQuery({
+    queryKey: localeKey(sheet, user),
+    queryFn: () => getJsonNow<UserLocale>(byUser(localePath(sheet), user)),
+    enabled: sheet !== '' && user !== '',
+  });
+}
+
+const FIGURE = /^(-?)(\d+)\.(\d{2})$/;
+
+/** A text as the locale shows it: a whole text that is a number with two decimals is a figure, shown in the
+ *  locale's form; any other text is shown as it is. */
+export function showFigure(text: string, locale: Locale | undefined): string {
+  if (locale !== 'de') return text;
+  const m = FIGURE.exec(text);
+  if (m === null) return text;
+  return `${m[1]}${m[2].replace(/\B(?=(\d{3})+(?!\d))/g, '.')},${m[3]}`;
+}
