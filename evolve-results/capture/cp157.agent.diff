new file mode 100644
index 000000000..cce4aafb4
--- /dev/null
+++ b/src/main/frontend/features/locale/UserLocale.tsx
@@ -0,0 +1,74 @@
+import { useEffect, useState } from 'react';
+import type { FormEvent } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { postJson } from '../../api/http';
+import { useOneAtATime } from '../../query/useOneAtATime';
+import { useCurrentSheet, useCurrentUser } from '../session/session';
+import { showFigures } from './figures';
+import { LOCALES, localeKey, useLocale } from './locale';
+import type { Locale } from './locale';
+
+// The signed-in user's locale: a select and its save, and the locale saved. Under de every figure the
+// screen shows is 1.234,56; under en as the app renders it. Entries are still typed with a dot.
+export function UserLocale() {
+  const [user] = useCurrentUser();
+  const [sheet] = useCurrentSheet();
+  const saved = useLocale().data?.locale;
+  const [chosen, setChosen] = useState<Locale>('en');
+  const [error, setError] = useState('');
+  const queryClient = useQueryClient();
+  const once = useOneAtATime();
+
+  useEffect(() => {
+    if (saved) setChosen(saved);
+  }, [saved]);
+
+  const locale: Locale = user && sheet && saved ? saved : 'en';
+  useEffect(() => showFigures(document.body, locale), [locale]);
+
+  const save = useMutation({
+    mutationFn: (value: Locale) =>
+      postJson<{ user: string; locale: Locale }>(
+        `/api/sheets/${encodeURIComponent(sheet)}/locale?user=${encodeURIComponent(user)}`,
+        { locale: value },
+      ),
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey: localeKey(sheet, user) });
+    },
+    onError: () => setError('The locale could not be saved.'),
+  });
+
+  if (!user || !sheet) return null;
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    setError('');
+    once(() => save.mutateAsync(chosen));
+  };
+
+  return (
+    <form onSubmit={submit}>
+      <span>
+        Locale: <strong data-testid="user-locale-current">{saved ?? ''}</strong>{' '}
+      </span>
+      <select
+        data-testid="user-locale"
+        value={chosen}
+        onChange={(e) => {
+          setChosen(e.target.value as Locale);
+          setError('');
+        }}
+      >
+        {LOCALES.map((l) => (
+          <option key={l} value={l}>
+            {l}
+          </option>
+        ))}
+      </select>
+      <button type="submit" data-testid="user-locale-save" disabled={save.isPending}>
+        Save locale
+      </button>
+      {error && <span data-testid="user-locale-error">{error}</span>}
+    </form>
+  );
+}
diff --git a/src/main/frontend/features/locale/figures.ts b/src/main/frontend/features/locale/figures.ts
new file mode 100644
index 000000000..260d61a48
--- /dev/null
+++ b/src/main/frontend/features/locale/figures.ts
@@ -0,0 +1,61 @@
+import type { Locale } from './locale';
+import { showFigure } from './locale';
+
+// Shows every figure on the screen in the user's locale. Features render figures as they always have
+// (1234.56); this rewrites, in place, each text that is the whole text of its element and a figure,
+// and keeps doing so as the screen changes. Form fields are left alone: entries are typed with a dot.
+const SKIP = new Set(['OPTION', 'TEXTAREA', 'SCRIPT', 'STYLE']);
+
+/** The rendered (en) text of each text node this rewrote, to put back when the locale turns en. */
+const rendered = new WeakMap<Text, string>();
+
+function show(node: Text, locale: Locale) {
+  const parent = node.parentElement;
+  if (!parent || SKIP.has(parent.tagName)) return;
+  const original = rendered.get(node);
+  if (original !== undefined && node.data === showFigure(original.trim(), 'de')) {
+    // Still as this rewrote it: kept under de, put back under en.
+    if (locale === 'en') {
+      rendered.delete(node);
+      node.data = original;
+    }
+    return;
+  }
+  rendered.delete(node);
+  if (locale !== 'de') return;
+  const trimmed = node.data.trim();
+  if ((parent.textContent ?? '').trim() !== trimmed) return;
+  const shown = showFigure(trimmed, locale);
+  if (shown === trimmed) return;
+  rendered.set(node, node.data);
+  node.data = shown;
+}
+
+function showAll(root: Node, locale: Locale) {
+  if (root.nodeType === Node.TEXT_NODE) {
+    show(root as Text, locale);
+    return;
+  }
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+  for (let n = walker.nextNode(); n; n = walker.nextNode()) show(n as Text, locale);
+}
+
+/** Keeps every figure under `root` shown in `locale` until the returned stop is called. */
+export function showFigures(root: HTMLElement, locale: Locale): () => void {
+  showAll(root, locale);
+  if (locale !== 'de') return () => {};
+  const observer = new MutationObserver((records) => {
+    for (const r of records) {
+      if (r.type === 'characterData') show(r.target as Text, locale);
+      else {
+        r.addedNodes.forEach((n) => showAll(n, locale));
+        // A child removed or added can make the rest of the element's text a whole figure, or not.
+        if (r.target.nodeType === Node.ELEMENT_NODE) {
+          r.target.childNodes.forEach((n) => n.nodeType === Node.TEXT_NODE && show(n as Text, locale));
+        }
+      }
+    }
+  });
+  observer.observe(root, { subtree: true, childList: true, characterData: true });
+  return () => observer.disconnect();
+}
