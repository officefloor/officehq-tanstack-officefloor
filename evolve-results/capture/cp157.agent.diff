+++ b/src/main/resources/officefloor/rest/api/users/{user}/locale.PUT.yml
@@ -0,0 +1,14 @@
+# Choose the user's locale. Validate the body before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.session.ValidateLocaleUser
+  next: locale
+locale:
+  class: net.officefloor.hq.app.session.ValidateLocale
+  next: apply
+apply:
+  class: net.officefloor.hq.app.session.ApplyLocale
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.session.RespondWithLocale
+  govern: [ transaction ]
