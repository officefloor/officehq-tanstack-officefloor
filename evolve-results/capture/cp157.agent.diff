@@ -0,0 +1,61 @@
+import { useEffect, useState } from 'react';
+import type { FormEvent } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { HttpError, putJson } from '../../api/http';
+import { useSubmitOnce } from '../../api/useSubmitOnce';
+import { LOCALES, localeKey, localePath, useLocale } from './locale';
+import type { Locale, UserLocale as Saved } from './locale';
+
+/** The signed-in user's locale: shown, and chosen with a select (saved per user; no audit line). */
+export function UserLocale({ user }: { user: string }) {
+  const queryClient = useQueryClient();
+  const current = useLocale(user);
+  const [chosen, setChosen] = useState<Locale>(current);
+  const once = useSubmitOnce();
+
+  useEffect(() => setChosen(current), [current]);
+
+  const save = useMutation({
+    mutationFn: (locale: Locale) => putJson<Saved>(localePath(user), { locale }),
+    onSuccess: (saved) => queryClient.setQueryData(localeKey(user), saved),
+    onSettled: once.done,
+  });
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    save.reset();
+    if (!once.start()) return;
+    save.mutate(chosen);
+  };
+
+  return (
+    <form data-testid="user-locale-form" onSubmit={submit}>
+      Locale <strong data-testid="user-locale-current">{current}</strong>{' '}
+      <label>
+        Show figures as{' '}
+        <select
+          data-testid="user-locale"
+          value={chosen}
+          onChange={(e) => {
+            setChosen(e.target.value as Locale);
+            save.reset();
+          }}
+        >
+          {LOCALES.map((l) => (
+            <option key={l} value={l}>
+              {l}
+            </option>
+          ))}
+        </select>
+      </label>{' '}
+      <button type="submit" data-testid="user-locale-save" disabled={save.isPending}>
+        Save locale
+      </button>
+      {save.isError && (
+        <p data-testid="user-locale-error" role="alert">
+          {save.error instanceof HttpError && save.error.body ? save.error.body : 'Could not change the locale.'}
+        </p>
+      )}
+    </form>
+  );
+}
diff --git a/src/main/frontend/features/locale/locale.ts b/src/main/frontend/features/locale/locale.ts
new file mode 100644
index 0000000..3f8ed1c
--- /dev/null
+++ b/src/main/frontend/features/locale/locale.ts
@@ -0,0 +1,37 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJsonNow } from '../../api/http';
+
+/** How figures are shown to a user: en (1234.56) or de (1.234,56). Entries are always typed with a dot. */
+export type Locale = 'en' | 'de';
+
+export const LOCALES: Locale[] = ['en', 'de'];
+
+export type UserLocale = { user: string; locale: Locale };
+
+// Kept per user, not per sheet: not under ['sheet', ...].
+export const localeKey = (user: string) => ['user', user, 'locale'] as const;
+
+export function localePath(user: string): string {
+  return `/api/users/${encodeURIComponent(user)}/locale`;
+}
+
+/** The signed-in user's locale ('en' until it is read, or until they choose one). */
+export function useLocale(user: string): Locale {
+  const q = useQuery({
+    queryKey: localeKey(user),
+    queryFn: () => getJsonNow<UserLocale>(localePath(user)),
+    enabled: user !== '',
+  });
+  return q.data?.locale ?? 'en';
+}
+
+/** A figure: a number with two decimals, the whole of its text. */
+const FIGURE = /^(-?)(\d+)\.(\d{2})$/;
+
+/** The figure as shown under the locale; any other text unchanged. */
+export function formatFigure(text: string, locale: Locale): string {
+  if (locale !== 'de') return text;
+  const m = FIGURE.exec(text.trim());
+  if (!m) return text;
+  return `${m[1]}${m[2].replace(/\B(?=(\d{3})+(?!\d))/g, '.')},${m[3]}`;
+}
