+# PUT /api/users/{user}/locale — change the user's locale. A locale other than en or de is a 400 and writes nothing.
+# Writes no audit record. Responds with the locale as stored.
+validate:
+  class: net.officefloor.hq.app.locale.ValidateLocale
+  next: save
+save:
+  class: net.officefloor.hq.app.locale.SaveLocale
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.locale.RespondWithLocale
