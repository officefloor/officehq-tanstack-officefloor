+# POST /api/sheets/{sheetId}/locale — choose the user's locale on the sheet (body: {user, locale}), 'en' or
+# 'de'. Refused (400), storing nothing, when no user or another locale is given. Not audited, and allowed
+# from a screen showing the sheet as of a date: it changes only how that user's screen shows figures.
+validate:
+  class: net.officefloor.hq.app.locale.ValidateLocale
+  next: save
+save:
+  class: net.officefloor.hq.app.locale.SaveLocale
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.locale.RespondWithSavedLocale
+  govern: [ transaction ]
