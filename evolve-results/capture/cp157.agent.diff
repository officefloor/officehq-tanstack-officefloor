new file mode 100644
index 00000000..ea65c665
--- /dev/null
+++ b/src/main/frontend/features/locale/LocaleFigures.tsx
@@ -0,0 +1,64 @@
+import { useLayoutEffect, useRef } from 'react';
+import type { ReactNode } from 'react';
+import { showFigure } from './figures';
+import type { Locale } from './localeQuery';
+
+// Text never shown as a figure: what a person types or picks, and what is not shown at all.
+const SKIP = new Set(['INPUT', 'TEXTAREA', 'SELECT', 'OPTION', 'SCRIPT', 'STYLE']);
+
+/**
+ * Shows every figure inside it under the user's locale. Figures are worked out and kept as text with a dot
+ * (1234.56) everywhere — in the store, the queries, exports and the audit file — so the locale is applied only
+ * here, where they are shown: any element whose whole text is a figure has it rewritten (1.234,56 under de),
+ * and rewritten again whenever React changes it. Each rewritten text remembers what React wrote, so a figure
+ * that stops being an element's whole text, or a change back to en, restores it.
+ */
+export function LocaleFigures({ locale, children }: { locale: Locale; children: ReactNode }) {
+  const ref = useRef<HTMLDivElement>(null);
+  // text node -> what React wrote and what is shown instead
+  const written = useRef(new WeakMap<Text, { original: string; shown: string }>());
+
+  useLayoutEffect(() => {
+    const root = ref.current;
+    if (!root) return;
+
+    const apply = (node: Text) => {
+      const parent = node.parentElement;
+      if (!parent || SKIP.has(parent.tagName)) return;
+      const seen = written.current.get(node);
+      const original = seen && node.data === seen.shown ? seen.original : node.data;
+      const text = original.trim();
+      const whole = parent.textContent?.trim() === node.data.trim();
+      const shown = whole ? original.replace(text, showFigure(text, locale)) : original;
+      if (shown !== original) written.current.set(node, { original, shown });
+      else written.current.delete(node);
+      if (node.data !== shown) node.data = shown;
+    };
+    const walk = (node: Node | null) => {
+      if (!node) return;
+      if (node.nodeType === Node.TEXT_NODE) {
+        apply(node as Text);
+        return;
+      }
+      const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT);
+      for (let t = walker.nextNode(); t; t = walker.nextNode()) apply(t as Text);
+    };
+
+    walk(root);
+    const observer = new MutationObserver((mutations) => {
+      // A text changed, added or removed changes whether its neighbours are their element's whole text.
+      const touched = new Set<Node>();
+      for (const m of mutations) {
+        const at = m.type === 'characterData' ? m.target.parentNode : m.target;
+        if (at && root.contains(at)) touched.add(at);
+      }
+      touched.forEach(walk);
+      // Our own rewrites are observed too; drop them so they do not loop.
+      observer.takeRecords();
+    });
+    observer.observe(root, { subtree: true, childList: true, characterData: true });
+    return () => observer.disconnect();
+  }, [locale]);
+
+  return <div ref={ref}>{children}</div>;
+}
diff --git a/src/main/frontend/features/locale/LocalePicker.tsx b/src/main/frontend/features/locale/LocalePicker.tsx
new file mode 100644
index 00000000..6ab97923
--- /dev/null
+++ b/src/main/frontend/features/locale/LocalePicker.tsx
@@ -0,0 +1,52 @@
+import { useEffect, useState } from 'react';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { putJson } from '../../api/http';
+import { LOCALES, localeKey, localeQuery } from './localeQuery';
+import type { Locale } from './localeQuery';
+
+/** The signed-in user's locale, and the select that changes it. Kept per user; nothing is written to the audit file. */
+export function LocalePicker({ user }: { user: string }) {
+  const queryClient = useQueryClient();
+  const current = useQuery(localeQuery(user)).data ?? 'en';
+  const [chosen, setChosen] = useState<Locale>(current);
+  const [error, setError] = useState('');
+  useEffect(() => setChosen(current), [current]);
+  const save = useMutation({
+    mutationFn: (locale: Locale) =>
+      putJson<{ locale: Locale }>(`/api/users/${encodeURIComponent(user)}/locale`, { locale }, user),
+    onSuccess: (r) => queryClient.setQueryData(localeKey(user), r.locale),
+    onError: () => setError('The locale could not be saved.'),
+  });
+
+  return (
+    <p>
+      Locale <strong data-testid="user-locale-current">{current}</strong>{' '}
+      <select
+        data-testid="user-locale"
+        value={chosen}
+        onChange={(e) => {
+          setChosen(e.target.value as Locale);
+          setError('');
+        }}
+      >
+        {LOCALES.map((l) => (
+          <option key={l} value={l}>
+            {l}
+          </option>
+        ))}
+      </select>{' '}
+      <button
+        type="button"
+        data-testid="user-locale-save"
+        disabled={save.isPending}
+        onClick={() => {
+          setError('');
+          save.mutate(chosen);
+        }}
+      >
+        Save locale
+      </button>
+      {error && <span data-testid="user-locale-error">{error}</span>}
+    </p>
+  );
+}
diff --git a/src/main/frontend/features/locale/figures.ts b/src/main/frontend/features/locale/figures.ts
new file mode 100644
index 00000000..efe2bbc5
--- /dev/null
+++ b/src/main/frontend/features/locale/figures.ts
@@ -0,0 +1,13 @@
+import type { Locale } from './localeQuery';
+
+/** A figure: the whole text is a number with two decimals, as the screen shows amounts, dues, totals, rates, shares and cuts. */
+const FIGURE = /^-?\d+\.\d{2}$/;
+
+/** The figure as shown under the locale; any other text is left as it is. */
+export function showFigure(text: string, locale: Locale): string {
+  if (locale === 'en' || !FIGURE.test(text)) return text;
+  const [whole, decimals] = text.split('.');
+  const sign = whole.startsWith('-') ? '-' : '';
+  const digits = sign ? whole.slice(1) : whole;
+  return `${sign}${digits.replace(/\B(?=(\d{3})+(?!\d))/g, '.')},${decimals}`;
+}
diff --git a/src/main/frontend/features/locale/localeQuery.ts b/src/main/frontend/features/locale/localeQuery.ts
new file mode 100644
index 00000000..5dcf1006
