diff --git a/src/main/frontend/features/locale/locale.slot.tsx b/src/main/frontend/features/locale/locale.slot.tsx
new file mode 100644
index 000000000..68d14f077
--- /dev/null
+++ b/src/main/frontend/features/locale/locale.slot.tsx
@@ -0,0 +1,64 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { HttpError, postJson } from '../../api/http';
+import { useSubmitOnce } from '../../query/useSubmitOnce';
+import { AppHeader } from '../../slots/defs/appHeader';
+import { useCurrentSheet, useCurrentUser } from '../../session/session';
+import { LOCALES, type Locale, localeKey, useLocale } from './locale';
+
+// The signed-in user's locale: how the screen shows them figures. Saved per user (on the sheet), not audited.
+function UserLocale() {
+  const [user] = useCurrentUser();
+  const [sheet] = useCurrentSheet();
+  const current = useLocale(sheet, user);
+  const [choice, setChoice] = useState<Locale | ''>('');
+  const queryClient = useQueryClient();
+  const save = useMutation({
+    mutationFn: (locale: Locale) =>
+      postJson<{ locale: Locale }>(`/api/sheets/${encodeURIComponent(sheet)}/locale`, { user, locale }),
+    onSuccess: (saved) => {
+      queryClient.setQueryData(localeKey(sheet, user), saved);
+      setChoice('');
+    },
+  });
+  const submit = useSubmitOnce(save);
+
+  if (!user || !sheet || !current.data) return null;
+  const selected = choice || current.data.locale;
+  return (
+    <form
+      data-testid="user-locale-form"
+      onSubmit={(e) => {
+        e.preventDefault();
+        submit(selected);
+      }}
+    >
+      Locale <strong data-testid="user-locale-current">{current.data.locale}</strong>{' '}
+      <select
+        data-testid="user-locale"
+        value={selected}
+        onChange={(e) => {
+          setChoice(e.target.value as Locale);
+          save.reset();
+        }}
+      >
+        {LOCALES.map((l) => (
+          <option key={l} value={l}>
+            {l}
+          </option>
+        ))}
+      </select>{' '}
+      <button type="submit" data-testid="user-locale-save" disabled={save.isPending}>
+        Save locale
+      </button>
+      {save.isError && (
+        <span data-testid="user-locale-error" role="alert">
+          {' '}
+          {save.error instanceof HttpError && save.error.reason ? `${save.error.reason}.` : 'The locale was refused.'}
+        </span>
+      )}
+    </form>
+  );
+}
+
+export const contribution = AppHeader.fill({ order: 15, Component: UserLocale });
diff --git a/src/main/frontend/features/locale/locale.ts b/src/main/frontend/features/locale/locale.ts
new file mode 100644
index 000000000..c47faf299
--- /dev/null
+++ b/src/main/frontend/features/locale/locale.ts
@@ -0,0 +1,40 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+import { useCurrentSheet, useCurrentUser } from '../../session/session';
+import { sheetKey } from '../sheet/sheet';
+
+export type Locale = 'en' | 'de';
+export const LOCALES: Locale[] = ['en', 'de'];
+
+/** Under the sheet's key, so loading the sheet again re-reads the user's locale. */
+export const localeKey = (sheet: string, user: string) => [...sheetKey(sheet), 'locale', user] as const;
+
+/** The locale the signed-in user has chosen on the sheet ('en' until they choose). Not as of a date: it
+ *  is how the screen shows figures, not part of the sheet. */
+export function useLocale(sheet: string, user: string) {
+  return useQuery({
+    queryKey: localeKey(sheet, user),
+    queryFn: () =>
+      getJson<{ locale: Locale }>(`/api/sheets/${encodeURIComponent(sheet)}/locale?user=${encodeURIComponent(user)}`),
+    enabled: sheet !== '' && user !== '',
+  });
+}
+
+const FIGURE = /^(-?)(\d+)\.(\d{2})$/;
+
+/** A figure as the locale shows it: under 'de' a text that is wholly a number with two decimals is shown
+ *  as 1.234,56; anything else, and every figure under 'en', is shown as it is. */
+export function formatFigure(value: string, locale: Locale): string {
+  const m = locale === 'de' ? FIGURE.exec(value) : null;
+  if (!m) return value;
+  return `${m[1]}${m[2].replace(/\B(?=(\d{3})+$)/g, '.')},${m[3]}`;
+}
+
+/** Formats a figure for the signed-in user's screen. Use it on every figure shown (never on an entry
+ *  typed, an export or an audit line): `const fig = useFigure(); <td>{fig(total)}</td>`. */
+export function useFigure(): (value: string | number | null | undefined) => string {
+  const [user] = useCurrentUser();
+  const [sheet] = useCurrentSheet();
+  const locale = useLocale(sheet, user).data?.locale ?? 'en';
+  return (value) => (value === null || value === undefined ? '' : formatFigure(String(value), locale));
+}
