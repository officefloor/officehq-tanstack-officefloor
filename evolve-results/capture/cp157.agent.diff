diff --git a/src/main/frontend/features/locale/locale.slot.tsx b/src/main/frontend/features/locale/locale.slot.tsx
new file mode 100644
index 000000000..a16891181
--- /dev/null
+++ b/src/main/frontend/features/locale/locale.slot.tsx
@@ -0,0 +1,57 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { postJson } from '../../api/http';
+import { useSingleFlight } from '../../query/useSingleFlight';
+import { SheetBody } from '../../slots/defs/sheetBody';
+import { LOCALES, localeKey, useLocale, type UserLocale } from './useLocale';
+
+/** The signed-in user's locale, shown and changeable: how the screen shows them figures (useFigure). It is kept
+ *  for the user, whatever sheet is loaded, and writes no audit line. */
+function LocaleControl({ user }: { user: string }) {
+  const locale = useLocale();
+  const [chosen, setChosen] = useState<string | null>(null);
+  const queryClient = useQueryClient();
+  const submitOnce = useSingleFlight();
+  const save = useMutation({
+    mutationFn: (raw: string) => postJson<UserLocale>('/api/locale', { locale: raw }),
+    onSuccess: (saved) => {
+      queryClient.setQueryData(localeKey(user), saved);
+      setChosen(null);
+    },
+  });
+
+  return (
+    <form
+      data-testid="user-locale-form"
+      onSubmit={(e) => {
+        e.preventDefault();
+        submitOnce(() => {
+          save.reset();
+          return save.mutateAsync(chosen ?? locale);
+        });
+      }}
+    >
+      Locale: <strong data-testid="user-locale-current">{locale}</strong>{' '}
+      <select
+        data-testid="user-locale"
+        value={chosen ?? locale}
+        onChange={(e) => {
+          setChosen(e.target.value);
+          save.reset();
+        }}
+      >
+        {LOCALES.map((l) => (
+          <option key={l} value={l}>
+            {l}
+          </option>
+        ))}
+      </select>{' '}
+      <button type="submit" data-testid="user-locale-save" disabled={save.isPending}>
+        Save locale
+      </button>
+      {save.isError && <p data-testid="user-locale-error">{save.error.message}</p>}
+    </form>
+  );
+}
+
+export const contribution = SheetBody.fill({ order: -20, Component: ({ user }) => <LocaleControl user={user} /> });
diff --git a/src/main/frontend/features/locale/useLocale.ts b/src/main/frontend/features/locale/useLocale.ts
new file mode 100644
index 000000000..26e335e1a
--- /dev/null
+++ b/src/main/frontend/features/locale/useLocale.ts
@@ -0,0 +1,38 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJsonNow } from '../../api/http';
+import { useSignedInUser } from '../session/useSession';
+
+export const LOCALES = ['en', 'de'] as const;
+export type UserLocale = { locale: string };
+
+/** The signed-in user's locale is theirs, not a sheet's: kept under its own key, not dropped when a sheet loads. */
+export const localeKey = (user: string) => ['user', user, 'locale'];
+
+/** The signed-in user's locale ('en' until they choose, and while it is being read). */
+export function useLocale(): string {
+  const [user] = useSignedInUser();
+  const locale = useQuery({
+    queryKey: localeKey(user),
+    queryFn: () => getJsonNow<UserLocale>('/api/locale'),
+    enabled: user !== '',
+  });
+  return locale.data?.locale ?? 'en';
+}
+
+/** A figure: the whole text a number with two decimals. */
+const FIGURE = /^(-?)(\d+)\.(\d{2})$/;
+
+/** A shown value as this locale shows it: under 'de' a figure reads 1.234,56 (a dot every three digits, a comma
+ *  before the decimals); anything else, and every value under 'en', is shown as it is. Only what the screen shows
+ *  goes through this: entries are typed with a dot, and exports and audit lines keep the dot. */
+export function figureIn(locale: string, value: string): string {
+  const m = locale === 'de' ? FIGURE.exec(value.trim()) : null;
+  if (!m) return value;
+  return `${m[1]}${m[2].replace(/\B(?=(\d{3})+$)/g, '.')},${m[3]}`;
+}
+
+/** Shows a value as the signed-in user's locale does (figureIn); a value that is not text is shown as it is. */
+export function useFigure(): <T>(value: T) => T | string {
+  const locale = useLocale();
+  return <T,>(value: T) => (typeof value === 'string' ? figureIn(locale, value) : value);
+}
