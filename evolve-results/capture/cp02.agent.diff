+# PUT /api/sheets/{sheetId}/today — change the sheet's today. A body that is not a real date is a
+# 400 and writes nothing. Responds with the sheet as stored.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateToday
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.sheet.ApplyToday
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.sheet.SaveSheet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheet
