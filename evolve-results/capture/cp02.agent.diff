+# Change the sheet's today. Validate the date before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: date
+date:
+  class: net.officefloor.hq.app.sheet.ValidateSheetToday
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.sheet.ApplySheetToday
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithSheetToday
+  govern: [ transaction ]
