+# Add a person to the sheet; a blank name or a grade other than A, B, C is refused (400).
+validate:
+  class: net.officefloor.hq.app.person.ValidatePersonRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.person.BuildPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SavePerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
