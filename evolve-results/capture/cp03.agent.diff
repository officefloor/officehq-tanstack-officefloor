+# Edit a person on a sheet. Validate first so a blank name or a bad grade is a 400, not a 404.
+validate:
+  class: net.officefloor.hq.app.person.ValidatePerson
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.ApplyPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SavePerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
