   next: save
 save:
   class: net.officefloor.hq.app.setting.SaveSetting
@@ -10,6 +14,10 @@ save:
 audit:
   class: net.officefloor.hq.app.setting.AuditSettingChanged
   govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
