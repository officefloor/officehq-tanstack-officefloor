+# POST /api/sheets/{sheetId}/people/{personId}/template-claims — add a DRAFT claim from a template. Body {"template":"<name>"}:
+# the claim takes the template's amount and note as they are now and a blank date, and is then added by every rule of claims.POST.yml.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.template.ValidateTemplateClaim
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: correction
+  govern: [ transaction ]
+correction:
+  class: net.officefloor.hq.app.claim.RefuseInvalidCorrectionInput
+  next: closed
+  govern: [ transaction ]
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedNewInput
+  next: retired
+  govern: [ transaction ]
+retired:
+  class: net.officefloor.hq.app.claim.RefuseRetiredInput
+  next: ref
+  govern: [ transaction ]
+ref:
+  class: net.officefloor.hq.app.claim.RefuseUsedRefInput
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.claim.AddClaim
