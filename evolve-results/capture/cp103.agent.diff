+# POST /api/sheets/{sheetId}/people/{personId}/template-claims — add a DRAFT claim to a person from a
+# template (body: {template, user}): the template's amount and note as they are now, with no date (so
+# dated as the claim form dates a blank date), and every rule of the claim form (see claims.POST.yml).
+# Refused (400), storing nothing, also when the sheet has no template of that name. The claim copies the
+# template: changing the template later leaves it as it is. Recorded as CLAIM_ADDED, as the form does.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateTemplateClaim
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: checkDate
+checkDate:
+  class: net.officefloor.hq.app.claim.CheckDatePeriod
+  govern: [ transaction ]
+  next: checkRetired
+checkRetired:
+  class: net.officefloor.hq.app.claim.CheckRetired
+  govern: [ transaction ]
+  next: checkCorrection
+checkCorrection:
+  class: net.officefloor.hq.app.claim.CheckCorrection
+  govern: [ transaction ]
