+# Save a claim template; saving a name again replaces it. Validate first so a blank name or an
+# amount the claim form would refuse is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.template.ValidateClaimTemplate
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.template.SaveClaimTemplate
+  govern: [ transaction ]
+  next: record
+# Audit only once the template is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.template.RecordClaimTemplateSaved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.template.RespondWithClaimTemplate
+  govern: [ transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/template-claims.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/template-claims.POST.yml
