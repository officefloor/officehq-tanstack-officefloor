diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/template-claims.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/template-claims.POST.yml
new file mode 100644
index 000000000..52d03b3ab
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/template-claims.POST.yml
@@ -0,0 +1,72 @@
+# Add a DRAFT claim to a person from a template: its amount and note as the template has them now,
+# undated (so dated like a claim with no date), then every rule of the claim form.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.template.ValidateTemplateClaim
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: loadPerson
+loadPerson:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: template
+template:
+  class: net.officefloor.hq.app.template.ClaimFromTemplate
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.claim.BuildClaim
+  govern: [ transaction ]
+  next: ref
+# A reference another claim on the sheet has (regardless of case) is a 400 and writes nothing.
+ref:
+  class: net.officefloor.hq.app.claim.CheckClaimRef
+  govern: [ transaction ]
+  next: correction
+# A correction (a negative amount) must name a settled claim of the same person: else a 400.
+correction:
+  class: net.officefloor.hq.app.claim.CheckCorrection
+  govern: [ transaction ]
+  next: closed
+# A claim due by a date inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: retired
+# A claim dated after its person's retirement date is a 409 and writes nothing.
+retired:
+  class: net.officefloor.hq.app.person.CheckClaimRetired
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: log
+# The status it was saved at, with who, when and its due then.
+log:
+  class: net.officefloor.hq.app.claim.LogClaimStatus
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimAdded
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
