+package net.officefloor.hq.app.template;
+
+import java.util.List;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.core.RowMapper;
+import org.springframework.stereotype.Repository;
+
+/** The claim templates store, kept per sheet, one per name. */
+@Repository
+public class TemplateRepository {
+
+    private static final RowMapper<ClaimTemplate> ROW = (rs, n) -> new ClaimTemplate(rs.getString("sheet_id"),
+            rs.getString("name"), rs.getBigDecimal("amount").setScale(2), rs.getString("note"));
+
+    private final JdbcTemplate jdbc;
+
+    public TemplateRepository(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** The sheet's templates, by name. */
+    public List<ClaimTemplate> findAll(String sheetId) {
+        return jdbc.query("SELECT sheet_id, name, amount, note FROM claim_template WHERE sheet_id = ? ORDER BY name",
+                ROW, sheetId);
+    }
+
+    /** The sheet's template of that name, or null. */
+    public ClaimTemplate find(String sheetId, String name) {
+        List<ClaimTemplate> found = jdbc.query(
+                "SELECT sheet_id, name, amount, note FROM claim_template WHERE sheet_id = ? AND name = ?",
+                ROW, sheetId, name);
+        return found.isEmpty() ? null : found.get(0);
+    }
+
+    /** Saves the template, replacing one of the same name on its sheet. */
+    public void save(ClaimTemplate t) {
+        int n = jdbc.update("UPDATE claim_template SET amount = ?, note = ? WHERE sheet_id = ? AND name = ?",
+                t.amount(), t.note(), t.sheetId(), t.name());
+        if (n == 0) {
+            jdbc.update("INSERT INTO claim_template (sheet_id, name, amount, note) VALUES (?, ?, ?, ?)",
+                    t.sheetId(), t.name(), t.amount(), t.note());
+        }
+    }
+}
