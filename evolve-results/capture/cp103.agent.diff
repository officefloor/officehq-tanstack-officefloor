+# POST /api/sheets/{sheetId}/people/{personId}/template-claims — add a DRAFT claim to a person with the named template's
+# amount and note as they are now, and no date, by every rule of the claim form (see claims.POST): a template not on
+# the sheet is a 400; a person not on the sheet is a 404; a claim the form would refuse is a 400; none writes anything.
+# Responds 201 with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.template.ValidateTemplateClaim
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.claim.AddClaim
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaimCreated
