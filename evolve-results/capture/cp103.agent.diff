index 000000000..4da7f7912
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/templates.POST.yml
@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/templates — save a claim template: its name (trimmed), amount and note. A blank name, or an
+# amount the claim form would refuse for a claim that corrects nothing, is a 400 and writes nothing. Saving a name again
+# replaces that template (claims already made from it keep their values). Responds 200 with the template.
+validate:
+  class: net.officefloor.hq.app.template.ValidateTemplate
+  next: save
+save:
+  class: net.officefloor.hq.app.template.SaveTemplate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.template.RecordTemplateSaved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.template.RespondWithTemplate
