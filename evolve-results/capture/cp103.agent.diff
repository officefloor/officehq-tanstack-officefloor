+# POST /api/sheets/{sheetId}/people/{personId}/template-claims — add a DRAFT claim to a person from a
+# template (named in the body): its amount and note as they stand now, no date (the sheet's default),
+# by every rule of the claim form (see claims.POST.yml). An unknown template is refused.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.template.ValidateTemplateClaim
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: create
+create:
+  class: net.officefloor.hq.app.claim.AddClaim
+  govern: [ transaction ]
+  next: log
+log:
+  class: net.officefloor.hq.app.claim.LogClaimStatus
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimAdded
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
