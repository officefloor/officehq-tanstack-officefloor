diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/templates.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/templates.POST.yml
new file mode 100644
index 000000000..daac810f9
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/templates.POST.yml
@@ -0,0 +1,25 @@
+# Save a claim template. A blank name, or an amount (or note) the claim form would refuse, is refused
+# (a 400) and writes nothing; saving a name again replaces that template.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.template.ValidateTemplate
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.template.SaveTemplate
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.template.AuditTemplateSaved
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.template.RespondWithTemplate
+  govern: [ transaction ]
