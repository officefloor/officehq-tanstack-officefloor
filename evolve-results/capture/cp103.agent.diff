+# claim form (claims.POST), except that its date (never given) may fall in a closed period: only its due-by may not.
+# An unknown template is refused like a bad claim; a refused add writes nothing.
+validate:
+  class: net.officefloor.hq.app.template.ValidateTemplateClaim
