+# The other sheets of the sheet's tree (its ancestors and its descendants) that exist, by sheet id. 404 for an id never loaded.
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithTree
+  govern: [ readonly-transaction ]
