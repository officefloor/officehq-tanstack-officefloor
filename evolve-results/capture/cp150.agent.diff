+# The ids of the other sheets of the sheet's tree (its ancestors and its descendants, among the
+# sheets that exist), by sheet id. Read from the live sheets (a parent is not dated).
+respond:
+  class: net.officefloor.hq.app.consolidated.RespondWithTree
+  govern: [ readonly-transaction ]
