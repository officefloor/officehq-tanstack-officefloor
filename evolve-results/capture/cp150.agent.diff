+# GET /api/sheets/{sheetId}/tree — the ids of the other sheets of the sheet's tree (its topmost ancestor and all that
+# sheet's descendants, the sheet itself left out), sorted by id.
+respond:
+  class: net.officefloor.hq.app.setting.RespondWithTree
+  govern: [ readonly-transaction ]
