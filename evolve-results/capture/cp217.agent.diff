+# POST /api/sheets/{sheetId}/claims/{claimId}/share — share a claim (body {person, share, user}) with another person
+# on the sheet (by id) at a share percent (two decimals, more than 0.00). Each holder's figures count their part of
+# the claim's due (the due times their share divided by 100, rounded half to even), and the claim's own person's
+# count the due less the parts. Refused (400) for a user who may not change the sheet, a claim not on the sheet or
+# one SETTLED, VOID or DELETED, a person not on the sheet, the claim's own person, a person already holding a
+# share, or shares that would total more than 100.00; nothing is stored then. A stored share is recorded in the
+# audit file as CLAIM_SHARED, then any move in the sheet's figures.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateShare
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkShare
+checkShare:
+  class: net.officefloor.hq.app.claim.CheckShare
+  govern: [ transaction ]
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyShare
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimShared
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
