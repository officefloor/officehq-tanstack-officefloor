diff --git a/src/main/resources/db/migration/V107__claim_share.sql b/src/main/resources/db/migration/V107__claim_share.sql
new file mode 100644
index 00000000..b6bcbede
--- /dev/null
+++ b/src/main/resources/db/migration/V107__claim_share.sql
@@ -0,0 +1,19 @@
+-- The people a claim is shared with, in the order shared: each holds a share (a percent with two
+-- decimals, more than 0.00) of the claim's due; the claim's own person keeps the rest. A person holds
+-- at most one share of a claim, and a claim's shares total at most 100.00.
+CREATE TABLE claim_share (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(200) NOT NULL,
+    claim_id  BIGINT       NOT NULL REFERENCES claim (id),
+    person_id BIGINT       NOT NULL,
+    share     DECIMAL(5,2) NOT NULL
+);
+CREATE INDEX claim_share_sheet ON claim_share (sheet_id, claim_id, id);
+
+CREATE TABLE asof.claim_share AS SELECT * FROM public.claim_share WHERE FALSE;
+CREATE TABLE asof_hist.claim_share AS SELECT * FROM public.claim_share WHERE FALSE;
+ALTER TABLE asof_hist.claim_share ADD COLUMN h_seq BIGINT NOT NULL;
+ALTER TABLE asof_hist.claim_share ADD COLUMN h_made_on DATE;
+ALTER TABLE asof_hist.claim_share ADD COLUMN h_op CHAR(1) NOT NULL;
+CREATE INDEX claim_share_hist_sheet ON asof_hist.claim_share (sheet_id, h_seq);
+CREATE TRIGGER claim_share_history AFTER INSERT, UPDATE, DELETE ON public.claim_share FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/share.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/share.POST.yml
new file mode 100644
index 00000000..f3ef3751
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/share.POST.yml
@@ -0,0 +1,35 @@
+# Share a claim with another person on its sheet: they hold a share of its due. A SETTLED, VOID or
+# DELETED claim, its own person, a person already holding a share, or shares over 100.00 are a 409 and write nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimShare
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimShare
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimShare
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused share writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimShared
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
