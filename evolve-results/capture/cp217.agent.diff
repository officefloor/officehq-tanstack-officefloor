+                + " date=" + claim.date() + (claim.number() == null ? "" : " number=" + claim.number())
+                + " with=" + (with == null ? "" : with.name()) + " share=" + sharing.share().toPlainString());
+        rollup.record(claim.sheetId(), sharing.by(), before);
+    }
+}
