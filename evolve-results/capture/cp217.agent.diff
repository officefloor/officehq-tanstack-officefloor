@@ -0,0 +1,43 @@
+# Share a DRAFT, REVIEW, OPEN or PENDING claim with another person on the sheet at a percent (two
+# decimals, more than 0.00). A missing or bad percent, the claim's own person, a person already holding
+# a share, or shares totalling more than 100.00 are a 400; a SETTLED, VOID or DELETED claim a 409.
+# A refusal writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateShare
+  govern: [ transaction ]
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+# Checks the rules and writes the share only when none refuses it.
+apply:
+  class: net.officefloor.hq.app.claim.ShareClaim
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the share is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimShared
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
