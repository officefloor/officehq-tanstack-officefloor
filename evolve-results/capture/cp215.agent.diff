@@ -0,0 +1,5 @@
+# GET /api/sheets/{sheetId}/exists — whether the sheet exists (it has been loaded, or has its own today). Reading it
+# writes nothing, so asking about a sheet never makes it exist.
+respond:
+  class: net.officefloor.hq.app.sheet.RespondWithExists
+  govern: [ readonly-transaction ]
