diff --git a/src/main/java/net/officefloor/hq/app/claim/DeleteClaim.java b/src/main/java/net/officefloor/hq/app/claim/DeleteClaim.java
new file mode 100644
index 000000000..e778d7028
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/DeleteClaim.java
@@ -0,0 +1,10 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Val;
+
+/** Deletes the claim: only a DRAFT may be deleted. A DELETED claim counts nowhere and cannot be edited, opened or voided. */
+public class DeleteClaim {
+    public void apply(@Val Claim claim) throws InvalidClaimStatusException {
+        claim.moveTo(ClaimStatus.DELETED);
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/RestoreClaim.java b/src/main/java/net/officefloor/hq/app/claim/RestoreClaim.java
