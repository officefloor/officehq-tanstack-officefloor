index 000000000..d76460ce0
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/RestoreClaim.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.claim;
+
+import java.time.LocalDate;
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.plugin.variable.Val;
+
+/**
+ * Restores a DELETED claim to a DRAFT: only on the sheet's today it was deleted (its last DELETED
+ * log line's date); on a later day the restore is refused.
+ */
+public class RestoreClaim {
+    public void apply(@Val Sheet sheet, @Val Claim claim, ClaimLogRepository log) throws InvalidClaimStatusException {
+        if (claim.getStatus() != ClaimStatus.DELETED) throw new InvalidClaimStatusException(claim.getStatus(), ClaimStatus.DRAFT);
+        LocalDate deleted = log.deletedOn(claim);
+        if (deleted == null || !deleted.equals(sheet.today())) {
+            throw new InvalidClaimStatusException("A claim may be restored only on the day it was deleted"
+                    + (deleted == null ? "" : ": " + deleted));
+        }
+        claim.moveTo(ClaimStatus.DRAFT);
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/delete.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/delete.POST.yml
new file mode 100644
index 000000000..22f8b0277
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/delete.POST.yml
@@ -0,0 +1,40 @@
+# Delete a DRAFT claim: any other status is a 409 and writes nothing.
+# A DRAFT moves no figure, so it writes no rollup line.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+# A claim due by a date inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.DeleteClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: log
+# The status it was saved at, with who, when and its due then.
+log:
+  class: net.officefloor.hq.app.claim.LogClaimStatus
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimStatus
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
