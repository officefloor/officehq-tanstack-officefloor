diff --git a/src/main/java/net/officefloor/hq/app/claim/AuditClaimAdded.java b/src/main/java/net/officefloor/hq/app/claim/AuditClaimAdded.java
new file mode 100644
index 0000000..ec5b01d
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/AuditClaimAdded.java
@@ -0,0 +1,14 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.plugin.variable.Val;
+
+/** Record the stored add in the audit file, with the amount and date as the screen shows them. */
+public class AuditClaimAdded {
+    public void audit(@Val ClaimInput input, @Val Person person, @Val Claim claim, Audit audit) {
+        ClaimResponse shown = ClaimResponse.from(claim);
+        audit.record("CLAIM_ADDED sheet=" + claim.sheetId() + " by=" + input.user()
+                + " person=" + person.name() + " amount=" + shown.amount() + " date=" + shown.date());
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/AuditClaimEdited.java b/src/main/java/net/officefloor/hq/app/claim/AuditClaimEdited.java
new file mode 100644
index 0000000..c16c89a
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/AuditClaimEdited.java
@@ -0,0 +1,15 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.plugin.variable.Val;
+
+/** Record the stored edit in the audit file, with the amount and date as the screen shows them. */
+public class AuditClaimEdited {
+    public void audit(@Val ClaimInput input, @Val Claim loaded, @Val ClaimResponse saved, PersonRepository people,
+            Audit audit) {
+        var person = people.find(loaded.sheetId(), loaded.personId());
+        audit.record("CLAIM_EDITED sheet=" + loaded.sheetId() + " by=" + input.user()
+                + " person=" + person.name() + " amount=" + saved.amount() + " date=" + saved.date());
+    }
+}
