@@ -0,0 +1,17 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.AuditUser;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.RequestHeader;
+
+/** Records the edited claim, once it is saved. */
+public class AuditClaimEdited {
+    public void audit(@Val Claim claim, PersonRepository people,
+            @RequestHeader(name = "X-User", required = false) String user, Audit audit) {
+        String person = people.findById(claim.getPersonId()).map(Person::getName).orElse("");
+        audit.record(ClaimAudit.line("CLAIM_EDITED", claim, person, AuditUser.decode(user)));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/ClaimAudit.java b/src/main/java/net/officefloor/hq/app/claim/ClaimAudit.java
new file mode 100644
index 00000000..6149d050
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/ClaimAudit.java
@@ -0,0 +1,13 @@
+package net.officefloor.hq.app.claim;
+
+/** A claim's audit line: the event, sheet, user, person, amount as the screen shows it, and date. */
+final class ClaimAudit {
+
+    private ClaimAudit() {
+    }
+
+    static String line(String event, Claim claim, String person, String user) {
+        return event + " sheet=" + claim.getSheetId() + " by=" + user + " person=" + person
+                + " amount=" + claim.getAmount().setScale(2).toPlainString() + " date=" + claim.getDate();
+    }
+}
