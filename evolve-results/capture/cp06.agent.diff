diff --git a/src/main/java/net/officefloor/hq/app/claim/RecordClaimAdded.java b/src/main/java/net/officefloor/hq/app/claim/RecordClaimAdded.java
new file mode 100644
index 00000000..5e790525
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/RecordClaimAdded.java
@@ -0,0 +1,14 @@
+package net.officefloor.hq.app.claim;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.plugin.variable.Val;
+
+/** Runs after the claim is saved, so a refused add writes no audit line. */
+public class RecordClaimAdded {
+    public void record(@Val ClaimValues values, @Val Person person, @Val Claim claim, Audit audit) {
+        audit.record("CLAIM_ADDED sheet=" + claim.getSheetId() + " by=" + values.user()
+                + " person=" + person.getName() + " amount=" + claim.getAmount().toPlainString()
+                + " date=" + claim.getDate());
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/claim/RecordClaimEdited.java b/src/main/java/net/officefloor/hq/app/claim/RecordClaimEdited.java
