+# GET /api/sheets/{sheetId}/dashboard — the steward's dashboard for the user named by X-User: the sheet's PENDING and
+# REVIEW claims and its overdue claims that count ({"pending":1,"review":0,"overdue":2}); every count null for a user
+# who is not a steward (as of the sheet's today, or the as-of date).
+respond:
+  class: net.officefloor.hq.app.dashboard.RespondWithDashboard
+  govern: [ readonly-transaction ]
