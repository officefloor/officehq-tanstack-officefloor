+package net.officefloor.hq.app.dashboard;
+
+/** The steward's dashboard counts; each null for a user who is not a steward. */
+public record DashboardResponse(Integer pending, Integer review, Integer overdue) {
+
+    public static final DashboardResponse NONE = new DashboardResponse(null, null, null);
+}
diff --git a/src/main/java/net/officefloor/hq/app/dashboard/RespondWithDashboard.java b/src/main/java/net/officefloor/hq/app/dashboard/RespondWithDashboard.java
new file mode 100644
index 00000000..7a515746
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/dashboard/RespondWithDashboard.java
@@ -0,0 +1,41 @@
+package net.officefloor.hq.app.dashboard;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.claim.Claim;
+import net.officefloor.hq.app.claim.ClaimStatus;
+import net.officefloor.hq.app.claim.Claims;
+import net.officefloor.hq.app.person.People;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.setting.Settings;
+import net.officefloor.hq.app.sheet.Sheets;
+import net.officefloor.server.http.ServerHttpConnection;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.web.bind.annotation.PathVariable;
+
+public class RespondWithDashboard {
+    // Only a steward (a delegation included) on the sheet's today sees the counts; as of a date, the role then.
+    public void respond(@PathVariable("sheetId") String sheetId, ServerHttpConnection connection, Settings settings,
+            Sheets sheets, Claims claims, People people, ObjectResponse<DashboardResponse> response) {
+        String sheet = sheetId.trim();
+        if (!Settings.STEWARD.equals(settings.role(sheet, Audit.user(connection).trim()))) {
+            response.send(DashboardResponse.NONE);
+            return;
+        }
+        LocalDate today = sheets.today(sheet);
+        List<Claim> all = claims.list(sheet);
+        Map<Long, Person> byId = people.list(sheet).stream().collect(Collectors.toMap(Person::id, Function.identity()));
+        int pending = (int) all.stream().filter(c -> c.status() == ClaimStatus.PENDING).count();
+        int review = (int) all.stream().filter(c -> c.status() == ClaimStatus.REVIEW).count();
+        int overdue = (int) all.stream().filter(c -> {
+            Person person = byId.get(c.personId());
+            return person != null && Rollup.counts(c, person, today) && settings.overdue(c, today);
+        }).count();
+        response.send(new DashboardResponse(pending, review, overdue));
+    }
+}
