@@ -0,0 +1,9 @@
+# The role the user acts in on the sheet (steward while a delegation to them is in force, else the one
+# assigned, else clerk). 404 for an id never loaded.
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ readonly-transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.role.RespondWithUserRole
+  govern: [ readonly-transaction ]
