+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml
@@ -0,0 +1,22 @@
+# Reopen a closed period, making its due-total live again. Only a steward may; anyone else, or a
+# period not closed, is a 400 and writes nothing.
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
