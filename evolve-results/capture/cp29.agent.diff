diff --git a/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
new file mode 100644
index 0000000..b1a6ac3
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
@@ -0,0 +1,22 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.setting.UserRole;
+import net.officefloor.hq.app.setting.UserRoleRepository;
+import net.officefloor.plugin.variable.Val;
+import net.officefloor.web.HttpHeaderParameter;
+
+/** Reopens the period, refusing one not closed or a user (arriving as X-User) who is not a steward; its
+ *  due-total is live again. */
+public class ReopenPeriod {
+    public void reopen(@Val Period period, @HttpHeaderParameter("X-User") String user, UserRoleRepository roles)
+            throws InvalidPeriodException {
+        String by = user == null ? "" : user.trim();
+        if (!UserRole.STEWARD.equals(roles.roleOf(period.getSheetId(), by))) {
+            throw new InvalidPeriodException("Only a steward can reopen a period.");
+        }
+        if (!period.isClosed()) {
+            throw new InvalidPeriodException("The period " + period.getName() + " is not closed.");
+        }
+        period.reopen();
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml
new file mode 100644
index 0000000..57a4a54
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml
@@ -0,0 +1,21 @@
+# Reopen a closed period, by a steward only, making its due-total live again. A period not on the sheet,
+# not closed, or a user who is not a steward is refused (400) and writes nothing.
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SavePeriod
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
