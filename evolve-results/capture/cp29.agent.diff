diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml
new file mode 100644
index 0000000..8e64e22
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml
@@ -0,0 +1,18 @@
+# Reopen a closed period, making its due-total live again. Only a steward may reopen. The audit line
+# is written last, once it is saved, so a refused reopen (no such period, not closed, or not a
+# steward: 400) writes none. Reopening moves no person's figures, so no rollup is written.
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithReopenedPeriod
+  govern: [ transaction ]
