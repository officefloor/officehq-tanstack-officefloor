--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
@@ -0,0 +1,18 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.plugin.variable.Val;
+
+/** Reopens a closed period, so its due-total is live again. Only a steward may reopen; reopening a period that is
+ *  not closed is refused. */
+public class ReopenPeriod {
+    public void reopen(@Val Period period, @Val PeriodCloseRequest request, PeriodRepository periods,
+            RoleRepository roles) throws InvalidPeriodException {
+        if (!RoleRepository.STEWARD.equals(roles.roleOf(period.sheetId(), request.by()))) {
+            throw new InvalidPeriodException("Only a steward may reopen a period");
+        }
+        if (!period.closed() || !periods.reopen(period)) {
+            throw new InvalidPeriodException("The period " + period.name() + " is not closed");
+        }
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodId}/reopen.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodId}/reopen.POST.yml
new file mode 100644
index 000000000..758ffc9a3
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodId}/reopen.POST.yml
@@ -0,0 +1,21 @@
+# POST /api/sheets/{sheetId}/periods/{periodId}/reopen — reopen a closed period, so its due-total is live again.
+# Only a steward may reopen. A period not on the sheet or not closed, or a user who is not a steward, is a 400 and
+# writes nothing. Responds with the period as stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriodClose
+  next: load
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.RecordPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
