+++ b/src/main/resources/officefloor/rest/api/sheets/{sheet}/periods/{period}/reopen.POST.yml
@@ -0,0 +1,9 @@
+# Reopen a closed period, making its due-total live again; refuses a user who is not a steward, a period not on the
+# sheet, or one not closed. Responds with the sheet's periods.
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriods
+  govern: [ transaction ]
