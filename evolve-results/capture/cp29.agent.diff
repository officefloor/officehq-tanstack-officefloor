     }
+
+    /** Reopen the period, dropping its fixed due-total: false when it was not closed, and nothing is written. */
+    public boolean reopen(Period period) {
+        return jdbc.update("UPDATE period SET closed = FALSE, closed_total = NULL WHERE sheet_id = ? AND name = ? AND closed",
+                period.sheetId(), period.name()) == 1;
+    }
 }
diff --git a/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
new file mode 100644
index 0000000..e190e8d
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
@@ -0,0 +1,29 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** Reopen the named period, dropping its fixed due-total so it is live again. Refused when the user is not a
+ *  steward, there is no such period, or it is not closed. */
+public class ReopenPeriod {
+    public void reopen(@PathVariable("sheetId") String sheetId, @PathVariable("periodName") String periodName,
+            @Val PeriodCloseInput input, PeriodRepository periods, RoleRepository roles, Out<Period> reopened)
+            throws InvalidPeriodException {
+        String id = sheetId.trim();
+        periods.lockSheet(id);
+        if (!Role.STEWARD.equals(roles.of(id, input.user()))) {
+            throw new InvalidPeriodException("Only a steward may reopen a period.");
+        }
+        Period period = periods.find(id, periodName);
+        if (period == null) {
+            throw new InvalidPeriodException("There is no period " + periodName.trim() + " on this sheet.");
+        }
+        if (!period.closed() || !periods.reopen(period)) {
+            throw new InvalidPeriodException("The period " + period.name() + " is not closed.");
+        }
+        reopened.set(new Period(period.sheetId(), period.name(), period.from(), period.to(), false, null));
+    }
+}
