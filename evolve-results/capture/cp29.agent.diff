+# POST /api/sheets/{sheetId}/periods/{name}/reopen — reopen a closed period, making its due-total
+# live again; refused (409) for anyone but a steward, or when it is not closed.
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.RecordPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
