diff --git a/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
new file mode 100644
index 00000000..9bd779b0
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
@@ -0,0 +1,25 @@
+package net.officefloor.hq.app.period;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.setting.Settings;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.web.bind.annotation.PathVariable;
+
+public class ReopenPeriod {
+    // Only a steward reopens a closed period; its due-total is then live again.
+    public void reopen(@PathVariable("sheetId") String sheetId, @PathVariable("name") String name, Periods periods,
+            Settings settings, ServerHttpConnection connection, Out<Period> periodOut) throws PeriodRefusedException {
+        Period period = periods.find(sheetId.trim(), name.trim());
+        if (period == null) {
+            throw new PeriodRefusedException("No period " + name + " on this sheet.");
+        }
+        if (!Settings.STEWARD.equals(settings.role(period.sheetId(), Audit.user(connection).trim()))) {
+            throw new PeriodRefusedException("Only a steward can reopen a period.");
+        }
+        if (!period.closed() || !periods.reopen(period)) {
+            throw new PeriodRefusedException("The period " + period.name() + " is not closed.");
+        }
+        periodOut.set(period.reopened());
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.PUT.yml
new file mode 100644
index 00000000..942de93b
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.PUT.yml
@@ -0,0 +1,13 @@
+# PUT /api/sheets/{sheetId}/periods/{name}/reopen — reopen a closed period, making its due-total live
+# again. Steward only. 409 for a period not on the sheet, not closed, or a user who is not a steward.
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodReopened
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
