@@ -0,0 +1,22 @@
+# Reopen a closed period (a steward only), its due-total live again. Validate the body before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: by
+by:
+  class: net.officefloor.hq.app.period.ValidateClosePeriod
+  next: load
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.RecordPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithReopenedPeriod
+  govern: [ transaction ]
