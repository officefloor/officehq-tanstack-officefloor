     }
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodName}/reopen.PUT.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodName}/reopen.PUT.yml
new file mode 100644
index 0000000..b693e11
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodName}/reopen.PUT.yml
@@ -0,0 +1,20 @@
+# Reopen a closed period, making its due-total live again. Only a steward may. A refused reopen (no signed-in user,
+# not a steward, unknown sheet or period, not closed) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriodClose
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
