                 total, sheetId, name) == 1;
     }
+
+    /** Reopens the closed period, dropping its fixed due-total; false when it is not closed (another
+     *  user reopened it first). */
+    public boolean reopen(String sheetId, String name) {
+        return jdbc.update("UPDATE period SET closed = FALSE, closed_total = NULL WHERE sheet_id = ? AND name = ? AND closed",
+                sheetId, name) == 1;
+    }
 }
diff --git a/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
new file mode 100644
index 000000000..e28db4d6e
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/period/ReopenPeriod.java
@@ -0,0 +1,30 @@
+package net.officefloor.hq.app.period;
+
+import java.time.LocalDate;
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** Reopens a closed period, dropping its fixed due-total so it is live again. Refused when the user is
+ *  not a steward on the sheet, there is no such period, or it is not closed. */
+public class ReopenPeriod {
+    public void reopen(@PathVariable("sheetId") String sheetId, @PathVariable("periodName") String periodName,
+            @Val CloseRequest request, PeriodStore store, RoleStore roles, Out<PeriodResponse> reopened)
+            throws InvalidSheetException {
+        String sheet = sheetId.trim();
+        if (roles.find(sheet, request.user()) != Role.STEWARD) {
+            throw new InvalidSheetException("Only a steward can reopen a period");
+        }
+        PeriodResponse period = store.find(sheet, periodName.trim());
+        if (period == null) {
+            throw new InvalidSheetException("No such period: " + periodName.trim());
+        }
+        if (!period.closed() || !store.reopen(sheet, period.name())) {
+            throw new InvalidSheetException("The period " + period.name() + " is not closed");
+        }
+        reopened.set(PeriodResponse.of(period.name(), LocalDate.parse(period.from()), LocalDate.parse(period.to())));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodName}/reopen.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodName}/reopen.POST.yml
new file mode 100644
index 000000000..cdbde2da0
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{periodName}/reopen.POST.yml
@@ -0,0 +1,18 @@
+# POST /api/sheets/{sheetId}/periods/{periodName}/reopen — reopen a closed period (body: {user}),
+# dropping its fixed due-total so it totals its claims' current figures again. Refused (400) when the
+# user is not a steward on the sheet, the period is not on the sheet or is not closed; nothing is
+# stored then. A reopened period is recorded in the audit file as PERIOD_REOPENED.
+validate:
+  class: net.officefloor.hq.app.period.ValidateClose
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithClosedPeriod
+  govern: [ transaction ]
