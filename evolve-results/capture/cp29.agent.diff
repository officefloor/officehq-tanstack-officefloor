diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml
new file mode 100644
index 00000000..cf7f1b33
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods/{name}/reopen.POST.yml
@@ -0,0 +1,18 @@
+# Reopen a closed period, making its due-total live again. An unknown period is a 400; one not
+# closed, or a reopen by anyone but a steward, is a 409.
+load:
+  class: net.officefloor.hq.app.period.LoadPeriod
+  govern: [ transaction ]
+  next: reopen
+reopen:
+  class: net.officefloor.hq.app.period.ReopenPeriod
+  govern: [ transaction ]
+  next: record
+# Audit only once the period is reopened: a refused reopen writes no line.
+record:
+  class: net.officefloor.hq.app.period.RecordPeriodReopened
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithReopenedPeriod
+  govern: [ transaction ]
