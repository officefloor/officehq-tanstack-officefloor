+++ b/src/main/frontend/features/grade/inlineGrade.slot.tsx
@@ -0,0 +1,82 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { putJson } from '../../api/http';
+import { PersonCells, PersonColumns } from '../../slots/defs/personRow';
+import { claimsKey } from '../claims/useClaims';
+import { GRADES, gradeOn, peopleKey, type Person } from '../people/usePeople';
+import { useRowAction } from '../people/useRowAction';
+import { useSheetToday } from '../sheet/useSheet';
+
+/**
+ * A grade select and save on the person's row: saves the chosen grade from the sheet's today exactly
+ * as the person form would, keeping the person's name, terms, contact and tags. It sends the version
+ * the row was read at, so a save made by someone else since refuses it.
+ */
+function PersonInlineGrade({ user, sheet, person }: { user: string; sheet: string; person: Person }) {
+  const queryClient = useQueryClient();
+  const today = useSheetToday(sheet);
+  const [chosen, setChosen] = useState<string | null>(null);
+  const grade = chosen ?? gradeOn(person, today);
+  const save = useMutation({
+    mutationFn: (g: string) =>
+      putJson<Person>(`/api/sheets/${encodeURIComponent(sheet)}/people/${person.id}`, {
+        name: person.name,
+        grade: g,
+        gradeFrom: '',
+        terms: person.terms === null ? '' : String(person.terms),
+        contact: person.contact ?? '',
+        tags: null,
+        version: person.version,
+        user,
+      }),
+    onSuccess: () => setChosen(null),
+    onSettled: () =>
+      Promise.all([
+        queryClient.invalidateQueries({ queryKey: peopleKey(sheet) }),
+        queryClient.invalidateQueries({ queryKey: claimsKey(sheet) }),
+      ]),
+  });
+  const actionTaken = useRowAction(sheet, person.id, () => save.reset());
+  return (
+    <td>
+      <select
+        data-testid="person-inline-grade"
+        aria-label="Grade"
+        value={grade}
+        onChange={(e) => {
+          setChosen(e.target.value);
+          save.reset();
+        }}
+      >
+        {GRADES.map((g) => (
+          <option key={g} value={g}>
+            {g}
+          </option>
+        ))}
+      </select>{' '}
+      <button
+        type="button"
+        data-testid="person-inline-grade-save"
+        disabled={save.isPending}
+        onClick={() => {
+          actionTaken();
+          save.reset();
+          save.mutate(grade);
+        }}
+      >
+        Save grade
+      </button>
+      {save.isError && (
+        <span data-testid="person-error" role="alert">
+          {' '}
+          Could not save the grade.
+        </span>
+      )}
+    </td>
+  );
+}
+
+export const contributions = [
+  PersonColumns.fill({ order: 3, Component: () => <th>Set grade</th> }),
+  PersonCells.fill({ order: 3, Component: PersonInlineGrade }),
+];
