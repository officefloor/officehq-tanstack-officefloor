@@ -0,0 +1,16 @@
+# Gives the person the grade from the sheet's today, exactly as the person form would. Validate before load so a bad
+# grade is a 400, not masked by a 404. Responds with the sheet's people.
+validate:
+  class: net.officefloor.hq.app.person.ValidateInlineGrade
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: grade
+grade:
+  class: net.officefloor.hq.app.person.GradePerson
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPeople
+  govern: [ transaction ]
