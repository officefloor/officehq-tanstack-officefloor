+# POST /api/sheets/{sheetId}/people/{personId}/grade — the row's grade save: records the chosen grade from the sheet's
+# today exactly as the person form's edit would (see the person's PUT), made from the person's current version with
+# their name, terms, contact and tags kept: PERSON_EDITED and the figures it moved. An invalid grade is a 400 and a
+# person not on the sheet a 404, neither writing anything. Responds with the person as stored.
+validate:
+  class: net.officefloor.hq.app.person.ValidateInlineGrade
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.person.BuildInlineGrade
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.person.CheckPersonRename
+  govern: [ transaction ]
+  next: contact
+contact:
+  class: net.officefloor.hq.app.person.CheckPersonRecontact
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.person.ApplyPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SavePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.RecordPersonEdited
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
