+# Save the grade chosen on a person's row from the sheet's today, exactly as the person form's edit would (name, terms,
+# contact and tags kept): its PERSON_EDITED line and then how the sheet's figures moved over it. A refused grade (no
+# user, bad grade, unknown person, a person saved by someone else since the row's version) writes nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateInlineGrade
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.person.BuildInlineGradeEdit
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.person.SavePerson
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.person.AuditPersonEdited
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditPersonRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithPerson
+  govern: [ transaction ]
