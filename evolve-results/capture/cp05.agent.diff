+package net.officefloor.hq.app.claim;
+
+import java.math.BigDecimal;
+import java.sql.Date;
+import java.sql.PreparedStatement;
+import java.sql.Statement;
+import java.time.LocalDate;
+import java.util.List;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.core.RowMapper;
+import org.springframework.jdbc.support.GeneratedKeyHolder;
+import org.springframework.stereotype.Repository;
+
+/** The claim store, kept per sheet. */
+@Repository
+public class Claims {
+
+    private static final RowMapper<Claim> ROW = (rs, i) -> new Claim(rs.getLong("id"), rs.getString("sheet_id"),
+            rs.getLong("person_id"), rs.getBigDecimal("amount"), rs.getDate("claim_date").toLocalDate(),
+            rs.getString("note"));
+
+    private final JdbcTemplate jdbc;
+
+    public Claims(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** The sheet's claims, newest first. */
+    public List<Claim> list(String sheetId) {
+        return jdbc.query("SELECT * FROM claim WHERE sheet_id = ? ORDER BY id DESC", ROW, sheetId);
+    }
+
+    public Claim find(String sheetId, long id) {
+        List<Claim> found = jdbc.query("SELECT * FROM claim WHERE sheet_id = ? AND id = ?", ROW, sheetId, id);
+        return found.isEmpty() ? null : found.get(0);
+    }
+
+    public Claim add(String sheetId, long personId, BigDecimal amount, LocalDate date, String note) {
+        GeneratedKeyHolder keys = new GeneratedKeyHolder();
+        jdbc.update(con -> {
+            PreparedStatement ps = con.prepareStatement(
+                    "INSERT INTO claim (sheet_id, person_id, amount, claim_date, note) VALUES (?, ?, ?, ?, ?)",
+                    Statement.RETURN_GENERATED_KEYS);
+            ps.setString(1, sheetId);
+            ps.setLong(2, personId);
+            ps.setBigDecimal(3, amount);
+            ps.setDate(4, Date.valueOf(date));
+            ps.setString(5, note);
+            return ps;
+        }, keys);
+        return new Claim(keys.getKey().longValue(), sheetId, personId, amount, date, note);
+    }
+
+    public void save(Claim claim) {
+        jdbc.update("UPDATE claim SET amount = ?, claim_date = ?, note = ? WHERE sheet_id = ? AND id = ?",
+                claim.getAmount(), Date.valueOf(claim.getDate()), claim.getNote(), claim.getSheetId(), claim.getId());
+    }
+}
