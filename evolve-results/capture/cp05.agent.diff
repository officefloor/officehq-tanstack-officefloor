+# Add a claim to a person: an amount (required; up to two decimals, 0.00 or more), a date (blank:
+# the sheet's today) and a note (may be empty).
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaim
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.AddClaim
+  govern: [ transaction ]
+  next: respond
