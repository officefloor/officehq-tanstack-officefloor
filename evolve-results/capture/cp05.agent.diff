+# PUT /api/sheets/{sheetId}/claims/{claimId} — edit a claim's amount, date and note, validated as an
+# add (a blank date takes the sheet's today). Invalid values are a 400 and a claim not on the sheet a
+# 404, neither writing anything. Responds with the claim as stored.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaim
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
