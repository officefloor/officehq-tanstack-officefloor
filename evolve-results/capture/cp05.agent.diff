+import { HomeMain } from '../../slots/defs/homeMain';
+import { PersonColumnHeads, PersonColumns } from '../../slots/defs/personColumns';
+import type { Person } from '../people/people';
+import { useCurrentSheet } from '../../session/session';
+import { claimed, useClaims } from './claims';
+
+// A person's claimed (the sum of their claims) and the sheet's claimed-total (everyone's).
+function ClaimedHead() {
+  return <th>Claimed</th>;
+}
+
+function PersonClaimed({ person }: { person: Person }) {
+  const [sheet] = useCurrentSheet();
+  const claims = useClaims(sheet);
+  return <td data-testid="person-claimed">{claimed((claims.data ?? []).filter((c) => c.personId === person.id))}</td>;
+}
+
+function ClaimedTotal() {
+  const [sheet] = useCurrentSheet();
+  const claims = useClaims(sheet);
+  return (
+    <p>
+      Claimed total <strong data-testid="rollup-claimed-total">{claimed(claims.data ?? [])}</strong>
+    </p>
+  );
+}
+
+export const contributions = [
+  PersonColumnHeads.fill({ order: 10, Component: ClaimedHead }),
+  PersonColumns.fill({ order: 10, Component: PersonClaimed }),
+  HomeMain.fill({ order: 30, Component: ClaimedTotal }),
+];
diff --git a/src/main/frontend/features/claims/claims.ts b/src/main/frontend/features/claims/claims.ts
new file mode 100644
index 000000000..fc7b8ccd1
--- /dev/null
+++ b/src/main/frontend/features/claims/claims.ts
@@ -0,0 +1,26 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+import { sheetKey } from '../sheet/sheet';
+
+/** `amount` has two decimals; `date` is yyyy-MM-dd. */
+export type Claim = { id: number; personId: number; amount: string; date: string; note: string };
+
+/** Under the sheet's key, so loading the sheet again re-reads its claims. */
+export const claimsKey = (sheet: string) => [...sheetKey(sheet), 'claims'] as const;
+
+/** Every claim on the sheet, newest first. */
+export function useClaims(sheet: string) {
+  return useQuery({
+    queryKey: claimsKey(sheet),
+    queryFn: () => getJson<Claim[]>(`/api/sheets/${encodeURIComponent(sheet)}/claims`),
+    enabled: sheet !== '',
+  });
+}
+
+/** Amounts are added in whole cents, so the sum is exact. */
+const cents = (amount: string) => Math.round(Number(amount) * 100);
+
+/** The sum of these claims' amounts, with two decimals. */
+export function claimed(claims: Claim[]): string {
+  return (claims.reduce((sum, c) => sum + cents(c.amount), 0) / 100).toFixed(2);
+}
diff --git a/src/main/frontend/features/claims/list.slot.tsx b/src/main/frontend/features/claims/list.slot.tsx
