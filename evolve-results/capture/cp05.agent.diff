+package net.officefloor.hq.app.claim;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+
+public class LoadClaim {
+    public void load(@PathVariable("sheetId") String sheetId, @PathVariable("claimId") String claimId,
+            Claims claims, Out<Claim> claimOut) throws ClaimNotFoundException {
+        Claim claim = null;
+        try {
+            claim = claims.find(sheetId, Long.parseLong(claimId));
+        } catch (NumberFormatException e) {
+            // not an id this app assigned
+        }
+        if (claim == null) {
+            throw new ClaimNotFoundException(claimId);
+        }
+        claimOut.set(claim);
+    }
+}
