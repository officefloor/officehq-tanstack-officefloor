+# POST /api/sheets/{sheetId}/people/{personId}/claims — add a claim to a person. Body
+# {"amount":"12.50","date":"yyyy-mm-dd","note":"..."}; a blank date is the sheet's today. An amount
+# that is not a number of 0.00 or more with up to two decimals, or a date that is not real, is
+# refused with 400 and nothing is stored; 404 for a person not on the sheet.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaim
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.claim.AddClaim
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
