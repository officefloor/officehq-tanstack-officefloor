+  class: net.officefloor.hq.app.claim.ValidateClaim
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaim
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithEditedClaim
+  govern: [ transaction ]
