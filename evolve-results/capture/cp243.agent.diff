+import { useRef } from 'react';
+import { csvField } from '../export/ExportPeople';
+import type { Person } from '../people/people';
+import { useCurrentSheet } from '../session/session';
+
+/** The cells of a person's row the export carries, in order. */
+const CELLS = [
+  'person-name',
+  'person-grade',
+  'person-claimed',
+  'person-due-total',
+  'person-statement-count',
+  'person-overdue-total',
+  'person-hold',
+  'person-retired',
+  'person-aliases',
+  'person-score',
+] as const;
+
+// The button that downloads a person's row as a CSV file: a header line `cell,value`, then one line per
+// cell above with its value as the row shows it (nothing for a cell the row does not show). Quoted and
+// ended as the people export.
+export function ExportPerson({ person }: { person: Person }) {
+  const [sheet] = useCurrentSheet();
+  const ref = useRef<HTMLTableCellElement>(null);
+
+  const download = () => {
+    const row = ref.current?.closest('tr');
+    const lines = [['cell', 'value']];
+    for (const cell of CELLS) {
+      lines.push([cell, row?.querySelector(`[data-testid="${cell}"]`)?.textContent ?? '']);
+    }
+    const csv = lines.map((l) => l.map(csvField).join(',') + '\n').join('');
+    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
+    const a = document.createElement('a');
+    a.href = url;
+    a.download = `person-${sheet}-${person.id}.csv`;
+    a.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  };
+
+  return (
+    <td ref={ref}>
+      <button type="button" data-testid="person-export" onClick={download}>
+        Export (CSV)
+      </button>
+    </td>
+  );
+}
