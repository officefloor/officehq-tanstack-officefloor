+import { useEffect, useRef, useState } from 'react';
+import { useIsFetching } from '@tanstack/react-query';
+import { PeopleHead, PersonRow } from '../../slots/defs/personRow';
+import type { Person } from '../people/people';
+import { csvValue, download } from './csv';
+
+/** The cells of a person's row the file holds, in file order. */
+const CELLS = [
+  'person-name',
+  'person-grade',
+  'person-claimed',
+  'person-due-total',
+  'person-statement-count',
+  'person-overdue-total',
+  'person-hold',
+  'person-retired',
+  'person-aliases',
+  'person-score',
+];
+
+function PersonExportHead() {
+  return <th />;
+}
+
+/** The button that downloads a person's row as a CSV file: a `cell,value` header, then one line per cell (see CELLS)
+ *  with its value exactly as the row shows it (empty when the cell's column is hidden). Made once the sheet's figures
+ *  are no longer being re-read, so the file holds what the screen shows. */
+function PersonExport({ sheetId, person }: { sheetId: string; person: Person }) {
+  const fetching = useIsFetching({ queryKey: ['sheet', sheetId] });
+  const [wanted, setWanted] = useState(false);
+  const cell = useRef<HTMLTableCellElement>(null);
+
+  useEffect(() => {
+    if (!wanted || fetching > 0) return;
+    setWanted(false);
+    const row = cell.current?.closest('tr');
+    const lines = ['cell,value'];
+    for (const id of CELLS) {
+      const td = row?.querySelector(`:scope > [data-testid="${id}"]`);
+      lines.push([id, td?.textContent ?? ''].map(csvValue).join(','));
+    }
+    download(`person-${person.id}-${sheetId}.csv`, lines);
+  }, [wanted, fetching, person.id, sheetId]);
+
+  return (
+    <td ref={cell}>
+      <button type="button" data-testid="person-export" onClick={() => setWanted(true)}>
+        Export (CSV)
+      </button>
+    </td>
+  );
+}
+
+export const contributions = [
+  PeopleHead.fill({ order: 97, Component: PersonExportHead }),
+  PersonRow.fill({ order: 97, Component: PersonExport }),
+];
