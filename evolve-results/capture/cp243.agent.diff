+import { PersonCells, PersonColumns } from '../../slots/defs/personRow';
+import type { Person } from '../people/usePeople';
+import { downloadCsv, useSheetRead } from './csv';
+
+/** The row's cells the export holds, in order. */
+const CELLS = [
+  'person-name',
+  'person-grade',
+  'person-claimed',
+  'person-due-total',
+  'person-statement-count',
+  'person-overdue-total',
+  'person-hold',
+  'person-retired',
+  'person-aliases',
+  'person-score',
+];
+
+/**
+ * A person's export: the button downloads their row as a CSV file, a header line `cell,value` then
+ * one line per cell above, each with the value exactly as the row shows it (read from the row
+ * itself, so it is the figure on screen; a cell the row does not show is blank). The button waits
+ * for the sheet's reads, as the other exports do.
+ */
+function PersonExport({ sheet, person }: { user: string; sheet: string; person: Person }) {
+  const read = useSheetRead(sheet);
+  const exportRow = (button: HTMLElement) => {
+    const row = button.closest('tr');
+    const lines = [['cell', 'value']];
+    for (const id of CELLS) {
+      const cell = row?.querySelector(`:scope > [data-testid="${id}"]`);
+      lines.push([id, cell?.textContent ?? '']);
+    }
+    downloadCsv(lines, `person-${sheet}-${person.id}.csv`);
+  };
+  return (
+    <td>
+      <button type="button" data-testid="person-export" disabled={!read} onClick={(e) => exportRow(e.currentTarget)}>
+        Export row (CSV)
+      </button>
+    </td>
+  );
+}
+
+export const contributions = [
+  PersonColumns.fill({ order: 90, Component: () => <th>Export</th> }),
+  PersonCells.fill({ order: 90, Component: PersonExport }),
+];
