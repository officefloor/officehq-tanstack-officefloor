+import type { MouseEvent } from 'react';
+import { downloadCsv } from '../../api/csv';
+import { PersonCells, PersonHeaders } from '../../slots/defs/personColumns';
+
+/** The row's cells the export holds, in its order. */
+const exportedCells = [
+  'person-name',
+  'person-grade',
+  'person-claimed',
+  'person-due-total',
+  'person-statement-count',
+  'person-overdue-total',
+  'person-hold',
+  'person-retired',
+  'person-aliases',
+  'person-score',
+];
+
+/**
+ * Downloads the person's row as CSV: a header line `cell,value`, then one line per exported cell with its value
+ * as the row shows it (empty when the row does not show that cell).
+ */
+function ExportRow({ personId }: { sheetId: string; personId: number }) {
+  const exportCsv = (e: MouseEvent<HTMLButtonElement>) => {
+    const row = e.currentTarget.closest('tr');
+    const shown = (cell: string) => row?.querySelector(`[data-testid="${cell}"]`)?.textContent ?? '';
+    downloadCsv(`person-${personId}.csv`, [['cell', 'value'], ...exportedCells.map((cell) => [cell, shown(cell)])]);
+  };
+
+  return (
+    <td>
+      <button type="button" data-testid="person-export" onClick={exportCsv}>
+        Export row (CSV)
+      </button>
+    </td>
+  );
+}
+
+export const contributions = [
+  PersonHeaders.fill({ order: 17.7, Component: () => <th>Row export</th> }),
+  PersonCells.fill({ order: 17.7, Component: ExportRow }),
+];
