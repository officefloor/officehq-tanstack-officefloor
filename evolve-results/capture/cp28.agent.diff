+    /**
+     * Advance {@code table}'s IDENTITY sequence past its current max id, so app-side {@code save()}
+     * calls that generate ids do not collide with rows the seed inserted at explicit ids.
+     */
+    private void syncIdentity(String table) {
+        Long max = jdbc.queryForObject("SELECT COALESCE(MAX(id), 0) FROM " + table, Long.class);
