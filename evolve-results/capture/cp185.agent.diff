+# POST /api/sheets/{sheetId}/claims/{claimId}/settle-part — part-settle an OPEN claim (body: {"amount":"5.25"}).
+# The amount is split off as the split action does (CLAIM_SPLIT, CLAIM_OPENED, rollup lines), and the new claim is then
+# settled by the user as the settle action does (CLAIM_SETTLED, or CLAIM_PENDING above the clerk limit; watchers; rollup
+# lines). Four eyes and the proof rule are judged on the original claim; the new claim's opener is the user, who may
+# still part-settle it. 422 when the split or the settle would be refused; nothing is stored or recorded. 404 for a
+# claim not on the sheet. The step owns its transaction, so it is not governed here.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  next: closed
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyPartSettle
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithEditedClaim
