diff --git a/src/main/java/net/officefloor/hq/app/claim/SettleSplitClaim.java b/src/main/java/net/officefloor/hq/app/claim/SettleSplitClaim.java
new file mode 100644
index 000000000..f16d79006
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/SettleSplitClaim.java
@@ -0,0 +1,32 @@
+package net.officefloor.hq.app.claim;
+
+import jakarta.servlet.http.HttpServletRequest;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.person.PersonRepository;
+import net.officefloor.hq.app.rate.RateRepository;
+import net.officefloor.hq.app.role.RoleRepository;
+import net.officefloor.hq.app.rollup.Rollup;
+import net.officefloor.hq.app.setting.SettingsRepository;
+import net.officefloor.hq.app.sheet.Sheet;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+
+/**
+ * Settles the claim a part-settle split off, as the settle button would (to PENDING when the clerk
+ * limit says so), the four-eyes and proof rules having been judged on the original; saves it and
+ * logs its status. Keeps the sheet's figures as split, so the rollup lines tell what the settle moved.
+ */
+public class SettleSplitClaim {
+    public void settle(@Val Sheet sheet, @Val Split split, PersonRepository people, RateRepository rates,
+            RoleRepository roles, SettingsRepository settings, ClaimRepository claims, ClaimLogRepository log,
+            HttpServletRequest request, Out<PartSettle> partOut)
+            throws InvalidClaimStatusException, SelfSettleException {
+        partOut.set(new PartSettle(Rollup.of(sheet.id(), sheet.today(), people, claims, rates, settings.find(sheet.id()))));
+        Claim made = split.made();
+        String user = Audit.user(request);
+        SettleClaim.settle(sheet, made, user, people, rates, roles, settings, true);
+        made.setSettleBatch(null);
+        claims.save(made);
+        log.record(made, user, sheet.today(), LogClaimStatus.due(sheet, made, people, rates, settings));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/settle-part.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/settle-part.POST.yml
new file mode 100644
index 000000000..540d12cfd
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/settle-part.POST.yml
@@ -0,0 +1,67 @@
+# Part-settle an OPEN claim: split an amount off it as the split does, and settle the new claim at
+# once as the settle does (to PENDING when the clerk limit says so). The four-eyes rules and the
+# proof rule are judged on the original claim. Whatever the split or the settle would refuse
+# refuses the whole action (a 400 or 409) and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateSplit
+  govern: [ transaction ]
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+# A claim due by a date inside a closed period is a 409 and writes nothing.
+closed:
+  class: net.officefloor.hq.app.period.CheckClaimPeriod
+  govern: [ transaction ]
+  next: judge
+# The settle's role, four-eyes and proof rules, on the original claim before it is split.
+judge:
+  class: net.officefloor.hq.app.claim.JudgePartSettle
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.SplitClaim
+  govern: [ transaction ]
+  next: save
+# Saves both claims; the new one takes the sheet's next number and logs its opening.
+save:
+  class: net.officefloor.hq.app.claim.SaveSplit
+  govern: [ transaction ]
+  next: audit
+# Every rule has passed and the split is saved.
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimSplit
+  govern: [ transaction ]
+  next: rollup
+# After the split's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: settle
+# Settles the new claim, saves it and logs its status.
+settle:
+  class: net.officefloor.hq.app.claim.SettleSplitClaim
+  govern: [ transaction ]
+  next: settled
+# The settle's own line, its watchers' lines, then the figures it moved.
+settled:
+  class: net.officefloor.hq.app.claim.AuditSplitSettled
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithSplit
+  govern: [ transaction ]
