index 000000000..591fcc6de
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/settle-part.POST.yml
@@ -0,0 +1,20 @@
+# POST /api/sheets/{sheetId}/claims/{claimId}/settle-part — part-settle an OPEN claim (body {amount, user}): the
+# amount is split off it exactly as a split does, and the new claim is settled at once by the user exactly as a
+# settle does (PENDING when the clerk limit says so). The four-eyes rules (the user who opened or last edited a
+# claim may not settle it) and the proof rule are judged on the original claim; the new claim's opener is the user,
+# who may still settle it. Refused (400), storing and auditing nothing, when the split or the settle would be
+# refused. Audited as the split (CLAIM_SPLIT, CLAIM_OPENED, figures), then the settle (CLAIM_SETTLED or CLAIM_PENDING, ...).
+validate:
+  class: net.officefloor.hq.app.claim.ValidateSplit
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyPartSettle
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
