+# Part-settle an OPEN claim: split an amount off it exactly as a split does, and settle the new claim at once by the
+# user exactly as a settle does (PENDING when the clerk limit says so). The four-eyes rules and the proof rule are
+# judged on the original claim. A split or a settle that would be refused refuses the whole action; nothing is written.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: amount
+amount:
+  class: net.officefloor.hq.app.claim.ValidateSplit
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.access.RefuseViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplySettlePart
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
