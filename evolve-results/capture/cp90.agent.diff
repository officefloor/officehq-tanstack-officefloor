+# Add a void reason. Validate first so a blank or repeated reason is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.voidreason.ValidateVoidReason
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.voidreason.SaveVoidReason
+  govern: [ transaction ]
+  next: record
+# Audit only once the reason is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.voidreason.RecordVoidReasonAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.voidreason.RespondWithVoidReason
+  govern: [ transaction ]
