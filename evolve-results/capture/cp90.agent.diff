+# POST /api/sheets/{sheetId}/void-reasons — adds a void reason to the sheet. Body {"reason":"..."}, trimmed. A blank
+# reason, or one already on the list (without regard to case), is refused with 422 and nothing is stored or recorded.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.voidreason.ValidateVoidReason
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.voidreason.AddVoidReason
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.voidreason.AuditVoidReasonAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.voidreason.RespondWithVoidReason
+  govern: [ transaction ]
