diff --git a/src/main/frontend/features/voidreasons/voidreasons.slot.tsx b/src/main/frontend/features/voidreasons/voidreasons.slot.tsx
new file mode 100644
index 000000000..f0bc3268e
--- /dev/null
+++ b/src/main/frontend/features/voidreasons/voidreasons.slot.tsx
@@ -0,0 +1,68 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { HttpError, postJson } from '../../api/http';
+import { useSubmitOnce } from '../../query/useSubmitOnce';
+import { HomeMain } from '../../slots/defs/homeMain';
+import { useCurrentSheet, useCurrentUser } from '../../session/session';
+import { type VoidReason, voidReasonsKey, useVoidReasons } from './voidreasons';
+
+// The sheet's void reasons, and the entry a reason is added with. A blank reason, or one already on the
+// list, is refused.
+function VoidReasons() {
+  const [user] = useCurrentUser();
+  const [sheet] = useCurrentSheet();
+  const reasons = useVoidReasons(sheet);
+  const [reason, setReason] = useState('');
+  const queryClient = useQueryClient();
+
+  const add = useMutation({
+    mutationFn: (r: string) =>
+      postJson<VoidReason>(`/api/sheets/${encodeURIComponent(sheet)}/void-reasons`, { reason: r, user }),
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey: voidReasonsKey(sheet) });
+      setReason('');
+    },
+  });
+  const submit = useSubmitOnce(add);
+
+  return (
+    <section data-testid="void-reasons">
+      <h2>Void reasons</h2>
+      <ul>
+        {(reasons.data ?? []).map((r) => (
+          <li key={r.reason} data-testid={`void-reason-row-${r.reason}`}>
+            {r.reason}
+          </li>
+        ))}
+      </ul>
+      <form
+        data-testid="void-reason-form"
+        onSubmit={(e) => {
+          e.preventDefault();
+          submit(reason);
+        }}
+      >
+        <input
+          data-testid="void-reason-text"
+          placeholder="Reason"
+          value={reason}
+          onChange={(e) => {
+            setReason(e.target.value);
+            add.reset();
+          }}
+        />
+        <button type="submit" data-testid="void-reason-add" disabled={add.isPending}>
+          Add void reason
+        </button>
+        {add.isError && (
+          <span data-testid="void-reason-error" role="alert">
+            {' '}
+            {add.error instanceof HttpError && add.error.reason ? `${add.error.reason}.` : 'The void reason was refused.'}
+          </span>
+        )}
+      </form>
+    </section>
+  );
+}
+
+export const contribution = HomeMain.fill({ order: 47.5, Component: VoidReasons });
diff --git a/src/main/frontend/features/voidreasons/voidreasons.ts b/src/main/frontend/features/voidreasons/voidreasons.ts
new file mode 100644
index 000000000..0917813e6
--- /dev/null
+++ b/src/main/frontend/features/voidreasons/voidreasons.ts
@@ -0,0 +1,19 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+import { asOfKey, asOfPath, sheetKey } from '../sheet/sheet';
+import { useAsOf } from '../../session/session';
+
+/** A void reason on the sheet. While the sheet has any, a claim is voided with one of them. */
+export type VoidReason = { reason: string };
+
+/** Under the sheet's key, so loading the sheet again re-reads its void reasons. */
+export const voidReasonsKey = (sheet: string) => [...sheetKey(sheet), 'void-reasons'] as const;
+
+export function useVoidReasons(sheet: string) {
+  const [asOf] = useAsOf();
+  return useQuery({
+    queryKey: asOfKey(voidReasonsKey(sheet), asOf),
+    queryFn: () => getJson<VoidReason[]>(asOfPath(`/api/sheets/${encodeURIComponent(sheet)}/void-reasons`, asOf)),
+    enabled: sheet !== '',
+  });
+}
