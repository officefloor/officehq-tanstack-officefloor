diff --git a/src/main/frontend/features/voidreasons/useVoidReasons.ts b/src/main/frontend/features/voidreasons/useVoidReasons.ts
new file mode 100644
index 00000000..e720b5b8
--- /dev/null
+++ b/src/main/frontend/features/voidreasons/useVoidReasons.ts
@@ -0,0 +1,19 @@
+import { useQuery } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+import { asOfKey, asOfPath, useAsOf } from '../asof/useAsOf';
+
+/** A void reason as the server sends it: its text. */
+export type VoidReason = { reason: string };
+
+export const voidReasonsKey = (sheet: string) => ['sheet', sheet, 'void-reasons'] as const;
+
+/** The sheet's void reasons, in the order added, re-read whenever the sheet is loaded. */
+export function useVoidReasons(sheet: string) {
+  const [asOf] = useAsOf();
+  return useQuery({
+    queryKey: asOfKey(voidReasonsKey(sheet), asOf),
+    queryFn: () => getJson<VoidReason[]>(asOfPath(`/api/sheets/${encodeURIComponent(sheet)}/void-reasons`, asOf)),
+    staleTime: 0,
+    gcTime: 0,
+  });
+}
diff --git a/src/main/frontend/features/voidreasons/voidReasons.slot.tsx b/src/main/frontend/features/voidreasons/voidReasons.slot.tsx
new file mode 100644
index 00000000..64c9230f
--- /dev/null
+++ b/src/main/frontend/features/voidreasons/voidReasons.slot.tsx
@@ -0,0 +1,84 @@
+import { useState } from 'react';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import { postJson } from '../../api/http';
+import { useSubmitOnce } from '../../query/useSubmitOnce';
+import { SheetPanels } from '../../slots/defs/sheetPanels';
+import { useVoidReasons, voidReasonsKey, type VoidReason } from './useVoidReasons';
+
+/**
+ * The sheet's void reasons and a text entry to add one. While the list is not empty, a claim is
+ * voided only with a reason chosen from it; a blank reason, or one already on the list, is refused.
+ */
+function VoidReasonsPanel({ user, sheet }: { user: string; sheet: string }) {
+  const queryClient = useQueryClient();
+  const { data: reasons = [] } = useVoidReasons(sheet);
+  const [text, setText] = useState('');
+  const [invalid, setInvalid] = useState(false);
+
+  const submitOnce = useSubmitOnce();
+  const add = useMutation({
+    mutationFn: (r: string) =>
+      postJson<VoidReason>(`/api/sheets/${encodeURIComponent(sheet)}/void-reasons`, { reason: r, user }),
+    onSuccess: async () => {
+      setText('');
+      await queryClient.invalidateQueries({ queryKey: voidReasonsKey(sheet) });
+    },
+  });
+
+  // An error goes as soon as its form is changed or submitted again.
+  const clearError = () => {
+    add.reset();
+    setInvalid(false);
+  };
+
+  return (
+    <section data-testid="void-reasons-panel">
+      <h2>Void reasons</h2>
+      <form
+        data-testid="void-reason-form"
+        onSubmit={(e) => {
+          e.preventDefault();
+          const r = text.trim();
+          if (r === '' || reasons.some((v) => v.reason === r)) {
+            // Refused here, before anything is sent: the store and the audit file are untouched.
+            add.reset();
+            setInvalid(true);
+            return;
+          }
+          setInvalid(false);
+          submitOnce(() => add.mutateAsync(r));
+        }}
+      >
+        <label>
+          Reason{' '}
+          <input
+            data-testid="void-reason-text"
+            value={text}
+            onChange={(e) => {
+              setText(e.target.value);
+              clearError();
+            }}
+          />
+        </label>{' '}
+        <button type="submit" data-testid="void-reason-add" disabled={add.isPending}>
+          Add void reason
+        </button>
+        {(invalid || add.isError) && (
+          <span data-testid="void-reason-error" role="alert">
+            {' '}
+            {invalid ? 'Enter a reason not already on the list.' : 'Could not add this void reason.'}
+          </span>
+        )}
+      </form>
+      <ul data-testid="void-reason-list">
+        {reasons.map((v) => (
+          <li key={v.reason} data-testid={`void-reason-row-${v.reason}`}>
+            {v.reason}
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+export const contribution = SheetPanels.fill({ order: 8, Component: VoidReasonsPanel });
