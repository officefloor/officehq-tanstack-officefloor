@@ -0,0 +1,24 @@
+# Add a void reason to the sheet. A blank reason, or one already on the list, is refused (a 400)
+# and writes nothing. A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.voidreason.ValidateVoidReason
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.voidreason.SaveVoidReason
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.voidreason.AuditVoidReasonAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.voidreason.RespondWithVoidReason
+  govern: [ transaction ]
