diff --git a/src/main/java/net/officefloor/hq/app/voidreason/VoidReasons.java b/src/main/java/net/officefloor/hq/app/voidreason/VoidReasons.java
new file mode 100644
index 00000000..bf290baf
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/voidreason/VoidReasons.java
@@ -0,0 +1,49 @@
+package net.officefloor.hq.app.voidreason;
+
+import java.util.List;
+import net.officefloor.hq.app.claim.ClaimStatus;
+import net.officefloor.hq.app.history.AsOf;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+
+/** The store of the sheet's void reasons, each at most once per sheet without regard to case, and of the reason each claim was voided with. */
+@Repository
+public class VoidReasons {
+
+    private final JdbcTemplate jdbc;
+
+    public VoidReasons(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** The sheet's void reasons, in the order they were added. */
+    public List<String> list(String sheetId) {
+        return jdbc.queryForList("SELECT reason FROM " + AsOf.table("void_reason") + " WHERE sheet_id = ? ORDER BY listed",
+                String.class, sheetId);
+    }
+
+    /** The sheet's void reasons, in the order they were added, each with how many VOID claims were voided with it. */
+    public List<VoidReasonResponse> counts(String sheetId) {
+        return jdbc.query("SELECT r.reason, (SELECT COUNT(*) FROM " + AsOf.table("claim", "c")
+                + " WHERE c.sheet_id = r.sheet_id AND c.status = ? AND c.void_reason = r.reason) AS voided FROM "
+                + AsOf.table("void_reason", "r") + " WHERE r.sheet_id = ? ORDER BY r.listed",
+                (rs, n) -> new VoidReasonResponse(rs.getString("reason"), rs.getInt("voided")), ClaimStatus.VOID.name(),
+                sheetId);
+    }
+
+    public boolean has(String sheetId, String reason) {
+        Integer n = jdbc.queryForObject("SELECT COUNT(*) FROM " + AsOf.table("void_reason")
+                + " WHERE sheet_id = ? AND LOWER(reason) = LOWER(?)", Integer.class, sheetId, reason);
+        return n != null && n > 0;
+    }
+
+    public void add(String sheetId, String reason) {
+        jdbc.update("INSERT INTO void_reason (sheet_id, reason, listed) VALUES (?, ?, "
+                + "(SELECT COALESCE(MAX(listed), 0) + 1 FROM void_reason WHERE sheet_id = ?))", sheetId, reason, sheetId);
+    }
+
+    /** Keeps the reason the claim was voided with. */
+    public void voided(long claimId, String reason) {
+        jdbc.update("UPDATE claim SET void_reason = ? WHERE id = ?", reason, claimId);
+    }
+}
diff --git a/src/main/resources/db/migration/V46__void_reason.sql b/src/main/resources/db/migration/V46__void_reason.sql
new file mode 100644
index 00000000..2eaad161
--- /dev/null
+++ b/src/main/resources/db/migration/V46__void_reason.sql
@@ -0,0 +1,20 @@
+-- The sheet's void reasons, listed in the order they were added; each reason at most once per sheet, without regard to
+-- case. While a sheet has any, a claim is voided only with one of them, kept on the claim (null: voided without one, or
+-- not voided). Kept in history too (see V39 and V40); the claim's journal trigger is made again around the change, as
+-- in V41.
+CREATE TABLE void_reason (
+    sheet_id VARCHAR(255) NOT NULL,
+    reason VARCHAR(255) NOT NULL,
+    listed BIGINT NOT NULL,
+    PRIMARY KEY (sheet_id, reason)
+);
+CREATE TABLE void_reason_history AS SELECT * FROM void_reason;
+ALTER TABLE void_reason_history ADD COLUMN history_on DATE DEFAULT DATE '0001-01-01' NOT NULL;
+ALTER TABLE void_reason_history ADD COLUMN history_gone BOOLEAN DEFAULT FALSE NOT NULL;
+ALTER TABLE void_reason_history ADD COLUMN history_seq BIGINT GENERATED BY DEFAULT AS IDENTITY;
+CREATE INDEX void_reason_history_key ON void_reason_history (sheet_id, reason);
+CREATE TRIGGER void_reason_journal AFTER INSERT, UPDATE, DELETE ON void_reason FOR EACH ROW CALL 'net.officefloor.hq.app.history.Journal';
+DROP TRIGGER claim_journal;
+ALTER TABLE claim ADD COLUMN void_reason VARCHAR(255);
+ALTER TABLE claim_history ADD COLUMN void_reason VARCHAR(255);
+CREATE TRIGGER claim_journal AFTER INSERT, UPDATE, DELETE ON claim FOR EACH ROW CALL 'net.officefloor.hq.app.history.Journal';
