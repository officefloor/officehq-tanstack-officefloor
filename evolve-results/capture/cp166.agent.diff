@@ -0,0 +1,15 @@
+# POST /api/sheets/{sheetId}/crews — add a crew (name trimmed) with a lead from the sheet's people. A blank name, one
+# already taken on the sheet, or an unknown lead is a 400 and writes nothing. Responds 201 with the crew.
+validate:
+  class: net.officefloor.hq.app.crew.ValidateCrew
+  next: add
+add:
+  class: net.officefloor.hq.app.crew.AddCrew
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.crew.RecordCrewAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.crew.RespondWithCrewCreated
