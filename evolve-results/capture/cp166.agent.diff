+package net.officefloor.hq.app.crew;
+
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonStore;
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Refuses a member by a viewer, of a crew or person not on the sheet, of the crew's lead, or of a person
+ *  already in the crew. */
+public class ValidateMember {
+    public void validate(@PathVariable("sheetId") String sheetId, @PathVariable("crewId") String crewId,
+            @RequestBody MemberRequest request, Out<MemberInput> body, RoleStore roles, CrewStore crews,
+            PersonStore people) throws InvalidSheetException {
+        String sheet = sheetId.trim();
+        String user = request == null || request.user() == null ? "" : request.user().trim();
+        roles.refuseChange(sheet, user);
+        CrewStore.Crew crew;
+        try {
+            crew = crews.find(sheet, Long.parseLong(crewId.trim()));
+        } catch (NumberFormatException e) {
+            crew = null;
+        }
+        if (crew == null) {
+            throw new InvalidSheetException("No such crew");
+        }
+        Person person = request == null || request.personId() == null ? null : people.find(sheet, request.personId());
+        if (person == null) {
+            throw new InvalidSheetException("A person is required");
+        }
+        if (person.getId() == crew.leadId()) {
+            throw new InvalidSheetException(person.getName() + " leads " + crew.name());
+        }
+        if (crews.isMember(crew.id(), person.getId())) {
+            throw new InvalidSheetException(person.getName() + " is already in " + crew.name());
+        }
+        body.set(new MemberInput(crew, person.getId(), person.getName(), user));
+    }
+}
diff --git a/src/main/resources/db/migration/V75__crew.sql b/src/main/resources/db/migration/V75__crew.sql
new file mode 100644
index 000000000..f204cce35
--- /dev/null
+++ b/src/main/resources/db/migration/V75__crew.sql
@@ -0,0 +1,34 @@
+-- The sheet's crews: a name (trimmed, at most once per sheet), a lead (a person on the sheet) and its members,
+-- each a person on the sheet at most once per crew and never the crew's lead. Kept by version like the rest
+-- of the screen.
+CREATE TABLE crew (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(255)  NOT NULL,
+    name      VARCHAR(1000) NOT NULL,
+    lead_id   BIGINT        NOT NULL,
+    UNIQUE (sheet_id, name)
+);
+
+CREATE TABLE crew_member (
+    id        BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id  VARCHAR(255) NOT NULL,
+    crew_id   BIGINT       NOT NULL,
+    person_id BIGINT       NOT NULL,
+    UNIQUE (crew_id, person_id)
+);
+
+CREATE TABLE crew_hist AS SELECT * FROM crew WITH NO DATA;
+ALTER TABLE crew_hist ADD COLUMN hist_seq BIGINT NOT NULL;
+ALTER TABLE crew_hist ADD COLUMN hist_made_on DATE NOT NULL;
+ALTER TABLE crew_hist ADD COLUMN hist_gone BOOLEAN DEFAULT FALSE NOT NULL;
+CREATE INDEX crew_hist_key ON crew_hist (id, hist_seq);
+CREATE TRIGGER crew_history AFTER INSERT, UPDATE, DELETE ON crew FOR EACH ROW
+    CALL 'net.officefloor.hq.app.history.HistoryTrigger';
+
+CREATE TABLE crew_member_hist AS SELECT * FROM crew_member WITH NO DATA;
+ALTER TABLE crew_member_hist ADD COLUMN hist_seq BIGINT NOT NULL;
+ALTER TABLE crew_member_hist ADD COLUMN hist_made_on DATE NOT NULL;
+ALTER TABLE crew_member_hist ADD COLUMN hist_gone BOOLEAN DEFAULT FALSE NOT NULL;
+CREATE INDEX crew_member_hist_key ON crew_member_hist (id, hist_seq);
+CREATE TRIGGER crew_member_history AFTER INSERT, UPDATE, DELETE ON crew_member FOR EACH ROW
+    CALL 'net.officefloor.hq.app.history.HistoryTrigger';
