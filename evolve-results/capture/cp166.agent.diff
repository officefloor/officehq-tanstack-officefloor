diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/crews.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/crews.POST.yml
new file mode 100644
index 00000000..4d3cb837
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/crews.POST.yml
@@ -0,0 +1,18 @@
+# Add a crew with its lead. Validate first so a blank or repeated name, or no such lead, is a 400 and
+# writes nothing.
+validate:
+  class: net.officefloor.hq.app.crew.ValidateCrew
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.crew.SaveCrew
+  govern: [ transaction ]
+  next: record
+# Audit only once the crew is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.crew.RecordCrewAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.crew.RespondWithCrews
+  govern: [ transaction ]
