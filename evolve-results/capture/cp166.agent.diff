+# POST /api/sheets/{sheetId}/crews — adds a crew to the sheet (body: {name, leadId, user}), trimmed. A blank
+# name, one already a crew, a lead not on the sheet, or a viewer is refused (400) and nothing is stored.
+# Recorded as CREW_ADDED.
+validate:
+  class: net.officefloor.hq.app.crew.ValidateCrew
+  next: save
+save:
+  class: net.officefloor.hq.app.crew.SaveCrew
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.crew.AuditCrewAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.crew.RespondWithCrewAdded
+  govern: [ transaction ]
