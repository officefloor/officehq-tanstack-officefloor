+
+/** A period's classic due-total: while it is open, the dues (as shown on their rows now) of every person's claims that
+ *  count by their status now (see live) whose due-by falls in it, added up; once closed or soft-closed, the figure
+ *  fixed then (see personPeriodDueTotal). */
+export function classicPeriodDueTotal(period: Period, claims: Claim[], people: Person[], rates: Rate[],
+    floor: DatedValue, late: Late): string {
+  if (period.closed || period.soft) return periodDueTotal(period, claims, people, rates, floor, late);
+  return sumDue(people.flatMap((p) => live(claims.filter((c) => c.personId === p.id), [p], late.today)
+    .filter((c) => periodOf([period], dueBy(c)))
+    .map((c) => claimDue(c, rateOn(rates, gradeOn(p, c.date), c.date), floor, late))));
+}
diff --git a/src/main/frontend/features/summary/classic.slot.tsx b/src/main/frontend/features/summary/classic.slot.tsx
new file mode 100644
index 0000000..2e8f0aa
--- /dev/null
+++ b/src/main/frontend/features/summary/classic.slot.tsx
@@ -0,0 +1,53 @@
+import { SheetBody } from '../../slots/defs/sheet';
+import { useClaims } from '../claims/claims';
+import { usePeople } from '../people/people';
+import { classicPeriodDueTotal, usePeriods } from '../periods/periods';
+import { personDueTotal, sumDue, useRates } from '../rates/rates';
+import { useCap, useFloor, useLate } from '../settings/settings';
+import { useSheetToday } from '../sheet/sheet';
+
+/** The classic summary, shown beside the summary: per period its classic due-total (each claim counted by its status
+ *  now; see classicPeriodDueTotal), and the sheet's due-total untrimmed: every person's due-total (as shown on their
+ *  row) added up, skipping n/a. */
+function ClassicSummary({ sheetId }: { sheetId: string; user: string }) {
+  const people = usePeople(sheetId).data ?? [];
+  const claims = useClaims(sheetId).data ?? [];
+  const periods = usePeriods(sheetId).data ?? [];
+  const rates = useRates(sheetId).data ?? [];
+  const today = useSheetToday(sheetId);
+  const floor = useFloor(sheetId);
+  const late = useLate(sheetId);
+  const cap = useCap(sheetId);
+
+  return (
+    <section data-testid="classic">
+      <h2>Classic summary</h2>
+      <table>
+        <tbody>
+          {periods.map((p) => (
+            <tr key={p.name} data-testid={`classic-period-${p.name}`}>
+              <th>Period {p.name}</th>
+              <td>
+                Due total{' '}
+                <span data-testid={`classic-period-${p.name}-due-total`}>
+                  {classicPeriodDueTotal(p, claims, people, rates, floor, late)}
+                </span>
+              </td>
+            </tr>
+          ))}
+          <tr>
+            <th>Sheet</th>
+            <td>
+              Due total{' '}
+              <span data-testid="classic-due-total">
+                {sumDue(people.map((p) => personDueTotal(p, claims, rates, today, floor, late, cap)))}
+              </span>
+            </td>
+          </tr>
+        </tbody>
+      </table>
+    </section>
+  );
+}
+
+export const contribution = SheetBody.fill({ order: 24, Component: ClassicSummary });
