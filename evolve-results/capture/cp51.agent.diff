diff --git a/src/main/java/net/officefloor/hq/app/claim/CheckProofs.java b/src/main/java/net/officefloor/hq/app/claim/CheckProofs.java
new file mode 100644
index 000000000..15f492913
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/claim/CheckProofs.java
@@ -0,0 +1,37 @@
+package net.officefloor.hq.app.claim;
+
+import java.math.BigDecimal;
+import net.officefloor.hq.app.person.Person;
+import net.officefloor.hq.app.person.PersonStore;
+import net.officefloor.hq.app.rate.RateStore;
+import net.officefloor.hq.app.setting.SettingStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.hq.app.sheet.SheetStore;
+
+/** Refuses settling an OPEN claim, or approving a PENDING one, while it has no proofs and its due is above
+ *  the proof threshold in force on its date. A sheet with no threshold then, and a claim whose due is n/a,
+ *  need no proof. */
+final class CheckProofs {
+    private CheckProofs() {
+    }
+
+    static void refuseUnproved(StatusInput input, Claim claim, SettingStore settings, PersonStore people,
+            RateStore rates, SheetStore sheets, ClaimStore claims) throws InvalidSheetException {
+        ClaimStatus from = claim.getStatus();
+        if (input.status() != ClaimStatus.SETTLED || (from != ClaimStatus.OPEN && from != ClaimStatus.PENDING)
+                || claim.getProofs() > 0) {
+            return;
+        }
+        BigDecimal threshold = settings.proofThreshold(claim.getSheetId(), claim.getDate());
+        if (threshold == null) {
+            return;
+        }
+        Person person = people.find(claim.getSheetId(), claim.getPersonId());
+        BigDecimal pct = person == null ? null : rates.find(claim.getSheetId(), person.gradeOn(claim.getDate()), claim.getDate());
+        BigDecimal due = Lateness.of(claim.getSheetId(), settings, sheets, claims).due(claim, pct);
+        if (due != null && due.compareTo(threshold) > 0) {
+            throw new InvalidSheetException("A claim due above the proof threshold of " + threshold.setScale(2)
+                    + " needs a proof before it can be " + (input.review() ? "approved" : "settled"));
+        }
+    }
+}
