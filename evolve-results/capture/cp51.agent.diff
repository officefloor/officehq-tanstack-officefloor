+# Add a proof to a claim, raising its proofs count by one. Refused for a SETTLED or VOID claim, or a claim in a closed
+# period.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: proof
+proof:
+  class: net.officefloor.hq.app.claim.ValidateProof
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+closed:
+  class: net.officefloor.hq.app.claim.RefuseClosedClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyProof
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.RecordClaimProofAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
