@@ -0,0 +1,23 @@
+# Add a proof to a claim: its proofs count goes up by one. A refused proof (a SETTLED or VOID claim, unknown claim, a claim dated in a closed period) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateProof
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: closed
+closed:
+  class: net.officefloor.hq.app.period.RefuseClosedClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveProof
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimProofAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
