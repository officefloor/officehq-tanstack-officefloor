+# POST /api/sheets/{sheetId}/claims/{claimId}/proof — raise a claim's proofs count by one (body {user}).
+# Refused (400) for a SETTLED or VOID claim, a claim not on the sheet, or one whose date falls in a
+# closed period; nothing is stored then. A stored proof is recorded in the audit file as CLAIM_PROOF_ADDED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateProof
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: checkClaim
+checkClaim:
+  class: net.officefloor.hq.app.claim.CheckClaimPeriod
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyProof
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimProof
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
