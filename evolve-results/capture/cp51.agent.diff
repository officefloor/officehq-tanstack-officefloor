diff --git a/src/main/resources/db/migration/V35__claim_proofs.sql b/src/main/resources/db/migration/V35__claim_proofs.sql
new file mode 100644
index 00000000..f4ea78ee
--- /dev/null
+++ b/src/main/resources/db/migration/V35__claim_proofs.sql
@@ -0,0 +1,4 @@
+-- How many proofs a claim has, raised by one at a time (not on a SETTLED or VOID claim, nor one
+-- dated in a closed period). A claim whose due is above the sheet's proof threshold in force on its
+-- date cannot be settled or approved while it has none.
+ALTER TABLE claim ADD COLUMN proofs INT NOT NULL DEFAULT 0;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/proof.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/proof.POST.yml
new file mode 100644
index 00000000..f3c8779a
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/proof.POST.yml
@@ -0,0 +1,25 @@
+# Add a proof to a claim: its proofs count goes up by one. A SETTLED or VOID claim, or one dated in a
+# closed period, is a 409 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimProof
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyClaimProof
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaim
+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimProofAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
