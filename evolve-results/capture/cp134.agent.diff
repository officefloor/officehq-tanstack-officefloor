+
+/** The people sorted by their key, ascending; equal keys (and no key) keep list order. */
+function sorted(people: Person[], key: ((p: Person) => string | number) | null): Person[] {
+  if (!key) return people;
+  return people.map((p, i) => ({ p, i, k: key(p) })).sort((a, b) => compare(a.k, b.k) || a.i - b.i).map((e) => e.p);
+}
+
+/** The key a person sorts on: their name as names compare, their grade, or their due-total (n/a last); null: list order. */
+function useSortKey(sort: SortKey): ((p: Person) => string | number) | null {
+  const rates = useRates().data ?? [];
+  const rules = useDueRules();
+  const claims = useClaims().data ?? [];
+  switch (sort) {
+    case 'name':
+      return (p) => nameKey(p.name);
+    case 'grade':
+      return (p) => p.grade;
+    case 'due-total':
+      return (p) => {
+        const total = personDue(claims.filter((c) => c.personId === p.id), rates, p.grades, liveHolds(p, rules.today), rules);
+        return total === NA ? Infinity : Math.round(Number(total) * 100);
+      };
+    default:
+      return null;
+  }
+}
diff --git a/src/main/frontend/features/people/SortBy.tsx b/src/main/frontend/features/people/SortBy.tsx
new file mode 100644
index 000000000..69ca3a6cb
--- /dev/null
+++ b/src/main/frontend/features/people/SortBy.tsx
@@ -0,0 +1,24 @@
+import { useCurrentSheet, useCurrentUser } from '../session/session';
+import { SORT_KEYS, usePeopleSort } from './people';
+
+// The select that sorts the people list on this screen only; the list's order (positions) is untouched.
+export function SortBy() {
+  const [user] = useCurrentUser();
+  const [sheet] = useCurrentSheet();
+  const [sort, setSort] = usePeopleSort();
+
+  if (!user || !sheet) return null;
+
+  return (
+    <label>
+      Sort by{' '}
+      <select data-testid="sort-by" value={sort} onChange={(e) => setSort(e.target.value === 'added' ? undefined : (e.target.value as typeof sort))}>
+        {SORT_KEYS.map((k) => (
+          <option key={k} value={k}>
+            {k}
+          </option>
+        ))}
+      </select>
+    </label>
+  );
+}
