diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml
new file mode 100644
index 000000000..88dba0f6d
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml
@@ -0,0 +1,23 @@
+# POST /api/sheets/{sheetId}/rates/withdraw — withdraw a grade's rate from a date (body: {grade, from, user};
+# a blank from is the rate from the beginning of time). The newest version of that grade and from-date is
+# removed and the version before it, when there is one, applies again; with none before it the rate is gone.
+# Only a steward may; anyone else, or a rate the sheet does not have, is refused (400) and nothing is stored.
+# Recorded in the audit file as RATE_WITHDRAWN; a refused one records nothing. Responds with the sheet's rates.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateWithdraw
+  next: snapshot
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.rate.AuditRateWithdrawn
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRatesNow
+  govern: [ transaction ]
