diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml
new file mode 100644
index 00000000..30e427a7
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml
@@ -0,0 +1,28 @@
+# Withdraw the newest version of a grade's rate for a from-date: the version before it applies again, or,
+# with none, the rate is gone. Only a steward may; anyone else, or an unknown rate, is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateWithdraw
+  govern: [ transaction ]
+  next: snapshot
+# Keep the figures as they were, so the change can audit the ones it moves.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: withdraw
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
+  next: record
+# Audit only once the rate is withdrawn: a refused withdrawal writes no line.
+record:
+  class: net.officefloor.hq.app.rate.RecordRateWithdrawn
+  govern: [ transaction ]
+  next: rollup
+# After the change's own line: a line per person whose figures moved, then the totals if they did.
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRatesAfterWithdraw
+  govern: [ transaction ]
