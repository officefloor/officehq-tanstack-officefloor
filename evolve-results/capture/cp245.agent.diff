+# Withdraw a rate (RATE_WITHDRAWN): the newest version of the sheet's own rate for the grade and from-date (blank: from
+# the start) is removed and the version before it, when there is one, is in force again; with none the rate is gone.
+# Followed by the rollup lines for the figures it moved. Anyone but a steward, a bad grade or from-date, or a grade and
+# from-date the sheet has no rate for is refused (400).
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: steward
+steward:
+  class: net.officefloor.hq.app.rate.CheckRateWithdrawSteward
+  next: validate
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateWithdrawRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: withdraw
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.rate.AuditRateWithdrawn
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRateWithdrawn
+  govern: [ transaction ]
