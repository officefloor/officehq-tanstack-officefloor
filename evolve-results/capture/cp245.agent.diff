@@ -0,0 +1,21 @@
+# POST /api/sheets/{sheetId}/rates/{grade}/withdraw — withdraw the newest version of the grade's rate for a from-date
+# (blank: the one with no from-date): the version before it, when there is one, applies again; with none the rate is
+# gone. Only a steward may withdraw. A user who is not a steward, a from-date that is not yyyy-MM-dd, or a grade and
+# from-date with no rate on the sheet, is a 400 and writes nothing. Responds with what is left for that from-date.
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateWithdraw
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: withdraw
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.rate.RecordRateWithdrawn
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRateWithdrawn
