+
+    /**
+     * Withdraws the newest version of the grade's rate for the from-date (null: the one from the start): the version
+     * before it, when there is one, is the rate in force again; with none the rate is gone. False when there is no such
+     * rate on the sheet.
+     */
+    public boolean withdraw(String sheet, String grade, LocalDate on) {
+        Date from = on == null ? null : Date.valueOf(on);
+        List<Integer> newest = jdbc.queryForList("SELECT version FROM rate WHERE sheet = ? AND grade = ?"
+                + " AND from_date IS NOT DISTINCT FROM ?", Integer.class, sheet, grade, from);
+        if (newest.isEmpty()) {
+            return false;
+        }
+        jdbc.update("DELETE FROM rate WHERE sheet = ? AND grade = ? AND from_date IS NOT DISTINCT FROM ?", sheet, grade,
+                from);
+        List<Integer> older = jdbc.queryForList("SELECT MAX(version) FROM rate_version WHERE sheet = ? AND grade = ?"
+                + " AND from_date IS NOT DISTINCT FROM ? AND version < ?", Integer.class, sheet, grade, from,
+                newest.get(0));
+        Integer previous = older.isEmpty() ? null : older.get(0);
+        if (previous != null) {
+            jdbc.update("INSERT INTO rate (sheet, grade, pct, from_date, to_date, version, forward_after) SELECT"
+                    + " sheet, grade, pct, from_date, to_date, version, forward_after FROM rate_version WHERE sheet = ?"
+                    + " AND grade = ? AND from_date IS NOT DISTINCT FROM ? AND version = ?", sheet, grade, from, previous);
+            jdbc.update("DELETE FROM rate_version WHERE sheet = ? AND grade = ? AND from_date IS NOT DISTINCT FROM ?"
+                    + " AND version = ?", sheet, grade, from, previous);
+        }
+        return true;
+    }
 }
diff --git a/src/main/java/net/officefloor/hq/app/rate/WithdrawRate.java b/src/main/java/net/officefloor/hq/app/rate/WithdrawRate.java
new file mode 100644
index 000000000..f7ef5f196
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/rate/WithdrawRate.java
@@ -0,0 +1,40 @@
+package net.officefloor.hq.app.rate;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.role.Role;
+import net.officefloor.hq.app.role.Roles;
+import net.officefloor.hq.app.rollup.Rollup;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestParam;
+
+/**
+ * Withdraws the newest version of a grade's rate for a from-date: the version before it applies again, or the rate is
+ * gone when there is none. Only a steward may; refuses anyone else, and a rate not on the sheet.
+ */
+public class WithdrawRate {
+    public void withdraw(@PathVariable("sheet") String sheet, @RequestParam("user") String user,
+            @RequestBody RateWithdrawRequest request, Rates rates, Roles roles, Audit audit, Rollup rollup)
+            throws InvalidRateException {
+        if (!Role.STEWARD.equals(roles.of(sheet, user))) {
+            throw new InvalidRateException("Only a steward may withdraw a rate");
+        }
+        String grade = request == null || request.grade() == null ? "" : request.grade().trim();
+        String text = request == null || request.from() == null ? "" : request.from().trim();
+        LocalDate from;
+        try {
+            from = text.isEmpty() || text.equals("start") ? null : LocalDate.parse(text);
+        } catch (DateTimeParseException e) {
+            throw new InvalidRateException("Not a valid from-date: " + text);
+        }
+        Rollup.Snapshot before = rollup.take(sheet);
+        if (!rates.withdraw(sheet, grade, from)) {
+            throw new InvalidRateException("There is no rate for grade " + grade + " from that date");
+        }
+        audit.record("RATE_WITHDRAWN sheet=" + sheet + " by=" + user + " grade=" + grade
+                + (from == null ? "" : " from=" + from));
+        rollup.record(sheet, user, before);
+    }
+}
