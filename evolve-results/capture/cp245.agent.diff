--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rate-withdraw.POST.yml
@@ -0,0 +1,12 @@
+# Withdraw a grade's rate from a from-date (blank: from the beginning of time), by a steward only: its newest
+# version is removed and the version before it, when there is one, applies again; with none the rate is gone
+# (RATE_WITHDRAWN). Refused for anyone else, and when the grade has no rate from that date.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: withdraw
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRate
