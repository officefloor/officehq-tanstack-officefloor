+# Only a steward may withdraw; a refusal is a 400 and writes nothing. Responds with the sheet's rates.
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRates
+  govern: [ transaction ]
