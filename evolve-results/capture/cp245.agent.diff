+# POST /api/sheets/{sheetId}/rates/{grade}/withdraw — withdraw the grade's rate for a from-date. Body {"from":"2026-03-05"}
+# (blank: the rate from the beginning of time). Steward only. The newest version is removed and the one before it, when
+# there is one, applies again; with none before it the rate is gone (RATE_WITHDRAWN, then its ROLLUP lines). A user who is
+# not a steward, or a grade and from-date with no rate, is refused with 400 and nothing is stored.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  next: withdraw
+  govern: [ transaction ]
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.rate.AuditRateWithdrawn
+  next: rollup
+  govern: [ transaction ]
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRateWithdrawn
+  govern: [ transaction ]
