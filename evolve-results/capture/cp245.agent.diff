+++ b/src/main/resources/db/migration/V103__rate_withdraw.sql
@@ -0,0 +1,4 @@
+-- A steward can withdraw a rate's newest version: the version before it applies again, or, with none,
+-- the rate is gone. A withdrawal that leaves no rate is kept in the history as a withdrawn line, so the
+-- sheet shown as of a date on or after it has no rate for that grade and from-date.
+ALTER TABLE rate_history ADD COLUMN withdrawn BOOLEAN NOT NULL DEFAULT FALSE;
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml
new file mode 100644
index 000000000..ba1f2e2bc
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/rates/withdraw.POST.yml
@@ -0,0 +1,27 @@
+# POST /api/sheets/{sheetId}/rates/withdraw — withdraw the newest version of a grade's rate from a from-date:
+# the version before it applies again; with none, the rate is gone. Refused for anyone but a steward, and
+# when the sheet has no such rate of its own.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.rate.ValidateRateWithdrawal
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: withdraw
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.rate.RecordRateWithdrawn
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.rate.RespondWithRateWithdrawn
