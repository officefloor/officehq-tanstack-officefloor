+# The sheet's figures before the change, so the change can audit what it moved.
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: withdraw
+# A steward withdraws the newest version of a grade's rate from a date; the one before it applies again.
+withdraw:
+  class: net.officefloor.hq.app.rate.WithdrawRate
+  govern: [ transaction ]
