index 000000000..329225019
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml
@@ -0,0 +1,31 @@
+# Add a plan to a person (PLAN_ADDED): an amount (0.00 or more, at most two decimals), a start date (blank: the
+# sheet's today), every N days (a whole number, 1 or more) and an end date. An end before the start, or a bad amount,
+# interval or date, is refused (400); a person not on the sheet (404).
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlanRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.plan.BuildPlan
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.plan.SavePlan
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.plan.AuditPlanAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
+  govern: [ transaction ]
