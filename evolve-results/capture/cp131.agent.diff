+# Add a plan to a person: an amount, a start date, every N days and an end date. A refused plan (no signed-in user, a bad
+# amount, date or interval, an end before the start, unknown person) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlan
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.plan.SavePlan
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.plan.AuditPlanAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlanCreated
+  govern: [ transaction ]
