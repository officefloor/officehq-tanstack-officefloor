--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-plans.POST.yml
@@ -0,0 +1,29 @@
+# Generate: for every plan on the sheet, in the order they were added, a DRAFT claim of the plan's amount, dated
+# that day with an empty note, for each plan date (the start, then every N days) up to its end and the sheet's today
+# that it has made none for yet, by the claim form's rules: a date the form refuses is skipped (and tried again next
+# time). Answers how many claims were made.
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.plan.GeneratePlanClaims
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithGenerated
+  govern: [ transaction ]
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml
