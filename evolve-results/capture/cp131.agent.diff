+package net.officefloor.hq.app.plan;
+
+import net.officefloor.hq.app.role.RoleStore;
+import net.officefloor.hq.app.sheet.InvalidSheetException;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Refuses a generate by a viewer or on an archived sheet. */
+public class ValidatePlanGenerate {
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody PlanGenerateRequest request,
+            Out<PlanGenerateRequest> body, RoleStore roles) throws InvalidSheetException {
+        String user = request == null || request.user() == null ? "" : request.user().trim();
+        roles.refuseChange(sheetId.trim(), user);
+        body.set(new PlanGenerateRequest(user));
+    }
+}
diff --git a/src/main/resources/db/migration/V64__plan.sql b/src/main/resources/db/migration/V64__plan.sql
new file mode 100644
index 000000000..14f092e8f
--- /dev/null
+++ b/src/main/resources/db/migration/V64__plan.sql
@@ -0,0 +1,19 @@
+-- A person's plans: a DRAFT claim of the amount is generated for every plan date (the start date, then
+-- every every_days days) up to the end date and the sheet's today. plan_made holds each plan date a
+-- claim was made for, so a date is made at most once and a refused one is tried again next time.
+CREATE TABLE plan (
+    id         BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id   VARCHAR(255)   NOT NULL,
+    person_id  BIGINT         NOT NULL,
+    amount     DECIMAL(19, 2) NOT NULL,
+    start_date DATE           NOT NULL,
+    every_days INT            NOT NULL,
+    end_date   DATE           NOT NULL
+);
+CREATE INDEX plan_sheet ON plan (sheet_id, id);
+
+CREATE TABLE plan_made (
+    plan_id BIGINT NOT NULL,
+    made_on DATE   NOT NULL,
+    PRIMARY KEY (plan_id, made_on)
+);
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml
