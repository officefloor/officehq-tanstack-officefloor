+# POST /api/sheets/{sheetId}/plans/generate — for every plan of the sheet, in the order added, a DRAFT claim of its amount
+# with an empty note for each plan date (the start, then every N days) up to its end and the sheet's today that it has
+# made none for yet, by the claim form's rules: a date the form refuses is skipped and tried again next time. Responds {"made":n}.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: snapshot
+  govern: [ transaction ]
+snapshot:
+  class: net.officefloor.hq.app.rollup.SnapshotRollup
