+# Add a plan to a person: an amount (more than zero, up to two decimals), a start date, every N days (a whole
+# number, at least 1) and an end date not before the start. Answers the sheet's plans.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlan
+  next: save
+save:
+  class: net.officefloor.hq.app.plan.SavePlan
+  govern: [ transaction ]
+  next: load
+load:
+  class: net.officefloor.hq.app.plan.LoadPlans
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlans
