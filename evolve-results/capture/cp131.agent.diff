+# POST /api/sheets/{sheetId}/people/{personId}/plans — add a plan to a person. Body
+# {"amount":"10.00","start":"yyyy-mm-dd","every":"7","end":"yyyy-mm-dd"} (a blank date is the sheet's today). An amount
+# the claim form would refuse, an interval that is not a whole number of at least 1, a bad date or an end before the
+# start is refused with 422 and nothing is stored; 404 for a person not on the sheet.
+viewer:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: archived
+  govern: [ transaction ]
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: validate
+  govern: [ transaction ]
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlan
+  next: load
+  govern: [ transaction ]
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.plan.AddPlan
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.plan.AuditPlanAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
+  govern: [ transaction ]
