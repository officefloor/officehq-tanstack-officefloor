diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-plans.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-plans.POST.yml
new file mode 100644
index 000000000..1565021d9
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/generate-plans.POST.yml
@@ -0,0 +1,22 @@
+# POST /api/sheets/{sheetId}/generate-plans — for every plan on the sheet, in the order they were added,
+# add a DRAFT claim of its amount for every plan date up to its end and the sheet's today that it has made
+# none for yet, by the claim form's rules (a refused date is skipped, and tried again next time).
+# Responds with how many were made.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: before
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: generate
+generate:
+  class: net.officefloor.hq.app.plan.GeneratePlanClaims
+  govern: [ transaction ]
+  next: rollup
+rollup:
+  class: net.officefloor.hq.app.rollup.RecordRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithGenerated
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml
