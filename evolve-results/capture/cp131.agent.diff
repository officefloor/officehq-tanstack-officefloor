--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/plans/generate.POST.yml
@@ -0,0 +1,28 @@
+# Generate the plans' claims: for every plan on the sheet in the order they were added, a DRAFT claim
+# for each plan date up to its end and the sheet's today that has none yet, by the claim form's rules
+# (a date the form refuses is skipped and tried again next time). Responds with how many were made.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: before
+# The sheet's figures before the change, so the rollup lines tell which moved.
+before:
+  class: net.officefloor.hq.app.rollup.TakeRollup
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.claim.AddPlanClaims
+  govern: [ transaction ]
+  next: rollup
+# After the change's own lines: the figures it moved.
+rollup:
+  class: net.officefloor.hq.app.rollup.AuditRollup
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithGenerate
+  govern: [ transaction ]
