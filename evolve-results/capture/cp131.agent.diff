+        this.planId = planId;
+        this.onDate = onDate;
+        this.claimId = claimId;
+    }
+
+    public Long getPlanId() {
+        return planId;
+    }
+
+    public LocalDate getOnDate() {
+        return onDate;
+    }
+
+    public Long getClaimId() {
+        return claimId;
+    }
+}
