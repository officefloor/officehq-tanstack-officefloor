+package net.officefloor.hq.app.plan;
+
+import net.officefloor.hq.app.Audit;
+import net.officefloor.hq.app.BadRequestException;
+import net.officefloor.hq.app.CurrentUser;
+import net.officefloor.plugin.variable.Val;
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** Add a plan to a person on the sheet, written as PLAN_ADDED. */
+public class SavePlan {
+    public void save(@PathVariable("sheetId") String sheetId, @PathVariable("personId") String personId,
+            @Val PlanInput input, ServerHttpConnection connection, PlanRepository repository, Audit audit)
+            throws BadRequestException {
+        String by = CurrentUser.require(connection);
+        String id = sheetId == null ? "" : sheetId.trim();
+        long pid;
+        try {
+            pid = Long.parseLong(personId == null ? "" : personId.trim());
+        } catch (NumberFormatException e) {
+            throw new BadRequestException("no such person");
+        }
+        String name = repository.personName(id, pid);
+        if (name == null) {
+            throw new BadRequestException("no such person");
+        }
+        Plan saved = repository.add(id, pid, input);
+        audit.record("PLAN_ADDED sheet=" + id + " by=" + by + " name=" + name + " amount=" + saved.amount()
+                + " start=" + saved.start() + " every=" + saved.every() + " end=" + saved.end());
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/plan/ValidatePlan.java b/src/main/java/net/officefloor/hq/app/plan/ValidatePlan.java
new file mode 100644
index 000000000..4120ab4cc
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/plan/ValidatePlan.java
@@ -0,0 +1,43 @@
+package net.officefloor.hq.app.plan;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import net.officefloor.hq.app.BadRequestException;
+import net.officefloor.hq.app.claim.ClaimInput;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Bind the plan form: an amount (more than zero, up to two decimals), a start date, every N days (a whole number,
+ *  at least 1) and an end date not before the start are all required. */
+public class ValidatePlan {
+    public void validate(@RequestBody PlanRequest request, Out<PlanInput> plan) throws BadRequestException {
+        String amount = request == null || request.amount() == null ? "" : request.amount().trim();
+        String every = request == null || request.every() == null ? "" : request.every().trim();
+        BigDecimal value = ClaimInput.signedAmount(amount);
+        if (value.signum() <= 0) {
+            throw new BadRequestException("amount must be more than 0");
+        }
+        LocalDate start = date(request == null ? null : request.start(), "start date");
+        LocalDate end = date(request == null ? null : request.end(), "end date");
+        if (!every.matches("[0-9]{1,6}") || Integer.parseInt(every) < 1) {
+            throw new BadRequestException("every must be a whole number of days, at least 1");
+        }
+        if (end.isBefore(start)) {
+            throw new BadRequestException("end date must not be before start date");
+        }
+        plan.set(new PlanInput(value, start, Integer.parseInt(every), end));
+    }
+
+    private static LocalDate date(String value, String what) throws BadRequestException {
+        String v = value == null ? "" : value.trim();
+        if (v.isEmpty()) {
+            throw new BadRequestException(what + " is required");
+        }
+        try {
+            return LocalDate.parse(v);
+        } catch (DateTimeParseException e) {
+            throw new BadRequestException(what + " must be yyyy-mm-dd");
+        }
+    }
+}
diff --git a/src/main/resources/db/migration/V72__plan.sql b/src/main/resources/db/migration/V72__plan.sql
new file mode 100644
index 000000000..acd542089
--- /dev/null
+++ b/src/main/resources/db/migration/V72__plan.sql
@@ -0,0 +1,23 @@
+-- A person's plans: an amount (more than 0.00, two decimals), a start date, an interval in days (1 or
+-- more) and an end date (not before the start). Generating makes a DRAFT claim for each plan date (the
+-- start, then every N days, up to the end and the sheet's today) that has none yet; plan_claim keeps the
+-- dates a plan has made a claim for. Listed in the order they were added (by id).
+CREATE TABLE plan (
+    id         BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id   VARCHAR(200)   NOT NULL REFERENCES sheet (id),
+    person_id  BIGINT         NOT NULL REFERENCES person (id),
+    amount     DECIMAL(14, 2) NOT NULL CHECK (amount > 0),
+    start_date DATE           NOT NULL,
+    every_days INT            NOT NULL CHECK (every_days >= 1),
+    end_date   DATE           NOT NULL
+);
+CREATE INDEX plan_sheet ON plan (sheet_id, id);
+
+CREATE TABLE plan_claim (
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet (id),
+    plan_id  BIGINT       NOT NULL REFERENCES plan (id),
+    on_date  DATE         NOT NULL,
+    claim_id BIGINT       NOT NULL,
+    PRIMARY KEY (plan_id, on_date)
+);
+CREATE INDEX plan_claim_sheet ON plan_claim (sheet_id);
