+# Generate the plans' claims: for every plan, in the order added, a DRAFT claim for each plan date up to its end
+# and the sheet's today that has none yet, by the claim form's rules (a refused date is skipped and tried again
+# next time). Answers how many were made.
+guard:
+  class: net.officefloor.hq.app.settings.RefuseViewer
+  next: generate
+generate:
+  class: net.officefloor.hq.app.plan.GeneratePlanClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithGenerated
