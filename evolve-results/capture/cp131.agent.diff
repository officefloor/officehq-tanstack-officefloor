--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/{personId}/plans.POST.yml
@@ -0,0 +1,21 @@
+# Add a plan to a person. Validate first so a bad amount, every or dates is a 400 and writes
+# nothing, not masked by a 404 for a missing person.
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlan
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.plan.SavePlan
+  govern: [ transaction ]
+  next: record
+# Audit only once the plan is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.plan.RecordPlanAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlans
+  govern: [ transaction ]
