@@ -0,0 +1,23 @@
+# POST /api/sheets/{sheetId}/people/{personId}/plans — add a plan to a person (body: {amount, start, every,
+# end, user}): a DRAFT claim of the amount for every plan date (the start, then every N days) up to the end,
+# made by POST plans/generate. The amount is a number with up to two decimals, every a whole number of at
+# least 1, the dates yyyy-MM-dd (a blank start the sheet's today). Refused (400), storing nothing, when any
+# is not, the end is before the start, or the person is not on the sheet. Recorded as PLAN_ADDED.
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlan
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.plan.SavePlan
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.plan.AuditPlanAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
+  govern: [ transaction ]
