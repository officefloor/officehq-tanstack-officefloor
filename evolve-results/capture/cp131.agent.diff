@@ -0,0 +1,24 @@
+# POST /api/sheets/{sheetId}/people/{personId}/plans — give the person a plan: an amount, a start date,
+# every N days and an end date. An amount the claim form would refuse (or negative), a date that is not a
+# date, an interval that is not a whole number of at least 1, or an end before the start, is refused.
+# A viewer may change nothing: refused before anything is read or written.
+guard:
+  class: net.officefloor.hq.app.setting.RefuseViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlan
+  next: load
+load:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.plan.AddPlan
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.plan.RecordPlanAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
