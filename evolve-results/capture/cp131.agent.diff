+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/plans/generate.POST.yml
@@ -0,0 +1,15 @@
+# POST /api/sheets/{sheetId}/plans/generate — for every plan on the sheet in the order they were added,
+# a DRAFT claim of its amount, dated that day with an empty note, for every plan date up to its end and the
+# sheet's today that it has made none for yet, by the claim form's rules: a date the form refuses is
+# skipped and tried again next time. Each is recorded as CLAIM_ADDED. Answers {generated}. Refused (400)
+# for a viewer or on an archived sheet.
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlanGenerate
+  next: generate
+generate:
+  class: net.officefloor.hq.app.plan.GeneratePlanClaims
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlanGenerate
+  govern: [ transaction ]
