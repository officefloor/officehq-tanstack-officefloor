+# Add a plan to a person: an amount the claim form would take, a start, every N days (a whole number,
+# at least 1) and an end not before the start. A bad plan is a 400 and writes nothing.
+# A viewer may change nothing: refused before anything is read or written.
+viewer:
+  class: net.officefloor.hq.app.role.CheckCanChange
+  next: validate
+validate:
+  class: net.officefloor.hq.app.plan.ValidatePlan
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: loadPerson
+loadPerson:
+  class: net.officefloor.hq.app.person.LoadPerson
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.plan.SavePlan
+  govern: [ transaction ]
+  next: audit
+# Last before the response: every rule has passed and the change is saved.
+audit:
+  class: net.officefloor.hq.app.plan.AuditPlanAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.plan.RespondWithPlan
+  govern: [ transaction ]
