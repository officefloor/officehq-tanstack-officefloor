@@ -0,0 +1,20 @@
+# Assign a user name a role, replacing any it had. Validate first so an unknown role is refused (400)
+# and writes nothing.
+validate:
+  class: net.officefloor.hq.app.setting.ValidateRole
+  next: apply
+apply:
+  class: net.officefloor.hq.app.setting.ApplyRole
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.setting.SaveRole
+  govern: [ transaction ]
+  next: audit
+# Record the change only once it is saved, so a refused change writes no audit line.
+audit:
+  class: net.officefloor.hq.app.setting.AuditRoleSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.setting.RespondWithRole
