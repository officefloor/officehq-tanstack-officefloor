+# POST /api/sheets/{sheetId}/settings — change a setting (body: {key, value, user}). The only key is
+# clerk-limit: a number of 0.00 or more with up to two decimals, or blank for no limit. Any other key
+# or value is refused (400) and nothing is stored. A stored change is recorded in the audit file as
+# SETTING_CHANGED (even when the value is the one already in force); a refused one records nothing.
+validate:
+  class: net.officefloor.hq.app.setting.ValidateSetting
+  next: save
