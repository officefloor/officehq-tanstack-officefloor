+  govern: [ transaction ]
+  next: record
+# Audit only once the change is saved: a refused change writes no line.
+record:
+  class: net.officefloor.hq.app.settings.RecordRoleSet
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.settings.RespondWithSettings
