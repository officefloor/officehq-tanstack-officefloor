@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.setting;
+
+import jakarta.validation.Valid;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateRoleRequest {
+    public void validate(@PathVariable("sheetId") String sheetId, @RequestBody @Valid RoleRequest request,
+            Out<UserRole> role) throws InvalidSettingException {
+        String user = request.user() == null ? "" : request.user().trim();
+        if (user.isEmpty()) {
+            throw new InvalidSettingException("A user name is required.");
+        }
+        Role found = Role.of(request.role());
+        if (found == null) {
+            throw new InvalidSettingException("The role must be clerk or steward.");
+        }
+        role.set(new UserRole(sheetId, user, found));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/setting/ValidateSettingsRequest.java b/src/main/java/net/officefloor/hq/app/setting/ValidateSettingsRequest.java
new file mode 100644
index 000000000..f3bf7dafc
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/setting/ValidateSettingsRequest.java
@@ -0,0 +1,26 @@
+package net.officefloor.hq.app.setting;
+
+import jakarta.validation.Valid;
+import java.math.BigDecimal;
+import java.util.regex.Pattern;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateSettingsRequest {
+
+    /** 0.00 or more, with at most two decimals. */
+    private static final Pattern AMOUNT = Pattern.compile("\\d{1,13}(\\.\\d{1,2})?|\\.\\d{1,2}");
+
+    public void validate(@RequestBody @Valid SettingsRequest request, Out<ClerkLimit> limit)
+            throws InvalidSettingException {
+        String value = request.clerkLimit() == null ? "" : request.clerkLimit().trim();
+        if (value.isEmpty()) {
+            limit.set(new ClerkLimit(null));
+            return;
+        }
+        if (!AMOUNT.matcher(value).matches()) {
+            throw new InvalidSettingException("The clerk limit must be 0.00 or more, with at most two decimals, or blank.");
+        }
+        limit.set(new ClerkLimit(new BigDecimal(value).setScale(2)));
+    }
+}
