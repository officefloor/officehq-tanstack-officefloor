@@ -0,0 +1,22 @@
+package net.officefloor.hq.app.setting;
+
+import java.util.Set;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateRole {
+    private static final Set<String> ROLES = Set.of(Role.CLERK, Role.STEWARD);
+
+    public void validate(@RequestBody RoleRequest request, Out<RoleRequest> body)
+            throws InvalidSettingException {
+        String user = request == null || request.user() == null ? "" : request.user().trim();
+        String role = request == null || request.role() == null ? "" : request.role().trim();
+        if (user.isEmpty()) {
+            throw new InvalidSettingException("A user name is required");
+        }
+        if (!ROLES.contains(role)) {
+            throw new InvalidSettingException("Role must be clerk or steward");
+        }
+        body.set(new RoleRequest(user, role));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/setting/ValidateSetting.java b/src/main/java/net/officefloor/hq/app/setting/ValidateSetting.java
new file mode 100644
index 000000000..116593228
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/setting/ValidateSetting.java
@@ -0,0 +1,25 @@
+package net.officefloor.hq.app.setting;
+
+import java.math.BigDecimal;
+import java.util.regex.Pattern;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+public class ValidateSetting {
+    /** 0 or more, with up to two decimals. */
+    private static final Pattern MONEY = Pattern.compile("(\\d+(\\.\\d{0,2})?|\\.\\d{1,2})");
+
+    public void validate(@RequestBody SettingRequest request, Out<SettingRequest> body)
+            throws InvalidSettingException {
+        String key = request == null || request.key() == null ? "" : request.key().trim();
+        String value = request == null || request.value() == null ? "" : request.value().trim();
+        if (!SettingRepository.CLERK_LIMIT.equals(key)) {
+            throw new InvalidSettingException("Unknown setting: " + key);
+        }
+        if (!value.isEmpty() && !MONEY.matcher(value).matches()) {
+            throw new InvalidSettingException("The clerk limit is blank or 0.00 or more with up to two decimals");
+        }
+        body.set(new SettingRequest(key,
+                value.isEmpty() ? null : new BigDecimal(value).setScale(2).toPlainString()));
+    }
+}
diff --git a/src/main/resources/db/migration/V18__setting_role.sql b/src/main/resources/db/migration/V18__setting_role.sql
