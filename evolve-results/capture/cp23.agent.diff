+# PUT /api/sheets/{sheetId}/settings — save the sheet's settings. Body {"clerkLimit":"1.50"}: an amount
+# with up to two decimals, kept with two; blank is no limit. Anything else is refused with 400 and
+# nothing is stored. Every save is audited, even of the value already in force.
+validate:
+  class: net.officefloor.hq.app.setting.ValidateSettings
+  next: apply
+  govern: [ transaction ]
+apply:
+  class: net.officefloor.hq.app.setting.ApplySettings
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.setting.AuditSettingChanged
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.setting.RespondWithSettings
+  govern: [ transaction ]
