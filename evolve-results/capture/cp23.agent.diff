+++ b/src/main/java/net/officefloor/hq/app/setting/ValidateRole.java
@@ -0,0 +1,23 @@
+package net.officefloor.hq.app.setting;
+
+import java.util.Set;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the role from the body, refusing an empty user name or a role other than clerk or steward. */
+public class ValidateRole {
+
+    private static final Set<String> ROLES = Set.of(UserRole.CLERK, UserRole.STEWARD);
+
+    public void validate(@RequestBody RoleRequest request, Out<RoleInput> roleOut) throws InvalidSettingException {
+        String user = request == null || request.user() == null ? "" : request.user().trim();
+        String role = request == null || request.role() == null ? "" : request.role().trim();
+        if (user.isEmpty()) {
+            throw new InvalidSettingException("The user name must not be empty.");
+        }
+        if (!ROLES.contains(role)) {
+            throw new InvalidSettingException("The role must be clerk or steward.");
+        }
+        roleOut.set(new RoleInput(user, role));
+    }
+}
diff --git a/src/main/java/net/officefloor/hq/app/setting/ValidateSettings.java b/src/main/java/net/officefloor/hq/app/setting/ValidateSettings.java
new file mode 100644
index 0000000..44c2e80
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/setting/ValidateSettings.java
@@ -0,0 +1,21 @@
+package net.officefloor.hq.app.setting;
+
+import java.math.BigDecimal;
+import java.util.regex.Pattern;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Reads the settings from the body, refusing a clerk limit that is not empty or 0.00 or more with up to two decimals. */
+public class ValidateSettings {
+
+    private static final Pattern LIMIT = Pattern.compile("\\d{1,12}(\\.\\d{1,2})?");
+
+    public void validate(@RequestBody SettingsRequest request, Out<SettingsInput> settingsOut)
+            throws InvalidSettingException {
+        String limit = request == null || request.clerkLimit() == null ? "" : request.clerkLimit().trim();
+        if (!limit.isEmpty() && !LIMIT.matcher(limit).matches()) {
+            throw new InvalidSettingException("The clerk limit must be empty or 0.00 or more, with up to two decimals.");
+        }
+        settingsOut.set(new SettingsInput(limit.isEmpty() ? null : new BigDecimal(limit).setScale(2).toPlainString()));
+    }
+}
