+# Retire the selected people together from a date (blank: the sheet's today), in list order. Each is retired
+# exactly as the row's retire would, with its PERSON_RETIRED line and then how the sheet's figures moved over it.
+# A refused request (no user, no people, a bad date) writes nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkRetire
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.BulkRetirePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
+  govern: [ transaction ]
