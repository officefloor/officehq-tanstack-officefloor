+# Retire the selected people together from a date (blank: the sheet's today): each, in list order (by
+# their position), exactly as the row's retire would. Answers how many were retired (none for a viewer).
+guard:
+  class: net.officefloor.hq.app.history.RefuseAsOf
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.BulkRetirePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
