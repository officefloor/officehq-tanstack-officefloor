diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-retire.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-retire.POST.yml
new file mode 100644
index 000000000..9133a9310
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-retire.POST.yml
@@ -0,0 +1,13 @@
+# POST /api/sheets/{sheetId}/bulk-retire — retire the selected people together from a date (blank: the sheet's today).
+# A date that is not yyyy-MM-dd is a 400 and writes nothing. Each selected person on the sheet, in list order (see the
+# people's move), is retired exactly as the row's retire would (see RetirePeople): PERSON_RETIRED and the figures it
+# moved. Responds with how many were retired.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkRetire
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
