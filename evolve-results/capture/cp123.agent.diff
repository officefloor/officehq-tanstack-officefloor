--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/people/bulk-retire.POST.yml
@@ -0,0 +1,19 @@
+# Retire the selected people together from a date (blank for the sheet's today), in list order,
+# each exactly as the row's retire would. A bad date is a 400: refused before anything is read or
+# written. A viewer may change nothing, nor anyone on an archived sheet: every selected person is
+# refused and none is retired.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkRetire
+  next: loadSheet
+loadSheet:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: retire
+# Each person retired is audited as it is retired: its own line, then the figures it moved.
+retire:
+  class: net.officefloor.hq.app.person.RetireSelectedPeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
+  govern: [ transaction ]
