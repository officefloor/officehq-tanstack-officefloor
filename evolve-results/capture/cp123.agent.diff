+# Retire the selected people together from a date, in list order (people as added). Each is retired as the row's
+# retire does (the same PERSON_RETIRED and rollup lines); answers how many were retired.
+# A viewer may retire no one: their bulk retire changes nothing and answers none.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: selected
+selected:
+  class: net.officefloor.hq.app.person.ValidateBulkRetire
+  next: archived
+archived:
+  class: net.officefloor.hq.app.sheet.RefuseArchived
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
+  govern: [ transaction ]
