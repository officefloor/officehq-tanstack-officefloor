@@ -0,0 +1,16 @@
+# POST /api/sheets/{sheetId}/bulk-retire — retire the selected people together (body {personIds, date,
+# user}). Each selected person, in list order (by their positions), is retired from the date (the
+# sheet's today when blank) exactly as the row's retire would, and recorded as PERSON_RETIRED, then
+# how it moved the sheet's figures. Answers {retired}. Refused (400), storing nothing, when no person
+# is selected, one is not on the sheet, the date is not a date, or the sheet is archived. A viewer
+# retires no one: answers {retired: 0}, storing and recording nothing.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkRetire
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
+  govern: [ transaction ]
