+# Retire the selected people together from a date (blank: the sheet's today). Each, in list order,
+# is retired as the row's retire would, audited as that would be. Answers how many were retired.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkRetire
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.RetirePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
+  govern: [ transaction ]
