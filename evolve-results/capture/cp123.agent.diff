@@ -0,0 +1,28 @@
+package net.officefloor.hq.app.person;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import java.util.List;
+import net.officefloor.plugin.variable.Out;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/** Refuses a bulk retire with no one selected or a date not a date. */
+public class ValidateBulkRetire {
+    public void validate(@RequestBody BulkRetireRequest request, Out<BulkRetireRequest> body)
+            throws InvalidPersonException {
+        List<Long> ids = request == null || request.personIds() == null ? List.of()
+                : request.personIds().stream().filter((id) -> id != null).toList();
+        if (ids.isEmpty()) {
+            throw new InvalidPersonException("Select the people to retire");
+        }
+        String from = request.from() == null ? "" : request.from().trim();
+        if (!from.isEmpty()) {
+            try {
+                LocalDate.parse(from);
+            } catch (DateTimeParseException e) {
+                throw new InvalidPersonException("Not a date: " + from);
+            }
+        }
+        body.set(new BulkRetireRequest(ids, from.isEmpty() ? null : from));
+    }
+}
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-retire.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-retire.POST.yml
new file mode 100644
index 000000000..bbcce0179
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/bulk-retire.POST.yml
@@ -0,0 +1,14 @@
+# POST /api/sheets/{sheetId}/bulk-retire — retire the selected people together from a date (blank:
+# the sheet's today), in list order, each exactly as the row's retire would (its PERSON_RETIRED line,
+# then the rollup lines it moved). Refused (400) with no one selected or a date not a date, or on an
+# archived sheet; a viewer may retire no one, so for a viewer nothing is written and none are counted.
+# Responds with how many were retired.
+validate:
+  class: net.officefloor.hq.app.person.ValidateBulkRetire
+  next: retire
+retire:
+  class: net.officefloor.hq.app.person.BulkRetirePeople
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.person.RespondWithBulkRetire
