diff --git a/src/main/resources/db/migration/V87__sheet_clone_source.sql b/src/main/resources/db/migration/V87__sheet_clone_source.sql
new file mode 100644
index 00000000..9b0ef595
--- /dev/null
+++ b/src/main/resources/db/migration/V87__sheet_clone_source.sql
@@ -0,0 +1,6 @@
+-- The sheet each cloned sheet was cloned from: its source, whose rates it uses when it and its parents have none in
+-- force for a grade on a date. Not dated, like the parent.
+CREATE TABLE sheet_source (
+    id        VARCHAR(255) PRIMARY KEY,
+    source_id VARCHAR(255) NOT NULL
+);
