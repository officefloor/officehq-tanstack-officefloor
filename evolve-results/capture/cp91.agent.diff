+# POST /api/sheets/{sheetId}/claims/{claimId}/comment — comment a claim (body {user, text}): the comment is
+# kept with its user and the sheet's today, in any status. Refused (400) for a viewer, an archived sheet, a
+# claim not on the sheet or an empty (blank) text; nothing is stored then. A kept comment is recorded in the
+# audit file as COMMENT_ADDED.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateComment
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: apply
+apply:
+  class: net.officefloor.hq.app.claim.ApplyComment
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditCommentAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
