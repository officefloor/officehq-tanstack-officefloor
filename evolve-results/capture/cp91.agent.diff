+# comment is refused (400) and writes nothing.
+archived:
+  class: net.officefloor.hq.app.sheet.CheckNotArchived
+  next: viewer
+viewer:
+  class: net.officefloor.hq.app.setting.CheckNotViewer
+  next: validate
+validate:
+  class: net.officefloor.hq.app.claim.ValidateCommentRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.claim.AddClaimComment
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditClaimCommentAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
