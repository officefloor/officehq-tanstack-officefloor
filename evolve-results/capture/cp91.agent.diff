+-- A claim's comments, in the order written: each keeps who wrote it, the sheet's today then, and its text.
+CREATE TABLE claim_comment (
+    id       BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200)  NOT NULL,
+    claim_id BIGINT        NOT NULL REFERENCES claim (id),
+    by_user  VARCHAR(200)  NOT NULL,
+    on_date  DATE          NOT NULL,
+    comment_text VARCHAR(2000) NOT NULL
+);
+CREATE INDEX claim_comment_sheet ON claim_comment (sheet_id, claim_id, id);
+
+CREATE TABLE asof.claim_comment AS SELECT * FROM public.claim_comment WHERE FALSE;
+CREATE TABLE asof_hist.claim_comment AS SELECT * FROM public.claim_comment WHERE FALSE;
+ALTER TABLE asof_hist.claim_comment ADD COLUMN h_seq BIGINT NOT NULL;
+ALTER TABLE asof_hist.claim_comment ADD COLUMN h_made_on DATE;
+ALTER TABLE asof_hist.claim_comment ADD COLUMN h_op CHAR(1) NOT NULL;
+CREATE INDEX claim_comment_hist_sheet ON asof_hist.claim_comment (sheet_id, h_seq);
+CREATE TRIGGER claim_comment_history AFTER INSERT, UPDATE, DELETE ON public.claim_comment FOR EACH ROW CALL 'net.officefloor.hq.app.sheet.History';
diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/comments.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/comments.POST.yml
new file mode 100644
index 00000000..7b3ad503
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/claims/{claimId}/comments.POST.yml
@@ -0,0 +1,21 @@
+# Comment on a claim: the comment is kept with who wrote it and the sheet's today. An empty comment
+# is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateClaimComment
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveClaimComment
+  govern: [ transaction ]
+  next: record
+# Audit only once the comment is saved: a refused comment writes no line.
+record:
+  class: net.officefloor.hq.app.claim.RecordClaimCommented
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
