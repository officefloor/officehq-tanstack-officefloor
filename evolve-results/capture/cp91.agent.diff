+# Comment a claim: it shows one more comment line, <user> on <date>: <text>, the date being the sheet's today. A refused comment (an empty text, unknown claim) writes nothing, not even an audit line.
+validate:
+  class: net.officefloor.hq.app.claim.ValidateComment
+  next: load
+load:
+  class: net.officefloor.hq.app.claim.LoadClaim
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.claim.SaveComment
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.claim.AuditCommentAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.claim.RespondWithClaim
+  govern: [ transaction ]
