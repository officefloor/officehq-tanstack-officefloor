@@ -0,0 +1,11 @@
+-- A claim's comments, oldest first (by id): each with its trimmed text, the user who wrote it and
+-- the sheet's today when it was written.
+CREATE TABLE claim_comment (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    claim_id BIGINT NOT NULL REFERENCES claim(id),
+    by_user VARCHAR(200) NOT NULL,
+    on_date DATE NOT NULL,
+    text VARCHAR(2000) NOT NULL
+);
+CREATE INDEX claim_comment_sheet ON claim_comment(sheet_id, claim_id, id);
diff --git a/src/main/resources/db/migration/V57__person_terms_history.sql b/src/main/resources/db/migration/V57__person_terms_history.sql
new file mode 100644
index 000000000..550585e06
--- /dev/null
+++ b/src/main/resources/db/migration/V57__person_terms_history.sql
@@ -0,0 +1,13 @@
+-- Every terms a person was given, oldest first, with the sheet's today when they were given (null
+-- terms: none): a person's terms as of a date are the last given on or before it. What was already
+-- stored counts from the beginning of time.
+CREATE TABLE person_terms_history (
+    id BIGINT AUTO_INCREMENT PRIMARY KEY,
+    sheet_id VARCHAR(200) NOT NULL REFERENCES sheet(id),
+    person_id BIGINT NOT NULL REFERENCES person(id),
+    terms INT,
+    set_on DATE NOT NULL
+);
+CREATE INDEX person_terms_history_sheet ON person_terms_history(sheet_id, person_id, id);
+INSERT INTO person_terms_history (sheet_id, person_id, terms, set_on)
+    SELECT sheet_id, id, terms, DATE '0001-01-01' FROM person;
