+# GET /api/sheets/{sheetId}/snapshots/compare?from=&to= — per person in list order, "<name> <then> <now>": then is the
+# due-total of the SNAPSHOT written when the sheet's today was changed away from the from-date (blank: the sheet's
+# today), now likewise for the to-date, or the person's due-total now when the to-date is blank. A figure with no
+# snapshot is empty; each line is trimmed.
+respond:
+  class: net.officefloor.hq.app.rollup.RespondWithSnapshotCompare
+  govern: [ readonly-transaction ]
