@@ -0,0 +1,38 @@
+import { useMutation } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+import { HomeMain } from '../../slots/defs/homeMain';
+import { useCurrentSheet } from '../../session/session';
+
+// The sheet's activity: for every user and every event in its audit lines, one line
+// "<user> <EVENT> <count>", sorted by user then event. It reads the file each time Show is pressed.
+function Activity() {
+  const [sheet] = useCurrentSheet();
+
+  const show = useMutation({
+    mutationFn: () => getJson<string[]>(`/api/sheets/${encodeURIComponent(sheet)}/activity`),
+  });
+
+  return (
+    <section data-testid="activity">
+      <h2>Activity</h2>
+      <button type="button" data-testid="activity-show" disabled={sheet === ''} onClick={() => show.mutate()}>
+        Show
+      </button>
+      {show.isError && (
+        <span data-testid="activity-error" role="alert">
+          {' '}
+          The activity could not be read.
+        </span>
+      )}
+      <ul>
+        {(show.isPending ? [] : (show.data ?? [])).map((line) => (
+          <li key={line} data-testid="activity-line">
+            {line}
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+export const contribution = HomeMain.fill({ order: 53, Component: Activity });
diff --git a/src/main/java/net/officefloor/hq/app/audit/RespondWithActivity.java b/src/main/java/net/officefloor/hq/app/audit/RespondWithActivity.java
new file mode 100644
index 000000000..27321d7e9
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/audit/RespondWithActivity.java
@@ -0,0 +1,34 @@
+package net.officefloor.hq.app.audit;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** The sheet's activity: for every user (by=) and every event in its audit lines, one line
+ *  "<user> <EVENT> <count>", sorted by user then event. */
+public class RespondWithActivity {
+    public void respond(@PathVariable("sheetId") String sheetId, Audit audit, ObjectResponse<List<String>> response) {
+        Map<String, Map<String, Integer>> counts = new TreeMap<>();
+        for (String line : audit.lines(sheetId.trim(), null)) {
+            String[] fields = line.split(" ");
+            String by = null;
+            for (String f : fields) {
+                if (f.startsWith("by=")) {
+                    by = f.substring("by=".length());
+                    break;
+                }
+            }
+            if (by == null || by.isEmpty()) {
+                continue;
+            }
+            counts.computeIfAbsent(by, u -> new TreeMap<>()).merge(fields[0], 1, Integer::sum);
+        }
+        List<String> lines = new ArrayList<>();
+        counts.forEach((user, events) -> events.forEach((event, n) -> lines.add(user + " " + event + " " + n)));
+        response.send(lines);
+    }
+}
