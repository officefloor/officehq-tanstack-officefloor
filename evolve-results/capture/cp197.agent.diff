+import { useMutation } from '@tanstack/react-query';
+import { getJson } from '../../api/http';
+import { HomeMain } from '../../slots/defs/homeMain';
+import { useCurrentSheet, useCurrentUser } from '../session/session';
+
+const activityPath = (sheetId: string) => `/api/sheets/${encodeURIComponent(sheetId)}/activity`;
+
+// The sheet's activity: one line "<user> <EVENT> <count>" per user and event in the sheet's audit file, sorted
+// by user then event. It reads the file each time Show is pressed; while a read runs the old lines are gone.
+function Activity() {
+  const [user] = useCurrentUser();
+  const [sheet] = useCurrentSheet();
+  const show = useMutation({
+    mutationFn: () => getJson<string[]>(activityPath(sheet ?? '')),
+  });
+
+  if (!user || !sheet) return null;
+  return (
+    <section data-testid="activity">
+      <h2>Activity</h2>
+      <button type="button" data-testid="activity-show" onClick={() => show.mutate()}>Show</button>
+      <ul>
+        {(show.isPending ? [] : show.data ?? []).map((line, i) => (
+          <li key={i} data-testid="activity-line">{line}</li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+export const contribution = HomeMain.fill({ order: 100, Component: Activity });
diff --git a/src/main/java/net/officefloor/hq/app/activity/RespondWithActivity.java b/src/main/java/net/officefloor/hq/app/activity/RespondWithActivity.java
new file mode 100644
index 00000000..80b479f2
--- /dev/null
+++ b/src/main/java/net/officefloor/hq/app/activity/RespondWithActivity.java
@@ -0,0 +1,37 @@
+package net.officefloor.hq.app.activity;
+
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import net.officefloor.hq.app.Audit;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.web.bind.annotation.PathVariable;
+
+/** The sheet's activity: for every user and every event in the sheet's audit lines, one line
+ *  "&lt;user&gt; &lt;EVENT&gt; &lt;count&gt;", sorted by user then event. */
+public class RespondWithActivity {
+    public void respond(@PathVariable("sheetId") String sheetId, Audit audit,
+            ObjectResponse<List<String>> response) {
+        Map<String, Map<String, Integer>> counts = new TreeMap<>();
+        for (String line : audit.linesOf(sheetId.trim())) {
+            String[] fields = line.split(" ");
+            String event = fields[0];
+            String user = null;
+            for (String field : fields) {
+                if (field.startsWith("by=")) {
+                    user = field.substring("by=".length());
+                    break;
+                }
+            }
+            if (event.isEmpty() || user == null) {
+                continue;
+            }
+            counts.computeIfAbsent(user, u -> new TreeMap<>()).merge(event, 1, Integer::sum);
+        }
+        List<String> lines = counts.entrySet().stream()
+                .flatMap(byUser -> byUser.getValue().entrySet().stream()
+                        .map(byEvent -> byUser.getKey() + " " + byEvent.getKey() + " " + byEvent.getValue()))
+                .toList();
+        response.send(lines);
+    }
+}
