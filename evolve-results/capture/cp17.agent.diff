+++ b/src/main/resources/db/migration/V14__period.sql
@@ -0,0 +1,12 @@
+-- The sheet's periods: a name unique on the sheet (compared without regard to case, ignoring surrounding
+-- spaces) and an inclusive from and to date. No two periods on a sheet overlap. A claim belongs to the
+-- period whose dates contain its date, or to none.
+CREATE TABLE period (
+    sheet_id  VARCHAR(100) NOT NULL REFERENCES sheet(id),
+    name      VARCHAR(200) NOT NULL,
+    name_key  VARCHAR(200) GENERATED ALWAYS AS (LOWER(TRIM(name))),
+    from_date DATE         NOT NULL,
+    to_date   DATE         NOT NULL,
+    CHECK (from_date <= to_date)
+);
+CREATE UNIQUE INDEX period_sheet_name ON period(sheet_id, name_key);
