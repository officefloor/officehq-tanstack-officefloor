+package net.officefloor.hq.app.period;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.time.LocalDate;
+
+/** A period of the sheet: a name unique on the sheet, and its from and to dates, inclusive. */
+@Entity
+@Table(name = "period")
+public class Period {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(name = "sheet_id", nullable = false)
+    private String sheetId;
+
+    @Column(name = "name", nullable = false)
+    private String name;
+
+    @Column(name = "from_date", nullable = false)
+    private LocalDate fromDate;
+
+    @Column(name = "to_date", nullable = false)
+    private LocalDate toDate;
+
+    protected Period() {
+    }
+
+    public Period(String sheetId, String name, LocalDate fromDate, LocalDate toDate) {
+        this.sheetId = sheetId;
+        this.name = name;
+        this.fromDate = fromDate;
+        this.toDate = toDate;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getSheetId() {
+        return sheetId;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public LocalDate getFromDate() {
+        return fromDate;
+    }
+
+    public LocalDate getToDate() {
+        return toDate;
+    }
+
+    /** Whether this period shares a date with the one from {@code from} to {@code to}, inclusive. */
+    public boolean overlaps(LocalDate from, LocalDate to) {
+        return !fromDate.isAfter(to) && !from.isAfter(toDate);
+    }
+}
