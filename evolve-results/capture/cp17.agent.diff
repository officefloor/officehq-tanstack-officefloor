diff --git a/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods.POST.yml b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods.POST.yml
new file mode 100644
index 000000000..f7c4b990c
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods.POST.yml
@@ -0,0 +1,23 @@
+# POST /api/sheets/{sheetId}/periods — add a period (body: {name, from, to, user}; dates yyyy-MM-dd,
+# inclusive). An empty name, a name another period on the sheet has (ignoring case and the spaces
+# around it), a missing or bad date, a to before the from, or dates overlapping another period's is
+# refused (400) and nothing is stored. A stored period is recorded in the audit file as PERIOD_ADDED;
+# a refused one records nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: check
+check:
+  class: net.officefloor.hq.app.period.CheckPeriodFree
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SavePeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
