+# Validate first so a bad name or date is a 400; Save refuses a duplicate name or an overlap before writing.
+# Responds with the sheet's periods.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SavePeriod
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriods
+  govern: [ transaction ]
