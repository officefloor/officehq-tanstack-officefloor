+# Add a period; a missing name, a bad date, a to-date before the from-date, a name already in use on the sheet, or dates overlapping another period, is refused (400).
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriodRequest
+  next: load
+load:
+  class: net.officefloor.hq.app.sheet.LoadSheet
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.period.BuildPeriod
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.period.CheckPeriodFits
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SavePeriod
+  govern: [ transaction ]
