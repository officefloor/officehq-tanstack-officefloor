index 00000000..8bf021b9
--- /dev/null
+++ b/src/main/resources/officefloor/rest/api/sheets/{sheetId}/periods.POST.yml
@@ -0,0 +1,26 @@
+# Add a period. Validate the body before touching the store, so a refusal writes nothing.
+validate:
+  class: net.officefloor.hq.app.sheet.ValidateSheetId
+  next: period
+period:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: ensure
+ensure:
+  class: net.officefloor.hq.app.sheet.EnsureSheet
+  govern: [ transaction ]
+  next: check
+check:
+  class: net.officefloor.hq.app.period.CheckPeriod
+  govern: [ transaction ]
+  next: build
+build:
+  class: net.officefloor.hq.app.period.BuildPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.RecordPeriodAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
