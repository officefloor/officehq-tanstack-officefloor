@@ -0,0 +1,22 @@
+# The audit line is written last, once every rule has passed, so a refused change writes none.
+# Validate first so a blank name, a missing date or a from after its to is a 400 and nothing is
+# written; a name already in use or dates overlapping another period are also a 400.
+# Adding a period moves no person's figures, so no rollup is written.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: check
+check:
+  class: net.officefloor.hq.app.period.CheckPeriod
+  govern: [ transaction ]
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SavePeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriodCreated
+  govern: [ transaction ]
