+# POST /api/sheets/{sheetId}/periods — add a period. Body {"name":"P1","from":"2026-03-01","to":"2026-03-31"}:
+# both dates inclusive. A blank or taken name, a bad date, a to-date before the from-date, or an
+# overlap with another of the sheet's periods is refused with 400 and nothing is stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: add
+  govern: [ transaction ]
+add:
+  class: net.officefloor.hq.app.period.AddPeriod
+  next: audit
+  govern: [ transaction ]
+audit:
+  class: net.officefloor.hq.app.period.AuditPeriodAdded
+  next: respond
+  govern: [ transaction ]
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
