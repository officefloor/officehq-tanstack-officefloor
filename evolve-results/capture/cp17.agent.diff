+# Add a period: a name unique on the sheet and a from- and to-date (inclusive, from on or before
+# to) that overlap no other period of the sheet.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: save
+save:
+  class: net.officefloor.hq.app.period.SavePeriod
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
