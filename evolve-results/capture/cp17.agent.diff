+# POST /api/sheets/{sheetId}/periods — add a period: a name and a from and to date, both inclusive. An empty name,
+# a date that is not yyyy-MM-dd, a to-date before the from-date, a name already on the sheet (case and outer spaces
+# ignored) or dates overlapping another period of the sheet is a 400 and writes nothing. Responds 201 with the
+# period as stored.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: check
+check:
+  class: net.officefloor.hq.app.period.CheckNewPeriod
+  govern: [ transaction ]
+  next: add
+add:
+  class: net.officefloor.hq.app.period.AddPeriod
+  govern: [ transaction ]
+  next: audit
+audit:
+  class: net.officefloor.hq.app.period.RecordPeriodAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriodCreated
