@@ -0,0 +1,17 @@
+# Add a period. Validate first so a bad name or dates is a 400 and writes nothing.
+validate:
+  class: net.officefloor.hq.app.period.ValidatePeriod
+  next: save
+# Refuses a name already used or dates overlapping another period of the sheet.
+save:
+  class: net.officefloor.hq.app.period.SavePeriod
+  govern: [ transaction ]
+  next: record
+# Audit only once the period is saved: a refused one writes no line.
+record:
+  class: net.officefloor.hq.app.period.RecordPeriodAdded
+  govern: [ transaction ]
+  next: respond
+respond:
+  class: net.officefloor.hq.app.period.RespondWithPeriod
+  govern: [ transaction ]
