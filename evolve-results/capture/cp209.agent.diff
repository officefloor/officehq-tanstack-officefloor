diff --git a/src/main/frontend/features/score/score.slot.tsx b/src/main/frontend/features/score/score.slot.tsx
new file mode 100644
index 000000000..410f83ab9
--- /dev/null
+++ b/src/main/frontend/features/score/score.slot.tsx
@@ -0,0 +1,14 @@
+import { PersonCells, PersonColumnHead } from '../../slots/defs/personRow';
+import { useScores } from './useScore';
+
+/** A person's score: their settled figures divided by 100, minus 5 per overdue claim that counts, rounded
+ *  half to even to a whole number. */
+function PersonScore({ sheetId, personId }: { sheetId: string; personId: number }) {
+  const score = useScores(sheetId).get(personId);
+  return <td data-testid="person-score">{score === undefined ? '' : score.toString()}</td>;
+}
+
+export const contributions = [
+  PersonColumnHead.fill({ order: 26, Component: () => <th>Score</th> }),
+  PersonCells.fill({ order: 26, Component: PersonScore }),
+];
diff --git a/src/main/frontend/features/score/useScore.ts b/src/main/frontend/features/score/useScore.ts
new file mode 100644
index 000000000..f4e916c5f
--- /dev/null
+++ b/src/main/frontend/features/score/useScore.ts
@@ -0,0 +1,27 @@
+import { useOverdue } from '../overdue/useOverdue';
+import { hundredths } from '../rates/useRates';
+import { useSettledOpenTotals } from '../rates/useDueTotals';
+
+/** Each person's score, by person id: their settled figures (the settled-total of their counting SETTLED
+ *  claims) divided by 100, minus 5 for every overdue claim of theirs that counts, rounded half to even to a
+ *  whole number. Worked in whole numbers, so exact. Missing until their figures are loaded. */
+export function useScores(sheetId: string): Map<number, bigint> {
+  const split = useSettledOpenTotals(sheetId);
+  const overdue = useOverdue(sheetId);
+  const scores = new Map<number, bigint>();
+  for (const [id, s] of split) {
+    const o = overdue.get(id);
+    if (o === undefined) continue;
+    scores.set(id, halfEven(hundredths(s.settled), 10_000n) - 5n * BigInt(o.count));
+  }
+  return scores;
+}
+
+/** n / d (d > 0) rounded half to even to a whole number. */
+function halfEven(n: bigint, d: bigint): bigint {
+  let q = n / d;
+  let r = n % d;
+  if (r < 0n) { q -= 1n; r += d; }
+  if (2n * r > d || (2n * r === d && q % 2n !== 0n)) q += 1n;
+  return q;
+}
